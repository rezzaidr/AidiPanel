# AidiPanel .gitignore

# Credentials — NEVER commit these
credentials.conf
.my.cnf
.env
*.key
*.pem
*.crt
panel-app/storage/db/*.sqlite

# Private / internal working files (kept local, never published)
_private/
docs/plans/
docs/handoffs/
docs/internal/
docs/prompts/
*.handoff.md
*.prompt.md

# Local tooling config (not part of the project)
.claude/

# Runtime storage
panel-app/storage/
panel-app/storage/logs/
tests/logs/

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Node / frontend build dependencies
# (the build OUTPUT in panel-app/public/assets is committed and deployed;
#  only the dev dependencies are ignored. package-lock.json IS committed.)
node_modules/
panel-app/node_modules/

# Build artifacts
*.tar.gz
*.zip
dist/
