# AidiPanel .gitignore

# Credentials — NEVER commit these
aidipanel-app/storage/db/*.sqlite
credentials.conf
.my.cnf
*.key
*.pem

# Test loop — secrets (config.env berisi DO API token; JANGAN pernah commit)
tests/config.env
tests/logs/

# Logs
*.log
aidipanel-app/storage/logs/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Build artifacts
*.tar.gz
*.zip
dist/
