_cache_opcache_restart() {
  _require_root "cache:opcache-restart"
  _parse_opts "$@"
  local target_ver; target_ver=$(_opt "php" "")

  local versions=()
  if [[ -n "$target_ver" ]]; then
    versions=("$target_ver")
  else
    while IFS= read -r svc; do
      local ver; ver=$(echo "$svc" | grep -oP '\d+\.\d+(?=-fpm)')
      [[ -n "$ver" ]] && versions+=("$ver")
    done < <(systemctl list-units --type=service --state=active --no-legend 2>/dev/null \
      | grep -oP 'php\d+\.\d+-fpm\.service' | sort -u)
  fi

  if [[ "${#versions[@]}" -eq 0 ]]; then
    warn "No active PHP-FPM found."
    return 0
  fi

  local ver
  for ver in "${versions[@]}"; do
    systemctl reload "php${ver}-fpm" >> "$CLI_LOG" 2>&1 \
      && ok "OPcache restarted (PHP ${ver})" \
      || warn "Failed to reload php${ver}-fpm — try: systemctl restart php${ver}-fpm"
  done
}

# ===========================================================================
# SITE SECURITY — HTTP Basic Authentication
# ===========================================================================

_security_id() {
  printf '%s' "$1" | sha256sum | cut -c1-20
}

_security_dir() {
  printf '/etc/nginx/aidipanel/security/%s' "$1"
}

_security_htpasswd() {
  printf '%s/basic-auth.htpasswd' "$(_security_dir "$1")"
}

_security_state() {
  printf '%s/basic-auth.state' "$(_security_dir "$1")"
}

_security_http_inc() {
  printf '/etc/nginx/conf.d/aidipanel-security-%s.conf' "$(_security_id "$1")"
}

# Per-site mutation lock (shared by every per-site Security feature so that
# Basic Auth, IP Block, and Cloudflare-only mutations on one domain serialize).
_security_lock_path() {
  printf '/run/lock/aidipanel-security-%s.lock' "$(_security_id "$1")"
}

# IP-Block per-site artifacts: saved deny list + state under the domain dir, and
# a dedicated http-context include (kept separate from the Basic Auth include so
# each feature is independently writable).
_security_ipblock_list() {
  printf '%s/ip-block.list' "$(_security_dir "$1")"
}

_security_ipblock_state() {
  printf '%s/ip-block.state' "$(_security_dir "$1")"
}

_security_ipblock_inc() {
  printf '/etc/nginx/conf.d/aidipanel-ipblock-%s.conf' "$(_security_id "$1")"
}

_security_cfonly_state() {
  printf '%s/cloudflare-only.state' "$(_security_dir "$1")"
}

_security_cfonly_state_render() {
  local target="$1" enabled="$2"
  [[ "$enabled" == 0 || "$enabled" == 1 ]] || return 1
  printf 'schema=1\nenabled=%s\n' "$enabled" > "$target" || return 1
  chmod 0600 "$target"
}

_security_cfonly_state_get() {
  local file="$1" wanted="$2" key value extra
  local schema="" enabled="" schema_seen=0 enabled_seen=0 lines=0
  [[ "$wanted" == schema || "$wanted" == enabled ]] || return 1
  [[ -f "$file" ]] || return 1
  while IFS='=' read -r key value extra || [[ -n "$key$value$extra" ]]; do
    lines=$((lines + 1))
    [[ -z "$extra" ]] || return 1
    case "$key" in
      schema)
        schema_seen=$((schema_seen + 1)); schema="$value"
        ;;
      enabled)
        enabled_seen=$((enabled_seen + 1)); enabled="$value"
        ;;
      *) return 1 ;;
    esac
  done < "$file"
  [[ "$lines" -eq 2 && "$schema_seen" -eq 1 && "$enabled_seen" -eq 1 ]] || return 1
  [[ "$schema" == 1 && ( "$enabled" == 0 || "$enabled" == 1 ) ]] || return 1
  if [[ "$wanted" == schema ]]; then printf '%s' "$schema"; else printf '%s' "$enabled"; fi
}

_security_cfonly_render_marker() {
  local target="$1"
  {
    printf '    # >>> AIDIPANEL_CLOUDFLARE_ONLY >>>\n'
    printf '    if ($aidipanel_from_cloudflare = 0) { return 403; }\n'
    printf '    # <<< AIDIPANEL_CLOUDFLARE_ONLY <<<\n'
  } > "$target"
}

_security_cfonly_dependency_healthy() {
  local body="$1" enabled error
  enabled=$(printf '%s\n' "$body" | awk -F= '$1=="enabled"{print substr($0,9); n++} END{if(n!=1)exit 1}') \
    || return 1
  error=$(printf '%s\n' "$body" | awk -F= '$1=="error"{print substr($0,7); n++} END{if(n!=1)exit 1}') \
    || return 1
  [[ "$enabled" == 1 && -z "$error" ]]
}

# Return one marker-integrity code: ok, missing_marker, duplicate_marker,
# misplaced_marker, or misordered_marker. It never rewrites the vhost.
_security_cfonly_marker_status() {
  local conf="$1" global_starts global_ends result
  [[ -f "$conf" ]] || { printf 'missing_marker'; return 0; }
  global_starts=$(grep -cF '# >>> AIDIPANEL_CLOUDFLARE_ONLY >>>' "$conf" 2>/dev/null || true)
  global_ends=$(grep -cF '# <<< AIDIPANEL_CLOUDFLARE_ONLY <<<' "$conf" 2>/dev/null || true)
  if [[ "$global_starts" -eq 0 && "$global_ends" -eq 0 ]]; then printf 'missing_marker'; return 0; fi
  if [[ "$global_starts" -gt 1 || "$global_ends" -gt 1 ]]; then printf 'duplicate_marker'; return 0; fi
  if [[ "$global_starts" -ne 1 || "$global_ends" -ne 1 ]]; then printf 'missing_marker'; return 0; fi
  result=$(awk '
    function delta(s, a,b,t){t=s;a=gsub(/\{/ ,"{",t);t=s;b=gsub(/\}/,"}",t);return a-b}
    function flush( i,tok,idx,last,type,seen_name){
      type="other"; last=0; seen_name=0
      for(i=1;i<=n;i++){
        if(buf[i] ~ /listen[[:space:]]+(\[::\]:)?443[[:space:]]+ssl([[:space:]]|;)/) type="tls"
        else if(type=="other" && buf[i] ~ /listen[[:space:]]+(\[::\]:)?80[[:space:]]*;/) type="http"
      }
      if(type=="tls") tls_blocks++
      for(i=1;i<=n;i++){
        if(buf[i] ~ /^[[:space:]]*server_name[[:space:]]+[^;]+;[[:space:]]*$/) seen_name=1
        if(buf[i] !~ /# >>> AIDIPANEL_[A-Z_]+ >>>/) continue
        tok=buf[i]; sub(/.*# >>> /,"",tok); sub(/ >>>.*/,"",tok)
        idx=0
        if(tok=="AIDIPANEL_CLOUDFLARE_ONLY") idx=1
        else if(tok=="AIDIPANEL_IP_BLOCK") idx=2
        else if(tok=="AIDIPANEL_BASIC_AUTH") idx=3
        if(tok=="AIDIPANEL_CLOUDFLARE_ONLY"){
          starts++; if(type=="tls") in_tls++; else misplaced=1
          if(type=="tls" && !seen_name) bad_anchor=1
        }
        if(type=="tls" && idx>0){if(last>idx) misordered=1; last=idx}
      }
      for(i=1;i<=n;i++) if(buf[i] ~ /# <<< AIDIPANEL_CLOUDFLARE_ONLY <<</) ends++
      n=0
    }
    !inb && /^[[:space:]]*server[[:space:]]*\{/ {inb=1;n=0;buf[++n]=$0;depth=delta($0);if(depth<=0){flush();inb=0};next}
    inb {buf[++n]=$0;depth+=delta($0);if(depth<=0){flush();inb=0};next}
    END{
      if(starts==0 && ends==0){print "missing_marker";exit}
      if(starts>1 || ends>1){print "duplicate_marker";exit}
      if(starts!=1 || ends!=1){print "missing_marker";exit}
      if(tls_blocks!=1 || bad_anchor){print "marker_drift";exit}
      if(misplaced || in_tls!=1){print "misplaced_marker";exit}
      if(misordered){print "misordered_marker";exit}
      print "ok"
    }
  ' "$conf") || return 1
  [[ "$result" != missing_marker ]] || result=misplaced_marker
  printf '%s' "$result"
}

_security_scope_valid() {
  [[ "$1" == "site" || "$1" == "wp-login" || "$1" == "custom" ]]
}

_security_user_valid() {
  local user="$1"
  (( ${#user} >= 1 && ${#user} <= 64 )) || return 1
  [[ "$user" =~ ^[A-Za-z0-9._-]+$ ]]
}

_security_path_valid() {
  local path="$1" segment
  (( ${#path} >= 2 && ${#path} <= 200 )) || return 1
  [[ "$path" =~ ^/[A-Za-z0-9._~/-]+$ ]] || return 1
  [[ "$path" != *"//"* ]] || return 1
  local -a segments=()
  IFS='/' read -ra segments <<< "$path"
  for segment in "${segments[@]}"; do
    [[ "$segment" != ".." ]] || return 1
  done
  return 0
}

_security_normalize_path() {
  local path="$1"
  while [[ "${#path}" -gt 1 && "$path" == */ ]]; do
    path="${path%/}"
  done
  [[ "$path" != "/" ]] || return 1
  printf '%s' "$path"
}

_security_regex_escape() {
  local value="$1"
  printf '%s' "${value//./\\.}"
}

_security_normalize_ips() {
  local raw="$1" token seen=" "
  local -a tokens=() out=()
  raw="${raw//$'\r'/,}"
  raw="${raw//$'\n'/,}"
  raw="${raw//$'\t'/,}"
  raw="${raw// /,}"
  IFS=',' read -ra tokens <<< "$raw"
  for token in "${tokens[@]}"; do
    [[ -n "$token" ]] || continue
    (( ${#token} <= 45 )) || return 1
    [[ "$token" =~ ^[0-9A-Fa-f:.]+$ ]] || return 1
    case "$seen" in
      *" ${token} "*) continue ;;
    esac
    out+=("$token")
    seen+="${token} "
  done
  local IFS=','
  printf '%s' "${out[*]}"
  return 0
}

# Canonicalize an IP-Block deny list from stdin (comma/newline separated, single
# IPv4/IPv6 addresses or CIDRs). Prints one canonical entry per line, deduped,
# FIRST-SEEN order preserved. Rejects empty, >1000 unique entries, >64 KiB stdin,
# invalid tokens, family/prefix mismatches, and /0. Self-contained (inline
# python3) so the unit test can extract and run it.
_security_ipblock_normalize() {
  python3 -c '
import sys, ipaddress
data = sys.stdin.buffer.read()
if len(data) > 65536:
    sys.exit(1)
try:
    text = data.decode("utf-8")
except UnicodeDecodeError:
    sys.exit(1)
tokens = [t.strip() for t in text.replace(",", "\n").split("\n")]
tokens = [t for t in tokens if t]
seen = set()
out = []
for tok in tokens:
    try:
        if "/" in tok:
            net = ipaddress.ip_network(tok, strict=False)
            if net.prefixlen == 0:
                sys.exit(1)
            canon = str(net)
        else:
            canon = str(ipaddress.ip_address(tok))
    except ValueError:
        sys.exit(1)
    if canon not in seen:
        seen.add(canon)
        out.append(canon)
if not out or len(out) > 1000:
    sys.exit(1)
sys.stdout.write("\n".join(out) + "\n")
'
}

# The IP-Block marker block (identical content for the :80 and :443 server
# blocks; placement differs and is handled by the vhost editor). The server-level
# `return 403` precedes Basic Auth and any force-https redirect (when placed at
# the top of the :80 block).
_security_ipblock_render_marker() {
  local domain="$1" target="$2" id
  id=$(_security_id "$domain")
  {
    printf '    # >>> AIDIPANEL_IP_BLOCK >>>\n'
    printf '    if ($aidipanel_block_%s) { return 403; }\n' "$id"
    printf '    # <<< AIDIPANEL_IP_BLOCK <<<\n'
  } > "$target"
}

# The per-site http-context include: a geo over the real visitor address plus the
# effective map that keeps HTTP-01 ACME open on port 80. List entries are one
# canonical address/CIDR per line (already normalized by _security_ipblock_normalize).
_security_ipblock_render_include() {
  local domain="$1" list="$2" target="$3" id
  id=$(_security_id "$domain")
  {
    printf '# Managed by AidiPanel (security:ip-block). Do not edit by hand.\n'
    printf 'geo $remote_addr $aidipanel_block_source_%s {\n' "$id"
    printf '    default 0;\n'
    awk 'NF{ print "    " $0 " 1;" }' "$list"
    printf '}\n'
    printf 'map "$aidipanel_block_source_%s:$server_port:$uri" $aidipanel_block_%s {\n' "$id" "$id"
    printf '    ~^1:80:/\\.well-known/acme-challenge(?:/|$) 0;\n'
    printf '    ~^1: 1;\n'
    printf '    default 0;\n'
    printf '}\n'
  } > "$target"
}

# schema=1 IP-Block state. List content lives ONLY in the list file; state holds
# count + sha256 so status can detect drift without echoing list data.
_security_ipblock_state_render() {
  local target="$1" enabled="$2" count="$3" sha="$4"
  printf 'schema=1\nenabled=%s\nentry_count=%s\nlist_sha256=%s\n' \
    "$enabled" "$count" "$sha" > "$target"
  chmod 0600 "$target"
}

_security_state_value() {
  local file="$1" key="$2"
  [[ -f "$file" ]] || return 0
  sed -n "s/^${key}=//p" "$file" | head -1
}

_security_state_render() {
  local target="$1" enabled="$2" scope="$3" path="$4" username="$5" bypass_ips="$6"
  printf 'enabled=%s\nscope=%s\npath=%s\nusername=%s\nbypass_ips=%s\n' \
    "$enabled" "$scope" "$path" "$username" "$bypass_ips" > "$target"
  chmod 0600 "$target"
}

_security_read_password() {
  local password="" REPLY=""
  if ! IFS= read -r password; then
    [[ -n "$password" ]] || return 1
  fi
  if IFS= read -r; then
    return 1
  fi
  [[ -n "$password" ]] || return 1
  [[ "$password" != *$'\r'* && ! "$password" =~ [[:cntrl:]] ]] || return 1
  printf '%s' "$password"
}

_security_render_http_include() {
  local domain="$1" scope="$2" path="$3" bypass_ips="$4" target="$5"
  local id; id=$(_security_id "$domain")
  local ip escaped_path=""
  local -a ips=()
  [[ -n "$bypass_ips" ]] && IFS=',' read -ra ips <<< "$bypass_ips"
  [[ "$scope" == "custom" ]] && escaped_path=$(_security_regex_escape "$path")

  {
    printf 'geo $aidipanel_ba_bypass_%s {\n' "$id"
    printf '    default 0;\n'
    for ip in "${ips[@]}"; do
      printf '    %s 1;\n' "$ip"
    done
    printf '}\n\n'

    if [[ "$scope" == "custom" ]]; then
      printf 'map $uri $aidipanel_ba_original_%s {\n' "$id"
      printf '    default "";\n'
      printf '}\n\n'
      printf 'map "$aidipanel_ba_bypass_%s:$aidipanel_ba_original_%s" $aidipanel_ba_realm_%s {\n' "$id" "$id" "$id"
    else
      printf 'map "$aidipanel_ba_bypass_%s:$uri" $aidipanel_ba_realm_%s {\n' "$id" "$id"
    fi

    printf '    ~^1: off;\n'
    printf '    ~^0:/\\.well-known/acme-challenge(?:/|$) off;\n'
    case "$scope" in
      wp-login)
        printf '    ~^0:/wp-admin/admin-ajax\\.php$ off;\n'
        printf '    ~^0:/wp-login\\.php(?:/|$) "Restricted Area";\n'
        printf '    ~^0:/wp-admin(?:/|$) "Restricted Area";\n'
        printf '    default off;\n'
        ;;
      custom)
        printf '    ~^0:%s(?:/|$) "Restricted Area";\n' "$escaped_path"
        printf '    default off;\n'
        ;;
      site)
        printf '    default "Restricted Area";\n'
        ;;
      *) return 1 ;;
    esac
    printf '}\n'
  } > "$target"
}

_security_render_marker() {
  local domain="$1" scope="$2" target="$3"
  local id; id=$(_security_id "$domain")
  {
    printf '    # >>> AIDIPANEL_BASIC_AUTH >>>\n'
    if [[ "$scope" == "custom" ]]; then
      printf '    if ($aidipanel_ba_original_%s = "") {\n' "$id"
      printf '        set $aidipanel_ba_original_%s $uri;\n' "$id"
      printf '    }\n'
    fi
    printf '    auth_basic $aidipanel_ba_realm_%s;\n' "$id"
    printf '    auth_basic_user_file %s;\n' "$(_security_htpasswd "$domain")"
    printf '    # <<< AIDIPANEL_BASIC_AUTH <<<\n'
  } > "$target"
}

# Bounded, parameterized managed-marker editor. Knows only internal marker
# identities (never user input). Each feature selects its target block(s):
#   cloudflare_only / basic_auth -> the single TLS (:443) server block
#   ip_block                     -> both the :80 and :443 server blocks
# In every target block it removes ALL known managed markers and reinserts the
# active ones in canonical order (Cloudflare-only -> IP Block -> Basic Auth),
# changing only the requested feature and staying byte-stable elsewhere.
# A 4-arg call defaults to basic_auth (Slice 1 compatibility).
_security_vhost_edit() {
  local source="$1" target="$2" mode="$3" marker_file="$4" marker_id="${5:-basic_auth}"
  local target_token do_http do_tls tok s e expected_target
  case "$marker_id" in
    cloudflare_only) target_token='AIDIPANEL_CLOUDFLARE_ONLY'; do_http=0; do_tls=1 ;;
    ip_block)        target_token='AIDIPANEL_IP_BLOCK';        do_http=1; do_tls=1 ;;
    basic_auth)      target_token='AIDIPANEL_BASIC_AUTH';      do_http=0; do_tls=1 ;;
    *) return 1 ;;
  esac
  # Every known marker must be globally balanced (catches orphan/stray markers
  # anywhere, including non-target blocks).
  for tok in AIDIPANEL_CLOUDFLARE_ONLY AIDIPANEL_IP_BLOCK AIDIPANEL_BASIC_AUTH; do
    s=$(grep -cF "# >>> ${tok} >>>" "$source" 2>/dev/null || true)
    e=$(grep -cF "# <<< ${tok} <<<" "$source" 2>/dev/null || true)
    [[ "$s" -eq "$e" ]] || return 1
  done
  expected_target=$(grep -cF "# >>> ${target_token} >>>" "$source" 2>/dev/null || true)

  awk -v mode="$mode" -v mf="$marker_file" -v target_token="$target_token" \
      -v do_http="$do_http" -v do_tls="$do_tls" -v expected_target="$expected_target" '
    function delta(s, a, b, t) {
      t=s; a=gsub(/\{/,"{",t)
      t=s; b=gsub(/\}/,"}",t)
      return a-b
    }
    function clear_block( i) { for (i in block) delete block[i]; n=0 }
    function flush_block( i, line, btype, nm, em, capturing, m, inserted, k, t, content, need) {
      btype="other"
      for (i=1; i<=n; i++)
        if (block[i] ~ /listen[[:space:]]+(\[::\]:)?443[[:space:]]+ssl([[:space:]]|;)/) { btype="tls"; break }
      if (btype == "other")
        for (i=1; i<=n; i++)
          if (block[i] ~ /listen[[:space:]]+(\[::\]:)?80[[:space:]]*;/) { btype="http"; break }

      if (btype == "other" || (btype=="tls" && !do_tls) || (btype=="http" && !do_http)) {
        for (i=1; i<=n; i++) print block[i]
        return
      }
      if (btype == "tls") targeted_tls++; else targeted_http++

      for (k in cap) delete cap[k]
      for (k in capseen) delete capseen[k]
      capturing=""; m=0
      for (i=1; i<=n; i++) {
        line=block[i]
        if (line ~ /# >>> AIDIPANEL_[A-Z_]+ >>>/) {
          nm=line; sub(/.*# >>> /,"",nm); sub(/ >>>.*/,"",nm)
          if (capturing != "") bad=1
          if (capseen[nm]) bad=1
          if (btype=="tls" && !valid_tls[nm]) bad=1
          if (btype=="http" && !valid_http[nm]) bad=1
          capturing=nm; capseen[nm]=1; cap[nm]=line "\n"
          if (nm == target_token) removed_target++
          continue
        }
        if (capturing != "") {
          cap[capturing]=cap[capturing] line "\n"
          if (line ~ /# <<< AIDIPANEL_[A-Z_]+ <<</) {
            em=line; sub(/.*# <<< /,"",em); sub(/ <<<.*/,"",em)
            if (em != capturing) bad=1
            capturing=""
          }
          continue
        }
        if (line ~ /# <<< AIDIPANEL_[A-Z_]+ <<</) bad=1
        clean[++m]=line
      }
      if (capturing != "") bad=1

      need=0
      for (k=1; k<=ord_n[btype]; k++) {
        t=ord[btype, k]
        if (t == target_token) { if (mode=="enable") need=1 }
        else if (capseen[t]) need=1
      }
      # Insertion anchor: the :443 block inserts after server_name; the :80 block
      # inserts at the TOP (right after "server {") so the IP-Block return precedes
      # any pre-server_name force-https redirect (e.g. Certbot "if ($host) return 301").
      inserted=0
      for (i=1; i<=m; i++) {
        print clean[i]
        if (!inserted && \
            ((btype=="tls"  && clean[i] ~ /^[[:space:]]*server_name[[:space:]]+[^;]+;[[:space:]]*$/) || \
             (btype=="http" && clean[i] ~ /^[[:space:]]*server[[:space:]]*\{[[:space:]]*$/))) {
          for (k=1; k<=ord_n[btype]; k++) {
            t=ord[btype, k]
            content=""
            if (t == target_token) { if (mode=="enable") content=marker_text }
            else if (capseen[t]) content=cap[t]
            if (content != "") printf "%s", content
          }
          inserted=1
        }
      }
      if (need && !inserted) bad=1
    }
    BEGIN {
      depth=0; inblock=0; bad=0
      targeted_tls=0; targeted_http=0; removed_target=0
      ord["tls",1]="AIDIPANEL_CLOUDFLARE_ONLY"; ord["tls",2]="AIDIPANEL_IP_BLOCK"; ord["tls",3]="AIDIPANEL_BASIC_AUTH"; ord_n["tls"]=3
      ord["http",1]="AIDIPANEL_IP_BLOCK"; ord_n["http"]=1
      valid_tls["AIDIPANEL_CLOUDFLARE_ONLY"]=1; valid_tls["AIDIPANEL_IP_BLOCK"]=1; valid_tls["AIDIPANEL_BASIC_AUTH"]=1
      valid_http["AIDIPANEL_IP_BLOCK"]=1
      marker_text=""
      if (mode == "enable") {
        while ((getline marker_line < mf) > 0) marker_text=marker_text marker_line "\n"
        close(mf)
        if (marker_text == "") bad=1
      }
    }
    !inblock && /^[[:space:]]*server[[:space:]]*\{/ {
      clear_block()
      inblock=1
      block[++n]=$0
      depth=delta($0)
      if (depth<=0) { flush_block(); inblock=0 }
      next
    }
    inblock {
      block[++n]=$0
      depth+=delta($0)
      if (depth<=0) { flush_block(); inblock=0 }
      next
    }
    { print }
    END {
      if (inblock || bad) exit 42
      if (do_tls && targeted_tls != 1) exit 42
      if (do_http && targeted_http != 1) exit 42
      if (removed_target != expected_target) exit 42
    }
  ' "$source" > "$target"
}

_security_vhost_marker_valid() {
  local conf="$1"
  [[ "$(grep -cF '# >>> AIDIPANEL_BASIC_AUTH >>>' "$conf" 2>/dev/null || true)" -eq 1 ]] || return 1
  [[ "$(grep -cF '# <<< AIDIPANEL_BASIC_AUTH <<<' "$conf" 2>/dev/null || true)" -eq 1 ]] || return 1
  _security_vhost_edit "$conf" /dev/null disable /dev/null
}

_security_cache_candidate() {
  local source="$1" target="$2"
  if grep -qF 'if ($http_authorization != "") { set $skip_cache 1; }' "$source"; then
    cp "$source" "$target"
    return 0
  fi
  awk '
    { print }
    !done && /if \(\$request_method = POST\)/ {
      print "if ($http_authorization != \"\") { set $skip_cache 1; }"
      done=1
    }
    END { if (!done) exit 42 }
  ' "$source" > "$target"
}

_security_credential_candidate() {
  local domain="$1" username="$2" use_stdin="$3" target="$4"
  local state; state=$(_security_state "$domain")
  local current_user; current_user=$(_security_state_value "$state" username)
  local credentials; credentials=$(_security_htpasswd "$domain")
  local password="" hash=""

  if [[ "$use_stdin" == "true" ]]; then
    if ! password=$(_security_read_password); then
      return 2
    fi
    if ! hash=$(printf '%s\n' "$password" | openssl passwd -6 -stdin); then
      return 3
    fi
    printf '%s:%s\n' "$username" "$hash" > "$target"
    unset password hash
    return 0
  fi

  [[ -f "$credentials" && "$current_user" == "$username" ]] || return 4
  cp "$credentials" "$target"
}

declare -a SECURITY_TX_PATHS=()
declare -a SECURITY_TX_PRESENT=()
SECURITY_TX_DIR=""
SECURITY_TX_BASE_EXISTED=0
SECURITY_TX_SECURITY_EXISTED=0
SECURITY_TX_ACTIVE=0
SECURITY_TX_DIRTY=0

_security_tx_exit_trap() {
  local exit_rc="${1:-1}" restore_rc=0 reload_rc=0
  trap - EXIT
  set +e
  if [[ "$SECURITY_TX_ACTIVE" == 1 && "$SECURITY_TX_DIRTY" == 1 ]]; then
    warn "Security transaction was interrupted; restoring the previous configuration."
    _security_tx_restore || restore_rc=1
    if [[ "$restore_rc" -eq 0 ]]; then
      if nginx -t >> "$CLI_LOG" 2>&1; then
        systemctl reload nginx >> "$CLI_LOG" 2>&1 || reload_rc=1
      else
        reload_rc=1
      fi
    fi
    if [[ "$restore_rc" -ne 0 || "$reload_rc" -ne 0 ]]; then
      warn "Interrupted Security rollback was incomplete. Inspect nginx immediately."
    fi
  fi
  _security_tx_cleanup
  exit "$exit_rc"
}

_security_tx_begin() {
  local path index=0
  SECURITY_TX_DIR=$(mktemp -d /tmp/aidipanel-security-tx.XXXXXX) || return 1
  SECURITY_TX_PATHS=()
  SECURITY_TX_PRESENT=()
  [[ -d /etc/nginx/aidipanel ]] && SECURITY_TX_BASE_EXISTED=1 || SECURITY_TX_BASE_EXISTED=0
  [[ -d /etc/nginx/aidipanel/security ]] && SECURITY_TX_SECURITY_EXISTED=1 || SECURITY_TX_SECURITY_EXISTED=0
  for path in "$@"; do
    SECURITY_TX_PATHS+=("$path")
    if [[ -e "$path" ]]; then
      SECURITY_TX_PRESENT+=(1)
      cp -a "$path" "${SECURITY_TX_DIR}/${index}" || return 1
    else
      SECURITY_TX_PRESENT+=(0)
    fi
    index=$((index + 1))
  done
  SECURITY_TX_ACTIVE=1
  SECURITY_TX_DIRTY=0
  trap '_security_tx_exit_trap $?' EXIT
}

_security_tx_restore() {
  local index path rc=0
  for ((index=0; index<${#SECURITY_TX_PATHS[@]}; index++)); do
    path="${SECURITY_TX_PATHS[$index]}"
    rm -rf -- "$path" || rc=1
    if [[ "${SECURITY_TX_PRESENT[$index]}" == 1 ]]; then
      cp -a "${SECURITY_TX_DIR}/${index}" "$path" || rc=1
    fi
  done
  [[ "$SECURITY_TX_SECURITY_EXISTED" == 0 ]] && rmdir /etc/nginx/aidipanel/security 2>/dev/null || true
  [[ "$SECURITY_TX_BASE_EXISTED" == 0 ]] && rmdir /etc/nginx/aidipanel 2>/dev/null || true
  return "$rc"
}

_security_tx_cleanup() {
  [[ "$SECURITY_TX_ACTIVE" == 1 ]] && trap - EXIT
  SECURITY_TX_ACTIVE=0
  SECURITY_TX_DIRTY=0
  [[ -n "$SECURITY_TX_DIR" ]] && rm -rf -- "$SECURITY_TX_DIR" || true
  SECURITY_TX_DIR=""
  SECURITY_TX_PATHS=()
  SECURITY_TX_PRESENT=()
}

_security_install_file() {
  local source="$1" target="$2" owner="$3" group="$4" mode="$5"
  local staged="${target}.aidipanel.$$"
  install -o "$owner" -g "$group" -m "$mode" "$source" "$staged" || return 1
  mv -f "$staged" "$target" || { rm -f "$staged"; return 1; }
}

_security_reload_transaction() {
  if nginx -t >> "$CLI_LOG" 2>&1 && systemctl reload nginx >> "$CLI_LOG" 2>&1; then
    return 0
  fi
  warn "Nginx rejected the Security change; restoring the previous configuration."
  _security_tx_restore || return 1
  nginx -t >> "$CLI_LOG" 2>&1 || return 1
  systemctl reload nginx >> "$CLI_LOG" 2>&1 || return 1
  return 2
}

_security_enabled() {
  local domain="$1" state; state=$(_security_state "$domain")
  [[ "$(_security_state_value "$state" enabled)" == "1" ]] \
    || grep -qF '# >>> AIDIPANEL_BASIC_AUTH >>>' "${NGINX_CONF_DIR}/${domain}.conf" 2>/dev/null
}

_security_enable() {
  local domain="$1" scope="$2" path="$3" username="$4" bypass_ips="$5" use_stdin="$6"
  local conf="${NGINX_CONF_DIR}/${domain}.conf"
  local include; include=$(_security_http_inc "$domain")
  local dir; dir=$(_security_dir "$domain")
  local credentials; credentials=$(_security_htpasswd "$domain")
  local state; state=$(_security_state "$domain")
  local cache; cache=$(_cache_snippet_path "$domain")
  local tmp; tmp=$(mktemp -d /tmp/aidipanel-security-build.XXXXXX)
  local credential_rc reload_rc install_restore_rc=0

  _security_force_https_on "$domain" || { rm -rf "$tmp"; die "Enable Force HTTPS before enabling HTTP Basic Authentication."; }
  _security_render_http_include "$domain" "$scope" "$path" "$bypass_ips" "${tmp}/include" \
    || { rm -rf "$tmp"; die "Could not render the Basic Auth map."; }
  _security_render_marker "$domain" "$scope" "${tmp}/marker"
  _security_vhost_edit "$conf" "${tmp}/vhost" enable "${tmp}/marker" \
    || { rm -rf "$tmp"; die "Could not identify one unambiguous HTTPS server block."; }
  _security_state_render "${tmp}/state" 1 "$scope" "$path" "$username" "$bypass_ips"
  if _security_credential_candidate "$domain" "$username" "$use_stdin" "${tmp}/htpasswd"; then
    credential_rc=0
  else
    credential_rc=$?
  fi
  case "$credential_rc" in
    0) ;;
    2) rm -rf "$tmp"; die "Password input must contain exactly one non-empty line without control characters." ;;
    3) rm -rf "$tmp"; die "Could not hash the Basic Auth password." ;;
    4) rm -rf "$tmp"; die "A password is required when creating credentials or changing the username." ;;
    *) rm -rf "$tmp"; die "Could not prepare Basic Auth credentials." ;;
  esac
  if [[ -f "$cache" ]]; then
    _security_cache_candidate "$cache" "${tmp}/cache" \
      || { rm -rf "$tmp"; die "The managed cache snippet has an unsupported structure."; }
  fi

  _security_tx_begin "$conf" "$include" "$dir" "$cache" \
    || { rm -rf "$tmp"; _security_tx_cleanup; die "Could not snapshot the current Basic Auth configuration."; }
  SECURITY_TX_DIRTY=1
  if ! install -d -o root -g root -m 0755 /etc/nginx/aidipanel \
    || ! install -d -o root -g www-data -m 0750 /etc/nginx/aidipanel/security "$dir" \
    || ! _security_install_file "${tmp}/vhost" "$conf" root root 0644 \
    || ! _security_install_file "${tmp}/include" "$include" root root 0644 \
    || ! _security_install_file "${tmp}/htpasswd" "$credentials" root www-data 0640 \
    || ! _security_install_file "${tmp}/state" "$state" root root 0600 \
    || { [[ -f "${tmp}/cache" ]] && ! _security_install_file "${tmp}/cache" "$cache" root root 0644; }; then
    _security_tx_restore || install_restore_rc=1
    _security_tx_cleanup
    rm -rf "$tmp"
    if [[ "$install_restore_rc" -eq 0 ]]; then
      die "Could not install the Basic Auth candidate files; the previous state was restored."
    fi
    die "Could not install the Basic Auth candidate files and rollback was incomplete. Inspect nginx immediately."
  fi

  if _security_reload_transaction; then
    reload_rc=0
  else
    reload_rc=$?
  fi
  if [[ "$reload_rc" -ne 0 ]]; then
    _security_tx_cleanup
    rm -rf "$tmp"
    [[ "$reload_rc" -eq 2 ]] \
      && die "The web server rejected Basic Auth; every managed file was restored." \
      || die "Basic Auth rollback could not reload the previous configuration. Inspect nginx immediately."
  fi

  _security_tx_cleanup
  rm -rf "$tmp"
  _cache_purge_domain "$domain" >/dev/null 2>&1 || warn "Basic Auth is active, but stale cache cleanup failed for ${domain}."
  printf 'enabled=1\nscope=%s\npath=%s\nusername=%s\nbypass_ips=%s\n' \
    "$scope" "$path" "$username" "$bypass_ips"
  ok "HTTP Basic Authentication enabled for ${domain}"
}

_security_disable() {
  local domain="$1" purge="$2"
  local conf="${NGINX_CONF_DIR}/${domain}.conf"
  local include; include=$(_security_http_inc "$domain")
  local dir; dir=$(_security_dir "$domain")
  local state; state=$(_security_state "$domain")
  local cache; cache=$(_cache_snippet_path "$domain")
  local marker_count stored_scope stored_path stored_user stored_ips
  local tmp; tmp=$(mktemp -d /tmp/aidipanel-security-build.XXXXXX)
  local reload_rc install_restore_rc=0

  marker_count=$(grep -cF '# >>> AIDIPANEL_BASIC_AUTH >>>' "$conf" 2>/dev/null || true)
  if [[ "$marker_count" -eq 0 && ! -f "$include" && ! -f "$state" && ! -d "$dir" ]]; then
    # Nothing to disable and the shared per-site dir is already absent, so there
    # is nothing to purge (and nothing of a sibling feature to protect).
    rm -rf "$tmp"
    printf 'enabled=0\n'
    return 0
  fi

  _security_vhost_edit "$conf" "${tmp}/vhost" disable /dev/null \
    || { rm -rf "$tmp"; die "Could not identify one unambiguous HTTPS server block."; }
  stored_scope=$(_security_state_value "$state" scope)
  stored_path=$(_security_state_value "$state" path)
  stored_user=$(_security_state_value "$state" username)
  stored_ips=$(_security_state_value "$state" bypass_ips)
  _security_state_render "${tmp}/state" 0 "$stored_scope" "$stored_path" "$stored_user" "$stored_ips"

  _security_tx_begin "$conf" "$include" "$dir" "$cache" \
    || { rm -rf "$tmp"; _security_tx_cleanup; die "Could not snapshot the current Basic Auth configuration."; }
  SECURITY_TX_DIRTY=1
  if ! _security_install_file "${tmp}/vhost" "$conf" root root 0644 \
    || ! rm -f "$include" \
    || ! install -d -o root -g root -m 0755 /etc/nginx/aidipanel \
    || ! install -d -o root -g www-data -m 0750 /etc/nginx/aidipanel/security "$dir" \
    || ! _security_install_file "${tmp}/state" "$state" root root 0600; then
    _security_tx_restore || install_restore_rc=1
    _security_tx_cleanup
    rm -rf "$tmp"
    if [[ "$install_restore_rc" -eq 0 ]]; then
      die "Could not install the Basic Auth disable candidate; the previous state was restored."
    fi
    die "Could not install the Basic Auth disable candidate and rollback was incomplete. Inspect nginx immediately."
  fi

  if _security_reload_transaction; then
    reload_rc=0
  else
    reload_rc=$?
  fi
  if [[ "$reload_rc" -ne 0 ]]; then
    _security_tx_cleanup
    rm -rf "$tmp"
    [[ "$reload_rc" -eq 2 ]] \
      && die "The web server rejected Basic Auth disable; every managed file was restored." \
      || die "Basic Auth disable rollback could not reload the previous configuration. Inspect nginx immediately."
  fi

  _security_tx_cleanup
  rm -rf "$tmp"
  if [[ "$purge" == "true" ]]; then
    # Purge only Basic Auth's own artifacts. The per-site dir is shared with
    # IP Blocking and Cloudflare-only, so never delete it wholesale; rmdir
    # clears it only when no sibling feature still keeps state there.
    rm -f -- "$(_security_htpasswd "$domain")" "$state"
    rmdir "$dir" 2>/dev/null || true
  fi
  _cache_purge_domain "$domain" >/dev/null 2>&1 || warn "Basic Auth is disabled, but stale cache cleanup failed for ${domain}."
  printf 'enabled=0\n'
  ok "HTTP Basic Authentication disabled for ${domain}"
}

# Force HTTPS is "on" only when the FIRST managed port-80 server block carries a
# catch-all redirect to https — one that fires for every request, not a stray
# `return 301 https://` sitting in a comment, the TLS block, an unrelated
# `location /preview`, or a second server block (the bug this guards against:
# Basic Auth only challenges over HTTPS, so a false positive could hide a
# plain-HTTP bypass). Two managed forms count, both scoped to the first port-80
# server: AidiPanel's `location / { return 301 https://... }` and Certbot's
# server-level `if ($host = ...) { return 301 https://...; }` redirect.
_security_force_https_on() {
  local conf="${NGINX_CONF_DIR}/${1}.conf"
  [[ -f "$conf" ]] || return 1
  awk '
    function braces(s,   o, c) { o = gsub(/[{]/, "", s); c = gsub(/[}]/, "", s); return o - c }
    { line = $0; sub(/#.*/, "", line) }
    # Seek the next "server {".
    state == 0 {
      if (line ~ /^[[:space:]]*server[[:space:]]*[{]/) {
        state = 1; depth = braces(line); is80 = 0; redir = 0; ctx = ""
        if (depth <= 0) state = 0
      }
      next
    }
    # Inside a server block: decide at its closing brace.
    {
      start = depth
      if (line ~ /listen[[:space:]]+(\[::\]:)?80([[:space:];]|$)/) is80 = 1

      # Only a direct child of "server" whose scope is every request can hold a
      # force-HTTPS redirect: the root "location /" or a server-level "if (...)".
      kind = "other"
      if (start == 1 && line ~ /[{]/) {
        if (line ~ /location[[:space:]]+\/[[:space:]]*[{]/) kind = "root"
        else if (line ~ /(^|[^[:alnum:]_])if[[:space:]]*\(/) kind = "if"
      }
      if (line ~ /return[[:space:]]+301[[:space:]]+https:\/\//) {
        if (start == 1) { if (kind == "root" || kind == "if") redir = 1 }
        else if (ctx == "root" || ctx == "if") redir = 1
      }

      depth += braces(line)
      if (start == 1 && depth >= 2) ctx = kind
      if (depth <= 1) ctx = ""
      if (depth <= 0) {
        if (is80) { found = redir; exit }
        state = 0
      }
    }
    END { exit (found ? 0 : 1) }
  ' "$conf"
}

_security_artifacts_match() {
  local domain="$1" scope="$2" path="$3"
  local conf="${NGINX_CONF_DIR}/${domain}.conf"
  local include; include=$(_security_http_inc "$domain")
  local credentials; credentials=$(_security_htpasswd "$domain")
  local id; id=$(_security_id "$domain")
  local escaped_path=""

  _security_vhost_marker_valid "$conf" || return 1
  grep -qE "^[[:space:]]*auth_basic[[:space:]]+\\\$aidipanel_ba_realm_${id};[[:space:]]*$" "$conf" || return 1
  grep -qF "auth_basic_user_file ${credentials};" "$conf" || return 1
  grep -qF "\$aidipanel_ba_bypass_${id}" "$include" || return 1
  grep -qF "\$aidipanel_ba_realm_${id}" "$include" || return 1

  case "$scope" in
    custom)
      escaped_path=$(_security_regex_escape "$path")
      grep -qF "\$aidipanel_ba_original_${id}" "$include" || return 1
      grep -qF "${escaped_path}(?:/|\$)" "$include" || return 1
      grep -qF "\$aidipanel_ba_original_${id}" "$conf" || return 1
      ;;
    wp-login)
      grep -qF '/wp-login\.php(?:/|$)' "$include" || return 1
      grep -qF '/wp-admin/admin-ajax\.php$' "$include" || return 1
      ;;
    site)
      grep -qF 'default "Restricted Area";' "$include" || return 1
      ;;
    *) return 1 ;;
  esac
  return 0
}

_security_status() {
  local domain="$1"
  local conf="${NGINX_CONF_DIR}/${domain}.conf"
  local state; state=$(_security_state "$domain")
  local include; include=$(_security_http_inc "$domain")
  local credentials; credentials=$(_security_htpasswd "$domain")
  local stored_enabled="" scope="" path="" username="" bypass_ips=""
  local enabled=0 htpasswd_exists=0 force_https=0 error=""
  local marker_count=0 marker_end_count=0 marker_valid=0 normalized=""

  if [[ -f "$state" ]]; then
    stored_enabled=$(_security_state_value "$state" enabled)
    scope=$(_security_state_value "$state" scope)
    path=$(_security_state_value "$state" path)
    username=$(_security_state_value "$state" username)
    bypass_ips=$(_security_state_value "$state" bypass_ips)
  fi
  [[ -f "$credentials" ]] && htpasswd_exists=1
  _security_force_https_on "$domain" && force_https=1
  marker_count=$(grep -cF '# >>> AIDIPANEL_BASIC_AUTH >>>' "$conf" 2>/dev/null || true)
  marker_end_count=$(grep -cF '# <<< AIDIPANEL_BASIC_AUTH <<<' "$conf" 2>/dev/null || true)
  _security_vhost_marker_valid "$conf" && marker_valid=1

  if [[ "$stored_enabled" == "1" ]]; then
    if [[ "$marker_valid" -ne 1 ]]; then
      error="missing_vhost_marker"
    elif [[ ! -r "$include" ]]; then
      error="missing_http_include"
    elif [[ ! -f "$credentials" ]]; then
      error="missing_credentials"
    elif ! sudo -u www-data test -r "$credentials" 2>/dev/null; then
      error="unreadable_credentials"
    elif ! _security_scope_valid "$scope" \
      || ! _security_user_valid "$username" \
      || { [[ "$scope" == "custom" ]] && ! _security_path_valid "$path"; } \
      || { [[ "$scope" != "custom" ]] && [[ -n "$path" ]]; }; then
      error="state_mismatch"
    elif ! normalized=$(_security_normalize_ips "$bypass_ips") \
      || [[ "$normalized" != "$bypass_ips" ]]; then
      error="state_mismatch"
    elif ! _security_artifacts_match "$domain" "$scope" "$path"; then
      error="state_mismatch"
    elif [[ "$force_https" -ne 1 ]]; then
      error="force_https_drift"
    else
      enabled=1
    fi
  elif [[ -f "$state" && "$stored_enabled" != "0" ]]; then
    error="state_mismatch"
  elif [[ "$marker_count" -ne 0 || "$marker_end_count" -ne 0 || -f "$include" ]]; then
    error="state_mismatch"
  elif [[ ! -f "$state" && -f "$credentials" ]]; then
    error="state_mismatch"
  fi

  printf 'enabled=%s\n' "$enabled"
  printf 'scope=%s\n' "$scope"
  printf 'path=%s\n' "$path"
  printf 'username=%s\n' "$username"
  printf 'bypass_ips=%s\n' "$bypass_ips"
  printf 'htpasswd_exists=%s\n' "$htpasswd_exists"
  printf 'force_https=%s\n' "$force_https"
  printf 'error=%s\n' "$error"
}

# Acquire the per-site Security lock (fd 201; shared for reads, exclusive for
# mutations). Bounded wait -> return 3 (busy). Mirrors _cloudflare_lock.
_security_lock() {
  local domain="$1" mode="${2:-x}" lock flag
  lock=$(_security_lock_path "$domain")
  mkdir -p "$(dirname "$lock")" 2>/dev/null || true
  exec 201>"$lock" || return 1
  flag='-x'; [[ "$mode" == s ]] && flag='-s'
  flock -w "${SECURITY_LOCK_WAIT:-10}" "$flag" 201 || return 3
  return 0
}

# IP Blocking status with the per-site lock already held. Keys: enabled,
# entry_count, list_sha256, realip_active, error. Never echoes list content.
_security_ipblock_status_locked() {
  local domain="$1"
  local conf="${NGINX_CONF_DIR}/${domain}.conf"
  local list state inc cf_state
  list=$(_security_ipblock_list "$domain"); state=$(_security_ipblock_state "$domain")
  inc=$(_security_ipblock_inc "$domain"); cf_state=$(_cloudflare_state_path)
  local stored_enabled enabled=0 entry_count=0 list_sha256="" error="" realip_active=0
  local starts ends actual_count actual_sha tmp

  grep -q '^enabled=1$' "$cf_state" 2>/dev/null && realip_active=1

  stored_enabled=$(_security_state_value "$state" enabled)
  entry_count=$(_security_state_value "$state" entry_count); entry_count=${entry_count:-0}
  list_sha256=$(_security_state_value "$state" list_sha256)
  starts=$(grep -cF '# >>> AIDIPANEL_IP_BLOCK >>>' "$conf" 2>/dev/null || true)
  ends=$(grep -cF '# <<< AIDIPANEL_IP_BLOCK <<<' "$conf" 2>/dev/null || true)

  if [[ "$stored_enabled" == "1" ]]; then
    if [[ ! -f "$list" ]]; then error=missing_list
    elif [[ ! -f "$inc" ]]; then error=missing_include
    elif [[ "$starts" -lt 2 || "$ends" -lt 2 ]]; then error=missing_marker
    elif [[ "$starts" -ne 2 || "$ends" -ne 2 ]]; then error=marker_drift
    else
      actual_count=$(grep -c . "$list" 2>/dev/null || true); actual_count=${actual_count:-0}
      actual_sha=$(sha256sum "$list" | cut -d' ' -f1)
      if [[ "$actual_count" != "$entry_count" || "$actual_sha" != "$list_sha256" ]]; then
        error=hash_count_mismatch
      else
        tmp=$(mktemp -d /tmp/aidipanel-ipblock-status.XXXXXX) || true
        if [[ -n "$tmp" ]]; then
          _security_ipblock_render_include "$domain" "$list" "${tmp}/inc"
          cmp -s "${tmp}/inc" "$inc" || error=generated_content_mismatch
          rm -rf "$tmp"
        fi
      fi
    fi
    [[ -z "$error" ]] && enabled=1
  elif [[ "$stored_enabled" == "0" ]]; then
    [[ "$starts" -ne 0 || "$ends" -ne 0 || -f "$inc" ]] && error=state_mismatch
  else
    [[ "$starts" -ne 0 || "$ends" -ne 0 || -f "$inc" || -f "$list" ]] && error=state_mismatch
  fi

  printf 'enabled=%s\n' "$enabled"
  printf 'entry_count=%s\n' "$entry_count"
  printf 'list_sha256=%s\n' "$list_sha256"
  printf 'realip_active=%s\n' "$realip_active"
  printf 'error=%s\n' "$error"
}

_security_ipblock_status() {
  local domain="$1"
  if ! _security_lock "$domain" s; then
    printf 'enabled=0\nentry_count=0\nlist_sha256=\nrealip_active=0\nerror=busy\n'
    return 0
  fi
  _security_ipblock_status_locked "$domain"
}

# Read-only transport for the saved list (the panel textarea). stdout = canonical
# list body ONLY; no log lines. Non-zero (no output) when absent or drifted.
_security_ipblock_get() {
  local domain="$1"
  _security_lock "$domain" s || return 3
  _security_ipblock_get_locked "$domain"
}

_security_ipblock_get_locked() {
  local domain="$1" list state stored_sha actual_sha
  list=$(_security_ipblock_list "$domain"); state=$(_security_ipblock_state "$domain")
  [[ -f "$list" && -f "$state" ]] || return 1
  stored_sha=$(_security_state_value "$state" list_sha256)
  actual_sha=$(sha256sum "$list" | cut -d' ' -f1)
  [[ "$actual_sha" == "$stored_sha" ]] || return 1
  cat "$list"
}

# Apply the complete desired deny list (stdin) under the per-site lock.
_security_ipblock_set() {
  local domain="$1"
  local conf="${NGINX_CONF_DIR}/${domain}.conf"
  local inc list state dir tmp count sha reload_rc install_restore_rc=0
  inc=$(_security_ipblock_inc "$domain"); list=$(_security_ipblock_list "$domain")
  state=$(_security_ipblock_state "$domain"); dir=$(_security_dir "$domain")

  _security_lock "$domain" x || { echo "error=busy"; return 3; }
  tmp=$(mktemp -d /tmp/aidipanel-ipblock-build.XXXXXX) || { echo "error=tmp"; return 1; }

  if ! _security_ipblock_normalize > "${tmp}/list"; then
    rm -rf "$tmp"; echo "error=invalid_list"; return 1
  fi
  # Sibling drift: refuse to mutate while an active Basic Auth sibling is broken.
  if [[ "$(_security_state_value "$(_security_state "$domain")" enabled)" == "1" ]]; then
    _security_vhost_marker_valid "$conf" || { rm -rf "$tmp"; echo "error=sibling_drift"; return 1; }
  fi

  count=$(grep -c . "${tmp}/list"); sha=$(sha256sum "${tmp}/list" | cut -d' ' -f1)
  _security_ipblock_render_include "$domain" "${tmp}/list" "${tmp}/inc"
  _security_ipblock_render_marker "$domain" "${tmp}/marker"
  if ! _security_vhost_edit "$conf" "${tmp}/vhost" enable "${tmp}/marker" ip_block; then
    rm -rf "$tmp"; echo "error=vhost_edit"; return 1
  fi
  _security_ipblock_state_render "${tmp}/state" 1 "$count" "$sha"

  _security_tx_begin "$conf" "$inc" "$list" "$state" \
    || { rm -rf "$tmp"; _security_tx_cleanup; die "Could not snapshot the IP Block configuration."; }
  SECURITY_TX_DIRTY=1
  if ! install -d -o root -g root -m 0755 /etc/nginx/aidipanel \
    || ! install -d -o root -g www-data -m 0750 /etc/nginx/aidipanel/security "$dir" \
    || ! _security_install_file "${tmp}/vhost" "$conf" root root 0644 \
    || ! _security_install_file "${tmp}/inc" "$inc" root root 0644 \
    || ! _security_install_file "${tmp}/list" "$list" root root 0640 \
    || ! _security_install_file "${tmp}/state" "$state" root root 0600; then
    _security_tx_restore || install_restore_rc=1
    _security_tx_cleanup; rm -rf "$tmp"
    [[ "$install_restore_rc" -eq 0 ]] \
      && die "Could not install the IP Block candidate files; the previous state was restored." \
      || die "Could not install the IP Block candidate files and rollback was incomplete. Inspect nginx immediately."
  fi
  rm -rf "$tmp"
  if _security_reload_transaction; then reload_rc=0; else reload_rc=$?; fi
  if [[ "$reload_rc" -ne 0 ]]; then
    _security_tx_cleanup
    [[ "$reload_rc" -eq 2 ]] \
      && { echo "error=nginx_rejected"; return 2; } \
      || die "IP Block rollback could not reload the previous configuration. Inspect nginx immediately."
  fi
  _security_tx_cleanup
  _cache_purge_domain "$domain" >/dev/null 2>&1 || true
  printf 'enabled=1\nentry_count=%s\n' "$count"
  ok "IP Blocking updated for ${domain} (${count} entries)"
}

# Remove the include + both markers transactionally; retain list/state disabled
# unless --purge deletes them.
_security_ipblock_disable() {
  local domain="$1" purge="$2"
  local conf="${NGINX_CONF_DIR}/${domain}.conf"
  local inc list state tmp count sha starts reload_rc install_restore_rc=0
  inc=$(_security_ipblock_inc "$domain"); list=$(_security_ipblock_list "$domain")
  state=$(_security_ipblock_state "$domain")

  _security_lock "$domain" x || { echo "error=busy"; return 3; }
  tmp=$(mktemp -d /tmp/aidipanel-ipblock-build.XXXXXX) || { echo "error=tmp"; return 1; }

  starts=$(grep -cF '# >>> AIDIPANEL_IP_BLOCK >>>' "$conf" 2>/dev/null || true)
  if [[ "$starts" -eq 0 && ! -f "$inc" && ! -f "$state" && ! -f "$list" ]]; then
    rm -rf "$tmp"
    printf 'enabled=0\n'; return 0
  fi

  if ! _security_vhost_edit "$conf" "${tmp}/vhost" disable /dev/null ip_block; then
    rm -rf "$tmp"; die "Could not edit the vhost to remove IP Block markers."
  fi
  if [[ -f "$list" ]]; then count=$(grep -c . "$list"); sha=$(sha256sum "$list" | cut -d' ' -f1); else count=0; sha=""; fi
  _security_ipblock_state_render "${tmp}/state" 0 "$count" "$sha"

  _security_tx_begin "$conf" "$inc" "$list" "$state" \
    || { rm -rf "$tmp"; _security_tx_cleanup; die "Could not snapshot the IP Block configuration."; }
  SECURITY_TX_DIRTY=1
  if ! _security_install_file "${tmp}/vhost" "$conf" root root 0644 \
    || ! rm -f "$inc" \
    || ! _security_install_file "${tmp}/state" "$state" root root 0600; then
    _security_tx_restore || install_restore_rc=1
    _security_tx_cleanup; rm -rf "$tmp"
    [[ "$install_restore_rc" -eq 0 ]] \
      && die "Could not remove the IP Block configuration; the previous state was restored." \
      || die "Could not remove the IP Block configuration and rollback was incomplete. Inspect nginx immediately."
  fi
  rm -rf "$tmp"
  if _security_reload_transaction; then reload_rc=0; else reload_rc=$?; fi
  if [[ "$reload_rc" -ne 0 ]]; then
    _security_tx_cleanup
    [[ "$reload_rc" -eq 2 ]] \
      && die "The web server rejected the IP Block change; every managed file was restored." \
      || die "IP Block rollback could not reload the previous configuration. Inspect nginx immediately."
  fi
  _security_tx_cleanup
  if [[ "$purge" == "true" ]]; then rm -f -- "$list" "$state"; fi
  _cache_purge_domain "$domain" >/dev/null 2>&1 || true
  printf 'enabled=0\n'
  ok "IP Blocking disabled for ${domain}$([[ "$purge" == "true" ]] && printf ' (list purged)')"
}

_security_ipblock() {
  _require_root "security:ip-block"
  _parse_opts "$@"
  local domain action purge
  domain=$(_opt domain); action=$(_opt action status); purge=$(_opt purge)
  _require_arg "domain" "$domain" "security:ip-block --domain example.com --action status"
  _domain_valid "$domain" || die "Invalid domain name: ${domain}"
  _domain_exists "$domain" || die "Site not found: ${domain}"
  case "$action" in
    status)  _security_ipblock_status "$domain" ;;
    get)     _security_ipblock_get "$domain" ;;
    set)     _security_ipblock_set "$domain" ;;
    disable) _security_ipblock_disable "$domain" "$purge" ;;
    *) die "Unknown action for security:ip-block: ${action} (use status|get|set|disable)" ;;
  esac
}

_security_cfonly_siblings_valid() {
  local domain="$1" basic="${2:-}" ip="${3:-}" basic_error ip_error
  [[ -n "$basic" ]] || basic=$(_security_status "$domain") || return 1
  basic_error=$(printf '%s\n' "$basic" \
    | awk -F= '$1=="error"{print substr($0,7); n++} END{if(n!=1)exit 1}') || return 1
  [[ -z "$basic_error" ]] || return 1
  [[ -n "$ip" ]] || ip=$(_security_ipblock_status_locked "$domain") || return 1
  ip_error=$(printf '%s\n' "$ip" \
    | awk -F= '$1=="error"{print substr($0,7); n++} END{if(n!=1)exit 1}') || return 1
  [[ -z "$ip_error" ]]
}

_security_cfonly_status() {
  local domain="$1" global_status="${2:-}" basic_status="${3:-}" ip_status="${4:-}"
  local conf="${NGINX_CONF_DIR}/${domain}.conf" state stored="" marker error="" enabled=0
  state=$(_security_cfonly_state "$domain")
  [[ -n "$global_status" ]] || global_status=$(_cloudflare_status)
  marker=$(_security_cfonly_marker_status "$conf")

  if [[ -f "$state" ]]; then
    if ! stored=$(_security_cfonly_state_get "$state" enabled 2>/dev/null); then
      error=malformed_state
    fi
  elif [[ "$marker" != missing_marker ]]; then
    error=missing_state
  fi

  if [[ -z "$error" && "$stored" == 1 ]]; then
    if [[ "$marker" != ok ]]; then
      error="$marker"
    elif [[ "$(grep -cF 'if ($aidipanel_from_cloudflare = 0) { return 403; }' "$conf" 2>/dev/null || true)" -ne 1 ]]; then
      error=marker_drift
    elif ! _security_cfonly_siblings_valid "$domain" "$basic_status" "$ip_status"; then
      error=sibling_drift
    elif ! _security_cfonly_dependency_healthy "$global_status"; then
      error=dependency_unhealthy
    else
      enabled=1
    fi
  elif [[ -z "$error" && "$stored" == 0 ]]; then
    [[ "$marker" == missing_marker ]] || error=state_mismatch
  fi

  printf 'enabled=%s\n' "$enabled"
  printf 'realip_required=1\n'
  printf 'error=%s\n' "$error"
}

_security_snapshot_emit() {
  local prefix="$1" payload="$2" line
  while IFS= read -r line; do
    [[ "$line" == *=* ]] || continue
    printf '%s_%s\n' "$prefix" "$line"
  done <<< "$payload"
}

# One read-only process for the Manage Site -> Security tab. Lock order remains
# global Cloudflare first, then per-site Security, matching Cloudflare-only
# mutations. Existing status functions remain the source of truth.
_security_snapshot() {
  _require_root "security:status"
  [[ "$#" -eq 2 && "$1" == "--domain" ]] \
    || die "Usage: security:status --domain example.com"
  local domain="$2"
  _domain_valid "$domain" || die "Invalid domain name: ${domain}"
  _domain_exists "$domain" || die "Site not found: ${domain}"

  local global_locked=0 site_locked=0
  local cloudflare_status basic_auth_status ip_block_status cloudflare_only_status
  local ip_block_list="" ip_block_list_b64="" ip_error=""

  if _cloudflare_lock s; then
    global_locked=1
    cloudflare_status=$(_cloudflare_status_locked)
  else
    cloudflare_status=$(_cloudflare_status_empty busy)
  fi

  if _security_lock "$domain" s; then
    site_locked=1
    basic_auth_status=$(_security_status "$domain")
    ip_block_status=$(_security_ipblock_status_locked "$domain")
  else
    basic_auth_status=$'enabled=0\nscope=wp-login\npath=\nusername=\nbypass_ips=\nhtpasswd_exists=0\nforce_https=0\nerror=busy'
    ip_block_status=$'enabled=0\nentry_count=0\nlist_sha256=\nrealip_active=0\nerror=busy'
  fi

  if [[ "$global_locked" -eq 1 && "$site_locked" -eq 1 ]]; then
    cloudflare_only_status=$(_security_cfonly_status \
      "$domain" "$cloudflare_status" "$basic_auth_status" "$ip_block_status")
  else
    cloudflare_only_status=$'enabled=0\nrealip_required=1\nerror=busy'
  fi

  ip_error=$(printf '%s\n' "$ip_block_status" \
    | awk -F= '$1=="error"{print substr($0,7); n++} END{if(n!=1)exit 1}') || ip_error=status_unavailable
  if [[ "$site_locked" -eq 1 && -z "$ip_error" ]]; then
    ip_block_list=$(_security_ipblock_get_locked "$domain") || ip_block_list=""
    if [[ -n "$ip_block_list" ]]; then
      ip_block_list_b64=$(printf '%s' "$ip_block_list" | base64 -w 0)
    fi
  fi

  _security_snapshot_emit basic_auth "$basic_auth_status"
  _security_snapshot_emit cloudflare "$cloudflare_status"
  _security_snapshot_emit ip_block "$ip_block_status"
  printf 'ip_block_list_b64=%s\n' "$ip_block_list_b64"
  _security_snapshot_emit cloudflare_only "$cloudflare_only_status"
}

_security_cfonly_enable_locked() {
  local domain="$1" global_status="$2"
  local conf="${NGINX_CONF_DIR}/${domain}.conf" state dir tmp status error enabled
  local reload_rc install_restore_rc=0
  state=$(_security_cfonly_state "$domain"); dir=$(_security_dir "$domain")

  status=$(_security_cfonly_status "$domain" "$global_status") || return 1
  error=$(printf '%s\n' "$status" | awk -F= '$1=="error"{print substr($0,7)}')
  enabled=$(printf '%s\n' "$status" | awk -F= '$1=="enabled"{print $2}')
  if [[ -n "$error" ]]; then echo "error=${error}"; return 1; fi
  if [[ "$enabled" == 1 ]]; then printf 'enabled=1\n'; return 0; fi
  _security_cfonly_dependency_healthy "$global_status" \
    || { echo 'error=dependency_unhealthy'; return 1; }
  _security_cfonly_siblings_valid "$domain" \
    || { echo 'error=sibling_drift'; return 1; }

  tmp=$(mktemp -d /tmp/aidipanel-cfonly-build.XXXXXX) || { echo 'error=tmp'; return 1; }
  _security_cfonly_render_marker "${tmp}/marker"
  if ! _security_vhost_edit "$conf" "${tmp}/vhost" enable "${tmp}/marker" cloudflare_only; then
    rm -rf "$tmp"; echo 'error=vhost_edit'; return 1
  fi
  _security_cfonly_state_render "${tmp}/state" 1 \
    || { rm -rf "$tmp"; echo 'error=state_render'; return 1; }

  _security_tx_begin "$conf" "$state" \
    || { rm -rf "$tmp"; _security_tx_cleanup; die "Could not snapshot Cloudflare-only state."; }
  SECURITY_TX_DIRTY=1
  if ! install -d -o root -g root -m 0755 /etc/nginx/aidipanel \
    || ! install -d -o root -g www-data -m 0750 /etc/nginx/aidipanel/security "$dir" \
    || ! _security_install_file "${tmp}/vhost" "$conf" root root 0644 \
    || ! _security_install_file "${tmp}/state" "$state" root root 0600; then
    _security_tx_restore || install_restore_rc=1
    _security_tx_cleanup; rm -rf "$tmp"
    [[ "$install_restore_rc" -eq 0 ]] \
      && die "Could not install Cloudflare-only; the previous state was restored." \
      || die "Could not install Cloudflare-only and rollback was incomplete. Inspect nginx immediately."
  fi
  rm -rf "$tmp"
  if _security_reload_transaction; then reload_rc=0; else reload_rc=$?; fi
  if [[ "$reload_rc" -ne 0 ]]; then
    _security_tx_cleanup
    [[ "$reload_rc" -eq 2 ]] \
      && { echo 'error=nginx_rejected'; return 2; } \
      || die "Cloudflare-only rollback could not reload the previous configuration. Inspect nginx immediately."
  fi
  _security_tx_cleanup
  _cache_purge_domain "$domain" >/dev/null 2>&1 || true
  printf 'enabled=1\n'
  ok "Direct-origin rejection enabled for ${domain}."
}

_security_cfonly_disable_locked() {
  local domain="$1"
  local conf="${NGINX_CONF_DIR}/${domain}.conf" state stored="" marker dir tmp
  local reload_rc install_restore_rc=0
  state=$(_security_cfonly_state "$domain"); dir=$(_security_dir "$domain")
  marker=$(_security_cfonly_marker_status "$conf")

  if [[ ! -f "$state" && "$marker" == missing_marker ]]; then
    printf 'enabled=0\n'; return 0
  fi
  if [[ ! -f "$state" ]]; then echo 'error=missing_state'; return 1; fi
  if ! stored=$(_security_cfonly_state_get "$state" enabled 2>/dev/null); then
    echo 'error=malformed_state'; return 1
  fi
  if [[ "$stored" == 0 ]]; then
    [[ "$marker" == missing_marker ]] || { echo 'error=state_mismatch'; return 1; }
    printf 'enabled=0\n'; return 0
  fi
  [[ "$marker" == ok ]] || { echo "error=${marker}"; return 1; }
  [[ "$(grep -cF 'if ($aidipanel_from_cloudflare = 0) { return 403; }' "$conf" 2>/dev/null || true)" -eq 1 ]] \
    || { echo 'error=marker_drift'; return 1; }
  _security_cfonly_siblings_valid "$domain" \
    || { echo 'error=sibling_drift'; return 1; }

  tmp=$(mktemp -d /tmp/aidipanel-cfonly-build.XXXXXX) || { echo 'error=tmp'; return 1; }
  if ! _security_vhost_edit "$conf" "${tmp}/vhost" disable /dev/null cloudflare_only; then
    rm -rf "$tmp"; echo 'error=vhost_edit'; return 1
  fi
  _security_cfonly_state_render "${tmp}/state" 0 \
    || { rm -rf "$tmp"; echo 'error=state_render'; return 1; }

  _security_tx_begin "$conf" "$state" \
    || { rm -rf "$tmp"; _security_tx_cleanup; die "Could not snapshot Cloudflare-only state."; }
  SECURITY_TX_DIRTY=1
  if ! install -d -o root -g root -m 0755 /etc/nginx/aidipanel \
    || ! install -d -o root -g www-data -m 0750 /etc/nginx/aidipanel/security "$dir" \
    || ! _security_install_file "${tmp}/vhost" "$conf" root root 0644 \
    || ! _security_install_file "${tmp}/state" "$state" root root 0600; then
    _security_tx_restore || install_restore_rc=1
    _security_tx_cleanup; rm -rf "$tmp"
    [[ "$install_restore_rc" -eq 0 ]] \
      && die "Could not disable Cloudflare-only; the previous state was restored." \
      || die "Could not disable Cloudflare-only and rollback was incomplete. Inspect nginx immediately."
  fi
  rm -rf "$tmp"
  if _security_reload_transaction; then reload_rc=0; else reload_rc=$?; fi
  if [[ "$reload_rc" -ne 0 ]]; then
    _security_tx_cleanup
    [[ "$reload_rc" -eq 2 ]] \
      && { echo 'error=nginx_rejected'; return 2; } \
      || die "Cloudflare-only rollback could not reload the previous configuration. Inspect nginx immediately."
  fi
  _security_tx_cleanup
  _cache_purge_domain "$domain" >/dev/null 2>&1 || true
  printf 'enabled=0\n'
  ok "Direct-origin rejection disabled for ${domain}."
}

_security_cloudflare_only() {
  _require_root "security:cloudflare-only"
  local domain="" action="" domain_seen=0 action_seen=0 mode global_status
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --domain)
        [[ "$domain_seen" == 0 && $# -ge 2 && -n "${2:-}" ]] \
          || { die "Missing or duplicate required option: --domain"; return 1; }
        domain_seen=1; domain="$2"; shift 2
        ;;
      --domain=*)
        [[ "$domain_seen" == 0 && -n "${1#--domain=}" ]] \
          || { die "Missing or duplicate required option: --domain"; return 1; }
        domain_seen=1; domain="${1#--domain=}"; shift
        ;;
      --action)
        [[ "$action_seen" == 0 && $# -ge 2 && -n "${2:-}" ]] \
          || { die "Missing or duplicate required option: --action"; return 1; }
        action_seen=1; action="$2"; shift 2
        ;;
      --action=*)
        [[ "$action_seen" == 0 && -n "${1#--action=}" ]] \
          || { die "Missing or duplicate required option: --action"; return 1; }
        action_seen=1; action="${1#--action=}"; shift
        ;;
      *) die "Unknown option for security:cloudflare-only: $1"; return 1 ;;
    esac
  done
  [[ "$domain_seen" == 1 ]] || { die "Missing required option: --domain"; return 1; }
  [[ "$action_seen" == 1 ]] || { die "Missing required option: --action"; return 1; }
  case "$action" in status) mode=s ;; enable|disable) mode=x ;; *) die "Unknown action: ${action}. Use status enable disable"; return 1 ;; esac
  _domain_valid "$domain" || die "Invalid domain name: ${domain}"

  if ! _cloudflare_lock "$mode"; then
    [[ "$action" == status ]] \
      && printf 'enabled=0\nrealip_required=1\nerror=busy\n' \
      || echo 'error=busy'
    return 3
  fi
  if ! _security_lock "$domain" "$mode"; then
    [[ "$action" == status ]] \
      && printf 'enabled=0\nrealip_required=1\nerror=busy\n' \
      || echo 'error=busy'
    return 3
  fi
  _domain_exists "$domain" || die "Site not found: ${domain}"
  global_status=$(_cloudflare_status_locked)
  case "$action" in
    status)  _security_cfonly_status "$domain" "$global_status" ;;
    enable)  _security_cfonly_enable_locked "$domain" "$global_status" ;;
    disable) _security_cfonly_disable_locked "$domain" ;;
  esac
}

_security_basic_auth() {
  _require_root "security:basic-auth"
  _parse_opts "$@"
  local domain action scope username path bypass_raw bypass_ips lock_mode
  domain=$(_opt "domain")
  action=$(_opt "action" "status")
  _require_arg "domain" "$domain" "security:basic-auth --domain example.com --action status"
  _domain_valid "$domain" || die "Invalid domain name: ${domain}"
  case "$action" in
    status) lock_mode=s ;;
    enable|disable) lock_mode=x ;;
    *) die "Unknown Basic Auth action: ${action}. Use: status, enable, or disable." ;;
  esac
  if ! _security_lock "$domain" "$lock_mode"; then
    if [[ "$action" == status ]]; then
      printf 'enabled=0\nscope=\npath=\nusername=\nbypass_ips=\nhtpasswd_exists=0\nforce_https=0\nerror=busy\n'
    else
      echo 'error=busy'
    fi
    return 3
  fi
  _domain_exists "$domain" || die "Site not found: ${domain}"

  case "$action" in
    status)
      _security_status "$domain"
      ;;
    enable)
      scope=$(_opt "scope")
      username=$(_opt "user")
      path=$(_opt "path" "")
      bypass_raw=$(_opt "bypass-ips" "")
      _security_scope_valid "$scope" || die "Invalid Basic Auth scope: ${scope}. Use: site, wp-login, or custom."
      _security_user_valid "$username" || die "Invalid Basic Auth username. Use 1-64 letters, numbers, dot, underscore, or hyphen."
      if [[ "$scope" == "custom" ]]; then
        if ! path=$(_security_normalize_path "$path"); then
          die "Invalid custom path. Use a path such as /private; the site root belongs to --scope site."
        fi
        _security_path_valid "$path" || die "Invalid custom path. Use a path such as /private; percent encoding, /, //, whitespace, and .. segments are not allowed."
      elif [[ -n "$path" ]]; then
        die "Invalid custom path: --path is only valid with --scope custom."
      fi
      if ! bypass_ips=$(_security_normalize_ips "$bypass_raw"); then
        die "Invalid bypass IP list. Use individual IPv4 or IPv6 addresses without CIDR."
      fi
      [[ -z "$(_opt "pass" "")" ]] || die "The --pass option is not supported; use --password-stdin."
      local use_stdin; use_stdin=$(_opt "password-stdin" "false")
      [[ "$use_stdin" == "false" || "$use_stdin" == "true" ]] \
        || die "--password-stdin is a flag and does not accept a value."
      _security_enable "$domain" "$scope" "$path" "$username" "$bypass_ips" "$use_stdin"
      ;;
    disable)
      _security_disable "$domain" "$(_opt "purge" "false")"
      ;;
  esac
}

# ===========================================================================
# DATABASE COMMANDS
# ===========================================================================

# Resolve a site's Linux user from its vhost and echo the DB name prefix
# (dashes -> underscores, plus a trailing "_"). Scopes every per-site db:*
# operation to one site; the vhost is root-owned, so this cannot be forged.
_db_site_prefix() {
  local domain="$1" user=""
  local conf="${NGINX_CONF_DIR}/${domain}.conf"
  _domain_valid "$domain" || die "Invalid domain name: ${domain}"
  [[ -f "$conf" ]] || die "Site not found: ${domain}"
  # Prefer the PHP-FPM socket (php<ver>-fpm-<user>.sock); fall back to the webroot owner.
  user=$(grep -oP 'php[0-9.]+-fpm-\K[a-z0-9_-]+(?=\.sock)' "$conf" 2>/dev/null | head -1 || echo "")
  [[ -n "$user" ]] || user=$(grep -oP "^[[:space:]]*root[[:space:]]+${HOME_BASE}/\K[^/]+" "$conf" 2>/dev/null | head -1 || echo "")
  [[ -n "$user" ]] || die "Could not resolve the site user for ${domain}."
  printf '%s_' "${user//-/_}"
}

# Refuse any name that is not inside the site's prefix (the isolation guard).
_db_require_prefix() {
  local name="$1" prefix="$2"
  [[ "$name" == "${prefix}"* ]] \
    || die "Name '${name}' is not allowed for this site (must start with '${prefix}')."
}

# Grant a user's privileges on a database at the requested level (rw=ALL, ro=SELECT).
_db_grant() {
  local db="$1" user="$2" perm="${3:-rw}"
  if [[ "$perm" == "ro" ]]; then
    _mysql_exec "GRANT SELECT ON \`${db}\`.* TO '${user}'@'localhost';" || return 1
  else
    _mysql_exec "GRANT ALL PRIVILEGES ON \`${db}\`.* TO '${user}'@'localhost';" || return 1
  fi
}

_db_secret_init() {
  mkdir -p "$DB_SECRET_DIR" "$(dirname "$DB_SECRET_KEY")" || return 1
  chown root:root "$DB_SECRET_DIR" "$(dirname "$DB_SECRET_KEY")" 2>/dev/null || true
  chmod 700 "$DB_SECRET_DIR" || return 1

  if [[ ! -f "$DB_SECRET_KEY" ]]; then
    local old_umask
    old_umask=$(umask)
    umask 177
    openssl rand -hex 32 > "$DB_SECRET_KEY" || { umask "$old_umask"; return 1; }
    umask "$old_umask"
  fi
  chown root:root "$DB_SECRET_KEY" 2>/dev/null || true
  chmod 600 "$DB_SECRET_KEY" || return 1

  if [[ ! -f "$DB_SECRET_STORE" ]]; then
    : > "$DB_SECRET_STORE" || return 1
  fi
  chown root:root "$DB_SECRET_STORE" 2>/dev/null || true
  chmod 600 "$DB_SECRET_STORE" || return 1
}

_db_secret_encrypt() {
  _db_secret_init || return 1
  printf '%s' "$1" | openssl enc -aes-256-cbc -pbkdf2 -salt -a -A -pass "file:${DB_SECRET_KEY}"
}

_db_secret_decrypt() {
  _db_secret_init || return 1
  printf '%s' "$1" | openssl enc -d -aes-256-cbc -pbkdf2 -a -A -pass "file:${DB_SECRET_KEY}" 2>/dev/null
}

_db_secret_put() {
  local site="$1" db_name="$2" db_user="$3" db_pass="$4"
  [[ -n "$site" && -n "$db_name" && -n "$db_user" && -n "$db_pass" ]] || return 1
  local cipher tmp
  cipher=$(_db_secret_encrypt "$db_pass") || return 1
  tmp=$(mktemp) || return 1
  awk -F '\t' -v s="$site" -v d="$db_name" -v u="$db_user" \
    'BEGIN { OFS = FS } !($1 == s && $2 == d && $3 == u) { print }' \
    "$DB_SECRET_STORE" > "$tmp" || { rm -f "$tmp"; return 1; }
  printf '%s\t%s\t%s\t%s\n' "$site" "$db_name" "$db_user" "$cipher" >> "$tmp"
  chown root:root "$tmp" 2>/dev/null || true
  chmod 600 "$tmp" || { rm -f "$tmp"; return 1; }
  mv "$tmp" "$DB_SECRET_STORE"
}

_db_secret_get() {
  local site="$1" db_name="$2" db_user="$3" cipher=""
  _db_secret_init || return 1
  cipher=$(awk -F '\t' -v s="$site" -v d="$db_name" -v u="$db_user" \
    '$1 == s && $2 == d && $3 == u { print $4; exit }' "$DB_SECRET_STORE")
  [[ -n "$cipher" ]] || return 1
  _db_secret_decrypt "$cipher"
}

_db_secret_delete_db() {
  local site="$1" db_name="$2" tmp
  _db_secret_init || return 0
  tmp=$(mktemp) || return 0
  awk -F '\t' -v s="$site" -v d="$db_name" \
    'BEGIN { OFS = FS } !($1 == s && $2 == d) { print }' \
    "$DB_SECRET_STORE" > "$tmp" || { rm -f "$tmp"; return 0; }
  chown root:root "$tmp" 2>/dev/null || true
  chmod 600 "$tmp" 2>/dev/null || true
  mv "$tmp" "$DB_SECRET_STORE" 2>/dev/null || true
}

_db_secret_delete_user() {
  local site="$1" db_user="$2" tmp
  _db_secret_init || return 0
  tmp=$(mktemp) || return 0
  awk -F '\t' -v s="$site" -v u="$db_user" \
    'BEGIN { OFS = FS } !($1 == s && $3 == u) { print }' \
    "$DB_SECRET_STORE" > "$tmp" || { rm -f "$tmp"; return 0; }
  chown root:root "$tmp" 2>/dev/null || true
  chmod 600 "$tmp" 2>/dev/null || true
  mv "$tmp" "$DB_SECRET_STORE" 2>/dev/null || true
}

# Remove every stored secret belonging to a site (keyed by the site identifier in
# column 1 — the domain passed as `db:add --site <domain>`). Used by site teardown.
_db_secret_delete_site() {
  local site="$1" tmp
  _db_secret_init || return 0
  tmp=$(mktemp) || return 0
  awk -F '\t' -v s="$site" \
    'BEGIN { OFS = FS } $1 != s { print }' \
    "$DB_SECRET_STORE" > "$tmp" || { rm -f "$tmp"; return 0; }
  chown root:root "$tmp" 2>/dev/null || true
  chmod 600 "$tmp" 2>/dev/null || true
  mv "$tmp" "$DB_SECRET_STORE" 2>/dev/null || true
}

_db_user_grant_dbs() {
  local db_user="$1"
  _mysql_exec "SELECT Db FROM mysql.db WHERE User = '$(_sql_escape_literal "$db_user")' AND Host = 'localhost';" 2>/dev/null \
    | awk 'NR > 1 && NF { print $1 }'
}

_db_wp_config_value() {
  local file="$1" key="$2"
  grep -E "define\([[:space:]]*['\"]${key}['\"]" "$file" 2>/dev/null \
    | head -1 \
    | sed -E "s/.*define\([[:space:]]*['\"]${key}['\"][[:space:]]*,[[:space:]]*['\"]([^'\"]*)['\"].*/\1/"
}

_db_secret_backfill_wp() {
  local site="$1" db_name="$2" db_user="$3"
  local conf="${NGINX_CONF_DIR}/${site}.conf"
  [[ -f "$conf" ]] || return 1
  local webroot; webroot=$(_vhost_webroot "$conf")
  local wp_config="${webroot}/wp-config.php"
  [[ -f "$wp_config" ]] || return 1
  local wp_db wp_user wp_pass
  wp_db=$(_db_wp_config_value "$wp_config" "DB_NAME")
  wp_user=$(_db_wp_config_value "$wp_config" "DB_USER")
  wp_pass=$(_db_wp_config_value "$wp_config" "DB_PASSWORD")
  [[ "$wp_db" == "$db_name" && "$wp_user" == "$db_user" && -n "$wp_pass" ]] || return 1
  _db_secret_put "$site" "$db_name" "$db_user" "$wp_pass" || return 1
  printf '%s' "$wp_pass"
}

# Escape SQL LIKE metacharacters so a value matches LITERALLY under `ESCAPE '|'`.
# A site DB prefix ends in `_`, which LIKE treats as a single-char wildcard; without
# this, prefix `aa_` (LIKE 'aa_%') would also match another site's `aab_*` databases.
# Escape the escape char first, then the wildcards.
_db_like_escape() {
  local s="$1"
  s="${s//|/||}"
  s="${s//%/|%}"
  s="${s//_/|_}"
  printf '%s' "$s"
}

# Provision / deprovision a MySQL database + user. Shared by db:add and WordPress
# provisioning so both go through one code path.
_db_provision() {
  local db_name="$1" db_user="$2" db_pass="$3" db_perm="${4:-rw}"
  local db_pass_sql; db_pass_sql=$(_sql_escape_literal "$db_pass")
  # `|| return 1` on each step so a failure surfaces even when this runs in a `||`
  # context (errexit suppressed), e.g. the site:add WordPress rollback path.
  _mysql_exec "CREATE DATABASE IF NOT EXISTS \`${db_name}\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;" || return 1
  _mysql_exec "CREATE USER IF NOT EXISTS '${db_user}'@'localhost' IDENTIFIED BY '${db_pass_sql}';" || return 1
  # CREATE USER IF NOT EXISTS is a no-op for an existing user, so without this a
  # leftover user from a prior site keeps its OLD password and the new connection
  # fails with "Access denied". ALTER USER force-sets the intended password.
  _mysql_exec "ALTER USER '${db_user}'@'localhost' IDENTIFIED BY '${db_pass_sql}';" || return 1
  _db_grant "$db_name" "$db_user" "$db_perm" || return 1
  _mysql_exec "FLUSH PRIVILEGES;" || return 1
}

_db_deprovision() {
  local db_name="$1" db_user="$2"
  _mysql_exec "DROP DATABASE IF EXISTS \`${db_name}\`;"
  _mysql_exec "DROP USER IF EXISTS '${db_user}'@'localhost';"
  _mysql_exec "FLUSH PRIVILEGES;"
}

# Drop every MySQL database + @localhost user that belongs to a site (matched by the
# site's `<site_user>_` prefix), plus the site's stored phpMyAdmin secrets. The prefix
# is LIKE-escaped (see _db_like_escape) so it can never reach another site's data.
# Non-fatal: warns and returns 0 so a database error can't block the rest of teardown.
_db_deprovision_site() {
  local site_user="$1" domain="$2"
  [[ -n "$site_user" ]] || { warn "No site user resolved; skipping database cleanup for ${domain:-site}."; return 0; }

  local prefix esc
  prefix="${site_user//-/_}_"
  esc=$(_db_like_escape "$prefix")

  local -a dbs users
  mapfile -t dbs < <(_mysql_exec "SELECT schema_name FROM information_schema.schemata WHERE schema_name LIKE '${esc}%' ESCAPE '|' AND schema_name NOT IN ('information_schema','mysql','performance_schema','sys');" 2>/dev/null | awk 'NR>1 && NF { print $1 }')
  mapfile -t users < <(_mysql_exec "SELECT User FROM mysql.user WHERE User LIKE '${esc}%' ESCAPE '|' AND Host='localhost';" 2>/dev/null | awk 'NR>1 && NF { print $1 }')

  local d u dropped_db=0 dropped_user=0
  for d in "${dbs[@]}"; do
    [[ -n "$d" ]] || continue
    if _mysql_exec "DROP DATABASE IF EXISTS \`${d}\`;"; then
      dropped_db=$((dropped_db + 1))
    else
      warn "Could not drop database ${d}."
    fi
  done
  for u in "${users[@]}"; do
    [[ -n "$u" ]] || continue
    if _mysql_exec "DROP USER IF EXISTS '${u}'@'localhost';"; then
      dropped_user=$((dropped_user + 1))
    else
      warn "Could not drop database user ${u}."
    fi
  done
  _mysql_exec "FLUSH PRIVILEGES;" >/dev/null 2>&1 || true

  if [[ -n "$domain" ]]; then
    _db_secret_delete_site "$domain"
  fi

  if [[ "$dropped_db" -gt 0 || "$dropped_user" -gt 0 ]]; then
    ok "Databases removed for ${domain:-$site_user}: ${dropped_db} database(s), ${dropped_user} user(s)."
  fi
  return 0
}

_db_add() {
  _require_root "db:add"
  _parse_opts "$@"
  local db_name; db_name=$(_opt "name")
  local db_user; db_user=$(_opt "user" "$db_name")
  local db_pass; db_pass=$(_opt "pass" "$(openssl rand -base64 16 | tr -dc 'A-Za-z0-9' | head -c 16)")
  local site;    site=$(_opt "site" "")
  local perm;    perm=$(_opt "permission" "rw")
  local no_user; no_user=$(_opt "no-user" "false")

  _require_arg "name" "$db_name" "db:add --name mydb --user myuser"

  # Validate: only alphanumeric and underscores
  [[ "$db_name" =~ ^[a-zA-Z0-9_]+$ ]] \
    || die "Database name must contain only letters, numbers, underscores"
  [[ "$db_user" =~ ^[a-zA-Z0-9_]+$ ]] \
    || die "Database user must contain only letters, numbers, underscores"
  [[ "$db_pass" =~ ^[A-Za-z0-9_!@#%+=.,:-]{8,128}$ ]] \
    || die "Database password must be 8-128 characters and contain only safe symbols"
  [[ "$perm" =~ ^(rw|ro)$ ]] || die "Permission must be 'rw' or 'ro'"

  # When scoped to a site, every name must live under that site's prefix.
  if [[ -n "$site" ]]; then
    local prefix; prefix=$(_db_site_prefix "$site")
    _db_require_prefix "$db_name" "$prefix"
    [[ "$no_user" == "true" ]] || _db_require_prefix "$db_user" "$prefix"
  fi

  if [[ "$no_user" == "true" ]]; then
    log "Creating database: ${db_name}..."
    _mysql_exec "CREATE DATABASE IF NOT EXISTS \`${db_name}\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;" \
      || die "Could not create database ${db_name}."
    ok "Database created: ${db_name}"
    echo ""
    _table_row "Database:" "$db_name"
    _table_row "Host:"     "localhost"
    echo ""
    return 0
  fi

  log "Creating database: ${db_name} (user: ${db_user}, ${perm})..."

  _db_provision "$db_name" "$db_user" "$db_pass" "$perm"
  if [[ -n "$site" ]]; then
    _db_secret_put "$site" "$db_name" "$db_user" "$db_pass" \
      || warn "Could not store encrypted phpMyAdmin credential; reset the user password before using Manage."
  fi

  ok "Database created: ${db_name}"
  echo ""
  _table_row "Database:"   "$db_name"
  _table_row "User:"       "$db_user"
  _table_row "Password:"   "$db_pass"
  _table_row "Permission:" "$perm"
  _table_row "Host:"       "localhost"
  echo ""
  warn "Save the password above — it will not be shown again."
}

_db_delete() {
  _require_root "db:delete"
  _parse_opts "$@"
  local db_name; db_name=$(_opt "name")
  _require_arg "name" "$db_name" "db:delete --name mydb [--user myuser]"
  [[ "$db_name" =~ ^[a-zA-Z0-9_]+$ ]] \
    || die "Database name must contain only letters, numbers, underscores"
  local db_user; db_user=$(_opt "user" "$db_name")
  [[ "$db_user" =~ ^[a-zA-Z0-9_]+$ ]] \
    || die "Database user must contain only letters, numbers, underscores"
  local site; site=$(_opt "site" "")
  if [[ -n "$site" ]]; then
    local prefix; prefix=$(_db_site_prefix "$site")
    _db_require_prefix "$db_name" "$prefix"
  fi
  local force; force=$(_opt "force" "false")

  [[ "$force" == "true" ]] || _confirm "Delete database '${db_name}' and its user '${db_user}'?" || { log "Cancelled."; return 0; }

  _db_deprovision "$db_name" "$db_user"
  [[ -n "$site" ]] && _db_secret_delete_db "$site" "$db_name"
  ok "Database deleted: ${db_name} (user: ${db_user})"
}

_db_list() {
  _parse_opts "$@"
  local plain; plain=$(_opt "plain" "false")
  local site;  site=$(_opt "site" "")
  local json;  json=$(_opt "json" "false")

  # Base exclusion of the server's own schemas; add the site prefix when --site is given.
  local where="schema_name NOT IN ('information_schema','mysql','performance_schema','sys')"
  if [[ -n "$site" ]]; then
    local prefix; prefix=$(_db_site_prefix "$site")
    where="${where} AND schema_name LIKE '$(_sql_escape_literal "$prefix")%'"
  fi

  if [[ "$plain" == "true" ]]; then
    _mysql_exec "SELECT schema_name FROM information_schema.schemata
      WHERE ${where}
      ORDER BY schema_name;" 2>/dev/null | awk 'NR > 1 && NF { print $1 }'
    return 0
  fi

  if [[ "$json" == "true" ]]; then
    # JSON array: [{name,size_mb,tables,status}]; status Active when tables>0 else Empty.
    _mysql_exec "SELECT s.schema_name,
        COALESCE(ROUND(SUM(t.data_length + t.index_length) / 1024 / 1024, 2), 0) AS size_mb,
        COALESCE(COUNT(t.table_name), 0) AS tables
      FROM information_schema.schemata s
      LEFT JOIN information_schema.tables t ON t.table_schema = s.schema_name
      WHERE ${where}
      GROUP BY s.schema_name ORDER BY s.schema_name;" 2>/dev/null \
    | awk 'NR > 1 && NF {
        st = ($3 > 0 ? "Active" : "Empty");
        printf "%s{\"name\":\"%s\",\"size_mb\":%s,\"tables\":%s,\"status\":\"%s\"}", (n++ ? "," : ""), $1, $2, $3, st }
        BEGIN { printf "[" } END { printf "]\n" }'
    return 0
  fi

  echo ""
  echo -e "  ${BOLD}Databases${RESET}"
  _hr
  _mysql_exec "SELECT table_schema AS 'Database',
    ROUND(SUM(data_length + index_length) / 1024 / 1024, 2) AS 'Size (MB)',
    COUNT(table_name) AS 'Tables'
    FROM information_schema.tables
    WHERE table_schema NOT IN ('information_schema','mysql','performance_schema','sys')
    GROUP BY table_schema;" 2>/dev/null | column -t | sed 's/^/  /'
  _hr
  echo ""
}

# List a site's database users (user, database, rw/ro permission) from mysql.db.
_db_users() {
  _require_root "db:users"
  _parse_opts "$@"
  local site; site=$(_opt "site")
  _require_arg "site" "$site" "db:users --site example.com"
  local json; json=$(_opt "json" "false")
  local prefix; prefix=$(_db_site_prefix "$site")
  local q; q="SELECT d.User, d.Db,
      CASE WHEN d.Insert_priv = 'Y' OR d.Update_priv = 'Y' OR d.Delete_priv = 'Y'
           THEN 'rw' ELSE 'ro' END AS permission
    FROM mysql.db d
    WHERE d.User LIKE '$(_sql_escape_literal "$prefix")%'
    ORDER BY d.User, d.Db;"

  if [[ "$json" == "true" ]]; then
    _mysql_exec "$q" 2>/dev/null | awk 'NR > 1 && NF {
        printf "%s{\"user\":\"%s\",\"database\":\"%s\",\"permission\":\"%s\"}", (n++ ? "," : ""), $1, $2, $3 }
        BEGIN { printf "[" } END { printf "]\n" }'
    return 0
  fi

  echo ""
  echo -e "  ${BOLD}Database users${RESET}"
  _hr
  _mysql_exec "$q" 2>/dev/null | column -t | sed 's/^/  /'
  _hr
  echo ""
}

_db_backup() {
  _require_root "db:backup"
  _parse_opts "$@"
  local db_name; db_name=$(_opt "name")
  local output_dir; output_dir=$(_opt "output" "/var/backups/aidipanel")
  _require_arg "name" "$db_name" "db:backup --name mydb"
  [[ "$db_name" =~ ^[a-zA-Z0-9_]+$ ]] \
    || die "Database name must contain only letters, numbers, underscores"

  _load_credentials
  mkdir -p "$output_dir"

  local backup_file; backup_file="${output_dir}/${db_name}_$(date +%Y%m%d_%H%M%S).sql.gz"
  log "Backing up database: ${db_name} → ${backup_file}"

  mysqldump \
    --defaults-extra-file=<(printf '[client]\nuser=root\npassword=%s\n' "${MYSQL_ROOT_PASSWORD}") \
    --single-transaction \
    --quick \
    --lock-tables=false \
    "$db_name" \
    | gzip > "$backup_file"

  local size; size=$(du -sh "$backup_file" | cut -f1)
  ok "Backup created: ${backup_file} (${size})"
}

# Create a new MySQL user on an existing database (site-scoped).
_db_user_add() {
  _require_root "db:user-add"
  _parse_opts "$@"
  local site;    site=$(_opt "site");    _require_arg "site" "$site" "db:user-add --site example.com --name <user> --db <database>"
  local db_user; db_user=$(_opt "name"); _require_arg "name" "$db_user" "db:user-add --name <user>"
  local db_name; db_name=$(_opt "db");   _require_arg "db" "$db_name" "db:user-add --db <database>"
  local db_pass; db_pass=$(_opt "pass" "$(openssl rand -base64 16 | tr -dc 'A-Za-z0-9' | head -c 16)")
  local perm;    perm=$(_opt "permission" "rw")

  [[ "$db_user" =~ ^[a-zA-Z0-9_]+$ ]] || die "Database user must contain only letters, numbers, underscores"
  [[ "$db_name" =~ ^[a-zA-Z0-9_]+$ ]] || die "Database name must contain only letters, numbers, underscores"
  [[ "$db_pass" =~ ^[A-Za-z0-9_!@#%+=.,:-]{8,128}$ ]] || die "Database password must be 8-128 characters and contain only safe symbols"
  [[ "$perm" =~ ^(rw|ro)$ ]] || die "Permission must be 'rw' or 'ro'"

  local prefix; prefix=$(_db_site_prefix "$site")
  _db_require_prefix "$db_user" "$prefix"
  _db_require_prefix "$db_name" "$prefix"

  local exists; exists=$(_mysql_exec "SELECT 1 FROM information_schema.schemata WHERE schema_name = '$(_sql_escape_literal "$db_name")' LIMIT 1;" 2>/dev/null | awk 'NR>1{print $1}')
  [[ "$exists" == "1" ]] || die "Database '${db_name}' does not exist."

  local db_pass_sql; db_pass_sql=$(_sql_escape_literal "$db_pass")
  log "Creating database user: ${db_user} on ${db_name} (${perm})..."
  _mysql_exec "CREATE USER IF NOT EXISTS '${db_user}'@'localhost' IDENTIFIED BY '${db_pass_sql}';" || die "Could not create user ${db_user}."
  _mysql_exec "ALTER USER '${db_user}'@'localhost' IDENTIFIED BY '${db_pass_sql}';" || die "Could not set the user password."
  _db_grant "$db_name" "$db_user" "$perm" || die "Could not grant privileges on ${db_name}."
  _mysql_exec "FLUSH PRIVILEGES;"
  _db_secret_put "$site" "$db_name" "$db_user" "$db_pass" \
    || warn "Could not store encrypted phpMyAdmin credential; reset the user password before using Manage."

  ok "Database user created: ${db_user}"
  echo ""
  _table_row "User:"       "$db_user"
  _table_row "Database:"   "$db_name"
  _table_row "Password:"   "$db_pass"
  _table_row "Permission:" "$perm"
  _table_row "Host:"       "localhost"
  echo ""
  warn "Save the password above — it will not be shown again."
}

# Change a database user's permission and/or password (site-scoped). Optional
# --wp-config rewrites DB_PASSWORD so a WordPress site keeps working.
_db_user_edit() {
  _require_root "db:user-edit"
  _parse_opts "$@"
  local site;     site=$(_opt "site");     _require_arg "site" "$site" "db:user-edit --site example.com --name <user>"
  local db_user;  db_user=$(_opt "name");  _require_arg "name" "$db_user" "db:user-edit --name <user>"
  local perm;     perm=$(_opt "permission" "")
  local new_pass; new_pass=$(_opt "pass" "")
  local generate; generate=$(_opt "generate" "false")
  local wp_config; wp_config=$(_opt "wp-config" "")

  [[ "$db_user" =~ ^[a-zA-Z0-9_]+$ ]] || die "Database user must contain only letters, numbers, underscores"
  local prefix; prefix=$(_db_site_prefix "$site")
  _db_require_prefix "$db_user" "$prefix"

  local exists; exists=$(_mysql_exec "SELECT 1 FROM mysql.user WHERE User = '$(_sql_escape_literal "$db_user")' AND Host = 'localhost' LIMIT 1;" 2>/dev/null | awk 'NR>1{print $1}')
  [[ "$exists" == "1" ]] || die "Database user '${db_user}' does not exist."

  local did=0

  if [[ -n "$perm" ]]; then
    [[ "$perm" =~ ^(rw|ro)$ ]] || die "Permission must be 'rw' or 'ro'"
    local dbs; dbs=$(_mysql_exec "SELECT Db FROM mysql.db WHERE User = '$(_sql_escape_literal "$db_user")';" 2>/dev/null | awk 'NR>1 && NF{print $1}')
    [[ -n "$dbs" ]] || die "User '${db_user}' has no database grant to change."
    local d
    while IFS= read -r d; do
      [[ -n "$d" ]] || continue
      # Revoke only ALL PRIVILEGES (not GRANT OPTION): the panel never grants WITH
      # GRANT OPTION, and naming it makes MySQL 8 fail the whole REVOKE (ERROR 1141,
      # "no such grant") — which silently left the old privileges in place.
      _mysql_exec "REVOKE ALL PRIVILEGES ON \`${d}\`.* FROM '${db_user}'@'localhost';" \
        || die "Could not revoke existing privileges on ${d}."
      _db_grant "$d" "$db_user" "$perm" || die "Could not change privileges on ${d}."
    done <<< "$dbs"
    did=1
    log "Permission for ${db_user} set to ${perm}."
  fi

  if [[ "$generate" == "true" || -n "$new_pass" ]]; then
    [[ "$generate" == "true" ]] && new_pass="$(openssl rand -base64 16 | tr -dc 'A-Za-z0-9' | head -c 16)"
    [[ "$new_pass" =~ ^[A-Za-z0-9_!@#%+=.,:-]{8,128}$ ]] || die "Database password must be 8-128 characters and contain only safe symbols"
    local p_sql; p_sql=$(_sql_escape_literal "$new_pass")
    _mysql_exec "ALTER USER '${db_user}'@'localhost' IDENTIFIED BY '${p_sql}';" || die "Could not set the new password."
    did=1
    local grant_db
    while IFS= read -r grant_db; do
      [[ -n "$grant_db" ]] || continue
      _db_secret_put "$site" "$grant_db" "$db_user" "$new_pass" \
        || warn "Could not store encrypted phpMyAdmin credential for ${db_user} on ${grant_db}."
    done <<< "$(_db_user_grant_dbs "$db_user")"

    if [[ -n "$wp_config" ]]; then
      if [[ -w "$wp_config" ]]; then
        cp -- "$wp_config" "${wp_config}.aidipanel-bak"
        local esc; esc=$(printf '%s' "$new_pass" | sed -e 's/[\&|]/\\&/g')
        if sed -i -E "s|(define\(\s*'DB_PASSWORD'\s*,\s*')[^']*('\s*\)\s*;)|\1${esc}\2|" "$wp_config"; then
          log "Updated DB_PASSWORD in ${wp_config} (backup: ${wp_config}.aidipanel-bak)."
        else
          warn "Could not rewrite ${wp_config}; update DB_PASSWORD manually."
        fi
      else
        warn "wp-config.php not writable (${wp_config}); update DB_PASSWORD manually."
      fi
    fi
  fi

  _mysql_exec "FLUSH PRIVILEGES;"
  [[ "$did" == "1" ]] || die "Nothing to change: pass --permission and/or --pass/--generate."

  ok "Database user updated: ${db_user}"
  if [[ "$generate" == "true" || -n "$new_pass" ]]; then
    echo ""
    _table_row "User:"     "$db_user"
    _table_row "Password:" "$new_pass"
    echo ""
    warn "Save the password above — it will not be shown again."
  fi
}

# Delete a database user (site-scoped).
_db_user_delete() {
  _require_root "db:user-delete"
  _parse_opts "$@"
  local site;    site=$(_opt "site");    _require_arg "site" "$site" "db:user-delete --site example.com --name <user>"
  local db_user; db_user=$(_opt "name"); _require_arg "name" "$db_user" "db:user-delete --name <user>"
  [[ "$db_user" =~ ^[a-zA-Z0-9_]+$ ]] || die "Database user must contain only letters, numbers, underscores"
  local prefix; prefix=$(_db_site_prefix "$site")
  _db_require_prefix "$db_user" "$prefix"
  local force; force=$(_opt "force" "false")

  [[ "$force" == "true" ]] || _confirm "Delete database user '${db_user}'?" || { log "Cancelled."; return 0; }

  _mysql_exec "DROP USER IF EXISTS '${db_user}'@'localhost';" || die "Could not delete user ${db_user}."
  _mysql_exec "FLUSH PRIVILEGES;"
  _db_secret_delete_user "$site" "$db_user"
  ok "Database user deleted: ${db_user}"
}

_db_pma_credentials() {
  _require_root "db:pma-credentials"
  _parse_opts "$@"
  local site;    site=$(_opt "site");    _require_arg "site" "$site" "db:pma-credentials --site example.com --user <user> --db <database>"
  local db_user; db_user=$(_opt "user"); _require_arg "user" "$db_user" "db:pma-credentials --user <user>"
  local db_name; db_name=$(_opt "db");   _require_arg "db" "$db_name" "db:pma-credentials --db <database>"

  [[ "$db_user" =~ ^[a-zA-Z0-9_]+$ ]] || die "Database user must contain only letters, numbers, underscores"
  [[ "$db_name" =~ ^[a-zA-Z0-9_]+$ ]] || die "Database name must contain only letters, numbers, underscores"
  local prefix; prefix=$(_db_site_prefix "$site")
  _db_require_prefix "$db_user" "$prefix"
  _db_require_prefix "$db_name" "$prefix"

  local has_grant
  has_grant=$(_mysql_exec "SELECT 1 FROM mysql.db WHERE User = '$(_sql_escape_literal "$db_user")' AND Host = 'localhost' AND Db = '$(_sql_escape_literal "$db_name")' LIMIT 1;" 2>/dev/null | awk 'NR>1{print $1}')
  [[ "$has_grant" == "1" ]] || die "Database user '${db_user}' has no grant on '${db_name}'."

  local db_pass=""
  db_pass=$(_db_secret_get "$site" "$db_name" "$db_user" 2>/dev/null || true)
  if [[ -z "$db_pass" ]]; then
    db_pass=$(_db_secret_backfill_wp "$site" "$db_name" "$db_user" 2>/dev/null || true)
  fi
  [[ -n "$db_pass" ]] || die "No stored password for '${db_user}'. Reset the database user password, then open phpMyAdmin again."

  echo "pma_user=${db_user}"
  echo "pma_db=${db_name}"
  echo "pma_password=${db_pass}"
  echo "pma_host=127.0.0.1"
  echo "pma_port=3306"
}

_db_pma_write_config() {
  mkdir -p /etc/aidipanel /var/lib/phpmyadmin/tmp
  chown www-data:www-data /var/lib/phpmyadmin/tmp
  chmod 700 /var/lib/phpmyadmin/tmp

  local secret
  secret=$(openssl rand -hex 16)
  cat > "${PMA_DIR}/config.inc.php" <<PHP
<?php
\$cfg['blowfish_secret'] = '${secret}';

\$i = 0;
\$i++;
\$cfg['Servers'][\$i]['auth_type'] = 'signon';
\$cfg['Servers'][\$i]['SignonSession'] = 'AIDIPANEL_PMA_SIGNON';
\$cfg['Servers'][\$i]['SignonURL'] = '/sites';
\$cfg['Servers'][\$i]['host'] = '127.0.0.1';
\$cfg['Servers'][\$i]['compress'] = false;
\$cfg['Servers'][\$i]['AllowNoPassword'] = false;
\$cfg['Servers'][\$i]['AllowRoot'] = false;
\$cfg['Servers'][\$i]['hide_db'] = '^(information_schema|performance_schema)$';

\$cfg['TempDir'] = '/var/lib/phpmyadmin/tmp';
PHP
  chown root:www-data "${PMA_DIR}/config.inc.php"
  chmod 640 "${PMA_DIR}/config.inc.php"

  cat > "$PMA_CONF" <<PMA
PMA_VERSION=${PMA_VERSION}
PMA_DIR=${PMA_DIR}
PMA_URL=${PMA_URL_PATH}
PMA
  chmod 644 "$PMA_CONF"
}

_db_pma_write_nginx() {
  local fpm_sock; fpm_sock=$(_php_sock "$PHP_DEFAULT_VERSION")
  [[ -S "$fpm_sock" ]] || die "PHP-FPM socket not found: ${fpm_sock}"

  cat > "$PMA_NGINX_SNIPPET" <<NGINX
    location = /phpmyadmin {
        return 302 /phpmyadmin/index.php;
    }

    location ~ ^/phpmyadmin/(config\\.inc\\.php|setup/|libraries/|templates/|tmp/) {
        deny all;
    }

    location ~ ^/phpmyadmin/(.+\\.php)$ {
        alias ${PMA_DIR}/\$1;
        fastcgi_pass unix:${fpm_sock};
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME ${PMA_DIR}/\$1;
        include fastcgi_params;
        fastcgi_read_timeout 300;
    }

    location /phpmyadmin/ {
        alias ${PMA_DIR}/;
        index index.php;
    }
NGINX
  chmod 644 "$PMA_NGINX_SNIPPET"
}

_db_pma_wire_panel_vhost() {
  local vhost="/etc/nginx/sites-available/aidipanel-ui.conf"
  [[ -f "$vhost" ]] || die "Panel vhost not found: ${vhost}"

  if ! grep -Fq "$PMA_NGINX_SNIPPET" "$vhost"; then
    local tmp include_line
    tmp=$(mktemp)
    include_line="    include ${PMA_NGINX_SNIPPET};"
    if ! awk -v inc="$include_line" '
      !done && $0 ~ /^[[:space:]]*location[[:space:]]+\/[[:space:]]*\{/ {
        print inc;
        print "";
        done=1;
      }
      { print }
      END { if (!done) exit 42 }
    ' "$vhost" > "$tmp"; then
      rm -f "$tmp"
      die "Could not insert phpMyAdmin location into panel vhost."
    fi
    cp -- "$vhost" "${vhost}.aidipanel-bak"
    cp -- "$tmp" "$vhost"
    rm -f "$tmp"
  fi
}

_db_pma_install() {
  _require_root "db:pma-install"
  _parse_opts "$@"

  local archive="/tmp/phpMyAdmin-${PMA_VERSION}-all-languages.tar.gz"
  local extracted="/tmp/phpMyAdmin-${PMA_VERSION}-all-languages"
  local url="https://files.phpmyadmin.net/phpMyAdmin/${PMA_VERSION}/phpMyAdmin-${PMA_VERSION}-all-languages.tar.gz"

  _progress 10 preflight "Checking phpMyAdmin"
  if [[ ! -f "${PMA_DIR}/index.php" ]]; then
    _progress 25 download "Downloading phpMyAdmin ${PMA_VERSION}"
    log "Downloading phpMyAdmin ${PMA_VERSION}..."
    curl -fsSL "$url" -o "$archive" || die "Could not download phpMyAdmin ${PMA_VERSION}."
    _progress 45 extract "Extracting phpMyAdmin"
    rm -rf "$extracted" "${PMA_DIR}.new"
    tar -xzf "$archive" -C /tmp || die "Could not extract phpMyAdmin archive."
    mv "$extracted" "${PMA_DIR}.new"
    rm -rf "$PMA_DIR"
    mv "${PMA_DIR}.new" "$PMA_DIR"
    _progress 60 permissions "Securing phpMyAdmin files"
    chown -R root:root "$PMA_DIR"
    find "$PMA_DIR" -type d -exec chmod 755 {} \;
    find "$PMA_DIR" -type f -exec chmod 644 {} \;
    rm -rf "${PMA_DIR}/setup"
  fi

  _progress 70 config "Writing phpMyAdmin signon config"
  _db_pma_write_config
  _progress 80 nginx "Writing nginx configuration"
  _db_pma_write_nginx
  _db_pma_wire_panel_vhost

  _progress 90 reload "Testing and reloading nginx"
  nginx -t >> "$CLI_LOG" 2>&1 || die "Nginx rejected the phpMyAdmin configuration. Check: ${CLI_LOG}"
  systemctl reload nginx >> "$CLI_LOG" 2>&1 || die "Could not reload nginx."

  ok "phpMyAdmin installed: ${PMA_URL_PATH}"
  echo "pma_url=${PMA_URL_PATH}"
  echo "pma_version=${PMA_VERSION}"
  _progress 100 "done" "Done"
}

# ===========================================================================
# PHP COMMANDS
# ===========================================================================

_ensure_php_version() {
  local ver="$1"
  _php_version_valid "$ver" || die "Invalid PHP version: ${ver}. Supported: ${PHP_AVAILABLE_VERSIONS}"

  # Idempotency probes the FPM binary, not the 99-aidipanel.ini marker we write:
  # that marker lives under /etc/php/<ver> and survives `apt purge`, so keying off
  # it would (a) read a purged version as installed and (b) refuse to reinstall it.
  if _php_installed "$ver"; then
    ok "PHP ${ver} is already installed."
    return 0
  fi

  log "Installing PHP ${ver} on-demand (this may take 1-2 minutes)..."

  export DEBIAN_FRONTEND=noninteractive
  apt-get update -qq || true

  # Build the package list, skipping suffixes the repo does not ship for this
  # version (e.g. PHP 8.5 bundles OPcache into core, so php8.5-opcache is absent).
  # apt-get fails the whole transaction on one unlocatable package, so filter first.
  local pkgs=() skipped=() exts ext
  local IFS=' '
  read -ra exts <<< "$PHP_EXTENSIONS"
  for ext in "${exts[@]}"; do
    if apt-cache show "php${ver}-${ext}" >/dev/null 2>&1; then
      pkgs+=("php${ver}-${ext}")
    else
      skipped+=("php${ver}-${ext}")
    fi
  done
  [[ ${#skipped[@]} -gt 0 ]] && log "Skipping packages not in repo for PHP ${ver}: ${skipped[*]} (bundled into core or unavailable)."
  [[ ${#pkgs[@]} -gt 0 ]] || die "PHP ${ver} is not available from this server's package repository."

  apt-get install -y -qq "${pkgs[@]}" || die "Could not install PHP ${ver}. The package repository may be temporarily unavailable — please try again."

  local ini_dir="/etc/php/${ver}/fpm/conf.d"
  mkdir -p "$ini_dir"
  cat > "${ini_dir}/99-aidipanel.ini" <<PHPINI
; AidiPanel PHP-FPM tuning (PHP ${ver})
memory_limit         = 256M
max_execution_time   = 300
max_input_time       = 300
post_max_size        = 256M
upload_max_filesize  = 256M
date.timezone        = Asia/Jakarta
expose_php           = Off

; OPcache (important for performance)
opcache.enable                  = 1
opcache.enable_cli              = 0
opcache.memory_consumption      = 128
opcache.interned_strings_buffer = 16
opcache.max_accelerated_files   = 10000
opcache.revalidate_freq         = 2
opcache.fast_shutdown           = 1
opcache.validate_timestamps     = 1
opcache.save_comments           = 1
PHPINI

  local pool_conf="/etc/php/${ver}/fpm/pool.d/www.conf"
  if [[ -f "$pool_conf" ]]; then
    local mem_mb max_ch=10 start_sv=2 min_sp=2 max_sp=4
    mem_mb=$(awk '/MemTotal/{printf "%d", $2/1024}' /proc/meminfo 2>/dev/null || echo 0)
    [[ -z "$mem_mb" ]] && mem_mb=0
    if (( mem_mb >= 2048 )); then max_ch=20; start_sv=4; min_sp=2; max_sp=6; fi
    if (( mem_mb >= 4096 )); then max_ch=40; start_sv=6; min_sp=4; max_sp=10; fi
    sed -i \
      -e "s|^listen = .*|listen = /run/php/php${ver}-fpm.sock|" \
      -e 's|^;listen.owner = .*|listen.owner = www-data|' \
      -e 's|^;listen.group = .*|listen.group = www-data|' \
      -e 's|^;listen.mode = .*|listen.mode = 0660|' \
      -e 's|^pm = .*|pm = dynamic|' \
      -e "s|^pm.max_children = .*|pm.max_children = ${max_ch}|" \
      -e "s|^pm.start_servers = .*|pm.start_servers = ${start_sv}|" \
      -e "s|^pm.min_spare_servers = .*|pm.min_spare_servers = ${min_sp}|" \
      -e "s|^pm.max_spare_servers = .*|pm.max_spare_servers = ${max_sp}|" \
      -e 's|^;pm.max_requests = .*|pm.max_requests = 500|' \
      "$pool_conf"
  fi

  systemctl enable --now "php${ver}-fpm" || die "Failed to start php${ver}-fpm"
  ok "PHP ${ver} installed successfully."
  return 0
}

_php_list() {
  _parse_opts "$@"
  echo ""
  echo -e "  ${BOLD}PHP versions${RESET}"
  _hr
  for ver in "${PHP_VERSIONS_SUPPORTED[@]}"; do
    local status="${DIM}available${RESET}"
    local fpm_status="${DIM}stopped${RESET}"
    if _php_installed "$ver"; then
      status="${GREEN}installed${RESET}"
      [[ "$ver" == "$PHP_DEFAULT_VERSION" ]] && status="${GREEN}installed (default)${RESET}"
      systemctl is-active --quiet "php${ver}-fpm" 2>/dev/null \
        && fpm_status="${GREEN}running${RESET}" \
        || fpm_status="${RED}stopped${RESET}"
    fi
    printf "  PHP %-6s " "$ver"
    echo -e "  status: $status  fpm: $fpm_status"
  done
  _hr
  echo ""
}

_php_version() {
  _require_root "php:version"
  _parse_opts "$@"
  local domain; domain=$(_opt "domain")
  local new_ver; new_ver=$(_opt "set" "")
  _require_arg "domain" "$domain" "php:version --domain example.com [--set 8.3]"
  _domain_valid "$domain" || die "Invalid domain name: ${domain}"
  _domain_exists "$domain" || die "Site not found: ${domain}"

  local conf="${NGINX_CONF_DIR}/${domain}.conf"
  local current_ver; current_ver=$(grep -oP 'php\K[0-9.]+(?=-fpm)' "$conf" 2>/dev/null | head -1 || echo "unknown")

  if [[ -z "$new_ver" ]]; then
    echo "  PHP version for ${domain}: ${BOLD}${current_ver}${RESET}"
    return 0
  fi

  _php_version_valid "$new_ver" || die "Invalid PHP version: ${new_ver}. Supported: ${PHP_VERSIONS_SUPPORTED[*]}"
  _progress 15 check "Preparing PHP ${new_ver}"
  # Auto-install the target version on demand if it is missing (Patch C).
  if ! _php_installed "$new_ver"; then
    _progress 25 php_install "Installing PHP ${new_ver}"
    log "PHP ${new_ver} not installed — installing it first (this may take 1-2 minutes)..."
    _ensure_php_version "$new_ver"
  fi

  log "Changing PHP for ${domain}: ${current_ver} → ${new_ver}"

  # Resolve the site-user from the current vhost socket, recreate its pool on the
  # new version, then repoint the vhost socket. (Pool must follow the version.)
  local site_user; site_user=$(grep -oP 'php[0-9.]+-fpm-\K[a-z0-9_-]+(?=\.sock)' "$conf" 2>/dev/null | head -1 || echo "")
  local old_sock new_sock
  _progress 65 php_pool "Reconfiguring PHP-FPM pool"
  if [[ -n "$site_user" ]]; then
    _write_fpm_pool "$site_user" "$new_ver" || die "Could not create php${new_ver} pool for ${site_user}."
    _remove_fpm_pool "$site_user" "$current_ver"
    old_sock=$(_site_php_sock "$current_ver" "$site_user")
    new_sock=$(_site_php_sock "$new_ver" "$site_user")
  else
    old_sock=$(_php_sock "$current_ver"); new_sock=$(_php_sock "$new_ver")   # legacy fallback
  fi

  local tmp; tmp=$(mktemp)
  sed "s|${old_sock}|${new_sock}|g" "$conf" > "$tmp" && cp "$tmp" "$conf"
  rm -f "$tmp"

  _progress 90 reload "Reloading nginx"
  _nginx_test_reload
  _progress 100 "done" "Done"
  ok "PHP version changed for ${domain}: ${current_ver} → ${new_ver}"
}

_php_install() {
  _require_root "php:install"
  _parse_opts "$@"
  local ver; ver=$(_opt "version")
  _require_arg "version" "$ver" "php:install --version 8.5"
  _progress 10 php_install "Installing PHP ${ver}"
  _ensure_php_version "$ver"
  _progress 100 "done" "PHP ${ver} ready"
}

_php_restart() {
  _require_root "php:restart"
  _parse_opts "$@"
  local ver; ver=$(_opt "version" "all")

  if [[ "$ver" == "all" ]]; then
    for v in "${PHP_VERSIONS_SUPPORTED[@]}"; do
      if systemctl list-units --quiet "php${v}-fpm.service" &>/dev/null; then
        systemctl restart "php${v}-fpm" >> "$CLI_LOG" 2>&1 \
          && ok "Restarted: php${v}-fpm" \
          || warn "Could not restart php${v}-fpm"
      fi
    done
  else
    _php_version_valid "$ver" || die "Invalid PHP version: ${ver}"
    systemctl restart "php${ver}-fpm" >> "$CLI_LOG" 2>&1
    ok "Restarted: php${ver}-fpm"
  fi
}

_php_info() {
  _parse_opts "$@"
  local ver; ver=$(_opt "version" "${PHP_DEFAULT_VERSION}")
  _php_version_valid "$ver" || die "Invalid PHP version: ${ver}"
  command -v "php${ver}" &>/dev/null || die "PHP ${ver} not installed"

  echo ""
  "php${ver}" -i 2>/dev/null | grep -E "^(PHP Version|memory_limit|upload_max_filesize|post_max_size|max_execution_time|opcache)" \
    | head -20 | sed 's/^/  /'
  echo ""
}

# ===========================================================================
# SSL COMMANDS
# ===========================================================================

# Does any of the given cert names cover $domain? Exact match or wildcard
# (*.example.com matches a single-label subdomain). Case-insensitive.
_cert_covers_domain() {
  local domain="${1,,}"; shift
  local name base sub
  for name in "$@"; do
    name="${name,,}"
    [[ "$name" == "$domain" ]] && return 0
    if [[ "$name" == \*.* ]]; then
      base="${name#\*.}"
      if [[ "$domain" == *".$base" ]]; then
        sub="${domain%.$base}"
        [[ -n "$sub" && "$sub" != *.* ]] && return 0
      fi
    fi
  done
  return 1
}

# Point a site's vhost at the given cert paths. Generalized: replaces whatever
# ssl_certificate path is currently set (self-signed / LE / custom), so switching
# between cert types always works. Backs up the conf and restores on nginx -t fail.
_ssl_point_vhost() {
  local domain="$1" fullchain="$2" privkey="$3"
  local conf="${NGINX_CONF_DIR}/${domain}.conf"
  [[ -f "$conf" ]] || die "Vhost not found: ${conf}"
  local bak tmp; bak=$(mktemp); tmp=$(mktemp)
  cp "$conf" "$bak"
  sed -E \
    -e "s#^([[:space:]]*ssl_certificate)[[:space:]]+[^;]+;#\1 ${fullchain};#" \
    -e "s#^([[:space:]]*ssl_certificate_key)[[:space:]]+[^;]+;#\1 ${privkey};#" \
    "$conf" > "$tmp" && cp "$tmp" "$conf"
  rm -f "$tmp"
  if ! nginx -t >> "$CLI_LOG" 2>&1; then
    cp "$bak" "$conf"; rm -f "$bak"
    die "The web server rejected the certificate change for ${domain}; it was reverted."
  fi
  rm -f "$bak"
  systemctl reload nginx >> "$CLI_LOG" 2>&1
}

# Import a user-supplied certificate (paid / wildcard / existing LE).
_ssl_import() {
  _require_root "ssl:import"
  _parse_opts "$@"
  local domain cert_path key_path chain_path
  domain=$(_opt "domain")
  cert_path=$(_opt "cert")
  key_path=$(_opt "key")
  chain_path=$(_opt "chain" "")
  _require_arg "domain" "$domain"    "ssl:import --domain example.com --cert cert.pem --key key.pem"
  _require_arg "cert"   "$cert_path" "ssl:import --domain example.com --cert cert.pem --key key.pem"
  _require_arg "key"    "$key_path"  "ssl:import --domain example.com --cert cert.pem --key key.pem"
  _domain_valid "$domain"  || die "Invalid domain name: ${domain}"
  _domain_exists "$domain" || die "Site not found: ${domain}"
  [[ -f "$cert_path" ]] || die "Certificate file not found: ${cert_path}"
  [[ -f "$key_path"  ]] || die "Private key file not found: ${key_path}"
  [[ -z "$chain_path" || -f "$chain_path" ]] || die "Chain file not found: ${chain_path}"

  # Validate: cert + key parse, key matches cert, cert not expired.
  openssl x509 -noout -in "$cert_path" 2>/dev/null || die "Certificate is not valid PEM."
  openssl pkey -noout -in "$key_path"  2>/dev/null || die "Private key is not valid PEM."
  local cert_pub key_pub
  cert_pub=$(openssl x509 -in "$cert_path" -noout -pubkey 2>/dev/null | openssl md5 2>/dev/null)
  key_pub=$(openssl pkey -in "$key_path" -pubout 2>/dev/null | openssl md5 2>/dev/null)
  [[ -n "$cert_pub" && "$cert_pub" == "$key_pub" ]] || die "Private key does not match the certificate."
  openssl x509 -checkend 0 -noout -in "$cert_path" 2>/dev/null || die "Certificate has already expired."

  # Ensure the cert actually covers this domain (CN or SAN). Importing a cert for
  # the wrong host is the most common mistake — it leaves the browser showing
  # "not secure" even though the import itself "succeeded".
  local -a cert_names=()
  local cn san
  cn=$(openssl x509 -in "$cert_path" -noout -subject 2>/dev/null \
       | grep -oiE 'CN *= *[A-Za-z0-9.*_-]+' | sed -E 's/^CN *= *//I' | head -1)
  [[ -n "$cn" ]] && cert_names+=("$cn")
  while IFS= read -r san; do
    [[ -n "$san" ]] && cert_names+=("$san")
  done < <(openssl x509 -in "$cert_path" -noout -ext subjectAltName 2>/dev/null \
           | grep -oiE 'DNS:[A-Za-z0-9.*_-]+' | sed -E 's/^DNS://I')
  _cert_covers_domain "$domain" "${cert_names[@]}" \
    || die "Certificate does not cover ${domain} (it is issued for: ${cert_names[*]:-unknown}). Import the certificate that matches this site."

  log "Importing certificate for: ${domain}..."
  local dir="/etc/ssl/aidipanel-custom/${domain}"
  mkdir -p "$dir"
  cat "$cert_path" > "${dir}/fullchain.pem"
  if [[ -n "$chain_path" ]]; then
    printf '\n' >> "${dir}/fullchain.pem"
    cat "$chain_path" >> "${dir}/fullchain.pem"
  fi
  cp "$key_path" "${dir}/privkey.pem"
  chown -R root:root "$dir"
  # The directory + public certificate must be readable by the panel (www-data)
  # so it can report the real SSL status; only the private key stays root-only.
  chmod 755 "$dir"
  chmod 644 "${dir}/fullchain.pem"
  chmod 600 "${dir}/privkey.pem"

  _ssl_point_vhost "$domain" "${dir}/fullchain.pem" "${dir}/privkey.pem"
  ok "Certificate imported for: ${domain}"
}

_ssl_install() {
  _require_root "ssl:install"
  _parse_opts "$@"
  local email; email=$(_opt "email" "")
  local staging; staging=$(_opt "staging" "")

  # Domains: prefer --domains "a,www.a" (the user picks which names go on the
  # cert); fall back to the legacy single --domain. This is why we never force
  # "www." onto a domain that has no DNS record — the #1 cause of LE failures.
  local domains_csv; domains_csv=$(_opt "domains" "")
  [[ -z "$domains_csv" ]] && domains_csv=$(_opt "domain" "")
  _require_arg "domains" "$domains_csv" "ssl:install --domains example.com,www.example.com"

  local -a domains=() _raw=()
  IFS=',' read -ra _raw <<< "$domains_csv"
  local d e exists
  for d in "${_raw[@]}"; do
    d="${d//[[:space:]]/}"
    [[ -z "$d" ]] && continue
    _domain_valid "$d" || die "Invalid domain name: ${d}"
    exists=0; for e in "${domains[@]}"; do [[ "$e" == "$d" ]] && exists=1; done
    [[ $exists -eq 0 ]] && domains+=("$d")
  done
  [[ ${#domains[@]} -gt 0 ]] || die "No valid domains provided."

  # certbot uses the first -d as the certificate name / live dir, so the site's
  # own domain leads.
  local primary="${domains[0]}"
  _domain_exists "$primary" || die "Site not found: ${primary}"

  command -v certbot &>/dev/null || die "Certbot (the Let's Encrypt client) is not installed on this server, so SSL cannot be issued."

  # Pre-flight DNS: every name must resolve, or certbot's HTTP-01 challenge fails
  # with a cryptic error. Fail early with a clear, per-domain message instead.
  _progress 10 dns "Checking DNS"
  local -a unresolved=()
  for d in "${domains[@]}"; do
    getent hosts "$d" >/dev/null 2>&1 || unresolved+=("$d")
  done
  if [[ ${#unresolved[@]} -gt 0 ]]; then
    die "These domains do not resolve in DNS yet: ${unresolved[*]} — point them to this server (or remove them) and try again."
  fi

  if [[ -n "$staging" ]]; then
    log "Installing Let's Encrypt SSL (STAGING) for: ${domains[*]}"
  else
    log "Installing Let's Encrypt SSL for: ${domains[*]}"
  fi

  local certbot_args=(certbot --nginx --non-interactive --agree-tos --cert-name "$primary")
  for d in "${domains[@]}"; do certbot_args+=(-d "$d"); done
  [[ -n "$email" ]] && certbot_args+=(--email "$email") || certbot_args+=(--register-unsafely-without-email)
  [[ -n "$staging" ]] && certbot_args+=(--test-cert)

  _progress 30 request "Requesting certificate (Let's Encrypt)"
  "${certbot_args[@]}" >> "$CLI_LOG" 2>&1 \
    || die "Let's Encrypt could not verify domain ownership. Make sure every domain points to this server's IP and that port 80 is open, then try again."

  # certbot makes /etc/letsencrypt/{live,archive} 0700 (root-only), which blocks
  # the panel (www-data) from reading the public cert to report SSL status.
  # Make the two parent dirs traversable; private keys keep their own 0600.
  chmod 755 /etc/letsencrypt/live /etc/letsencrypt/archive 2>/dev/null || true

  # Point the vhost at the LE certs (generalized — replaces whatever path is
  # currently set, so self-signed/custom → LE all work; tests + restores on fail).
  _progress 90 reload "Updating nginx"
  _ssl_point_vhost "$primary" \
    "/etc/letsencrypt/live/${primary}/fullchain.pem" \
    "/etc/letsencrypt/live/${primary}/privkey.pem"
  _progress 100 "done" "Done"
  # LE certs auto-renew via the global cron; mark it so the panel can show it.
  _vhost_marker_set "${NGINX_CONF_DIR}/${primary}.conf" "AUTORENEW" "on"
  ok "SSL certificate installed for: ${domains[*]}"
  info "Auto-renewal is managed by: /etc/cron.d/aidipanel"
}

_ssl_renew() {
  _require_root "ssl:renew"
  _parse_opts "$@"
  local domain; domain=$(_opt "domain" "")

  log "Renewing SSL certificates..."
  _progress 20 renew "Renewing certificate"
  if [[ -n "$domain" ]]; then
    _domain_valid "$domain" || die "Invalid domain name: ${domain}"
    certbot renew --cert-name "$domain" --nginx --non-interactive >> "$CLI_LOG" 2>&1
    ok "Renewed: ${domain}"
  else
    certbot renew --nginx --non-interactive >> "$CLI_LOG" 2>&1
    ok "All certificates renewed"
  fi
  _progress 90 reload "Reloading nginx"
  systemctl reload nginx >> "$CLI_LOG" 2>&1
  _progress 100 "done" "Done"
}

_ssl_status() {
  _parse_opts "$@"
  echo ""
  echo -e "  ${BOLD}SSL Certificate Status${RESET}"
  _hr
  printf "  %-30s %-14s %s\n" "Domain" "Type" "Expiry"
  _hr

  for conf in "${NGINX_CONF_DIR}"/*.conf; do
    [[ -f "$conf" ]] || continue
    [[ "$(basename "$conf")" == "aidipanel-ui.conf" ]] && continue
    local domain; domain=$(basename "$conf" .conf)
    local cert_type expiry

    if [[ -f "/etc/letsencrypt/live/${domain}/fullchain.pem" ]]; then
      cert_type="Let's Encrypt"
      expiry=$(openssl x509 -enddate -noout \
        -in "/etc/letsencrypt/live/${domain}/fullchain.pem" 2>/dev/null \
        | cut -d= -f2 || echo "unknown")
    elif [[ -f "/etc/ssl/aidipanel-custom/${domain}/fullchain.pem" ]]; then
      cert_type="imported"
      expiry=$(openssl x509 -enddate -noout \
        -in "/etc/ssl/aidipanel-custom/${domain}/fullchain.pem" 2>/dev/null \
        | cut -d= -f2 || echo "unknown")
    elif [[ -f "/etc/ssl/aidipanel-self/${domain}.crt" ]]; then
      cert_type="self-signed"
      expiry=$(openssl x509 -enddate -noout \
        -in "/etc/ssl/aidipanel-self/${domain}.crt" 2>/dev/null \
        | cut -d= -f2 || echo "unknown")
    else
      cert_type="none"
      expiry="-"
    fi

    printf "  %-30s %-14s %s\n" "$domain" "$cert_type" "$expiry"
  done
  _hr
  echo ""
}

# ---------------------------------------------------------------------------
# SSL — HTTPS options (force-https / HSTS / per-site auto-renew) + JSON check
# ---------------------------------------------------------------------------

# Read/replace a managed marker comment (e.g. # AIDIPANEL_AUTORENEW=on) in a
# vhost. Markers are top-level comments, so they never affect nginx parsing.
_vhost_marker_get() {
  grep -oP "^# AIDIPANEL_$2=\K\S+" "$1" 2>/dev/null | head -1 || true
}
_vhost_marker_set() {
  local conf="$1" key="$2" val="$3" tmp; tmp=$(mktemp)
  if grep -q "^# AIDIPANEL_${key}=" "$conf" 2>/dev/null; then
    sed -E "s/^# AIDIPANEL_${key}=.*/# AIDIPANEL_${key}=${val}/" "$conf" > "$tmp"
  else
    sed -E "1a # AIDIPANEL_${key}=${val}" "$conf" > "$tmp"
  fi
  cp "$tmp" "$conf"; rm -f "$tmp"
}

# Atomically swap a vhost with an edited copy: back up, install, nginx -t, then
# restore + die on failure (so a bad edit never takes the site offline), else
# reload. Mirrors the safety of _ssl_point_vhost. Removes $newfile when done.
_vhost_commit() {
  local conf="$1" newfile="$2" bak; bak=$(mktemp)
  cp "$conf" "$bak"; cp "$newfile" "$conf"
  if ! nginx -t >> "$CLI_LOG" 2>&1; then
    cp "$bak" "$conf"; rm -f "$bak" "$newfile"
    die "The web server rejected the change for $(basename "$conf"); it was reverted."
  fi
  rm -f "$bak" "$newfile"
  systemctl reload nginx >> "$CLI_LOG" 2>&1
}

# Replace the FIRST top-level `server { … }` block (always the port-80 block in
# AidiPanel vhosts) with the contents of $blockfile. Brace-aware so nested
# location/if blocks toggle cleanly between redirect and serve forms.
_vhost_replace_first_server() {
  local conf="$1" blockfile="$2" tmp; tmp=$(mktemp)
  awk -v bf="$blockfile" '
    BEGIN { depth=0; inblock=0; done=0 }
    !done && !inblock && /^server[[:space:]]*\{/ {
      inblock=1
      depth += gsub(/\{/,"{") - gsub(/\}/,"}")
      while ((getline l < bf) > 0) print l
      close(bf)
      if (depth<=0) { inblock=0; done=1 }
      next
    }
    inblock {
      depth += gsub(/\{/,"{") - gsub(/\}/,"}")
      if (depth<=0) { inblock=0; done=1 }
      next
    }
    { print }
  ' "$conf" > "$tmp" && cp "$tmp" "$conf"
  rm -f "$tmp"
}

# Port-80 block, redirect form (Force HTTPS = on): bounce everything to https,
# keeping the ACME challenge path reachable for certbot.
_vhost_port80_redirect() {
  local domain="$1"
  cat <<REDIR
server {
    listen 80;
    listen [::]:80;
    server_name ${domain} www.${domain};

    # ACME challenge for Let's Encrypt
    location /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 301 https://\$host\$request_uri; }
}
REDIR
}

# Port-80 block, serve form (Force HTTPS = off): also answer plain HTTP. Built
# from the live vhost's own facts (type/root/index/socket) so it tracks the
# real site. Keep the essentials in sync with _site_write_vhost's 443 block.
_vhost_port80_serve() {
  local domain="$1" conf="$2"
  local type webroot index sock
  type=$(grep -oP '# Type: \K\w+' "$conf" 2>/dev/null || echo php)
  webroot=$(awk '/^[[:space:]]*root[[:space:]]/{print $2; exit}' "$conf" | tr -d ';')
  index=$(awk '/^[[:space:]]*index[[:space:]]/{sub(/^[[:space:]]*index[[:space:]]+/,""); sub(/;[[:space:]]*$/,""); print; exit}' "$conf")
  [[ -n "$index" ]] || index="index.php index.html"
  sock=$(grep -oP 'fastcgi_pass[[:space:]]+unix:\K[^;]+' "$conf" 2>/dev/null | head -1)

  local body
  if [[ "$type" == "proxy" ]]; then
    local proxy_pass; proxy_pass=$(grep -oP 'proxy_pass[[:space:]]+\K\S+' "$conf" 2>/dev/null | head -1 | tr -d ';')
    body=$(cat <<PROXY
    location / {
        proxy_pass         ${proxy_pass};
        proxy_http_version 1.1;
        proxy_set_header   Upgrade \$http_upgrade;
        proxy_set_header   Connection 'upgrade';
        proxy_set_header   Host \$host;
        proxy_set_header   X-Real-IP \$remote_addr;
        proxy_set_header   X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto \$scheme;
        proxy_cache_bypass \$http_upgrade;
    }
PROXY
)
  else
    local try="try_files \$uri \$uri/ =404;"
    [[ "$type" == "wordpress" ]] && try="try_files \$uri \$uri/ /index.php?\$args;"
    local php_loc=""
    if [[ "$type" != "static" && -n "$sock" ]]; then
      php_loc=$(cat <<PHPL

    location ~ \.php\$ {
        try_files \$uri =404;
        fastcgi_split_path_info ^(.+\.php)(/.+)\$;
        fastcgi_pass unix:${sock};
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME \$document_root\$fastcgi_script_name;
        include fastcgi_params;
    }
PHPL
)
    fi
    local wp_deny=""
    if [[ "$type" == "wordpress" ]]; then
      wp_deny=$(cat <<'WPD'

    location ~ ^/(wp-config\.php|xmlrpc\.php|wp-cron\.php)$ { deny all; }
    location ~* /(?:uploads|files)/.*\.php$ { deny all; }
WPD
)
    fi
    body=$(cat <<MAIN
    location / {
        ${try}
    }${wp_deny}${php_loc}
MAIN
)
  fi

  cat <<SERVE
server {
    listen 80;
    listen [::]:80;
    server_name ${domain} www.${domain};

    root ${webroot};
    index ${index};

    # ACME challenge for Let's Encrypt
    location /.well-known/acme-challenge/ { root /var/www/letsencrypt; }

    # Deny hidden files
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

${body}
}
SERVE
}

_ssl_force_https() {
  _require_root "ssl:force-https"
  _parse_opts "$@"
  local domain action conf
  domain=$(_opt "domain"); action=$(_opt "action")
  _require_arg "domain" "$domain" "ssl:force-https --domain example.com --action on"
  _require_arg "action" "$action" "ssl:force-https --domain example.com --action on|off"
  _domain_valid "$domain"  || die "Invalid domain name: ${domain}"
  _domain_exists "$domain" || die "Site not found: ${domain}"
  [[ "$action" == "on" || "$action" == "off" ]] || die "Action must be 'on' or 'off'."
  if [[ "$action" == "off" ]] && _security_enabled "$domain"; then
    die "Disable HTTP Basic Authentication before turning Force HTTPS off."
  fi
  conf="${NGINX_CONF_DIR}/${domain}.conf"
  [[ -f "$conf" ]] || die "Vhost not found: ${conf}"

  local blockfile newconf; blockfile=$(mktemp); newconf=$(mktemp)
  if [[ "$action" == "on" ]]; then
    _vhost_port80_redirect "$domain" > "$blockfile"
  else
    _vhost_port80_serve "$domain" "$conf" > "$blockfile"
  fi
  cp "$conf" "$newconf"
  _vhost_replace_first_server "$newconf" "$blockfile"
  rm -f "$blockfile"
  _vhost_commit "$conf" "$newconf"
  ok "Force HTTPS turned ${action} for ${domain}"
}

_ssl_hsts() {
  _require_root "ssl:hsts"
  _parse_opts "$@"
  local domain action conf
  domain=$(_opt "domain"); action=$(_opt "action")
  _require_arg "domain" "$domain" "ssl:hsts --domain example.com --action on"
  _require_arg "action" "$action" "ssl:hsts --domain example.com --action on|off"
  _domain_valid "$domain"  || die "Invalid domain name: ${domain}"
  _domain_exists "$domain" || die "Site not found: ${domain}"
  [[ "$action" == "on" || "$action" == "off" ]] || die "Action must be 'on' or 'off'."
  conf="${NGINX_CONF_DIR}/${domain}.conf"
  [[ -f "$conf" ]] || die "Vhost not found: ${conf}"

  local newconf; newconf=$(mktemp); cp "$conf" "$newconf"
  local hsts='add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;'
  # Use '|' as the sed delimiter: the comment marker '#' appears in the replacement.
  if [[ "$action" == "off" ]]; then
    # Comment any active HSTS line (idempotent: already-commented lines won't match).
    sed -E -i 's|^([[:space:]]*)(add_header[[:space:]]+Strict-Transport-Security.*)|\1# \2|' "$newconf"
  else
    # Uncomment a commented HSTS line; if none exists at all, inject one in the 443 block.
    sed -E -i 's|^([[:space:]]*)#[[:space:]]*(add_header[[:space:]]+Strict-Transport-Security.*)|\1\2|' "$newconf"
    if ! grep -Eq '^[[:space:]]*add_header[[:space:]]+Strict-Transport-Security' "$newconf"; then
      sed -E -i "s|^([[:space:]]*)(ssl_session_timeout[[:space:]].*)|\1\2\n\1${hsts}|" "$newconf"
    fi
  fi
  _vhost_commit "$conf" "$newconf"
  ok "HSTS turned ${action} for ${domain}"
}

_ssl_autorenew() {
  _parse_opts "$@"
  local domain action
  domain=$(_opt "domain"); action=$(_opt "action")
  _require_arg "domain" "$domain" "ssl:autorenew --domain example.com --action on"
  _require_arg "action" "$action" "ssl:autorenew --domain example.com --action on|off|status"
  _domain_valid "$domain" || die "Invalid domain name: ${domain}"
  local renewal="/etc/letsencrypt/renewal/${domain}.conf"
  local disabled="${renewal}.disabled"

  if [[ "$action" == "status" ]]; then
    if [[ -f "$renewal" ]]; then echo "on"
    elif [[ -f "$disabled" ]]; then echo "off"
    else echo "none"; fi
    return 0
  fi

  _require_root "ssl:autorenew"
  _domain_exists "$domain" || die "Site not found: ${domain}"
  [[ "$action" == "on" || "$action" == "off" ]] || die "Action must be 'on', 'off' or 'status'."
  [[ -f "$renewal" || -f "$disabled" ]] || die "No Let's Encrypt certificate to manage for ${domain}."

  # Disabling moves the renewal config aside so the global `certbot renew` skips
  # just this site; enabling moves it back. Mirror the state into a vhost marker
  # so the panel (www-data) can show it without reading the root-only renewal dir.
  if [[ "$action" == "off" ]]; then
    [[ -f "$renewal" ]] && mv "$renewal" "$disabled"
  else
    [[ -f "$disabled" ]] && mv "$disabled" "$renewal"
  fi
  local conf="${NGINX_CONF_DIR}/${domain}.conf"
  [[ -f "$conf" ]] && _vhost_marker_set "$conf" "AUTORENEW" "$action"
  ok "Auto-renew turned ${action} for ${domain}"
}

# Machine-readable status for the panel's "Run SSL check". One JSON line.
_ssl_check() {
  _parse_opts "$@"
  local domain; domain=$(_opt "domain")
  _require_arg "domain" "$domain" "ssl:check --domain example.com"
  _domain_valid "$domain" || die "Invalid domain name: ${domain}"
  local conf="${NGINX_CONF_DIR}/${domain}.conf"

  # Prefer the certificate actually wired into the vhost (ssl_certificate), so the
  # reported state follows "Use this cert" switches instead of file priority.
  local state="none" certfile="" wired=""
  if [[ -f "$conf" ]]; then
    wired=$(grep -E '^[[:space:]]*ssl_certificate[[:space:]]' "$conf" 2>/dev/null | head -1 \
            | sed -E 's/^[[:space:]]*ssl_certificate[[:space:]]+([^;]+);.*/\1/' | tr -d '[:space:]')
  fi
  if [[ "$wired" == "/etc/letsencrypt/live/${domain}/fullchain.pem" ]]; then
    state="letsencrypt"; certfile="$wired"
  elif [[ "$wired" == "/etc/ssl/aidipanel-custom/${domain}/fullchain.pem" ]]; then
    state="custom"; certfile="$wired"
  elif [[ "$wired" == "/etc/ssl/aidipanel-self/${domain}.crt" ]]; then
    state="self-signed"; certfile="$wired"
  elif [[ -f "/etc/letsencrypt/live/${domain}/fullchain.pem" ]]; then
    state="letsencrypt"; certfile="/etc/letsencrypt/live/${domain}/fullchain.pem"
  elif [[ -f "/etc/ssl/aidipanel-custom/${domain}/fullchain.pem" ]]; then
    state="custom"; certfile="/etc/ssl/aidipanel-custom/${domain}/fullchain.pem"
  elif [[ -f "/etc/ssl/aidipanel-self/${domain}.crt" ]]; then
    state="self-signed"; certfile="/etc/ssl/aidipanel-self/${domain}.crt"
  fi

  local expiry="" days=0 issuer="" trusted="false"
  if [[ -n "$certfile" ]]; then
    local end; end=$(openssl x509 -enddate -noout -in "$certfile" 2>/dev/null | cut -d= -f2)
    if [[ -n "$end" ]]; then
      expiry=$(date -d "$end" '+%Y-%m-%d' 2>/dev/null || echo "")
      days=$(( ( $(date -d "$end" +%s 2>/dev/null || echo 0) - $(date +%s) ) / 86400 ))
    fi
    issuer=$(openssl x509 -issuer -noout -in "$certfile" 2>/dev/null | sed -E 's/^issuer=//')
    issuer="${issuer//\"/}"; issuer="${issuer//\\/}"
    [[ "$state" != "self-signed" && "$days" -gt 0 ]] && trusted="true"
  fi

  local force_https="off" hsts="off" autorenew="none"
  if [[ -f "$conf" ]]; then
    grep -q 'return 301 https' "$conf" 2>/dev/null && force_https="on"
    grep -Eq '^[[:space:]]*add_header[[:space:]]+Strict-Transport-Security' "$conf" 2>/dev/null && hsts="on"
  fi
  if [[ -f "/etc/letsencrypt/renewal/${domain}.conf" ]]; then autorenew="on"
  elif [[ -f "/etc/letsencrypt/renewal/${domain}.conf.disabled" ]]; then autorenew="off"; fi

  printf '{"domain":"%s","state":"%s","expiry":"%s","days_left":%s,"issuer":"%s","trusted":%s,"force_https":"%s","hsts":"%s","auto_renew":"%s"}\n' \
    "$domain" "$state" "$expiry" "$days" "$issuer" "$trusted" "$force_https" "$hsts" "$autorenew"
}

# Switch the vhost to an already-present certificate (Let's Encrypt / imported /
# self-signed). Drives the certificates table's "Use this cert" action.
_ssl_use() {
  _require_root "ssl:use"
  _parse_opts "$@"
  local domain type; domain=$(_opt "domain"); type=$(_opt "type")
  _require_arg "domain" "$domain" "ssl:use --domain example.com --type letsencrypt"
  _require_arg "type"   "$type"   "ssl:use --domain example.com --type letsencrypt|custom|self-signed"
  _domain_valid "$domain"  || die "Invalid domain name: ${domain}"
  _domain_exists "$domain" || die "Site not found: ${domain}"
  local fullchain privkey
  case "$type" in
    letsencrypt) fullchain="/etc/letsencrypt/live/${domain}/fullchain.pem"; privkey="/etc/letsencrypt/live/${domain}/privkey.pem" ;;
    custom)      fullchain="/etc/ssl/aidipanel-custom/${domain}/fullchain.pem"; privkey="/etc/ssl/aidipanel-custom/${domain}/privkey.pem" ;;
    self-signed) fullchain="/etc/ssl/aidipanel-self/${domain}.crt"; privkey="/etc/ssl/aidipanel-self/${domain}.key" ;;
    *) die "Unknown certificate type: ${type}" ;;
  esac
  [[ -f "$fullchain" && -f "$privkey" ]] || die "No ${type} certificate is available for ${domain}."
  _ssl_point_vhost "$domain" "$fullchain" "$privkey"
  ok "Now using the ${type} certificate for ${domain}"
}

