# ---------------------------------------------------------------------------
# PARSE OPTIONS — returns assoc array of key=value pairs from --key value args
# ---------------------------------------------------------------------------
declare -A OPTS=()

_parse_opts() {
  # Parses --key value pairs from "$@" into global OPTS[]
  OPTS=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --*)
        local key="${1#--}"
        if [[ $# -gt 1 && "${2:-}" != --* ]]; then
          OPTS["$key"]="${2}"
          shift 2
        else
          OPTS["$key"]="true"
          shift
        fi
        ;;
      *)
        # Positional argument stored as "arg"
        OPTS["arg"]="${OPTS[arg]:-} $1"
        shift
        ;;
    esac
  done
}

_opt() {
  # Get option value with optional default
  local key="$1" default="${2:-}"
  echo "${OPTS[$key]:-$default}"
}

# ===========================================================================
# SITE COMMANDS
# ===========================================================================

_site_add() {
  _require_root "site:add"
  _parse_opts "$@"

  local domain php_ver site_type site_user
  domain=$(_opt "domain"); php_ver=$(_opt "php" "${PHP_DEFAULT_VERSION}"); site_type=$(_opt "type" "php")
  site_user=$(_opt "user" "")

  # WordPress provisioning options (only used for --type wordpress)
  local wp_title wp_admin_user wp_admin_pass wp_admin_email wp_multisite
  wp_title=$(_opt "wp-title" ""); wp_admin_user=$(_opt "wp-admin-user" "admin")
  wp_admin_pass=$(_opt "wp-admin-pass" ""); wp_admin_email=$(_opt "wp-admin-email" "")
  wp_multisite=$(_opt "wp-multisite" "off")

  _require_arg "domain" "$domain" "site:add --domain example.com --user example --type wordpress"

  # Validate
  _domain_valid "$domain" || die "Invalid domain name: ${domain}"
  _domain_exists "$domain" && die "Site already exists: ${domain}"
  _php_version_valid "$php_ver" || die "Invalid PHP version: ${php_ver}. Supported: ${PHP_VERSIONS_SUPPORTED[*]}"

  [[ "$site_type" =~ ^(wordpress|php|laravel|static|proxy)$ ]] \
    || die "Invalid site type: ${site_type}. Supported: wordpress, php, laravel, static, proxy"

  # WordPress: validate multisite mode (subdomain deferred — needs wildcard SSL), and
  # when admin details are supplied, validate the install fields + WP-CLI availability.
  local wp_do_install=0
  if [[ "$site_type" == "wordpress" ]]; then
    case "$wp_multisite" in
      off|subdir) ;;
      subdomain) die "Subdomain multisite needs wildcard SSL (DNS-01), not supported yet. Use --wp-multisite subdir." ;;
      *) die "Invalid --wp-multisite '${wp_multisite}'. Use: off or subdir." ;;
    esac
    if [[ -n "$wp_admin_email" ]]; then
      wp_do_install=1
      [[ -n "$wp_title" ]]      || die "WordPress install requires --wp-title."
      [[ -n "$wp_admin_user" ]] || die "WordPress install requires --wp-admin-user."
      [[ -n "$wp_admin_pass" ]] || die "WordPress install requires --wp-admin-pass."
      [[ "$wp_admin_email" =~ ^[^@[:space:]]+@[^@[:space:]]+\.[^@[:space:]]+$ ]] \
        || die "Invalid --wp-admin-email: ${wp_admin_email}"
      command -v wp >/dev/null 2>&1 || die "WP-CLI not installed; cannot install WordPress (install.sh installs it)."
    fi
  fi

  # --user is optional; derive a unique suggestion from the domain when absent.
  [[ -z "$site_user" ]] && site_user=$(_unique_site_user "$(_suggest_site_user "$domain")")
  _validate_site_user "$site_user"
  id "$site_user" &>/dev/null && die "Site user already exists: ${site_user} (pass a different --user)."

  # Auto-install the requested PHP version on demand if it is missing (Patch C).
  # Runs BEFORE the rollback ledger below, so a failed install dies cleanly with
  # no half-created site. _ensure_php_version is idempotent and validates the version.
  if ! _php_installed "$php_ver"; then
    _progress 5 php_install "Installing PHP ${php_ver}"
    log "PHP ${php_ver} not installed — installing it first (this may take 1-2 minutes)..."
    _ensure_php_version "$php_ver"
  fi
  [[ -w "$HOME_BASE" ]] || die "${HOME_BASE} is not writable."

  log "Creating site: ${domain} (user: ${site_user}, type: ${site_type}, PHP: ${php_ver})..."
  local webroot="${HOME_BASE}/${site_user}/htdocs/${domain}"

  # Rollback ledger
  DID_CREATE_USER=0
  local created_home=0 wrote_pool=0 wrote_vhost=0 enabled=0 wrote_snippet=0 wrote_db=0
  local db_name="" db_user="" db_pass=""
  _site_add_rollback() {
    [[ "$wrote_db"     == 1 ]] && _db_deprovision "$db_name" "$db_user"
    [[ "$enabled"      == 1 ]] && rm -f "${NGINX_ENABLED_DIR}/${domain}.conf"
    [[ "$wrote_vhost"  == 1 ]] && rm -f "${NGINX_CONF_DIR}/${domain}.conf"
    [[ "$wrote_snippet" == 1 ]] && rm -f "$(_cache_snippet_path "$domain")"
    [[ "$wrote_pool"   == 1 ]] && _remove_fpm_pool "$site_user" "$php_ver"
    if [[ "$DID_CREATE_USER" == 1 ]]; then
      _remove_site_user "$site_user"   # user + home + its (otherwise-orphan) group
    elif [[ "$created_home" == 1 ]]; then
      rm -rf "${HOME_BASE}/${site_user}/htdocs/${domain}"
    fi
    systemctl reload nginx >> "$CLI_LOG" 2>&1 || true
  }

  _progress 12 create_user "Creating site user"
  _ensure_site_user "$site_user"            || { _site_add_rollback; die "Could not create site user '${site_user}'."; }
  _site_make_layout "$site_user" "$domain" "$webroot"; created_home=1
  _site_grant_web_access "$site_user"       || { _site_add_rollback; die "Could not grant web access for '${site_user}'."; }
  _progress 25 php_pool "Configuring PHP-FPM pool"
  _write_fpm_pool "$site_user" "$php_ver"   || { _site_add_rollback; die "PHP-FPM pool creation failed."; }
  wrote_pool=1
  _progress 35 vhost "Writing nginx configuration"
  _site_write_vhost "$domain" "$php_ver" "$webroot" "$site_type" "$site_user" "$wp_multisite"; wrote_vhost=1

  # New sites carry only a self-signed cert until the user installs Let's Encrypt,
  # so don't force HTTPS yet — keep plain http serving so visitors don't hit an
  # untrusted-cert warning (HSTS is likewise shipped off in the template). Both are
  # one-click panel toggles once a trusted cert is in place. Reuse the same serve
  # block builder as `ssl:force-https off`; keep the redirect if it yields nothing.
  local _p80; _p80=$(mktemp)
  if _vhost_port80_serve "$domain" "${NGINX_CONF_DIR}/${domain}.conf" > "$_p80" && [[ -s "$_p80" ]]; then
    _vhost_replace_first_server "${NGINX_CONF_DIR}/${domain}.conf" "$_p80"
  fi
  rm -f "$_p80"

  # Create per-site cache snippet (cache OFF by default; enables on cache:enable)
  _cache_snippet_write "$domain" "1h" \
    "$(_cache_default_exclude_urls)" \
    "$(_cache_baseline_cookies)" \
    "off" "off" "on"
  wrote_snippet=1

  ln -sf "${NGINX_CONF_DIR}/${domain}.conf" "${NGINX_ENABLED_DIR}/${domain}.conf"; enabled=1

  # nginx -t validates ALL enabled vhosts; on failure roll back THIS site so one
  # broken vhost can't make every future site:add fail.
  _progress 45 nginx "Testing and reloading nginx"
  if ! nginx -t >> "$CLI_LOG" 2>&1; then
    _site_add_rollback
    die "The web server rejected the configuration for ${domain}; the site was rolled back."
  fi
  systemctl reload nginx >> "$CLI_LOG" 2>&1
  ok "Site created: ${domain}"

  # --- WordPress provisioning (only when admin details were supplied) ---
  local wp_installed=0
  if [[ "$wp_do_install" == 1 ]]; then
    # Derive a shell/SQL-safe DB identity from the (unique) site user, using the
    # SAME "<site_user>_" prefix the Database tab scopes by (see _db_site_prefix),
    # so a site's WordPress database + user show up in — and are managed by — its
    # tab. The user is capped at 29 + "_wp" to respect MySQL's 32-char user limit;
    # the database name (64-char limit) keeps the full prefix so it always matches.
    local _s; _s=$(printf '%s' "$site_user" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_' '_')
    db_user="${_s:0:29}_wp"; db_name="${_s}_wp"
    db_pass=$(openssl rand -base64 18 | tr -dc 'A-Za-z0-9' | head -c 24)
    _progress 55 database "Provisioning database"
    log "Provisioning database for WordPress: ${db_name} (user: ${db_user})..."
    _db_provision "$db_name" "$db_user" "$db_pass" \
      || { _site_add_rollback; die "Database provisioning failed for ${domain}."; }
    _db_secret_put "$domain" "$db_name" "$db_user" "$db_pass" \
      || { _site_add_rollback; die "Could not store the encrypted database credential for ${domain}."; }
    wrote_db=1
    _progress 60 wp_setup "Setting up WordPress"
    log "Installing WordPress (${domain}, multisite=${wp_multisite})..."
    if ! _site_install_wordpress "$domain" "$site_user" "$webroot" "$wp_multisite" \
         "$wp_title" "$wp_admin_user" "$wp_admin_pass" "$wp_admin_email" \
         "$db_name" "$db_user" "$db_pass"; then
      _site_add_rollback
      die "WordPress installation failed for ${domain}; the half-created site was rolled back. Please try again."
    fi
    wp_installed=1
    ok "WordPress installed: ${domain}"
  fi

  _progress 100 "done" "Done"
  # Machine-readable summary for the Panel (Patch 2). The CLI writes NO DB state.
  local sock; sock=$(_site_php_sock "$php_ver" "$site_user")
  echo "site_user=${site_user}"
  echo "web_root=${webroot}"
  echo "pool=${site_user}"
  echo "socket=${sock}"
  echo "php_version=${php_ver}"
  if [[ "$wp_installed" == 1 ]]; then
    echo "wp_installed=1"
    echo "wp_multisite=${wp_multisite}"
    echo "db_name=${db_name}"
    echo "db_user=${db_user}"
    echo "admin_url=https://${domain}/wp-admin"
  fi
}

_site_write_vhost() {
  local domain="$1" php_ver="$2" webroot="$3" site_type="$4" site_user="$5" wp_multisite="${6:-off}"
  local sock; sock=$(_site_php_sock "$php_ver" "$site_user")
  local conf_file="${NGINX_CONF_DIR}/${domain}.conf"

  # Self-signed cert FIRST — the HTTPS vhost below references it, so if cert
  # generation fails we bail before writing a vhost that nginx -t can't load.
  # (-s checks non-empty: also recovers from a half-written cert left by a
  # previously failed attempt.)
  local self_ssl_dir="/etc/ssl/aidipanel-self"
  mkdir -p "$self_ssl_dir"
  if [[ ! -s "${self_ssl_dir}/${domain}.crt" || ! -s "${self_ssl_dir}/${domain}.key" ]]; then
    if ! openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
      -keyout "${self_ssl_dir}/${domain}.key" \
      -out    "${self_ssl_dir}/${domain}.crt" \
      -subj   "/CN=${domain}" >> "$CLI_LOG" 2>&1; then
      die "Failed to generate self-signed certificate for ${domain}"
    fi
  fi

  # Choose index based on type
  local index="index.php index.html"
  [[ "$site_type" == "static" ]] && index="index.html index.htm"

  # PHP location block — empty for static sites
  local php_location=""
  if [[ "$site_type" != "static" && "$site_type" != "proxy" ]]; then
    php_location=$(cat <<PHPLOC

    # FastCGI cache bypass rules
    include ${NGINX_SNIPPET_DIR}/cache-${domain}.conf;

    # PHP handler with FastCGI cache
    location ~ \.php\$ {
        try_files \$uri =404;
        fastcgi_split_path_info ^(.+\.php)(/.+)\$;
        fastcgi_pass unix:${sock};
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME \$document_root\$fastcgi_script_name;
        include fastcgi_params;

        #fastcgi_cache        ${NGINX_CACHE_ZONE};
        # AidiPanel caches public 404 responses for 60 seconds when the FastCGI
        # page cache is enabled. This short TTL absorbs repeated bot/scanner probes
        # without keeping stale 404s for long. Server errors are never cached —
        # only the codes listed below are.
        #fastcgi_cache_valid  200 301 302 1h;
        #fastcgi_cache_valid  404 1m;
        #fastcgi_cache_use_stale error timeout updating http_500 http_503;
        #fastcgi_cache_bypass \$skip_cache;
        #fastcgi_no_cache     \$skip_cache;

        fastcgi_connect_timeout 60s;
        fastcgi_send_timeout    180s;
        fastcgi_read_timeout    180s;
        fastcgi_buffer_size     64k;
        fastcgi_buffers         8 128k;
    }
PHPLOC
)
  fi

  # Laravel: point root to /public
  [[ "$site_type" == "laravel" ]] && webroot="${webroot}/public"

  # Proxy upstream
  local proxy_block=""
  if [[ "$site_type" == "proxy" ]]; then
    local proxy_pass; proxy_pass=$(_opt "proxy-pass" "http://127.0.0.1:3000")
    _proxy_url_valid "$proxy_pass" || die "Invalid reverse proxy URL: ${proxy_pass}"
    proxy_block=$(cat <<PROXYBLK

    location / {
        proxy_pass         ${proxy_pass};
        proxy_http_version 1.1;
        proxy_set_header   Upgrade \$http_upgrade;
        proxy_set_header   Connection 'upgrade';
        proxy_set_header   Host \$host;
        proxy_set_header   X-Real-IP \$remote_addr;
        proxy_set_header   X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto \$scheme;
        proxy_cache_bypass \$http_upgrade;
    }
PROXYBLK
)
  fi

  # WordPress try_files vs default
  local try_files="try_files \$uri \$uri/ =404;"
  [[ "$site_type" == "wordpress" ]] && try_files="try_files \$uri \$uri/ /index.php?\$args;"

  # Main `location /` block. Proxy supplies its OWN `location /` (proxy_pass)
  # via $proxy_block, so skip this one for proxy — otherwise the vhost ends up
  # with two `location /` and nginx -t fails: duplicate location "/".
  local main_location=""
  if [[ "$site_type" != "proxy" ]]; then
    main_location=$(cat <<MAINLOC

    # Main location
    location / {
        ${try_files}
    }
MAINLOC
)
  fi

  # WordPress-specific deny block (pre-computed, used inside heredoc)
  local wp_deny_block=""
  if [[ "$site_type" == "wordpress" ]]; then
    wp_deny_block=$(cat <<'WPDENY'

    # Deny access to sensitive WordPress files
    location ~ ^/(wp-config\.php|xmlrpc\.php|wp-cron\.php)$ { deny all; }
    location ~* /(?:uploads|files)/.*\.php$ { deny all; }
WPDENY
)
  fi

  # WordPress subdirectory-multisite network rewrites (server scope). Subdomain mode is
  # intentionally NOT emitted — it needs wildcard SSL (deferred).
  local wp_multisite_block=""
  if [[ "$site_type" == "wordpress" && "$wp_multisite" == "subdir" ]]; then
    wp_multisite_block=$(cat <<'WPMS'

    # WordPress subdirectory multisite
    if (!-e $request_filename) {
        rewrite /wp-admin$ $scheme://$host$uri/ permanent;
        rewrite ^(/[^/]+)?(/wp-.*) $2 last;
        rewrite ^(/[^/]+)?(/.*\.php) $2 last;
    }
WPMS
)
  fi

  cat > "$conf_file" <<VHOST
# AidiPanel — ${domain}
# Type: ${site_type} | PHP: ${php_ver}
# Created: $(date '+%Y-%m-%d %H:%M:%S')

server {
    listen 80;
    listen [::]:80;
    server_name ${domain} www.${domain};

    # ACME challenge for Let's Encrypt
    location /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 301 https://\$host\$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${domain} www.${domain};

    root ${webroot};
    index ${index};

    # SSL — will be configured by: aidipanel ssl:install --domain ${domain}
    ssl_certificate     /etc/ssl/aidipanel-self/${domain}.crt;
    ssl_certificate_key /etc/ssl/aidipanel-self/${domain}.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL_${domain}:10m;
    ssl_session_timeout 1d;

    # Security headers (HSTS shipped off until a trusted cert is installed — toggle in panel)
    # add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options    "nosniff" always;
    add_header X-Frame-Options           "SAMEORIGIN" always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;

    # Cache-status debug header at SERVER scope on purpose: nginx add_header does
    # not merge across levels, so putting it inside `location ~ \.php$` would
    # suppress every security header above for PHP/WordPress responses. Empty
    # value unless the FastCGI page cache is enabled.
    add_header X-FastCGI-Cache \$upstream_cache_status always;

    # Static file caching
    location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg|woff|woff2|ttf|eot|webp|avif|mp4|webm)\$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        # This location's own add_header suppresses the inherited security headers,
        # so repeat the one that actually matters for assets: nosniff stops the
        # browser MIME-sniffing CSS/JS/SVG/uploads. HSTS (already host-wide once the
        # document sets it), X-Frame-Options and Referrer-Policy add nothing on
        # assets, so they are intentionally not duplicated here.
        add_header X-Content-Type-Options "nosniff" always;
        access_log off;
        log_not_found off;
    }

    # Deny hidden files
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
${wp_deny_block}
${main_location}
${wp_multisite_block}
${php_location}
${proxy_block}

    # Logs
    access_log /var/log/nginx/${domain}-access.log main;
    error_log  /var/log/nginx/${domain}-error.log warn;
}
VHOST
}

# Install WordPress into an already-created site, run as the site user via WP-CLI.
# Passwords are fed over stdin (--prompt) so they never appear in the process list.
# Returns non-zero on any failure so the caller can roll back; detail goes to CLI_LOG.
_site_install_wordpress() {
  local domain="$1" site_user="$2" webroot="$3" multisite="$4"
  local wp_title="$5" wp_admin_user="$6" wp_admin_pass="$7" wp_admin_email="$8"
  local db_name="$9" db_user="${10}" db_pass="${11}"

  local cache_dir="/tmp/aidipanel-wp-cli-cache"
  mkdir -p "$cache_dir"
  chown "${site_user}:${site_user}" "$cache_dir" 2>/dev/null || true
  local wp=(sudo -u "$site_user" -- env "WP_CLI_CACHE_DIR=${cache_dir}" wp --path="$webroot")

  _progress 65 wp_download "Downloading WordPress core"
  # 1. Download core (idempotent)
  if [[ ! -f "${webroot}/wp-load.php" ]]; then
    "${wp[@]}" core download --version=latest >> "$CLI_LOG" 2>&1 \
      || { warn "wp core download failed"; return 1; }
  fi

  _progress 85 wp_config "Writing wp-config.php"
  # 2. wp-config.php — salts auto-generated; DB password via stdin, not argv.
  printf '%s\n' "$db_pass" | "${wp[@]}" config create \
    --dbname="$db_name" --dbuser="$db_user" --dbhost=localhost --force --prompt=dbpass \
    >> "$CLI_LOG" 2>&1 || { warn "wp config create failed"; return 1; }

  _progress 90 wp_install "Installing WordPress"
  # 3. Install (single or subdirectory network). Admin password via stdin.
  local -a subcmd checkargs
  if [[ "$multisite" == "subdir" ]]; then
    subcmd=(core multisite-install); checkargs=(core is-installed --network)
  else
    subcmd=(core install);           checkargs=(core is-installed)
  fi
  printf '%s\n' "$wp_admin_pass" | "${wp[@]}" "${subcmd[@]}" \
    --url="https://${domain}" --title="$wp_title" --admin_user="$wp_admin_user" \
    --admin_email="$wp_admin_email" --skip-email --prompt=admin_password \
    >> "$CLI_LOG" 2>&1 || { warn "wp ${subcmd[*]} failed"; return 1; }

  _progress 97 wp_verify "Verifying installation"
  # 4. Verify
  "${wp[@]}" "${checkargs[@]}" >> "$CLI_LOG" 2>&1 \
    || { warn "WordPress not installed after setup"; return 1; }

  return 0
}

# Validate the .aidipanel-managed marker before a destructive purge. return 1 to refuse.
_site_purge_guard() {
  local domain="$1" site_user="$2" expect_user="$3"
  [[ -n "$site_user" ]] || { warn "No site_user resolved for ${domain}."; return 1; }
  local marker="${HOME_BASE}/${site_user}/.aidipanel-managed"
  [[ -f "$marker" ]] || { warn "Marker missing: ${marker}"; return 1; }
  [[ "$(stat -c '%U:%G' "$marker" 2>/dev/null)" == "root:root" ]] \
    || { warn "Marker not root-owned (site-user may have replaced it) — refusing purge."; return 1; }
  case "$(stat -c '%a' "$marker" 2>/dev/null)" in
    644|640|600|400) ;;
    *) warn "Marker has unsafe/writable mode — refusing purge."; return 1 ;;
  esac
  grep -q "\"domain\": \"${domain}\"" "$marker"       || { warn "Marker domain mismatch."; return 1; }
  grep -q "\"site_user\": \"${site_user}\"" "$marker" || { warn "Marker site_user mismatch."; return 1; }
  if [[ -n "$expect_user" && "$expect_user" != "$site_user" ]]; then
    warn "Marker user (${site_user}) != --user (${expect_user})."; return 1
  fi
  return 0
}

_site_delete() {
  _require_root "site:delete"
  _parse_opts "$@"
  local domain; domain=$(_opt "domain")
  _require_arg "domain" "$domain" "site:delete --domain example.com [--purge --yes]"
  _domain_valid "$domain" || die "Invalid domain name: ${domain}"
  _domain_exists "$domain" || die "Site not found: ${domain}"
  local purge yes force expect_user
  purge=$(_opt "purge" "false"); yes=$(_opt "yes" "false")
  force=$(_opt "force" "false"); expect_user=$(_opt "user" "")
  [[ "$force" == "true" ]] && yes="true"     # back-compat: --force == non-interactive (keep-home)

  # Resolve site_user from the vhost root (works for ALL types incl static/proxy);
  # php_ver from the FPM socket if present (none for static/proxy -> no pool).
  local conf="${NGINX_CONF_DIR}/${domain}.conf"
  local site_user php_ver
  site_user=$(grep -oP '^\s*root\s+/home/\K[^/;]+' "$conf" 2>/dev/null | head -1 || echo "")
  php_ver=$(grep -oP 'php\K[0-9.]+(?=-fpm)' "$conf" 2>/dev/null | head -1 || echo "")

  if [[ "$purge" == "true" ]]; then
    [[ "$yes" == "true" ]] || die "Refusing purge without --yes (no interactive TTY through the web wrapper)."
    _site_purge_guard "$domain" "$site_user" "$expect_user" || die "Purge refused for ${domain} (marker validation failed)."
  elif [[ "$yes" != "true" ]]; then
    echo -e "${RED}WARNING: removes vhost + PHP-FPM pool + databases for ${domain} (home kept).${RESET}"
    _confirm "Delete site '${domain}'?" || { log "Cancelled."; return 0; }
  fi

  # Teardown (both modes)
  _db_deprovision_site "$site_user" "$domain"
  rm -f "${NGINX_ENABLED_DIR}/${domain}.conf" "${NGINX_CONF_DIR}/${domain}.conf"
  rm -f "/etc/ssl/aidipanel-self/${domain}.crt" "/etc/ssl/aidipanel-self/${domain}.key"
  # Remove the per-site FPM pool. A site has exactly one pool (named by site_user);
  # sweep EVERY PHP version so a php_ver-resolution miss can't leave an orphan pool
  # that later makes `php-fpm -t` (and the whole service) fail for that version.
  if [[ -n "$site_user" ]]; then
    local _pool _pv
    for _pool in /etc/php/*/fpm/pool.d/"${site_user}".conf; do
      [[ -f "$_pool" ]] || continue
      _pv=$(printf '%s' "$_pool" | sed -n 's#^/etc/php/\([0-9.]\+\)/fpm/.*#\1#p')
      [[ -n "$_pv" ]] && _remove_fpm_pool "$site_user" "$_pv"
    done
  fi
  _cache_purge_domain "$domain" 2>/dev/null || true
  _nginx_test_reload

  if [[ "$purge" == "true" && -n "$site_user" ]]; then
    _remove_site_user "$site_user"   # user + home + its (otherwise-orphan) group
    ok "Site purged: ${domain} (user ${site_user} + home removed)"
  else
    [[ -n "$site_user" ]] && passwd -l "$site_user" >> "$CLI_LOG" 2>&1 || true
    ok "Site deleted: ${domain} (home kept; user ${site_user:-unknown} locked)"
  fi
}

_site_list() {
  _parse_opts "$@"
  local found=0

  echo ""
  printf "  ${BOLD}%-30s %-8s %-18s %-10s${RESET}\n" "Domain" "PHP" "Type" "SSL"
  _hr

  for conf in "${NGINX_CONF_DIR}"/*.conf; do
    [[ -f "$conf" ]] || continue
    [[ "$(basename "$conf")" == "aidipanel-ui.conf" ]] && continue

    local domain; domain=$(basename "$conf" .conf)
    local php_ver; php_ver=$(grep -oP 'php\K[0-9.]+(?=-fpm)' "$conf" 2>/dev/null | head -1 || echo "-")
    local site_type; site_type=$(grep -oP '# Type: \K\w+' "$conf" 2>/dev/null || echo "php")
    local ssl_status="self-signed"

    # Check if Let's Encrypt cert exists
    if [[ -f "/etc/letsencrypt/live/${domain}/fullchain.pem" ]]; then
      # Check expiry
      local expiry; expiry=$(openssl x509 -enddate -noout \
        -in "/etc/letsencrypt/live/${domain}/fullchain.pem" 2>/dev/null \
        | cut -d= -f2 || echo "unknown")
      ssl_status="LE (${expiry})"
    fi

    printf "  %-30s %-8s %-18s %-10s\n" "$domain" "$php_ver" "$site_type" "$ssl_status"
    (( found++ )) || true
  done

  _hr
  echo ""
  [[ $found -eq 0 ]] && info "No sites found. Add one: aidipanel site:add --domain example.com"
  echo "  Total: ${found} site(s)"
  echo ""
}

# Resolve a site's document root from its vhost. Anchors on the per-site-user
# /home/<user>/htdocs/<domain> root, skipping the /var/www/letsencrypt
# ACME-challenge root that SSL vhosts also contain. Echoes empty if none found.
_vhost_webroot() {
  grep -oP '^\s*root\s+\K/home/[^;]+' "$1" 2>/dev/null | head -1 | tr -d ' ' || true
}

_site_info() {
  _parse_opts "$@"
  local domain; domain=$(_opt "domain")
  _require_arg "domain" "$domain" "site:info --domain example.com"
  _domain_valid "$domain" || die "Invalid domain name: ${domain}"
  _domain_exists "$domain" || die "Site not found: ${domain}"

  local conf="${NGINX_CONF_DIR}/${domain}.conf"
  local php_ver; php_ver=$(grep -oP 'php\K[0-9.]+(?=-fpm)' "$conf" 2>/dev/null | head -1 || echo "-")
  local site_type; site_type=$(grep -oP '# Type: \K\w+' "$conf" 2>/dev/null || echo "php")
  local webroot; webroot=$(_vhost_webroot "$conf"); [[ -n "$webroot" ]] || webroot="-"
  local enabled; enabled=$([[ -L "${NGINX_ENABLED_DIR}/${domain}.conf" ]] && echo "yes" || echo "no")
  local disk_usage; disk_usage=$(du -sh "$webroot" 2>/dev/null | cut -f1 || echo "-")

  local ssl_type="self-signed"
  local ssl_expiry="-"
  if [[ -f "/etc/letsencrypt/live/${domain}/fullchain.pem" ]]; then
    ssl_type="Let's Encrypt"
    ssl_expiry=$(openssl x509 -enddate -noout \
      -in "/etc/letsencrypt/live/${domain}/fullchain.pem" 2>/dev/null \
      | cut -d= -f2 || echo "unknown")
  fi

  # FastCGI cache status
  local cache_enabled="disabled"
  grep -Eq "^[[:space:]]*fastcgi_cache[[:space:]]+${NGINX_CACHE_ZONE}" "$conf" 2>/dev/null && cache_enabled="enabled"

  echo ""
  echo -e "  ${BOLD}Site info: ${CYAN}${domain}${RESET}"
  _hr
  _table_row "Type:"            "$site_type"
  _table_row "PHP version:"     "$php_ver"
  _table_row "Webroot:"         "$webroot"
  _table_row "Nginx config:"    "$conf"
  _table_row "Enabled:"         "$enabled"
  _table_row "Disk usage:"      "$disk_usage"
  _table_row "FastCGI cache:"   "$cache_enabled"
  _table_row "SSL type:"        "$ssl_type"
  _table_row "SSL expiry:"      "$ssl_expiry"
  _hr
  echo ""
}

_vhost_save() {
  _require_root "vhost:save"
  _parse_opts "$@"
  local domain; domain=$(_opt "domain")
  local src_file; src_file=$(_opt "file")
  _require_arg "domain" "$domain" "vhost:save --domain example.com --file /path/to/new.conf"
  _require_arg "file" "$src_file" "vhost:save --domain example.com --file /path/to/new.conf"

  _domain_valid "$domain" || die "Invalid domain name: ${domain}"
  _domain_exists "$domain" || die "Site not found: ${domain}"
  [[ -f "$src_file" && -s "$src_file" && -r "$src_file" ]] || die "Config file is not readable: ${src_file}"

  local conf="${NGINX_CONF_DIR}/${domain}.conf"
  local backup; backup="${conf}.bak.$(date +%Y%m%d%H%M%S)"
  cp -p "$conf" "$backup"

  cp "$src_file" "$conf"
  chmod 644 "$conf"

  if ! nginx -t >> "$CLI_LOG" 2>&1; then
    cp "$backup" "$conf"
    nginx -t >> "$CLI_LOG" 2>&1 || true
    die "Nginx config test failed. Restored backup: ${backup}"
  fi

  systemctl reload nginx >> "$CLI_LOG" 2>&1 \
    || { cp "$backup" "$conf"; die "Nginx reload failed. Restored backup: ${backup}"; }

  ok "Vhost saved and Nginx reloaded: ${domain}"
  _table_row "Backup:" "$backup"
}

