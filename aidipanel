_db_add() {
  _require_root "db:add"
  _parse_opts "$@"
  local db_name; db_name=$(_opt "name")
  local db_user; db_user=$(_opt "user" "$db_name")
  local db_pass; db_pass=$(_opt "pass" "$(openssl rand -base64 16 | tr -dc 'A-Za-z0-9' | head -c 16)")
  local db_pass_sql; db_pass_sql=$(_sql_escape_literal "$db_pass")

  _require_arg "name" "$db_name" "db:add --name mydb --user myuser"

  # Validate: only alphanumeric and underscores
  [[ "$db_name" =~ ^[a-zA-Z0-9_]+$ ]] \
    || die "Database name must contain only letters, numbers, underscores"
  [[ "$db_user" =~ ^[a-zA-Z0-9_]+$ ]] \
    || die "Database user must contain only letters, numbers, underscores"
  [[ "$db_pass" =~ ^[A-Za-z0-9_!@#%+=.,:-]{8,128}$ ]] \
    || die "Database password must be 8-128 characters and contain only safe symbols"

  log "Creating database: ${db_name} (user: ${db_user})..."

  _mysql_exec "CREATE DATABASE IF NOT EXISTS \`${db_name}\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
  _mysql_exec "CREATE USER IF NOT EXISTS '${db_user}'@'localhost' IDENTIFIED BY '${db_pass_sql}';"
  _mysql_exec "GRANT ALL PRIVILEGES ON \`${db_name}\`.* TO '${db_user}'@'localhost';"
  _mysql_exec "FLUSH PRIVILEGES;"

  ok "Database created: ${db_name}"
  echo ""
  _table_row "Database:" "$db_name"
  _table_row "User:"     "$db_user"
  _table_row "Password:" "$db_pass"
  _table_row "Host:"     "localhost"
  echo ""
  warn "Save the password above — it will not be shown again."
}

_db_delete() {
  _require_root "db:delete"
  _parse_opts "$@"
  local db_name; db_name=$(_opt "name")
  _require_arg "name" "$db_name" "db:delete --name mydb"
  [[ "$db_name" =~ ^[a-zA-Z0-9_]+$ ]] \
    || die "Database name must contain only letters, numbers, underscores"
  local force; force=$(_opt "force" "false")

  [[ "$force" == "true" ]] || _confirm "Delete database '${db_name}' and its user '${db_name}'?" || { log "Cancelled."; return 0; }

  _mysql_exec "DROP DATABASE IF EXISTS \`${db_name}\`;"
  _mysql_exec "DROP USER IF EXISTS '${db_name}'@'localhost';"
  _mysql_exec "FLUSH PRIVILEGES;"
  ok "Database deleted: ${db_name}"
}

_db_list() {
  _parse_opts "$@"
  local plain; plain=$(_opt "plain" "false")
  if [[ "$plain" == "true" ]]; then
    _mysql_exec "SELECT schema_name FROM information_schema.schemata
      WHERE schema_name NOT IN ('information_schema','mysql','performance_schema','sys')
      ORDER BY schema_name;" 2>/dev/null | awk 'NR > 1 && NF { print $1 }'
    return 0
  fi

  echo ""
  echo -e "  ${BOLD}Databases${RESET}"
  _hr
  _mysql_exec "SELECT table_schema AS 'Database',
    ROUND(SUM(data_length + index_length) / 1024 / 1024, 2) AS 'Size (MB)',
    COUNT(table_name) AS 'Tables'
    FROM information_schema.tables
    WHERE table_schema NOT IN ('information_schema','mysql','performance_schema','sys')
    GROUP BY table_schema;" 2>/dev/null | column -t | sed 's/^/  /'
  _hr
  echo ""
}

_db_backup() {
  _require_root "db:backup"
  _parse_opts "$@"
  local db_name; db_name=$(_opt "name")
  local output_dir; output_dir=$(_opt "output" "/var/backups/aidipanel")
  _require_arg "name" "$db_name" "db:backup --name mydb"
  [[ "$db_name" =~ ^[a-zA-Z0-9_]+$ ]] \
    || die "Database name must contain only letters, numbers, underscores"

  _load_credentials
  mkdir -p "$output_dir"

  local backup_file="${output_dir}/${db_name}_$(date +%Y%m%d_%H%M%S).sql.gz"
  log "Backing up database: ${db_name} → ${backup_file}"

  mysqldump \
    --defaults-extra-file=<(printf '[client]\nuser=root\npassword=%s\n' "${MYSQL_ROOT_PASSWORD}") \
    --single-transaction \
    --quick \
    --lock-tables=false \
    "$db_name" \
    | gzip > "$backup_file"

  local size; size=$(du -sh "$backup_file" | cut -f1)
  ok "Backup created: ${backup_file} (${size})"
}

# ===========================================================================
# PHP COMMANDS
# ===========================================================================

_ensure_php_version() {
  local ver="$1"
  _php_version_valid "$ver" || die "Invalid PHP version: ${ver}. Supported: ${PHP_AVAILABLE_VERSIONS}"

  if [[ -f "/etc/php/${ver}/fpm/conf.d/99-aidipanel.ini" ]]; then
    ok "PHP ${ver} is already installed."
    return 0
  fi

  log "Installing PHP ${ver} on-demand (this may take 1-2 minutes)..."

  export DEBIAN_FRONTEND=noninteractive
  apt-get update -qq || true

  # Build the package list, skipping suffixes the repo does not ship for this
  # version (e.g. PHP 8.5 bundles OPcache into core, so php8.5-opcache is absent).
  # apt-get fails the whole transaction on one unlocatable package, so filter first.
  local pkgs=() skipped=() exts ext
  local IFS=' '
  read -ra exts <<< "$PHP_EXTENSIONS"
  for ext in "${exts[@]}"; do
    if apt-cache show "php${ver}-${ext}" >/dev/null 2>&1; then
      pkgs+=("php${ver}-${ext}")
    else
      skipped+=("php${ver}-${ext}")
    fi
  done
  [[ ${#skipped[@]} -gt 0 ]] && log "Skipping packages not in repo for PHP ${ver}: ${skipped[*]} (bundled into core or unavailable)."
  [[ ${#pkgs[@]} -gt 0 ]] || die "No php${ver} packages found in the repository. Check that the ondrej PPA provides PHP ${ver}."

  apt-get install -y -qq "${pkgs[@]}" || die "Failed to install PHP ${ver}. Check that the package repository provides php${ver}."

  local ini_dir="/etc/php/${ver}/fpm/conf.d"
  mkdir -p "$ini_dir"
  cat > "${ini_dir}/99-aidipanel.ini" <<PHPINI
; AidiPanel PHP-FPM tuning (PHP ${ver})
memory_limit         = 256M
max_execution_time   = 300
max_input_time       = 300
post_max_size        = 256M
upload_max_filesize  = 256M
date.timezone        = Asia/Jakarta
expose_php           = Off

; OPcache (important for performance)
opcache.enable                  = 1
opcache.enable_cli              = 0
opcache.memory_consumption      = 128
opcache.interned_strings_buffer = 16
opcache.max_accelerated_files   = 10000
opcache.revalidate_freq         = 2
opcache.fast_shutdown           = 1
opcache.validate_timestamps     = 1
opcache.save_comments           = 1
PHPINI

  local pool_conf="/etc/php/${ver}/fpm/pool.d/www.conf"
  if [[ -f "$pool_conf" ]]; then
    local mem_mb max_ch=10 start_sv=2 min_sp=2 max_sp=4
    mem_mb=$(awk '/MemTotal/{printf "%d", $2/1024}' /proc/meminfo 2>/dev/null || echo 0)
    [[ -z "$mem_mb" ]] && mem_mb=0
    if (( mem_mb >= 2048 )); then max_ch=20; start_sv=4; min_sp=2; max_sp=6; fi
    if (( mem_mb >= 4096 )); then max_ch=40; start_sv=6; min_sp=4; max_sp=10; fi
    sed -i \
      -e "s|^listen = .*|listen = /run/php/php${ver}-fpm.sock|" \
      -e 's|^;listen.owner = .*|listen.owner = www-data|' \
      -e 's|^;listen.group = .*|listen.group = www-data|' \
      -e 's|^;listen.mode = .*|listen.mode = 0660|' \
      -e 's|^pm = .*|pm = dynamic|' \
      -e "s|^pm.max_children = .*|pm.max_children = ${max_ch}|" \
      -e "s|^pm.start_servers = .*|pm.start_servers = ${start_sv}|" \
      -e "s|^pm.min_spare_servers = .*|pm.min_spare_servers = ${min_sp}|" \
      -e "s|^pm.max_spare_servers = .*|pm.max_spare_servers = ${max_sp}|" \
      -e 's|^;pm.max_requests = .*|pm.max_requests = 500|' \
      "$pool_conf"
  fi

  systemctl enable --now "php${ver}-fpm" || die "Failed to start php${ver}-fpm"
  ok "PHP ${ver} installed successfully."
  return 0
}

_php_list() {
  _parse_opts "$@"
  echo ""
  echo -e "  ${BOLD}PHP versions${RESET}"
  _hr
  for ver in "${PHP_VERSIONS_SUPPORTED[@]}"; do
    local status="${DIM}available${RESET}"
    local fpm_status="${DIM}stopped${RESET}"
    if [[ -d "/etc/php/${ver}/fpm" ]]; then
      status="${GREEN}installed${RESET}"
      [[ "$ver" == "$PHP_DEFAULT_VERSION" ]] && status="${GREEN}installed (default)${RESET}"
      systemctl is-active --quiet "php${ver}-fpm" 2>/dev/null \
        && fpm_status="${GREEN}running${RESET}" \
        || fpm_status="${RED}stopped${RESET}"
    fi
    printf "  PHP %-6s " "$ver"
    echo -e "  status: $status  fpm: $fpm_status"
  done
  _hr
  echo ""
}

_php_version() {
  _require_root "php:version"
  _parse_opts "$@"
  local domain; domain=$(_opt "domain")
  local new_ver; new_ver=$(_opt "set" "")
  _require_arg "domain" "$domain" "php:version --domain example.com [--set 8.3]"
  _domain_valid "$domain" || die "Invalid domain name: ${domain}"
  _domain_exists "$domain" || die "Site not found: ${domain}"

  local conf="${NGINX_CONF_DIR}/${domain}.conf"
  local current_ver; current_ver=$(grep -oP 'php\K[0-9.]+(?=-fpm)' "$conf" 2>/dev/null | head -1 || echo "unknown")

  if [[ -z "$new_ver" ]]; then
    echo "  PHP version for ${domain}: ${BOLD}${current_ver}${RESET}"
    return 0
  fi

  _php_version_valid "$new_ver" || die "Invalid PHP version: ${new_ver}. Supported: ${PHP_VERSIONS_SUPPORTED[*]}"
  [[ -d "/etc/php/${new_ver}/fpm/pool.d" ]] || die "PHP ${new_ver} is not installed. Run: aidipanel php:install --version ${new_ver}"

  log "Changing PHP for ${domain}: ${current_ver} → ${new_ver}"

  # Resolve the site-user from the current vhost socket, recreate its pool on the
  # new version, then repoint the vhost socket. (Pool must follow the version.)
  local site_user; site_user=$(grep -oP 'php[0-9.]+-fpm-\K[a-z0-9_-]+(?=\.sock)' "$conf" 2>/dev/null | head -1 || echo "")
  local old_sock new_sock
  if [[ -n "$site_user" ]]; then
    _write_fpm_pool "$site_user" "$new_ver" || die "Could not create php${new_ver} pool for ${site_user}."
    _remove_fpm_pool "$site_user" "$current_ver"
    old_sock=$(_site_php_sock "$current_ver" "$site_user")
    new_sock=$(_site_php_sock "$new_ver" "$site_user")
  else
    old_sock=$(_php_sock "$current_ver"); new_sock=$(_php_sock "$new_ver")   # legacy fallback
  fi

  local tmp; tmp=$(mktemp)
  sed "s|${old_sock}|${new_sock}|g" "$conf" > "$tmp" && cp "$tmp" "$conf"
  rm -f "$tmp"

  _nginx_test_reload
  ok "PHP version changed for ${domain}: ${current_ver} → ${new_ver}"
}

_php_install() {
  _require_root "php:install"
  _parse_opts "$@"
  local ver; ver=$(_opt "version")
  _require_arg "version" "$ver" "php:install --version 8.5"
  _ensure_php_version "$ver"
}

_php_restart() {
  _require_root "php:restart"
  _parse_opts "$@"
  local ver; ver=$(_opt "version" "all")

  if [[ "$ver" == "all" ]]; then
    for v in "${PHP_VERSIONS_SUPPORTED[@]}"; do
      if systemctl list-units --quiet "php${v}-fpm.service" &>/dev/null; then
        systemctl restart "php${v}-fpm" >> "$CLI_LOG" 2>&1 \
          && ok "Restarted: php${v}-fpm" \
          || warn "Could not restart php${v}-fpm"
      fi
    done
  else
    _php_version_valid "$ver" || die "Invalid PHP version: ${ver}"
    systemctl restart "php${ver}-fpm" >> "$CLI_LOG" 2>&1
    ok "Restarted: php${ver}-fpm"
  fi
}

_php_info() {
  _parse_opts "$@"
  local ver; ver=$(_opt "version" "8.3")
  _php_version_valid "$ver" || die "Invalid PHP version: ${ver}"
  command -v "php${ver}" &>/dev/null || die "PHP ${ver} not installed"

  echo ""
  "php${ver}" -i 2>/dev/null | grep -E "^(PHP Version|memory_limit|upload_max_filesize|post_max_size|max_execution_time|opcache)" \
    | head -20 | sed 's/^/  /'
  echo ""
}

# ===========================================================================
# SSL COMMANDS
# ===========================================================================

# Does any of the given cert names cover $domain? Exact match or wildcard
# (*.example.com matches a single-label subdomain). Case-insensitive.
_cert_covers_domain() {
  local domain="${1,,}"; shift
  local name base sub
  for name in "$@"; do
    name="${name,,}"
    [[ "$name" == "$domain" ]] && return 0
    if [[ "$name" == \*.* ]]; then
      base="${name#\*.}"
      if [[ "$domain" == *".$base" ]]; then
        sub="${domain%.$base}"
        [[ -n "$sub" && "$sub" != *.* ]] && return 0
      fi
    fi
  done
  return 1
}

# Point a site's vhost at the given cert paths. Generalized: replaces whatever
# ssl_certificate path is currently set (self-signed / LE / custom), so switching
# between cert types always works. Backs up the conf and restores on nginx -t fail.
_ssl_point_vhost() {
  local domain="$1" fullchain="$2" privkey="$3"
  local conf="${NGINX_CONF_DIR}/${domain}.conf"
  [[ -f "$conf" ]] || die "Vhost not found: ${conf}"
  local bak tmp; bak=$(mktemp); tmp=$(mktemp)
  cp "$conf" "$bak"
  sed -E \
    -e "s#^([[:space:]]*ssl_certificate)[[:space:]]+[^;]+;#\1 ${fullchain};#" \
    -e "s#^([[:space:]]*ssl_certificate_key)[[:space:]]+[^;]+;#\1 ${privkey};#" \
    "$conf" > "$tmp" && cp "$tmp" "$conf"
  rm -f "$tmp"
  if ! nginx -t >> "$CLI_LOG" 2>&1; then
    cp "$bak" "$conf"; rm -f "$bak"
    die "Nginx config test failed after cert change — reverted ${domain}. Run: nginx -t"
  fi
  rm -f "$bak"
  systemctl reload nginx >> "$CLI_LOG" 2>&1
}

# Import a user-supplied certificate (paid / wildcard / existing LE).
_ssl_import() {
  _require_root "ssl:import"
  _parse_opts "$@"
  local domain cert_path key_path chain_path
  domain=$(_opt "domain")
  cert_path=$(_opt "cert")
  key_path=$(_opt "key")
  chain_path=$(_opt "chain" "")
  _require_arg "domain" "$domain"    "ssl:import --domain example.com --cert cert.pem --key key.pem"
  _require_arg "cert"   "$cert_path" "ssl:import --domain example.com --cert cert.pem --key key.pem"
  _require_arg "key"    "$key_path"  "ssl:import --domain example.com --cert cert.pem --key key.pem"
  _domain_valid "$domain"  || die "Invalid domain name: ${domain}"
  _domain_exists "$domain" || die "Site not found: ${domain}"
  [[ -f "$cert_path" ]] || die "Certificate file not found: ${cert_path}"
  [[ -f "$key_path"  ]] || die "Private key file not found: ${key_path}"
  [[ -z "$chain_path" || -f "$chain_path" ]] || die "Chain file not found: ${chain_path}"

  # Validate: cert + key parse, key matches cert, cert not expired.
  openssl x509 -noout -in "$cert_path" 2>/dev/null || die "Certificate is not valid PEM."
  openssl pkey -noout -in "$key_path"  2>/dev/null || die "Private key is not valid PEM."
  local cert_pub key_pub
  cert_pub=$(openssl x509 -in "$cert_path" -noout -pubkey 2>/dev/null | openssl md5 2>/dev/null)
  key_pub=$(openssl pkey -in "$key_path" -pubout 2>/dev/null | openssl md5 2>/dev/null)
  [[ -n "$cert_pub" && "$cert_pub" == "$key_pub" ]] || die "Private key does not match the certificate."
  openssl x509 -checkend 0 -noout -in "$cert_path" 2>/dev/null || die "Certificate has already expired."

  # Ensure the cert actually covers this domain (CN or SAN). Importing a cert for
  # the wrong host is the most common mistake — it leaves the browser showing
  # "not secure" even though the import itself "succeeded".
  local -a cert_names=()
  local cn san
  cn=$(openssl x509 -in "$cert_path" -noout -subject 2>/dev/null \
       | grep -oiE 'CN *= *[A-Za-z0-9.*_-]+' | sed -E 's/^CN *= *//I' | head -1)
  [[ -n "$cn" ]] && cert_names+=("$cn")
  while IFS= read -r san; do
    [[ -n "$san" ]] && cert_names+=("$san")
  done < <(openssl x509 -in "$cert_path" -noout -ext subjectAltName 2>/dev/null \
           | grep -oiE 'DNS:[A-Za-z0-9.*_-]+' | sed -E 's/^DNS://I')
  _cert_covers_domain "$domain" "${cert_names[@]}" \
    || die "Certificate does not cover ${domain} (it is issued for: ${cert_names[*]:-unknown}). Import the certificate that matches this site."

  log "Importing certificate for: ${domain}..."
  local dir="/etc/ssl/aidipanel-custom/${domain}"
  mkdir -p "$dir"
  cat "$cert_path" > "${dir}/fullchain.pem"
  if [[ -n "$chain_path" ]]; then
    printf '\n' >> "${dir}/fullchain.pem"
    cat "$chain_path" >> "${dir}/fullchain.pem"
  fi
  cp "$key_path" "${dir}/privkey.pem"
  chown -R root:root "$dir"
  # The directory + public certificate must be readable by the panel (www-data)
  # so it can report the real SSL status; only the private key stays root-only.
  chmod 755 "$dir"
  chmod 644 "${dir}/fullchain.pem"
  chmod 600 "${dir}/privkey.pem"

  _ssl_point_vhost "$domain" "${dir}/fullchain.pem" "${dir}/privkey.pem"
  ok "Certificate imported for: ${domain}"
}

_ssl_install() {
  _require_root "ssl:install"
  _parse_opts "$@"
  local email; email=$(_opt "email" "")
  local staging; staging=$(_opt "staging" "")

  # Domains: prefer --domains "a,www.a" (the user picks which names go on the
  # cert); fall back to the legacy single --domain. This is why we never force
  # "www." onto a domain that has no DNS record — the #1 cause of LE failures.
  local domains_csv; domains_csv=$(_opt "domains" "")
  [[ -z "$domains_csv" ]] && domains_csv=$(_opt "domain" "")
  _require_arg "domains" "$domains_csv" "ssl:install --domains example.com,www.example.com"

  local -a domains=() _raw=()
  IFS=',' read -ra _raw <<< "$domains_csv"
  local d e exists
  for d in "${_raw[@]}"; do
    d="${d//[[:space:]]/}"
    [[ -z "$d" ]] && continue
    _domain_valid "$d" || die "Invalid domain name: ${d}"
    exists=0; for e in "${domains[@]}"; do [[ "$e" == "$d" ]] && exists=1; done
    [[ $exists -eq 0 ]] && domains+=("$d")
  done
  [[ ${#domains[@]} -gt 0 ]] || die "No valid domains provided."

  # certbot uses the first -d as the certificate name / live dir, so the site's
  # own domain leads.
  local primary="${domains[0]}"
  _domain_exists "$primary" || die "Site not found: ${primary}"

  command -v certbot &>/dev/null || die "Certbot is not installed. Run: apt install certbot python3-certbot-nginx"

  # Pre-flight DNS: every name must resolve, or certbot's HTTP-01 challenge fails
  # with a cryptic error. Fail early with a clear, per-domain message instead.
  local -a unresolved=()
  for d in "${domains[@]}"; do
    getent hosts "$d" >/dev/null 2>&1 || unresolved+=("$d")
  done
  if [[ ${#unresolved[@]} -gt 0 ]]; then
    die "These domains do not resolve in DNS yet: ${unresolved[*]} — point them to this server (or remove them) and try again."
  fi

  if [[ -n "$staging" ]]; then
    log "Installing Let's Encrypt SSL (STAGING) for: ${domains[*]}"
  else
    log "Installing Let's Encrypt SSL for: ${domains[*]}"
  fi

  local certbot_args=(certbot --nginx --non-interactive --agree-tos --cert-name "$primary")
  for d in "${domains[@]}"; do certbot_args+=(-d "$d"); done
  [[ -n "$email" ]] && certbot_args+=(--email "$email") || certbot_args+=(--register-unsafely-without-email)
  [[ -n "$staging" ]] && certbot_args+=(--test-cert)

  "${certbot_args[@]}" >> "$CLI_LOG" 2>&1 \
    || die "Certbot failed. Check: ${CLI_LOG}"

  # certbot makes /etc/letsencrypt/{live,archive} 0700 (root-only), which blocks
  # the panel (www-data) from reading the public cert to report SSL status.
  # Make the two parent dirs traversable; private keys keep their own 0600.
  chmod 755 /etc/letsencrypt/live /etc/letsencrypt/archive 2>/dev/null || true

  # Point the vhost at the LE certs (generalized — replaces whatever path is
  # currently set, so self-signed/custom → LE all work; tests + restores on fail).
  _ssl_point_vhost "$primary" \
    "/etc/letsencrypt/live/${primary}/fullchain.pem" \
    "/etc/letsencrypt/live/${primary}/privkey.pem"
  ok "SSL certificate installed for: ${domains[*]}"
  info "Auto-renewal is managed by: /etc/cron.d/aidipanel"
}

_ssl_renew() {
  _require_root "ssl:renew"
  _parse_opts "$@"
  local domain; domain=$(_opt "domain" "")

  log "Renewing SSL certificates..."
  if [[ -n "$domain" ]]; then
    _domain_valid "$domain" || die "Invalid domain name: ${domain}"
    certbot renew --cert-name "$domain" --nginx --non-interactive >> "$CLI_LOG" 2>&1
    ok "Renewed: ${domain}"
  else
    certbot renew --nginx --non-interactive >> "$CLI_LOG" 2>&1
    ok "All certificates renewed"
  fi
  systemctl reload nginx >> "$CLI_LOG" 2>&1
}

_ssl_status() {
  _parse_opts "$@"
  echo ""
  echo -e "  ${BOLD}SSL Certificate Status${RESET}"
  _hr
  printf "  %-30s %-14s %s\n" "Domain" "Type" "Expiry"
  _hr

  for conf in "${NGINX_CONF_DIR}"/*.conf; do
    [[ -f "$conf" ]] || continue
    [[ "$(basename "$conf")" == "aidipanel-ui.conf" ]] && continue
    local domain; domain=$(basename "$conf" .conf)
    local cert_type expiry

    if [[ -f "/etc/letsencrypt/live/${domain}/fullchain.pem" ]]; then
      cert_type="Let's Encrypt"
      expiry=$(openssl x509 -enddate -noout \
        -in "/etc/letsencrypt/live/${domain}/fullchain.pem" 2>/dev/null \
        | cut -d= -f2 || echo "unknown")
    elif [[ -f "/etc/ssl/aidipanel-custom/${domain}/fullchain.pem" ]]; then
      cert_type="imported"
      expiry=$(openssl x509 -enddate -noout \
        -in "/etc/ssl/aidipanel-custom/${domain}/fullchain.pem" 2>/dev/null \
        | cut -d= -f2 || echo "unknown")
    elif [[ -f "/etc/ssl/aidipanel-self/${domain}.crt" ]]; then
      cert_type="self-signed"
      expiry=$(openssl x509 -enddate -noout \
        -in "/etc/ssl/aidipanel-self/${domain}.crt" 2>/dev/null \
        | cut -d= -f2 || echo "unknown")
    else
      cert_type="none"
      expiry="-"
    fi

    printf "  %-30s %-14s %s\n" "$domain" "$cert_type" "$expiry"
  done
  _hr
  echo ""
}

# ===========================================================================
# SERVICE COMMANDS
# ===========================================================================

_service_status() {
  _parse_opts "$@"
  echo ""
  echo -e "  ${BOLD}AidiPanel Services${RESET}"
  _hr

  local services=("nginx" "mysql" "redis-server")
  for ver in "${PHP_VERSIONS_SUPPORTED[@]}"; do
    services+=("php${ver}-fpm")
  done

  for svc in "${services[@]}"; do
    local status
    if systemctl is-active --quiet "$svc" 2>/dev/null; then
      status="${GREEN}● running${RESET}"
    elif systemctl list-units --quiet "${svc}.service" &>/dev/null; then
      status="${RED}● stopped${RESET}"
    else
      status="${DIM}  not installed${RESET}"
    fi
    printf "  %-20s " "$svc"
    echo -e "$status"
  done
  _hr
  echo ""
}

_service_action() {
  _require_root "service:${1}"
  local action="$1"
  _parse_opts "${@:2}"
  local service_name; service_name="${OPTS[arg]:-}"
  service_name="${service_name// /}"

  [[ -n "$service_name" ]] || die "Specify a service: nginx, mysql, redis, php (or php8.3, etc.)"
  [[ "$action" =~ ^(start|stop|restart|reload)$ ]] || die "Invalid service action: ${action}"

  # Aliases
  [[ "$service_name" == "redis" ]] && service_name="redis-server"
  [[ "$service_name" == "php" ]]   && service_name="php${PHP_DEFAULT_VERSION:-8.3}-fpm"
  [[ "$service_name" =~ ^php[0-9]+\.[0-9]+$ ]] && service_name="${service_name}-fpm"

  case "$service_name" in
    nginx|mysql|mariadb|redis-server|php8.2-fpm|php8.3-fpm|php8.4-fpm|php8.5-fpm) ;;
    *) die "Invalid service: ${service_name}" ;;
  esac

  log "${action^}: ${service_name}"
  systemctl "$action" "$service_name" >> "$CLI_LOG" 2>&1 \
    || die "Failed to ${action} ${service_name}. Check: journalctl -u ${service_name}"
  ok "${action^}ed: ${service_name}"
}

# ===========================================================================
# USER COMMANDS
# ===========================================================================

_user_add() {
  _require_root "user:add"
  _parse_opts "$@"
  local username; username=$(_opt "user")
  local domain; domain=$(_opt "domain" "")
  _require_arg "user" "$username" "user:add --user john --domain example.com"

  [[ "$username" =~ ^[a-z_][a-z0-9_-]*$ ]] \
    || die "Username must be lowercase letters, numbers, underscores, hyphens"
  [[ -z "$domain" ]] || _domain_valid "$domain" || die "Invalid domain name: ${domain}"

  id "$username" &>/dev/null && die "User already exists: ${username}"

  local home_dir="${SITES_DIR}/${domain:-$username}"
  useradd \
    --create-home \
    --home-dir "$home_dir" \
    --shell /bin/bash \
    --groups www-data \
    "$username"

  # Generate random password
  local pass; pass=$(openssl rand -base64 16 | tr -dc 'A-Za-z0-9' | head -c 16)
  echo "${username}:${pass}" | chpasswd

  ok "User created: ${username}"
  _table_row "Username:"  "$username"
  _table_row "Password:"  "$pass"
  _table_row "Home dir:"  "$home_dir"
  warn "Save the password — it will not be shown again."
}

_user_delete() {
  _require_root "user:delete"
  _parse_opts "$@"
  local username; username=$(_opt "user")
  _require_arg "user" "$username" "user:delete --user john"

  id "$username" &>/dev/null || die "User not found: ${username}"
  _confirm "Delete user '${username}'?" || { log "Cancelled."; return 0; }

  userdel --remove "$username" 2>/dev/null || userdel "$username"
  ok "User deleted: ${username}"
}

_user_list() {
  _parse_opts "$@"
  echo ""
  echo -e "  ${BOLD}Site Users${RESET}"
  _hr
  # List users with home under SITES_DIR
  while IFS=: read -r user _ uid _ _ home _; do
    [[ "$home" == "${SITES_DIR}/"* ]] || continue
    (( uid >= 1000 )) || continue
    printf "  %-20s %s\n" "$user" "$home"
  done < /etc/passwd
  _hr
  echo ""
}

_user_passwd() {
  _require_root "user:passwd"
  _parse_opts "$@"
  local username; username=$(_opt "user")
  local new_pass; new_pass=$(_opt "pass" "")
  _require_arg "user" "$username" "user:passwd --user john"

  id "$username" &>/dev/null || die "User not found: ${username}"

  if [[ -z "$new_pass" ]]; then
    new_pass=$(openssl rand -base64 16 | tr -dc 'A-Za-z0-9' | head -c 16)
    echo "${username}:${new_pass}" | chpasswd
    ok "Password changed for: ${username}"
    _table_row "New password:" "$new_pass"
    warn "Save the password — it will not be shown again."
  else
    echo "${username}:${new_pass}" | chpasswd
    ok "Password changed for: ${username}"
  fi
}

# ===========================================================================
# SYSTEM COMMANDS
# ===========================================================================

_system_info() {
  _parse_opts "$@"
  local hostname; hostname=$(hostname)
  local server_ip; server_ip=$(ip route get 8.8.8.8 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1);exit}}' || echo "-")
  local os_info; os_info=$(grep PRETTY_NAME /etc/os-release 2>/dev/null | cut -d= -f2 | tr -d '"' || echo "-")
  local kernel; kernel=$(uname -r)
  local arch; arch=$(uname -m)
  local cpu; cpu=$(nproc)
  local mem_total; mem_total=$(grep MemTotal /proc/meminfo | awk '{printf "%.0f MB", $2/1024}')
  local mem_free; mem_free=$(grep MemAvailable /proc/meminfo | awk '{printf "%.0f MB", $2/1024}')
  local disk; disk=$(df -h / | awk 'NR==2{print $4" free of "$2}')
  local load; load=$(cut -d' ' -f1-3 /proc/loadavg)
  local uptime_str; uptime_str=$(uptime -p 2>/dev/null || uptime)

  echo ""
  echo -e "  ${BOLD}${CYAN}AidiPanel v${CLI_VERSION}${RESET} — System Information"
  _hr
  _table_row "Hostname:"     "$hostname"
  _table_row "IP address:"   "$server_ip"
  _table_row "OS:"           "$os_info"
  _table_row "Kernel:"       "$kernel"
  _table_row "Architecture:" "$arch"
  _table_row "CPU cores:"    "$cpu"
  _table_row "Memory total:" "$mem_total"
  _table_row "Memory free:"  "$mem_free"
  _table_row "Disk (/):"     "$disk"
  _table_row "Load avg:"     "$load"
  _table_row "Uptime:"       "$uptime_str"
  _hr
  echo ""
}

_log_tail() {
  _parse_opts "$@"
  local domain; domain=$(_opt "domain")
  local log_type; log_type=$(_opt "type" "access")
  local lines; lines=$(_opt "lines" "50")
  _require_arg "domain" "$domain" "log:tail --domain example.com --type access"
  _domain_valid "$domain" || die "Invalid domain name: ${domain}"
  [[ "$lines" =~ ^[0-9]+$ ]] || die "Lines must be a number"

  local log_file
  case "$log_type" in
    access)     log_file="/var/log/nginx/${domain}-access.log" ;;
    error)      log_file="/var/log/nginx/${domain}-error.log" ;;
    php)        log_file="/var/log/php/php-fpm.log" ;;
    aidipanel)  log_file="$CLI_LOG" ;;
    *)          die "Invalid log type: ${log_type}. Supported: access, error, php, aidipanel" ;;
  esac

  [[ -f "$log_file" ]] || die "Log file not found: ${log_file}"

  log "Tailing ${lines} lines from: ${log_file} (Ctrl+C to stop)"
  tail -n "$lines" -f "$log_file"
}

_self_update() {
  _require_root "self:update"
  log "Checking for AidiPanel CLI updates..."
  local install_url="https://raw.githubusercontent.com/aidipanel/aidipanel/main/aidipanel"
  local tmp_file; tmp_file=$(mktemp /tmp/aidipanel-cli.XXXXXX)

  curl -fsSL "$install_url" -o "$tmp_file" 2>/dev/null \
    || die "Failed to download update. Check internet connection."

  bash -n "$tmp_file" || die "Downloaded script has syntax errors — aborting update."

  local current_bin; current_bin=$(command -v aidipanel)
  cp "$tmp_file" "$current_bin"
  chmod +x "$current_bin"
  rm -f "$tmp_file"

  ok "AidiPanel CLI updated: ${current_bin}"
  aidipanel --version 2>/dev/null || true
}

# ---------------------------------------------------------------------------
# RUN HELPER (used inside functions to exec+log commands)
# ---------------------------------------------------------------------------
run() {
  echo "[$(_ts)] RUN: $*" >> "$CLI_LOG" 2>/dev/null || true
  "$@" >> "$CLI_LOG" 2>&1
}

# ===========================================================================
# MAIN DISPATCHER
# ===========================================================================
main() {
  # Init log
  mkdir -p "$(dirname "$CLI_LOG")"
  touch "$CLI_LOG" 2>/dev/null || true

  local command="${1:-}"
  shift 2>/dev/null || true

  case "$command" in
    # Site
    site:add)       _site_add "$@" ;;
    site:delete)    _site_delete "$@" ;;
    site:list)      _site_list "$@" ;;
    site:info)      _site_info "$@" ;;
    vhost:save)     _vhost_save "$@" ;;

    # Cache
    cache:status)   _cache_status "$@" ;;
    cache:purge)    _cache_purge "$@" ;;
    cache:enable)   _cache_toggle enable "$@" ;;
    cache:disable)  _cache_toggle disable "$@" ;;

    # Database
    db:add)         _db_add "$@" ;;
    db:delete)      _db_delete "$@" ;;
    db:list)        _db_list "$@" ;;
    db:backup)      _db_backup "$@" ;;

    # PHP
    php:install)    _php_install "$@" ;;
    php:list)       _php_list "$@" ;;
    php:version)    _php_version "$@" ;;
    php:restart)    _php_restart "$@" ;;
    php:info)       _php_info "$@" ;;

    # SSL
    ssl:install)    _ssl_install "$@" ;;
    ssl:renew)      _ssl_renew "$@" ;;
    ssl:status)     _ssl_status "$@" ;;
    ssl:import)     _ssl_import "$@" ;;

    # Service
    service:status)  _service_status "$@" ;;
    service:restart) _service_action restart "$@" ;;
    service:reload)  _service_action reload "$@" ;;
    service:start)   _service_action start "$@" ;;
    service:stop)    _service_action stop "$@" ;;

    # User
    user:add)       _user_add "$@" ;;
    user:delete)    _user_delete "$@" ;;
    user:list)      _user_list "$@" ;;
    user:passwd)    _user_passwd "$@" ;;

    # System
    system:info)    _system_info "$@" ;;
    log:tail)       _log_tail "$@" ;;
    self:update)    _self_update "$@" ;;

    --version|-v)
      echo "AidiPanel CLI v${CLI_VERSION}"
      ;;

    help|--help|-h|"")
      _usage
      ;;

    *)
      echo -e "${RED}Unknown command: '${command}'${RESET}"
      echo "Run 'aidipanel help' to see all available commands."
      exit 1
      ;;
  esac
}

main "$@"
