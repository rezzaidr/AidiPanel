  echo "  aidipanel ssl:install --domain test.example.com --staging"
  echo "  aidipanel service:restart nginx"
  echo "  aidipanel log:tail --domain example.com --type access"
  echo ""
}

# ---------------------------------------------------------------------------
# PARSE OPTIONS — returns assoc array of key=value pairs from --key value args
# ---------------------------------------------------------------------------
declare -A OPTS=()

_parse_opts() {
  # Parses --key value pairs from "$@" into global OPTS[]
  OPTS=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --*)
        local key="${1#--}"
        if [[ $# -gt 1 && "${2:-}" != --* ]]; then
          OPTS["$key"]="${2}"
          shift 2
        else
          OPTS["$key"]="true"
          shift
        fi
        ;;
      *)
        # Positional argument stored as "arg"
        OPTS["arg"]="${OPTS[arg]:-} $1"
        shift
        ;;
    esac
  done
}

_opt() {
  # Get option value with optional default
  local key="$1" default="${2:-}"
  echo "${OPTS[$key]:-$default}"
}

# ===========================================================================
# SITE COMMANDS
# ===========================================================================

_site_add() {
  _require_root "site:add"
  _parse_opts "$@"

  local domain php_ver site_type site_user
  domain=$(_opt "domain"); php_ver=$(_opt "php" "${PHP_DEFAULT_VERSION}"); site_type=$(_opt "type" "php")
  site_user=$(_opt "user" "")

  # WordPress provisioning options (only used for --type wordpress)
  local wp_title wp_admin_user wp_admin_pass wp_admin_email wp_multisite
  wp_title=$(_opt "wp-title" ""); wp_admin_user=$(_opt "wp-admin-user" "admin")
  wp_admin_pass=$(_opt "wp-admin-pass" ""); wp_admin_email=$(_opt "wp-admin-email" "")
  wp_multisite=$(_opt "wp-multisite" "off")

  _require_arg "domain" "$domain" "site:add --domain example.com --user example --type wordpress"

  # Validate
  _domain_valid "$domain" || die "Invalid domain name: ${domain}"
  _domain_exists "$domain" && die "Site already exists: ${domain}"
  _php_version_valid "$php_ver" || die "Invalid PHP version: ${php_ver}. Supported: ${PHP_VERSIONS_SUPPORTED[*]}"

  [[ "$site_type" =~ ^(wordpress|php|laravel|static|proxy)$ ]] \
    || die "Invalid site type: ${site_type}. Supported: wordpress, php, laravel, static, proxy"

  # WordPress: validate multisite mode (subdomain deferred — needs wildcard SSL), and
  # when admin details are supplied, validate the install fields + WP-CLI availability.
  local wp_do_install=0
  if [[ "$site_type" == "wordpress" ]]; then
    case "$wp_multisite" in
      off|subdir) ;;
      subdomain) die "Subdomain multisite needs wildcard SSL (DNS-01), not supported yet. Use --wp-multisite subdir." ;;
      *) die "Invalid --wp-multisite '${wp_multisite}'. Use: off or subdir." ;;
    esac
    if [[ -n "$wp_admin_email" ]]; then
      wp_do_install=1
      [[ -n "$wp_title" ]]      || die "WordPress install requires --wp-title."
      [[ -n "$wp_admin_user" ]] || die "WordPress install requires --wp-admin-user."
      [[ -n "$wp_admin_pass" ]] || die "WordPress install requires --wp-admin-pass."
      [[ "$wp_admin_email" =~ ^[^@[:space:]]+@[^@[:space:]]+\.[^@[:space:]]+$ ]] \
        || die "Invalid --wp-admin-email: ${wp_admin_email}"
      command -v wp >/dev/null 2>&1 || die "WP-CLI not installed; cannot install WordPress (install.sh installs it)."
    fi
  fi

  # --user is optional; derive a unique suggestion from the domain when absent.
  [[ -z "$site_user" ]] && site_user=$(_unique_site_user "$(_suggest_site_user "$domain")")
  _validate_site_user "$site_user"
  id "$site_user" &>/dev/null && die "Site user already exists: ${site_user} (pass a different --user)."

  # Auto-install the requested PHP version on demand if it is missing (Patch C).
  # Runs BEFORE the rollback ledger below, so a failed install dies cleanly with
  # no half-created site. _ensure_php_version is idempotent and validates the version.
  if ! _php_installed "$php_ver"; then
    _progress 5 php_install "Installing PHP ${php_ver}"
    log "PHP ${php_ver} not installed — installing it first (this may take 1-2 minutes)..."
    _ensure_php_version "$php_ver"
  fi
  [[ -w "$HOME_BASE" ]] || die "${HOME_BASE} is not writable."

  log "Creating site: ${domain} (user: ${site_user}, type: ${site_type}, PHP: ${php_ver})..."
  local webroot="${HOME_BASE}/${site_user}/htdocs/${domain}"

  # Rollback ledger
  DID_CREATE_USER=0
  local created_home=0 wrote_pool=0 wrote_vhost=0 enabled=0 wrote_snippet=0 wrote_db=0
  local db_name="" db_user="" db_pass=""
  _site_add_rollback() {
    [[ "$wrote_db"     == 1 ]] && _db_deprovision "$db_name" "$db_user"
    [[ "$enabled"      == 1 ]] && rm -f "${NGINX_ENABLED_DIR}/${domain}.conf"
    [[ "$wrote_vhost"  == 1 ]] && rm -f "${NGINX_CONF_DIR}/${domain}.conf"
    [[ "$wrote_snippet" == 1 ]] && rm -f "$(_cache_snippet_path "$domain")"
    [[ "$wrote_pool"   == 1 ]] && _remove_fpm_pool "$site_user" "$php_ver"
    if [[ "$DID_CREATE_USER" == 1 ]]; then
      _remove_site_user "$site_user"   # user + home + its (otherwise-orphan) group
    elif [[ "$created_home" == 1 ]]; then
      rm -rf "${HOME_BASE}/${site_user}/htdocs/${domain}"
    fi
    systemctl reload nginx >> "$CLI_LOG" 2>&1 || true
  }

  _progress 12 create_user "Creating site user"
  _ensure_site_user "$site_user"            || { _site_add_rollback; die "Could not create site user '${site_user}'."; }
  _site_make_layout "$site_user" "$domain" "$webroot"; created_home=1
  _site_grant_web_access "$site_user"       || { _site_add_rollback; die "Could not grant web access for '${site_user}'."; }
  _progress 25 php_pool "Configuring PHP-FPM pool"
  _write_fpm_pool "$site_user" "$php_ver"   || { _site_add_rollback; die "PHP-FPM pool creation failed."; }
  wrote_pool=1
  _progress 35 vhost "Writing nginx configuration"
  _site_write_vhost "$domain" "$php_ver" "$webroot" "$site_type" "$site_user" "$wp_multisite"; wrote_vhost=1

  # New sites carry only a self-signed cert until the user installs Let's Encrypt,
  # so don't force HTTPS yet — keep plain http serving so visitors don't hit an
  # untrusted-cert warning (HSTS is likewise shipped off in the template). Both are
  # one-click panel toggles once a trusted cert is in place. Reuse the same serve
  # block builder as `ssl:force-https off`; keep the redirect if it yields nothing.
  local _p80; _p80=$(mktemp)
  if _vhost_port80_serve "$domain" "${NGINX_CONF_DIR}/${domain}.conf" > "$_p80" && [[ -s "$_p80" ]]; then
    _vhost_replace_first_server "${NGINX_CONF_DIR}/${domain}.conf" "$_p80"
  fi
  rm -f "$_p80"

  # Create per-site cache snippet (cache OFF by default; enables on cache:enable)
  _cache_snippet_write "$domain" "1h" \
    "$(_cache_default_exclude_urls)" \
    "$(_cache_baseline_cookies)" \
    "off" "off" "on"
  wrote_snippet=1

  ln -sf "${NGINX_CONF_DIR}/${domain}.conf" "${NGINX_ENABLED_DIR}/${domain}.conf"; enabled=1

  # nginx -t validates ALL enabled vhosts; on failure roll back THIS site so one
  # broken vhost can't make every future site:add fail.
  _progress 45 nginx "Testing and reloading nginx"
  if ! nginx -t >> "$CLI_LOG" 2>&1; then
    _site_add_rollback
    die "The web server rejected the configuration for ${domain}; the site was rolled back."
  fi
  systemctl reload nginx >> "$CLI_LOG" 2>&1
  ok "Site created: ${domain}"

  # --- WordPress provisioning (only when admin details were supplied) ---
  local wp_installed=0
  if [[ "$wp_do_install" == 1 ]]; then
    # Derive a shell/SQL-safe DB identity from the (unique) site user, using the
    # SAME "<site_user>_" prefix the Database tab scopes by (see _db_site_prefix),
    # so a site's WordPress database + user show up in — and are managed by — its
    # tab. The user is capped at 29 + "_wp" to respect MySQL's 32-char user limit;
    # the database name (64-char limit) keeps the full prefix so it always matches.
    local _s; _s=$(printf '%s' "$site_user" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_' '_')
    db_user="${_s:0:29}_wp"; db_name="${_s}_wp"
    db_pass=$(openssl rand -base64 18 | tr -dc 'A-Za-z0-9' | head -c 24)
    _progress 55 database "Provisioning database"
    log "Provisioning database for WordPress: ${db_name} (user: ${db_user})..."
    _db_provision "$db_name" "$db_user" "$db_pass" \
      || { _site_add_rollback; die "Database provisioning failed for ${domain}."; }
    _db_secret_put "$domain" "$db_name" "$db_user" "$db_pass" \
      || { _site_add_rollback; die "Could not store the encrypted database credential for ${domain}."; }
    wrote_db=1
    _progress 60 wp_setup "Setting up WordPress"
    log "Installing WordPress (${domain}, multisite=${wp_multisite})..."
    if ! _site_install_wordpress "$domain" "$site_user" "$webroot" "$wp_multisite" \
         "$wp_title" "$wp_admin_user" "$wp_admin_pass" "$wp_admin_email" \
         "$db_name" "$db_user" "$db_pass"; then
      _site_add_rollback
      die "WordPress installation failed for ${domain}; the half-created site was rolled back. Please try again."
    fi
    wp_installed=1
    ok "WordPress installed: ${domain}"
  fi

  _progress 100 "done" "Done"
  # Machine-readable summary for the Panel (Patch 2). The CLI writes NO DB state.
  local sock; sock=$(_site_php_sock "$php_ver" "$site_user")
  echo "site_user=${site_user}"
  echo "web_root=${webroot}"
  echo "pool=${site_user}"
  echo "socket=${sock}"
  echo "php_version=${php_ver}"
  if [[ "$wp_installed" == 1 ]]; then
    echo "wp_installed=1"
    echo "wp_multisite=${wp_multisite}"
    echo "db_name=${db_name}"
    echo "db_user=${db_user}"
    echo "admin_url=https://${domain}/wp-admin"
  fi
}

_site_write_vhost() {
  local domain="$1" php_ver="$2" webroot="$3" site_type="$4" site_user="$5" wp_multisite="${6:-off}"
  local sock; sock=$(_site_php_sock "$php_ver" "$site_user")
  local conf_file="${NGINX_CONF_DIR}/${domain}.conf"

  # Self-signed cert FIRST — the HTTPS vhost below references it, so if cert
  # generation fails we bail before writing a vhost that nginx -t can't load.
  # (-s checks non-empty: also recovers from a half-written cert left by a
  # previously failed attempt.)
  local self_ssl_dir="/etc/ssl/aidipanel-self"
  mkdir -p "$self_ssl_dir"
  if [[ ! -s "${self_ssl_dir}/${domain}.crt" || ! -s "${self_ssl_dir}/${domain}.key" ]]; then
    if ! openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
      -keyout "${self_ssl_dir}/${domain}.key" \
      -out    "${self_ssl_dir}/${domain}.crt" \
      -subj   "/CN=${domain}" >> "$CLI_LOG" 2>&1; then
      die "Failed to generate self-signed certificate for ${domain}"
    fi
  fi

  # Choose index based on type
  local index="index.php index.html"
  [[ "$site_type" == "static" ]] && index="index.html index.htm"

  # PHP location block — empty for static sites
  local php_location=""
  if [[ "$site_type" != "static" && "$site_type" != "proxy" ]]; then
    php_location=$(cat <<PHPLOC

    # FastCGI cache bypass rules
    include ${NGINX_SNIPPET_DIR}/cache-${domain}.conf;

    # PHP handler with FastCGI cache
    location ~ \.php\$ {
        try_files \$uri =404;
        fastcgi_split_path_info ^(.+\.php)(/.+)\$;
        fastcgi_pass unix:${sock};
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME \$document_root\$fastcgi_script_name;
        include fastcgi_params;

        #fastcgi_cache        ${NGINX_CACHE_ZONE};
        # AidiPanel caches public 404 responses for 60 seconds when the FastCGI
        # page cache is enabled. This short TTL absorbs repeated bot/scanner probes
        # without keeping stale 404s for long. Server errors are never cached —
        # only the codes listed below are.
        #fastcgi_cache_valid  200 301 302 1h;
        #fastcgi_cache_valid  404 1m;
        #fastcgi_cache_use_stale error timeout updating http_500 http_503;
        #fastcgi_cache_bypass \$skip_cache;
        #fastcgi_no_cache     \$skip_cache;

        fastcgi_connect_timeout 60s;
        fastcgi_send_timeout    180s;
        fastcgi_read_timeout    180s;
        fastcgi_buffer_size     64k;
        fastcgi_buffers         8 128k;
    }
PHPLOC
)
  fi

  # Laravel: point root to /public
  [[ "$site_type" == "laravel" ]] && webroot="${webroot}/public"

  # Proxy upstream
  local proxy_block=""
  if [[ "$site_type" == "proxy" ]]; then
    local proxy_pass; proxy_pass=$(_opt "proxy-pass" "http://127.0.0.1:3000")
    _proxy_url_valid "$proxy_pass" || die "Invalid reverse proxy URL: ${proxy_pass}"
    proxy_block=$(cat <<PROXYBLK

    location / {
        proxy_pass         ${proxy_pass};
        proxy_http_version 1.1;
        proxy_set_header   Upgrade \$http_upgrade;
        proxy_set_header   Connection 'upgrade';
        proxy_set_header   Host \$host;
        proxy_set_header   X-Real-IP \$remote_addr;
        proxy_set_header   X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto \$scheme;
        proxy_cache_bypass \$http_upgrade;
    }
PROXYBLK
)
  fi

  # WordPress try_files vs default
  local try_files="try_files \$uri \$uri/ =404;"
  [[ "$site_type" == "wordpress" ]] && try_files="try_files \$uri \$uri/ /index.php?\$args;"

  # Main `location /` block. Proxy supplies its OWN `location /` (proxy_pass)
  # via $proxy_block, so skip this one for proxy — otherwise the vhost ends up
  # with two `location /` and nginx -t fails: duplicate location "/".
  local main_location=""
  if [[ "$site_type" != "proxy" ]]; then
    main_location=$(cat <<MAINLOC

    # Main location
    location / {
        ${try_files}
    }
MAINLOC
)
  fi

  # WordPress-specific deny block (pre-computed, used inside heredoc)
  local wp_deny_block=""
  if [[ "$site_type" == "wordpress" ]]; then
    wp_deny_block=$(cat <<'WPDENY'

    # Deny access to sensitive WordPress files
    location ~ ^/(wp-config\.php|xmlrpc\.php|wp-cron\.php)$ { deny all; }
    location ~* /(?:uploads|files)/.*\.php$ { deny all; }
WPDENY
)
  fi

  # WordPress subdirectory-multisite network rewrites (server scope). Subdomain mode is
  # intentionally NOT emitted — it needs wildcard SSL (deferred).
  local wp_multisite_block=""
  if [[ "$site_type" == "wordpress" && "$wp_multisite" == "subdir" ]]; then
    wp_multisite_block=$(cat <<'WPMS'

    # WordPress subdirectory multisite
    if (!-e $request_filename) {
        rewrite /wp-admin$ $scheme://$host$uri/ permanent;
        rewrite ^(/[^/]+)?(/wp-.*) $2 last;
        rewrite ^(/[^/]+)?(/.*\.php) $2 last;
    }
WPMS
)
  fi

  cat > "$conf_file" <<VHOST
# AidiPanel — ${domain}
# Type: ${site_type} | PHP: ${php_ver}
# Created: $(date '+%Y-%m-%d %H:%M:%S')

server {
    listen 80;
    listen [::]:80;
    server_name ${domain} www.${domain};

    # ACME challenge for Let's Encrypt
    location /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 301 https://\$host\$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${domain} www.${domain};

    root ${webroot};
    index ${index};

    # SSL — will be configured by: aidipanel ssl:install --domain ${domain}
    ssl_certificate     /etc/ssl/aidipanel-self/${domain}.crt;
    ssl_certificate_key /etc/ssl/aidipanel-self/${domain}.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL_${domain}:10m;
    ssl_session_timeout 1d;

    # Security headers (HSTS shipped off until a trusted cert is installed — toggle in panel)
    # add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options    "nosniff" always;
    add_header X-Frame-Options           "SAMEORIGIN" always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;

    # Cache-status debug header at SERVER scope on purpose: nginx add_header does
    # not merge across levels, so putting it inside \`location ~ \.php$\` would
    # suppress every security header above for PHP/WordPress responses. Empty
    # value unless the FastCGI page cache is enabled.
    add_header X-FastCGI-Cache \$upstream_cache_status always;

    # Static file caching
    location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg|woff|woff2|ttf|eot|webp|avif|mp4|webm)\$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        # This location's own add_header suppresses the inherited security headers,
        # so repeat the one that actually matters for assets: nosniff stops the
        # browser MIME-sniffing CSS/JS/SVG/uploads. HSTS (already host-wide once the
        # document sets it), X-Frame-Options and Referrer-Policy add nothing on
        # assets, so they are intentionally not duplicated here.
        add_header X-Content-Type-Options "nosniff" always;
        access_log off;
        log_not_found off;
    }

    # Deny hidden files
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
${wp_deny_block}
${main_location}
${wp_multisite_block}
${php_location}
${proxy_block}

    # Logs
    access_log /var/log/nginx/${domain}-access.log main;
    error_log  /var/log/nginx/${domain}-error.log warn;
}
VHOST
}

# Install WordPress into an already-created site, run as the site user via WP-CLI.
# Passwords are fed over stdin (--prompt) so they never appear in the process list.
# Returns non-zero on any failure so the caller can roll back; detail goes to CLI_LOG.
_site_install_wordpress() {
  local domain="$1" site_user="$2" webroot="$3" multisite="$4"
  local wp_title="$5" wp_admin_user="$6" wp_admin_pass="$7" wp_admin_email="$8"
  local db_name="$9" db_user="${10}" db_pass="${11}"

  local cache_dir="/tmp/aidipanel-wp-cli-cache"
  mkdir -p "$cache_dir"
  chown "${site_user}:${site_user}" "$cache_dir" 2>/dev/null || true
  local wp=(sudo -u "$site_user" -- env "WP_CLI_CACHE_DIR=${cache_dir}" wp --path="$webroot")

  _progress 65 wp_download "Downloading WordPress core"
  # 1. Download core (idempotent)
  if [[ ! -f "${webroot}/wp-load.php" ]]; then
    "${wp[@]}" core download --version=latest >> "$CLI_LOG" 2>&1 \
      || { warn "wp core download failed"; return 1; }
  fi

  _progress 85 wp_config "Writing wp-config.php"
  # 2. wp-config.php — salts auto-generated; DB password via stdin, not argv.
  printf '%s\n' "$db_pass" | "${wp[@]}" config create \
    --dbname="$db_name" --dbuser="$db_user" --dbhost=localhost --force --prompt=dbpass \
    >> "$CLI_LOG" 2>&1 || { warn "wp config create failed"; return 1; }

  _progress 90 wp_install "Installing WordPress"
  # 3. Install (single or subdirectory network). Admin password via stdin.
  local -a subcmd checkargs
  if [[ "$multisite" == "subdir" ]]; then
    subcmd=(core multisite-install); checkargs=(core is-installed --network)
  else
    subcmd=(core install);           checkargs=(core is-installed)
  fi
  printf '%s\n' "$wp_admin_pass" | "${wp[@]}" "${subcmd[@]}" \
    --url="https://${domain}" --title="$wp_title" --admin_user="$wp_admin_user" \
    --admin_email="$wp_admin_email" --skip-email --prompt=admin_password \
    >> "$CLI_LOG" 2>&1 || { warn "wp ${subcmd[*]} failed"; return 1; }

  _progress 97 wp_verify "Verifying installation"
  # 4. Verify
  "${wp[@]}" "${checkargs[@]}" >> "$CLI_LOG" 2>&1 \
    || { warn "WordPress not installed after setup"; return 1; }

  return 0
}

# Validate the .aidipanel-managed marker before a destructive purge. return 1 to refuse.
_site_purge_guard() {
  local domain="$1" site_user="$2" expect_user="$3"
  [[ -n "$site_user" ]] || { warn "No site_user resolved for ${domain}."; return 1; }
  local marker="${HOME_BASE}/${site_user}/.aidipanel-managed"
  [[ -f "$marker" ]] || { warn "Marker missing: ${marker}"; return 1; }
  [[ "$(stat -c '%U:%G' "$marker" 2>/dev/null)" == "root:root" ]] \
    || { warn "Marker not root-owned (site-user may have replaced it) — refusing purge."; return 1; }
  case "$(stat -c '%a' "$marker" 2>/dev/null)" in
    644|640|600|400) ;;
    *) warn "Marker has unsafe/writable mode — refusing purge."; return 1 ;;
  esac
  grep -q "\"domain\": \"${domain}\"" "$marker"       || { warn "Marker domain mismatch."; return 1; }
  grep -q "\"site_user\": \"${site_user}\"" "$marker" || { warn "Marker site_user mismatch."; return 1; }
  if [[ -n "$expect_user" && "$expect_user" != "$site_user" ]]; then
    warn "Marker user (${site_user}) != --user (${expect_user})."; return 1
  fi
  return 0
}

_site_delete() {
  _require_root "site:delete"
  _parse_opts "$@"
  local domain; domain=$(_opt "domain")
  _require_arg "domain" "$domain" "site:delete --domain example.com [--purge --yes]"
  _domain_valid "$domain" || die "Invalid domain name: ${domain}"
  _domain_exists "$domain" || die "Site not found: ${domain}"
  local purge yes force expect_user
  purge=$(_opt "purge" "false"); yes=$(_opt "yes" "false")
  force=$(_opt "force" "false"); expect_user=$(_opt "user" "")
  [[ "$force" == "true" ]] && yes="true"     # back-compat: --force == non-interactive (keep-home)

  if [[ "$purge" == "true" ]]; then
    [[ "$yes" == "true" ]] || die "Refusing purge without --yes (no interactive TTY through the web wrapper)."
  elif [[ "$yes" != "true" ]]; then
    echo -e "${RED}WARNING: removes vhost + PHP-FPM pool + databases for ${domain} (home kept).${RESET}"
    _confirm "Delete site '${domain}'?" || { log "Cancelled."; return 0; }
  fi

  # Site deletion removes Cloudflare-only dependency state plus the shared vhost.
  # Serialize it with global mutations first, then every per-site Security action.
  _cloudflare_lock x || { echo "error=busy"; return 3; }
  _security_lock "$domain" x || { echo "error=busy"; return 3; }

  # Resolve site_user from the now-locked vhost root (all types incl static/proxy);
  # php_ver from the FPM socket if present (none for static/proxy -> no pool).
  local conf="${NGINX_CONF_DIR}/${domain}.conf"
  local site_user php_ver
  site_user=$(grep -oP '^\s*root\s+/home/\K[^/;]+' "$conf" 2>/dev/null | head -1 || echo "")
  php_ver=$(grep -oP 'php\K[0-9.]+(?=-fpm)' "$conf" 2>/dev/null | head -1 || echo "")
  if [[ "$purge" == "true" ]]; then
    _site_purge_guard "$domain" "$site_user" "$expect_user" \
      || die "Purge refused for ${domain} (marker validation failed)."
  fi

  # Teardown (both modes)
  _db_deprovision_site "$site_user" "$domain"
  _redis_site_purge "$site_user"   # drop per-site Redis ACL user + keys (backlog #6)
  rm -f "${NGINX_ENABLED_DIR}/${domain}.conf" "${NGINX_CONF_DIR}/${domain}.conf"
  rm -f "$(_security_http_inc "$domain")"
  rm -f "$(_security_ipblock_inc "$domain")"
  rm -rf -- "$(_security_dir "$domain")"
  rm -f "/etc/ssl/aidipanel-self/${domain}.crt" "/etc/ssl/aidipanel-self/${domain}.key"
  # Remove the per-site FPM pool. A site has exactly one pool (named by site_user);
  # sweep EVERY PHP version so a php_ver-resolution miss can't leave an orphan pool
  # that later makes `php-fpm -t` (and the whole service) fail for that version.
  if [[ -n "$site_user" ]]; then
    local _pool _pv
    for _pool in /etc/php/*/fpm/pool.d/"${site_user}".conf; do
      [[ -f "$_pool" ]] || continue
      _pv=$(printf '%s' "$_pool" | sed -n 's#^/etc/php/\([0-9.]\+\)/fpm/.*#\1#p')
      [[ -n "$_pv" ]] && _remove_fpm_pool "$site_user" "$_pv"
    done
  fi
  _cache_purge_domain "$domain" 2>/dev/null || true
  _nginx_test_reload

  if [[ "$purge" == "true" && -n "$site_user" ]]; then
    _remove_site_user "$site_user"   # user + home + its (otherwise-orphan) group
    ok "Site purged: ${domain} (user ${site_user} + home removed)"
  else
    [[ -n "$site_user" ]] && passwd -l "$site_user" >> "$CLI_LOG" 2>&1 || true
    ok "Site deleted: ${domain} (home kept; user ${site_user:-unknown} locked)"
  fi
}

_site_list() {
  _parse_opts "$@"
  local found=0

  echo ""
  printf "  ${BOLD}%-30s %-8s %-18s %-10s${RESET}\n" "Domain" "PHP" "Type" "SSL"
  _hr

  for conf in "${NGINX_CONF_DIR}"/*.conf; do
    [[ -f "$conf" ]] || continue
    [[ "$(basename "$conf")" == "aidipanel-ui.conf" ]] && continue

    local domain; domain=$(basename "$conf" .conf)
    local php_ver; php_ver=$(grep -oP 'php\K[0-9.]+(?=-fpm)' "$conf" 2>/dev/null | head -1 || echo "-")
    local site_type; site_type=$(grep -oP '# Type: \K\w+' "$conf" 2>/dev/null || echo "php")
    local ssl_status="self-signed"

    # Check if Let's Encrypt cert exists
    if [[ -f "/etc/letsencrypt/live/${domain}/fullchain.pem" ]]; then
      # Check expiry
      local expiry; expiry=$(openssl x509 -enddate -noout \
        -in "/etc/letsencrypt/live/${domain}/fullchain.pem" 2>/dev/null \
        | cut -d= -f2 || echo "unknown")
      ssl_status="LE (${expiry})"
    fi

    printf "  %-30s %-8s %-18s %-10s\n" "$domain" "$php_ver" "$site_type" "$ssl_status"
    (( found++ )) || true
  done

  _hr
  echo ""
  [[ $found -eq 0 ]] && info "No sites found. Add one: aidipanel site:add --domain example.com"
  echo "  Total: ${found} site(s)"
  echo ""
}

# Resolve a site's document root from its vhost. Anchors on the per-site-user
# /home/<user>/htdocs/<domain> root, skipping the /var/www/letsencrypt
# ACME-challenge root that SSL vhosts also contain. Echoes empty if none found.
_vhost_webroot() {
  grep -oP '^\s*root\s+\K/home/[^;]+' "$1" 2>/dev/null | head -1 | tr -d ' ' || true
}

# ---------------------------------------------------------------------------
# Cron jobs (per-site). Managed jobs live in the site user's own crontab and are
# tagged so manually added lines are never touched. The pure helpers below are
# unit-tested; crontab integration + the cron:* commands build on them.
# ---------------------------------------------------------------------------

# Validate a 5-field cron schedule. Returns 0 if valid, 1 otherwise. No output.
_cron_validate_schedule() {
  python3 - "$1" <<'PY'
import sys, re
s = sys.argv[1].split()
if len(s) != 5:
    sys.exit(1)
bounds = [(0, 59), (0, 23), (1, 31), (1, 12), (0, 7)]   # min hour dom mon dow
def ok_field(field, lo, hi):
    for part in field.split(','):
        if part == '*':
            continue
        m = re.fullmatch(r'(\*|\d+(?:-\d+)?)(?:/(\d+))?', part)
        if not m:
            return False
        rng, step = m.group(1), m.group(2)
        if step is not None and int(step) < 1:
            return False
        if rng != '*':
            nums = [int(x) for x in rng.split('-')]
            if any(n < lo or n > hi for n in nums):
                return False
            if len(nums) == 2 and nums[0] > nums[1]:
                return False
    return True
for field, (lo, hi) in zip(s, bounds):
    if not ok_field(field, lo, hi):
        sys.exit(1)
sys.exit(0)
PY
}

# Trailing managed-job tag for an id.
_cron_tag() {
  printf '# aidipanel id=%s' "$1"
}

# Build the ACTIVE crontab line: "<schedule> <command> # aidipanel id=<id>"
_cron_line_active() {
  local id="$1" sched="$2" cmd="$3"
  printf '%s %s %s' "$sched" "$cmd" "$(_cron_tag "$id")"
}

# Render one stored line for a state (active|off) from schedule + command.
_cron_render() {
  local id="$1" state="$2" sched="$3" cmd="$4" line
  line="$(_cron_line_active "$id" "$sched" "$cmd")"
  if [[ "$state" == "off" ]]; then printf '#AIDIPANEL_OFF %s' "$line"; else printf '%s' "$line"; fi
  return 0
}

# Read a crontab on stdin, drop any managed line for <id> (active or off), then
# (unless action=delete) append the rendered <state> line. Foreign/manual lines
# pass through untouched and in order.
_cron_merge() {
  local id="$1" action="$2" sched="$3" cmd="$4" tag line
  tag="$(_cron_tag "$id")"
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" == *"$tag" ]] && continue
    printf '%s\n' "$line"
  done
  if [[ "$action" != "delete" ]]; then
    _cron_render "$id" "$action" "$sched" "$cmd"
    printf '\n'
  fi
  return 0
}

# Resolve a domain to its site user + webroot (mirrors _cache_redis_resolve).
# Sets CRON_CONF / CRON_USER / CRON_WEBROOT; die on unknown/invalid domain.
_cron_resolve() {
  local domain="$1"
  _domain_valid "$domain" || die "Invalid domain name: ${domain}"
  CRON_CONF="${NGINX_CONF_DIR}/${domain}.conf"
  [[ -f "$CRON_CONF" ]] || die "Site not found: ${domain}"
  CRON_USER=$(grep -oP '^\s*root\s+/home/\K[^/;]+' "$CRON_CONF" 2>/dev/null | head -1 || echo "")
  [[ -n "$CRON_USER" ]] || die "Could not resolve the site user for ${domain}."
  CRON_WEBROOT=$(_vhost_webroot "$CRON_CONF")
  return 0
}

# Replace a user's crontab from stdin text (crontab itself validates syntax).
_cron_install_for_user() {
  local user="$1" tmp; tmp=$(mktemp) || return 1
  cat > "$tmp"
  if ! crontab -u "$user" "$tmp" 2>/dev/null; then rm -f "$tmp"; return 1; fi
  rm -f "$tmp"; return 0
}

_cron_list() {
  _require_root "cron:list"
  _parse_opts "$@"
  local domain; domain=$(_opt "domain"); _require_arg "domain" "$domain" "cron:list --domain example.com"
  _cron_resolve "$domain"
  local manual=0 line body sched cmd id state m h dom mon dow
  echo "site_user=${CRON_USER}"
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" != \#* && "$line" == *' # aidipanel id='* ]]; then
      state=active
    elif [[ "$line" == '#AIDIPANEL_OFF '*' # aidipanel id='* ]]; then
      state=off; line="${line#\#AIDIPANEL_OFF }"
    elif [[ -n "${line// }" ]]; then
      manual=$((manual + 1)); continue
    else
      continue
    fi
    id="${line##* id=}"
    body="${line% # aidipanel id=*}"
    IFS=' ' read -r m h dom mon dow cmd <<< "$body"
    sched="${m} ${h} ${dom} ${mon} ${dow}"
    printf 'job\tid=%s\tstate=%s\tschedule=%s\tcommand=%s\n' "$id" "$state" "$sched" "$cmd"
  done < <(crontab -u "$CRON_USER" -l 2>/dev/null || true)
  echo "manual_count=${manual}"
  return 0
}

_cron_add() {
  _require_root "cron:add"
  _parse_opts "$@"
  local domain sched id cmd
  domain=$(_opt "domain"); _require_arg "domain" "$domain" "cron:add --domain X --schedule '* * * * *' (command on stdin)"
  sched=$(_opt "schedule"); _require_arg "schedule" "$sched" "cron:add --domain X --schedule '* * * * *'"
  _cron_validate_schedule "$sched" || die "Invalid cron schedule: ${sched}"
  id=$(_opt "id"); [[ -n "$id" ]] || id=$(openssl rand -hex 4)
  [[ "$id" =~ ^[a-z0-9]+$ ]] || die "Invalid job id."
  cmd=$(cat); cmd="${cmd%$'\n'}"
  [[ -n "$cmd" ]] || die "Command is required."
  [[ "$cmd" != *$'\n'* ]] || die "Command must be a single line."
  [[ "${#cmd}" -le 1000 ]] || die "Command is too long (max 1000 characters)."
  _cron_resolve "$domain"
  { crontab -u "$CRON_USER" -l 2>/dev/null || true; } | _cron_merge "$id" active "$sched" "$cmd" \
    | _cron_install_for_user "$CRON_USER" || die "Could not update the crontab for ${domain}."
  ok "Cron job saved."
  echo "id=${id}"
  return 0
}

_cron_delete() {
  _require_root "cron:delete"
  _parse_opts "$@"
  local domain id
  domain=$(_opt "domain"); _require_arg "domain" "$domain" "cron:delete --domain X --id <id>"
  id=$(_opt "id"); [[ "$id" =~ ^[a-z0-9]+$ ]] || die "Invalid job id."
  _cron_resolve "$domain"
  { crontab -u "$CRON_USER" -l 2>/dev/null || true; } | _cron_merge "$id" delete "" "" \
    | _cron_install_for_user "$CRON_USER" || die "Could not update the crontab for ${domain}."
  ok "Cron job deleted."
  return 0
}

_cron_toggle() {
  _require_root "cron:toggle"
  _parse_opts "$@"
  local domain id state current body sched cmd render_state m h dom mon dow
  domain=$(_opt "domain"); _require_arg "domain" "$domain" "cron:toggle --domain X --id <id> --state on|off"
  id=$(_opt "id"); [[ "$id" =~ ^[a-z0-9]+$ ]] || die "Invalid job id."
  state=$(_opt "state"); [[ "$state" == "on" || "$state" == "off" ]] || die "State must be on or off."
  _cron_resolve "$domain"
  current=$({ crontab -u "$CRON_USER" -l 2>/dev/null || true; } | grep -E " # aidipanel id=${id}\$" | head -1 || true)
  [[ -n "$current" ]] || die "Cron job not found: ${id}"
  current="${current#\#AIDIPANEL_OFF }"
  body="${current% # aidipanel id=*}"
  IFS=' ' read -r m h dom mon dow cmd <<< "$body"
  sched="${m} ${h} ${dom} ${mon} ${dow}"
  if [[ "$state" == "on" ]]; then render_state=active; else render_state=off; fi
  { crontab -u "$CRON_USER" -l 2>/dev/null || true; } | _cron_merge "$id" "$render_state" "$sched" "$cmd" \
    | _cron_install_for_user "$CRON_USER" || die "Could not update the crontab for ${domain}."
  ok "Cron job turned ${state}."
  return 0
}

_cron_wp() {
  _require_root "cron:wp"
  _parse_opts "$@"
  local domain action interval wp_bak wp_bin
  domain=$(_opt "domain"); _require_arg "domain" "$domain" "cron:wp --domain X --action enable|disable [--interval 5]"
  action=$(_opt "action"); [[ "$action" == "enable" || "$action" == "disable" ]] || die "Action must be enable or disable."
  _cron_resolve "$domain"
  [[ -f "${CRON_WEBROOT}/wp-config.php" ]] || die "This site is not a WordPress install."
  local wp=(sudo -u "$CRON_USER" -- env "WP_CLI_CACHE_DIR=/tmp/aidipanel-wp-cli-cache" wp --path="$CRON_WEBROOT")
  wp_bin=$(command -v wp 2>/dev/null || echo /usr/local/bin/wp)   # absolute path for cron (minimal PATH)
  if [[ "$action" == "enable" ]]; then
    interval=$(_opt "interval" "5")
    { [[ "$interval" =~ ^[0-9]+$ ]] && (( interval >= 1 && interval <= 60 )); } || die "Interval must be between 1 and 60 minutes."
    wp_bak="${CRON_WEBROOT}/wp-config.php.aidipanel-bak.$(date +%Y%m%dT%H%M%SZ)"
    cp -p "${CRON_WEBROOT}/wp-config.php" "$wp_bak" || die "Could not back up wp-config.php."
    "${wp[@]}" config set DISABLE_WP_CRON true --raw --type=constant >/dev/null 2>&1 || die "Could not set DISABLE_WP_CRON."
    { crontab -u "$CRON_USER" -l 2>/dev/null || true; } \
      | _cron_merge wpcron active "*/${interval} * * * *" "cd ${CRON_WEBROOT} && ${wp_bin} cron event run --due-now --quiet" \
      | _cron_install_for_user "$CRON_USER" || die "Could not install the WordPress cron job."
    ok "WordPress cron enabled (every ${interval} min)."
  else
    { crontab -u "$CRON_USER" -l 2>/dev/null || true; } | _cron_merge wpcron delete "" "" \
      | _cron_install_for_user "$CRON_USER" || die "Could not remove the WordPress cron job."
    "${wp[@]}" config set DISABLE_WP_CRON false --raw --type=constant >/dev/null 2>&1 \
      || warn "Removed the cron job, but could not revert DISABLE_WP_CRON."
    ok "WordPress cron disabled."
  fi
  echo "wp_cron=${action}d"
  return 0
}

# ---------------------------------------------------------------------------
# File manager (per-site). Jail root = /home/<site_user>. The CLI resolves the
# user from the domain (authoritative), drops to that user with `sudo -u` for all
# I/O, and validates every path with realpath containment. Untrusted paths/names
# arrive on STDIN (never argv) because the web wrapper filters argument content;
# only --domain + safe flags (--mode/--new/--recursive/--expect-sha256) cross as
# arguments. See _files_resolve / _files_resolve_existing / _files_resolve_new.
# ---------------------------------------------------------------------------

# Resolve a domain to its site user + jail root. Sets FILES_USER / FILES_HOME.
_files_resolve() {
  local domain="$1"
  _domain_valid "$domain" || die "Invalid domain name: ${domain}"
  local conf="${NGINX_CONF_DIR}/${domain}.conf"
  [[ -f "$conf" ]] || die "Site not found: ${domain}"
  FILES_USER=$(grep -oP '^\s*root\s+/home/\K[^/;]+' "$conf" 2>/dev/null | head -1 || echo "")
  [[ -n "$FILES_USER" ]] || die "Could not resolve the site user for ${domain}."
  FILES_HOME="${HOME_BASE}/${FILES_USER}"
  [[ -d "$FILES_HOME" ]] || die "Site home not found: ${FILES_HOME}"
  return 0
}

# Normalize a jail-relative path string (strip a leading slash; reject newline).
_files_clean_rel() {
  local rel="$1"
  rel="${rel#/}"
  [[ "$rel" != *$'\n'* ]] || die "Invalid path."
  printf '%s' "$rel"
}

# Resolve an EXISTING path; realpath must land inside the jail. Echoes abs path.
_files_resolve_existing() {
  local rel abs
  rel=$(_files_clean_rel "$1")
  abs=$(realpath -- "${FILES_HOME}/${rel}" 2>/dev/null) || die "No such file or directory."
  [[ "$abs" == "$FILES_HOME" || "$abs" == "$FILES_HOME"/* ]] || die "Path is outside the site."
  printf '%s' "$abs"
}

# Resolve a NEW path: parent must exist + be inside the jail; basename validated.
_files_resolve_new() {
  local rel parent base rparent
  rel=$(_files_clean_rel "$1")
  parent=$(dirname -- "${FILES_HOME}/${rel}")
  base=$(basename -- "${FILES_HOME}/${rel}")
  [[ -n "$base" && "$base" != "." && "$base" != ".." ]] || die "Invalid name."
  [[ "${#base}" -le 255 ]] || die "Name too long."
  rparent=$(realpath -- "$parent" 2>/dev/null) || die "Destination folder does not exist."
  [[ "$rparent" == "$FILES_HOME" || "$rparent" == "$FILES_HOME"/* ]] || die "Path is outside the site."
  printf '%s/%s' "$rparent" "$base"
}

# Validate a basename-only token (rename target / new name / archive name).
_files_basename_only() {
  local b="$1"
  [[ -n "$b" && "$b" != *"/"* && "$b" != "." && "$b" != ".." && "$b" != *$'\n'* ]] || die "Invalid name."
  [[ "${#b}" -le 255 ]] || die "Name too long."
  printf '%s' "$b"
}

# Run a command as the resolved site user.
_files_run() { sudo -u "$FILES_USER" -- "$@"; }

# Resolve a path WITHOUT following a final symlink: parent canonicalized + inside
# the jail, final component kept literal; the entry must exist. Used by delete/
# rename/move/copy/zip so we act on the named entry, never its symlink target.
_files_resolve_nofollow() {
  local rel parent base rparent full
  rel=$(_files_clean_rel "$1")
  [[ -n "$rel" ]] || die "Path is required."
  parent=$(dirname -- "${FILES_HOME}/${rel}")
  base=$(basename -- "${FILES_HOME}/${rel}")
  [[ -n "$base" && "$base" != "." && "$base" != ".." ]] || die "Invalid name."
  rparent=$(realpath -- "$parent" 2>/dev/null) || die "No such file or directory."
  [[ "$rparent" == "$FILES_HOME" || "$rparent" == "$FILES_HOME"/* ]] || die "Path is outside the site."
  full="${rparent}/${base}"
  [[ -e "$full" || -L "$full" ]] || die "No such file or directory."
  printf '%s' "$full"
}

# files:list --domain X    (path on stdin; empty = jail root) -> JSON listing
_files_list() {
  _require_root "files:list"
  _parse_opts "$@"
  local domain rel dir
  domain=$(_opt "domain"); _require_arg "domain" "$domain" "files:list --domain X (path on stdin)"
  _files_resolve "$domain"
  IFS= read -r rel || true
  dir=$(_files_resolve_existing "$rel")
  [[ -d "$dir" ]] || die "Not a directory."
  _files_run python3 - "$dir" "$FILES_HOME" <<'PY'
import json, os, sys, stat, pwd, grp
d, jail = sys.argv[1], sys.argv[2]
def within(p):
    try: rp = os.path.realpath(p)
    except OSError: return False
    return rp == jail or rp.startswith(jail + os.sep)
rel = os.path.relpath(d, jail); rel = "" if rel == "." else rel
crumb, acc = [], ""
for part in [p for p in rel.split(os.sep) if p]:
    acc = f"{acc}/{part}" if acc else part
    crumb.append({"name": part, "path": acc})
out = []
with os.scandir(d) as it:
    for e in it:
        nm = e.name
        if (nm.startswith(".aidipanel-up-") and nm.endswith(".part")) or nm.startswith(".aidipanel-dl.") or nm.startswith(".aidipanel."):
            continue  # hide only the panel's own transient temps (upload parts, download/write tmp)
        try: st = e.stat(follow_symlinks=False)
        except OSError: continue
        is_link = e.is_symlink()
        kind = "symlink" if is_link else ("dir" if e.is_dir(follow_symlinks=False) else "file")
        try: owner = pwd.getpwuid(st.st_uid).pw_name
        except KeyError: owner = str(st.st_uid)
        try: group = grp.getgrgid(st.st_gid).gr_name
        except KeyError: group = str(st.st_gid)
        out.append({
            "name": e.name, "type": kind,
            "size": st.st_size, "mtime": int(st.st_mtime),
            "perms_octal": oct(stat.S_IMODE(st.st_mode))[2:].zfill(4),
            "perms_str": stat.filemode(st.st_mode),
            "owner": owner, "group": group,
            "blocked": bool(is_link and not within(e.path)),
        })
out.sort(key=lambda x: (x["type"] != "dir", x["name"].lower()))
print(json.dumps({"path": rel, "breadcrumb": crumb, "entries": out}))
PY
  return 0
}

# files:read --domain X    (path on stdin) -> JSON {content,sha256,mtime,size} | {error}
_files_read() {
  _require_root "files:read"
  _parse_opts "$@"
  local domain rel file size max
  domain=$(_opt "domain"); _require_arg "domain" "$domain" "files:read --domain X (path on stdin)"
  _files_resolve "$domain"
  IFS= read -r rel || true
  [[ -n "$rel" ]] || die "Path is required."
  file=$(_files_resolve_existing "$rel")
  [[ -f "$file" ]] || die "Not a regular file."
  max=${AIDIPANEL_FILES_EDIT_MAX:-2097152}
  size=$(_files_run stat -c '%s' -- "$file")
  if (( size > max )); then echo '{"error":"too_large"}'; return 0; fi
  _files_run python3 - "$file" <<'PY'
import json, sys, hashlib, os
f = sys.argv[1]
with open(f, "rb") as fh: data = fh.read()
if b"\x00" in data:
    print('{"error":"binary"}'); sys.exit(0)
print(json.dumps({
    "content": data.decode("utf-8", "replace"),
    "sha256": hashlib.sha256(data).hexdigest(),
    "mtime": int(os.path.getmtime(f)),
    "size": len(data),
}))
PY
  return 0
}

# files:write --domain X [--new] [--expect-sha256 HEX]   (line1=path, rest=content)
_files_write() {
  _require_root "files:write"
  _parse_opts "$@"
  local domain expect is_new rel dest tmp oldmode cur _a
  domain=$(_opt "domain"); _require_arg "domain" "$domain" "files:write --domain X (path+content on stdin)"
  _files_resolve "$domain"
  expect=$(_opt "expect-sha256")
  is_new=0; for _a in "$@"; do [[ "$_a" == "--new" ]] && is_new=1; done
  IFS= read -r rel || true
  [[ -n "$rel" ]] || die "Path is required."
  if [[ "$is_new" == "1" ]]; then
    dest=$(_files_resolve_new "$rel")
    [[ ! -e "$dest" ]] || die "A file with that name already exists."
    oldmode=0644
  else
    dest=$(_files_resolve_existing "$rel")
    [[ -f "$dest" ]] || die "Not a regular file."
    oldmode=$(_files_run stat -c '%a' -- "$dest")
    if [[ -n "$expect" ]]; then
      cur=$(_files_run sha256sum -- "$dest" | awk '{print $1}')
      [[ "$cur" == "$expect" ]] || { echo '{"error":"conflict"}'; return 0; }
    fi
  fi
  tmp=$(_files_run mktemp -- "$(dirname -- "$dest")/.aidipanel.XXXXXX") || die "Could not create a temp file."
  _files_run tee -- "$tmp" >/dev/null
  _files_run chmod "$oldmode" -- "$tmp" 2>/dev/null || true
  _files_run mv -f -- "$tmp" "$dest" || { _files_run rm -f -- "$tmp"; die "Could not save the file."; }
  ok "Saved."
  return 0
}

# files:mkdir --domain X   (path on stdin)
_files_mkdir() {
  _require_root "files:mkdir"
  _parse_opts "$@"
  local domain rel dest
  domain=$(_opt "domain"); _require_arg "domain" "$domain" "files:mkdir --domain X (path on stdin)"
  _files_resolve "$domain"
  IFS= read -r rel || true
  [[ -n "$rel" ]] || die "Path is required."
  dest=$(_files_resolve_new "$rel")
  [[ ! -e "$dest" ]] || die "A file or folder with that name already exists."
  _files_run mkdir -m 0755 -- "$dest" || die "Could not create the folder."
  ok "Folder created."
  return 0
}

# files:delete --domain X  (one path per line on stdin)
_files_delete() {
  _require_root "files:delete"
  _parse_opts "$@"
  local domain line abs n=0
  domain=$(_opt "domain"); _require_arg "domain" "$domain" "files:delete --domain X (paths on stdin)"
  _files_resolve "$domain"
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -n "$line" ]] || continue
    abs=$(_files_resolve_nofollow "$line")
    [[ "$abs" != "$FILES_HOME" ]] || die "Refusing to delete the site root."
    if [[ -L "$abs" ]]; then
      _files_run rm -f -- "$abs"            # symlink: remove the link only
    else
      _files_run rm -rf -- "$abs"           # rm does not traverse symlinks it removes
    fi
    n=$((n + 1))
  done
  ok "Deleted ${n} item(s)."
  return 0
}

# files:download --domain X  (path on stdin) -> raw bytes on stdout
_files_download() {
  _require_root "files:download"
  _parse_opts "$@"
  local domain rel file
  domain=$(_opt "domain"); _require_arg "domain" "$domain" "files:download --domain X (path on stdin)"
  _files_resolve "$domain"
  IFS= read -r rel || true
  [[ -n "$rel" ]] || die "Path is required."
  file=$(_files_resolve_existing "$rel")
  [[ -f "$file" ]] || die "Not a regular file."
  _files_run cat -- "$file"
  return 0
}

# files:rename --domain X   (line1=path, line2=newName)
_files_rename() {
  _require_root "files:rename"
  _parse_opts "$@"
  local domain rel to src parent dest
  domain=$(_opt "domain"); _require_arg "domain" "$domain" "files:rename --domain X (path,newName on stdin)"
  _files_resolve "$domain"
  IFS= read -r rel || true
  IFS= read -r to || true
  [[ -n "$rel" ]] || die "Path is required."
  to=$(_files_basename_only "$to")
  src=$(_files_resolve_nofollow "$rel")
  [[ "$src" != "$FILES_HOME" ]] || die "Cannot rename the site root."
  parent=$(dirname -- "$src")
  dest="${parent}/${to}"
  [[ ! -e "$dest" ]] || die "A file with that name already exists."
  _files_run mv -n -- "$src" "$dest" || die "Rename failed."
  ok "Renamed."
  return 0
}

# files:copy / files:move --domain X   (line1=destDir, then one source path per line)
_files_copy() { _files_copy_or_move copy "$@"; }
_files_move() { _files_copy_or_move move "$@"; }
_files_copy_or_move() {
  local mode="$1"; shift
  _require_root "files:${mode}"
  _parse_opts "$@"
  local domain to destdir line src base dest n=0
  domain=$(_opt "domain"); _require_arg "domain" "$domain" "files:${mode} --domain X (destDir + paths on stdin)"
  _files_resolve "$domain"
  IFS= read -r to || true; [[ "$to" == "." ]] && to=""
  destdir=$(_files_resolve_existing "$to")
  [[ -d "$destdir" ]] || die "Destination is not a folder."
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -n "$line" ]] || continue
    src=$(_files_resolve_nofollow "$line")
    base=$(basename -- "$src")
    dest="${destdir}/${base}"
    case "${dest}/" in "${src}/"*) die "Cannot copy or move a folder into itself." ;; esac
    [[ ! -e "$dest" ]] || die "Already exists in destination: ${base}"
    if [[ "$mode" == "copy" ]]; then
      _files_run cp -a -- "$src" "$dest" || die "Copy failed for ${base}."
    else
      _files_run mv -n -- "$src" "$dest" || die "Move failed for ${base}."
    fi
    n=$((n + 1))
  done
  ok "${mode} done (${n})."
  return 0
}

# files:chmod --domain X --mode 0644 [--recursive]   (one path per line on stdin)
_files_chmod() {
  _require_root "files:chmod"
  _parse_opts "$@"
  local domain mode rec line abs n=0 _a
  domain=$(_opt "domain"); _require_arg "domain" "$domain" "files:chmod --domain X --mode 0644 (paths on stdin)"
  _files_resolve "$domain"
  mode=$(_opt "mode"); _require_arg "mode" "$mode" "files:chmod ... --mode 0644"
  case "$mode" in 0644|0664|0600|0755|0775|0700) ;; *) die "Permission ${mode} is not allowed." ;; esac
  rec=0; for _a in "$@"; do [[ "$_a" == "--recursive" ]] && rec=1; done
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -n "$line" ]] || continue
    abs=$(_files_resolve_existing "$line")
    if [[ "$rec" == "1" ]]; then
      _files_run chmod -R "$mode" -- "$abs" || die "chmod failed."
    else
      _files_run chmod "$mode" -- "$abs" || die "chmod failed."
    fi
    n=$((n + 1))
  done
  ok "Permissions updated (${n})."
  return 0
}

# files:zip --domain X   (line1=cwdDir, line2=archiveName.zip, then one source per line)
_files_zip() {
  _require_root "files:zip"
  _parse_opts "$@"
  local domain reldir name cwd dest line src n=0
  local -a args=()
  domain=$(_opt "domain"); _require_arg "domain" "$domain" "files:zip --domain X (dir,name,paths on stdin)"
  _files_resolve "$domain"
  IFS= read -r reldir || true; [[ "$reldir" == "." ]] && reldir=""
  IFS= read -r name || true
  name=$(_files_basename_only "$name")
  [[ "$name" == *.zip ]] || die "Archive name must end in .zip"
  cwd=$(_files_resolve_existing "$reldir"); [[ -d "$cwd" ]] || die "Not a folder."
  dest="${cwd}/${name}"
  [[ ! -e "$dest" ]] || die "An archive with that name already exists."
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -n "$line" ]] || continue
    src=$(_files_resolve_nofollow "$line")
    [[ "$(dirname -- "$src")" == "$cwd" ]] || die "Can only compress items in the current folder."
    args+=("./$(basename -- "$src")")
    n=$((n + 1))
  done
  [[ "$n" -gt 0 ]] || die "Nothing to compress."
  # zip rejects `--`; prefix with ./ so leading-dash names aren't read as options
  # (zip strips the ./ in stored entry names).
  ( cd "$cwd" && _files_run zip -r -y -q "./${name}" "${args[@]}" ) || die "Compression failed."
  ok "Created ${name}."
  return 0
}

# files:unzip --domain X   (line1=archivePath, line2=destDir optional). Hardened.
_files_unzip() {
  _require_root "files:unzip"
  _parse_opts "$@"
  local domain relarc reldest archive destdir out
  domain=$(_opt "domain"); _require_arg "domain" "$domain" "files:unzip --domain X (archive[,dest] on stdin)"
  _files_resolve "$domain"
  IFS= read -r relarc || true
  IFS= read -r reldest || true
  [[ -n "$relarc" ]] || die "Archive path is required."
  archive=$(_files_resolve_existing "$relarc"); [[ -f "$archive" ]] || die "Not a file."
  if [[ -n "$reldest" ]]; then destdir=$(_files_resolve_existing "$reldest"); else destdir=$(dirname -- "$archive"); fi
  [[ -d "$destdir" ]] || die "Destination is not a folder."
  out=$(_files_run python3 - "$archive" "$destdir" <<'PY'
import os, sys, zipfile
archive, dest = sys.argv[1], os.path.realpath(sys.argv[2])
MAX_ENTRIES, MAX_TOTAL, MAX_RATIO = 10000, 1 << 30, 100
try:
    z = zipfile.ZipFile(archive)
except Exception:
    print("Not a valid zip archive."); sys.exit(1)
infos = z.infolist()
if len(infos) > MAX_ENTRIES:
    print("Too many entries in the archive."); sys.exit(1)
comp = sum(i.compress_size for i in infos) or 1
total = sum(i.file_size for i in infos)
if total > MAX_TOTAL or (total / comp) > MAX_RATIO:
    print("Archive too large (possible zip bomb)."); sys.exit(1)
for i in infos:
    if (i.external_attr >> 16) & 0o170000 == 0o120000:
        print("Symlink entries are not allowed."); sys.exit(1)
    name = i.filename
    if name.startswith("/") or ".." in name.replace("\\", "/").split("/"):
        print("Unsafe path in archive."); sys.exit(1)
    target = os.path.realpath(os.path.join(dest, name))
    if target != dest and not target.startswith(dest + os.sep):
        print("An entry escapes the destination."); sys.exit(1)
for i in infos:
    outp = os.path.join(dest, i.filename)
    if i.is_dir():
        os.makedirs(outp, mode=0o755, exist_ok=True); continue
    os.makedirs(os.path.dirname(outp) or dest, mode=0o755, exist_ok=True)
    with z.open(i) as src, open(outp, "wb") as dst:
        while True:
            chunk = src.read(1 << 20)
            if not chunk: break
            dst.write(chunk)
    os.chmod(outp, 0o644)
PY
) || die "${out:-Extraction failed.}"
  ok "Extracted."
  return 0
}

# files:download-many --domain X   (one jail-relative path per line on stdin)
# Zips the selection (all items must share one parent = the listing dir) into a
# temp archive under the jail, streams it to stdout, then removes it.
_files_download_many() {
  _require_root "files:download-many"
  _parse_opts "$@"
  local domain line src parent cwd="" tmp n=0
  local -a args=()
  domain=$(_opt "domain"); _require_arg "domain" "$domain" "files:download-many --domain X (paths on stdin)"
  _files_resolve "$domain"
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -n "$line" ]] || continue
    src=$(_files_resolve_nofollow "$line")
    parent=$(dirname -- "$src")
    if [[ -z "$cwd" ]]; then cwd="$parent"; elif [[ "$parent" != "$cwd" ]]; then die "All items must be in the same folder."; fi
    args+=("./$(basename -- "$src")")
    n=$((n + 1))
  done
  [[ "$n" -gt 0 ]] || die "Nothing to download."
  tmp=$(_files_run mktemp -d -- "${FILES_HOME}/.aidipanel-dl.XXXXXX") || die "Could not create a temp archive."
  # Always remove the temp archive — even if the client aborts mid-stream (cat gets
  # SIGPIPE and the script exits) or compression fails.
  trap '_files_run rm -rf -- "$tmp" 2>/dev/null || true' EXIT
  ( cd "$cwd" && _files_run zip -r -y -q "${tmp}/archive.zip" "${args[@]}" ) || die "Compression failed."
  _files_run cat -- "${tmp}/archive.zip"
  trap - EXIT
  _files_run rm -rf -- "$tmp"
  return 0
}

# files:upload-chunk --domain X --id TOKEN --offset N [--total N] [--final]
# stdin: line1=destDir, line2=name, then the raw bytes of THIS chunk.
# Appends each chunk to <destDir>/.aidipanel-up-<id>.part at byte <offset> (so a
# retried/partial chunk is idempotent), then --final verifies the size + moves it
# into place. Lets the browser stream multi-GB migration archives in small
# requests, sidestepping nginx/PHP body-size + timeout limits.
_files_upload_chunk() {
  _require_root "files:upload-chunk"
  _parse_opts "$@"
  local domain id is_final offset total reldir name dir part dest cur avail max _a
  domain=$(_opt "domain"); _require_arg "domain" "$domain" "files:upload-chunk --domain X --id TOKEN [--final]"
  _files_resolve "$domain"
  id=$(_opt "id"); _require_arg "id" "$id" "files:upload-chunk ... --id TOKEN"
  [[ "$id" =~ ^[A-Za-z0-9]{8,64}$ ]] || die "Invalid upload id."
  offset=$(_opt "offset"); offset=${offset:-0}; [[ "$offset" =~ ^[0-9]+$ ]] || die "Invalid offset."
  total=$(_opt "total");   total=${total:-0};   [[ "$total"  =~ ^[0-9]+$ ]] || die "Invalid total."
  is_final=0; for _a in "$@"; do [[ "$_a" == "--final" ]] && is_final=1; done
  IFS= read -r reldir || true
  IFS= read -r name || true
  name=$(_files_basename_only "$name")
  dir=$(_files_resolve_existing "$reldir"); [[ -d "$dir" ]] || die "Destination is not a folder."
  dest="${dir}/${name}"
  case "$dest" in "$FILES_HOME"|"$FILES_HOME"/*) ;; *) die "Path is outside the site." ;; esac
  [[ ! -e "$dest" ]] || die "A file with that name already exists."
  part="${dir}/.aidipanel-up-${id}.part"
  if [[ "$offset" == "0" ]]; then
    _files_run rm -f -- "$part" 2>/dev/null || true                                                          # fresh start for this id
    _files_run find "$dir" -maxdepth 1 -name '.aidipanel-up-*.part' -mmin +1440 -delete 2>/dev/null || true  # sweep abandoned parts (>24h)
    if [[ "$total" != "0" ]]; then
      avail=$(_files_run df -P -B1 -- "$dir" 2>/dev/null | awk 'NR==2{print $4}')
      if [[ -n "$avail" ]] && (( total + 536870912 > avail )); then die "Not enough disk space for this upload."; fi
    fi
  fi
  # Optional hard ceiling (default 0 = unlimited, for migration archives).
  max=${AIDIPANEL_FILES_UPLOAD_MAX:-0}
  if [[ "$max" != "0" ]] && (( total > max )); then die "Upload exceeds the maximum size."; fi
  # Idempotent append: drop anything at/after this offset (a retried or partially
  # written chunk), then append this chunk's bytes.
  cur=$(_files_run stat -c '%s' -- "$part" 2>/dev/null || echo 0)
  (( cur >= offset )) || die "Upload chunk out of order."
  (( cur == offset )) || _files_run truncate -s "$offset" -- "$part"
  _files_run tee -a -- "$part" >/dev/null || die "Could not write the upload chunk."
  if [[ "$is_final" == "1" ]]; then
    if [[ "$total" != "0" ]]; then
      cur=$(_files_run stat -c '%s' -- "$part" 2>/dev/null || echo 0)
      (( cur == total )) || { _files_run rm -f -- "$part"; die "Upload size mismatch — please retry."; }
    fi
    _files_run chmod 0644 -- "$part" 2>/dev/null || true
    _files_run mv -n -- "$part" "$dest" 2>/dev/null || true
    # mv -n is silent when the target already appeared (TOCTOU); confirm the part moved.
    if _files_run test -e "$part"; then _files_run rm -f -- "$part"; die "A file with that name already exists."; fi
    ok "Uploaded."
  else
    ok "Chunk received."
  fi
  return 0
}

# files:upload-cancel --domain X --id TOKEN   (stdin: destDir)
# Removes a partial chunked-upload temp so an aborted/cancelled upload leaves
# nothing behind.
_files_upload_cancel() {
  _require_root "files:upload-cancel"
  _parse_opts "$@"
  local domain id reldir dir part
  domain=$(_opt "domain"); _require_arg "domain" "$domain" "files:upload-cancel --domain X --id TOKEN (destDir on stdin)"
  _files_resolve "$domain"
  id=$(_opt "id"); _require_arg "id" "$id" "files:upload-cancel ... --id TOKEN"
  [[ "$id" =~ ^[A-Za-z0-9]{8,64}$ ]] || die "Invalid upload id."
  IFS= read -r reldir || true
  dir=$(_files_resolve_existing "$reldir"); [[ -d "$dir" ]] || die "Destination is not a folder."
  part="${dir}/.aidipanel-up-${id}.part"
  _files_run rm -f -- "$part" 2>/dev/null || true
  ok "Upload cancelled."
  return 0
}

# ---------------------------------------------------------------------------
# Per-site SFTP (chrooted, SFTP-only). One shared sshd block keyed on the
# aidipanel-sftp group; enabling a site adds its Linux user to that group and
# makes the home a valid chroot. Reuses the Files resolver (domain -> user/home).
# ---------------------------------------------------------------------------
SFTP_GROUP="aidipanel-sftp"
SFTP_DROPIN="/etc/ssh/sshd_config.d/50-aidipanel-sftp.conf"

# Ensure the group + sshd drop-in exist and are valid; reload sshd only if changed
# and only if `sshd -t` passes (never break SSH).
_sftp_ensure_sshd() {
  getent group "$SFTP_GROUP" >/dev/null 2>&1 || groupadd "$SFTP_GROUP"
  local want changed=0
  want=$(cat <<EOF
# Managed by AidiPanel — per-site chrooted SFTP-only access. Do not edit by hand.
Match Group ${SFTP_GROUP}
    ChrootDirectory %h
    ForceCommand internal-sftp
    AllowTcpForwarding no
    X11Forwarding no
    PermitTunnel no
    PasswordAuthentication yes
EOF
)
  if [[ ! -f "$SFTP_DROPIN" ]] || [[ "$(cat "$SFTP_DROPIN" 2>/dev/null)" != "$want" ]]; then
    printf '%s\n' "$want" > "${SFTP_DROPIN}.tmp"
    chmod 0644 "${SFTP_DROPIN}.tmp"
    mv -f "${SFTP_DROPIN}.tmp" "$SFTP_DROPIN"
    changed=1
  fi
  if ! sshd -t 2>/dev/null; then
    [[ "$changed" == "1" ]] && rm -f "$SFTP_DROPIN"
    die "sshd configuration test failed; SFTP was not applied."
  fi
  if [[ "$changed" == "1" ]]; then
    systemctl reload ssh 2>/dev/null || systemctl reload sshd 2>/dev/null || true
  fi
  return 0
}

# Ensure ~/.ssh + authorized_keys exist with strict perms, owned by the site user.
_sftp_ensure_sshdir() {
  local sshdir="${FILES_HOME}/.ssh" ak="${FILES_HOME}/.ssh/authorized_keys"
  [[ -d "$sshdir" ]] || mkdir -p "$sshdir"
  [[ -f "$ak" ]] || : > "$ak"
  chown "$FILES_USER":"$FILES_USER" "$sshdir" "$ak"
  chmod 700 "$sshdir"; chmod 600 "$ak"
}

# Make the home a valid chroot target (root-owned dir; group stays the user so they
# can still traverse their own home; content subdirs stay user-owned + writable).
_sftp_chroot_prep() {
  chown root:"$FILES_USER" "$FILES_HOME"
  chmod 750 "$FILES_HOME"
  _sftp_ensure_sshdir
}

_sftp_in_group() {
  # space-pad both sides so a substring match is exact; case is IFS-independent
  # (the CLI runs with IFS=$'\n\t', so `for g in $(id -nG)` would NOT split on spaces).
  case " $(id -nG "$FILES_USER" 2>/dev/null) " in
    *" ${SFTP_GROUP} "*) return 0 ;;
  esac
  return 1
}

# sftp:status --domain X -> JSON
_sftp_status() {
  _require_root "sftp:status"; _parse_opts "$@"
  local domain; domain=$(_opt "domain"); _require_arg "domain" "$domain" "sftp:status --domain X"
  _files_resolve "$domain"
  local enabled=0 host port pwhash owner
  _sftp_in_group && enabled=1
  host=$(hostname -I 2>/dev/null | awk '{print $1}'); [[ -n "$host" ]] || host=$(hostname -f 2>/dev/null || hostname)
  port=$(sshd -T 2>/dev/null | awk '/^port /{print $2}' | tail -n1); [[ "$port" =~ ^[0-9]+$ ]] || port=22
  pwhash=$(getent shadow "$FILES_USER" 2>/dev/null | cut -d: -f2)
  owner=$(stat -c '%U' "$FILES_HOME" 2>/dev/null)
  python3 - "$FILES_USER" "${FILES_HOME}/.ssh/authorized_keys" "$enabled" "$host" "$port" "$pwhash" "$owner" <<'PY'
import json, sys, os, hashlib, base64
user, ak, enabled, host, port, pwhash, owner = sys.argv[1:8]
pwset = bool(pwhash) and pwhash[0] not in "!*"
keys = []
if os.path.isfile(ak):
    for line in open(ak, encoding="utf-8", errors="replace"):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split()
        idx = next((i for i, p in enumerate(parts) if p.startswith(("ssh-", "ecdsa-", "sk-"))), None)
        if idx is None or idx + 1 >= len(parts):
            continue
        ktype, b64, comment = parts[idx], parts[idx + 1], " ".join(parts[idx + 2:])
        try:
            fp = "SHA256:" + base64.b64encode(hashlib.sha256(base64.b64decode(b64)).digest()).decode().rstrip("=")
        except Exception:
            fp = ""
        keys.append({"type": ktype, "comment": comment, "fingerprint": fp})
print(json.dumps({
    "enabled": enabled == "1", "password_set": pwset, "chroot_ready": owner == "root",
    "host": host, "port": int(port), "user": user, "path": "/htdocs", "protocol": "SFTP",
    "keys": keys,
}))
PY
  return 0
}

# sftp:enable --domain X
_sftp_enable() {
  _require_root "sftp:enable"; _parse_opts "$@"
  local domain; domain=$(_opt "domain"); _require_arg "domain" "$domain" "sftp:enable --domain X"
  _files_resolve "$domain"
  _sftp_ensure_sshd
  _sftp_chroot_prep
  usermod -aG "$SFTP_GROUP" "$FILES_USER"
  ok "SFTP enabled."
  return 0
}

# sftp:disable --domain X
_sftp_disable() {
  _require_root "sftp:disable"; _parse_opts "$@"
  local domain; domain=$(_opt "domain"); _require_arg "domain" "$domain" "sftp:disable --domain X"
  _files_resolve "$domain"
  if _sftp_in_group; then gpasswd -d "$FILES_USER" "$SFTP_GROUP" >/dev/null 2>&1 || true; fi
  ok "SFTP disabled."
  return 0
}

# sftp:passwd --domain X   (password on stdin, one line)
_sftp_passwd() {
  _require_root "sftp:passwd"; _parse_opts "$@"
  local domain pw; domain=$(_opt "domain"); _require_arg "domain" "$domain" "sftp:passwd --domain X (password on stdin)"
  _files_resolve "$domain"
  IFS= read -r pw || true
  [[ -n "$pw" ]] || die "No password provided."
  [[ "${#pw}" -ge 8 ]] || die "Password must be at least 8 characters."
  printf '%s:%s\n' "$FILES_USER" "$pw" | chpasswd || die "Could not set the password."
  ok "Password set."
  return 0
}

# sftp:passwd-clear --domain X   (disable password auth; keys still work)
_sftp_passwd_clear() {
  _require_root "sftp:passwd-clear"; _parse_opts "$@"
  local domain; domain=$(_opt "domain"); _require_arg "domain" "$domain" "sftp:passwd-clear --domain X"
  _files_resolve "$domain"
  usermod -p '!' "$FILES_USER" || die "Could not clear the password."
  ok "Password disabled (key-only)."
  return 0
}

# sftp:key-add --domain X   (one SSH public key on stdin)
_sftp_key_add() {
  _require_root "sftp:key-add"; _parse_opts "$@"
  local domain key tmp body ak; domain=$(_opt "domain"); _require_arg "domain" "$domain" "sftp:key-add --domain X (key on stdin)"
  _files_resolve "$domain"
  IFS= read -r key || true
  [[ -n "$key" ]] || die "No key provided."
  tmp=$(mktemp); printf '%s\n' "$key" > "$tmp"
  if ! ssh-keygen -l -f "$tmp" >/dev/null 2>&1; then rm -f "$tmp"; die "That is not a valid SSH public key."; fi
  rm -f "$tmp"
  _sftp_ensure_sshdir
  ak="${FILES_HOME}/.ssh/authorized_keys"
  body=$(awk '{print $2}' <<<"$key")
  if [[ -n "$body" ]] && awk -v b="$body" '$2==b{found=1} END{exit !found}' "$ak"; then
    die "That key is already added."
  fi
  printf '%s\n' "$key" >> "$ak"
  chown "$FILES_USER":"$FILES_USER" "$ak"; chmod 600 "$ak"
  ok "Key added."
  return 0
}

# sftp:key-delete --domain X   (fingerprint on stdin, e.g. SHA256:...)
_sftp_key_delete() {
  _require_root "sftp:key-delete"; _parse_opts "$@"
  local domain fp ak; domain=$(_opt "domain"); _require_arg "domain" "$domain" "sftp:key-delete --domain X (fingerprint on stdin)"
  _files_resolve "$domain"
  IFS= read -r fp || true
  [[ -n "$fp" ]] || die "No fingerprint provided."
  ak="${FILES_HOME}/.ssh/authorized_keys"
  [[ -f "$ak" ]] || die "No keys to remove."
  python3 - "$ak" "$fp" <<'PY' || die "Key not found."
import sys, os, hashlib, base64
ak, target = sys.argv[1], sys.argv[2]
out, removed = [], 0
for line in open(ak, encoding="utf-8", errors="replace"):
    s = line.strip()
    if not s or s.startswith("#"):
        out.append(line); continue
    parts = s.split()
    idx = next((i for i, p in enumerate(parts) if p.startswith(("ssh-", "ecdsa-", "sk-"))), None)
    fp = ""
    if idx is not None and idx + 1 < len(parts):
        try:
            fp = "SHA256:" + base64.b64encode(hashlib.sha256(base64.b64decode(parts[idx + 1])).digest()).decode().rstrip("=")
        except Exception:
            fp = ""
    if fp == target:
        removed += 1
    else:
        out.append(line)
if removed:
    tmp = ak + ".tmp"
    open(tmp, "w", encoding="utf-8").writelines(out)
    os.replace(tmp, ak)
sys.exit(0 if removed else 3)
PY
  chown "$FILES_USER":"$FILES_USER" "$ak"; chmod 600 "$ak"
  ok "Key removed."
  return 0
}

_site_info() {
  _parse_opts "$@"
  local domain; domain=$(_opt "domain")
  _require_arg "domain" "$domain" "site:info --domain example.com"
  _domain_valid "$domain" || die "Invalid domain name: ${domain}"
  _domain_exists "$domain" || die "Site not found: ${domain}"

  local conf="${NGINX_CONF_DIR}/${domain}.conf"
  local php_ver; php_ver=$(grep -oP 'php\K[0-9.]+(?=-fpm)' "$conf" 2>/dev/null | head -1 || echo "-")
  local site_type; site_type=$(grep -oP '# Type: \K\w+' "$conf" 2>/dev/null || echo "php")
  local webroot; webroot=$(_vhost_webroot "$conf"); [[ -n "$webroot" ]] || webroot="-"
  local enabled; enabled=$([[ -L "${NGINX_ENABLED_DIR}/${domain}.conf" ]] && echo "yes" || echo "no")
  local disk_usage; disk_usage=$(du -sh "$webroot" 2>/dev/null | cut -f1 || echo "-")

  local ssl_type="self-signed"
  local ssl_expiry="-"
  if [[ -f "/etc/letsencrypt/live/${domain}/fullchain.pem" ]]; then
    ssl_type="Let's Encrypt"
    ssl_expiry=$(openssl x509 -enddate -noout \
      -in "/etc/letsencrypt/live/${domain}/fullchain.pem" 2>/dev/null \
      | cut -d= -f2 || echo "unknown")
  fi

  # FastCGI cache status
  local cache_enabled="disabled"
  grep -Eq "^[[:space:]]*fastcgi_cache[[:space:]]+${NGINX_CACHE_ZONE}" "$conf" 2>/dev/null && cache_enabled="enabled"

  echo ""
  echo -e "  ${BOLD}Site info: ${CYAN}${domain}${RESET}"
  _hr
  _table_row "Type:"            "$site_type"
  _table_row "PHP version:"     "$php_ver"
  _table_row "Webroot:"         "$webroot"
  _table_row "Nginx config:"    "$conf"
  _table_row "Enabled:"         "$enabled"
  _table_row "Disk usage:"      "$disk_usage"
  _table_row "FastCGI cache:"   "$cache_enabled"
  _table_row "SSL type:"        "$ssl_type"
  _table_row "SSL expiry:"      "$ssl_expiry"
  _hr
  echo ""
}

_vhost_save() {
  _require_root "vhost:save"
  _parse_opts "$@"
  local domain; domain=$(_opt "domain")
  local src_file; src_file=$(_opt "file")
  _require_arg "domain" "$domain" "vhost:save --domain example.com --file /path/to/new.conf"
  _require_arg "file" "$src_file" "vhost:save --domain example.com --file /path/to/new.conf"

  _domain_valid "$domain" || die "Invalid domain name: ${domain}"
  _domain_exists "$domain" || die "Site not found: ${domain}"
  [[ -f "$src_file" && -s "$src_file" && -r "$src_file" ]] || die "Config file is not readable: ${src_file}"

  local conf="${NGINX_CONF_DIR}/${domain}.conf"
  local backup; backup="${conf}.bak.$(date +%Y%m%d%H%M%S)"
  cp -p "$conf" "$backup"

  cp "$src_file" "$conf"
  chmod 644 "$conf"

  if ! nginx -t >> "$CLI_LOG" 2>&1; then
    cp "$backup" "$conf"
    nginx -t >> "$CLI_LOG" 2>&1 || true
    die "Nginx config test failed. Restored backup: ${backup}"
  fi

  systemctl reload nginx >> "$CLI_LOG" 2>&1 \
    || { cp "$backup" "$conf"; die "Nginx reload failed. Restored backup: ${backup}"; }

  ok "Vhost saved and Nginx reloaded: ${domain}"
  _table_row "Backup:" "$backup"
}

