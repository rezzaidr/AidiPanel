readonly REDIS_ADMIN_KEY="/etc/aidipanel/redis-admin.key"
readonly REDIS_ACL_STATE="/etc/aidipanel/redis-acl.enabled"
# PHP policy — single source of truth (/etc/aidipanel/php.conf), with a dev fallback.
if [[ -f "/etc/aidipanel/php.conf" ]]; then
  # shellcheck source=/dev/null
  source /etc/aidipanel/php.conf
else
  PHP_DEFAULT_VERSION="8.4"
  PHP_AVAILABLE_VERSIONS="8.2 8.3 8.4 8.5"
  PHP_EXTENSIONS="fpm cli common mysql sqlite3 redis xml mbstring curl zip gd intl bcmath soap imagick opcache"
fi
# Build the supported-versions array (space-split despite global IFS=$'\n\t').
PHP_VERSIONS_SUPPORTED=()
{ local_ifs_save=$IFS; IFS=' '; read -ra PHP_VERSIONS_SUPPORTED <<< "$PHP_AVAILABLE_VERSIONS"; IFS=$local_ifs_save; }

# Colors
# Colors — NO_COLOR support (https://no-color.org)
RED=''; YELLOW=''; GREEN=''
CYAN=''; BOLD=''; DIM=''; RESET=''
BLUE=''
if [[ -z "${NO_COLOR:-}" ]] && [[ -t 1 ]]; then
  RED='\033[0;31m'; YELLOW='\033[1;33m'; GREEN='\033[0;32m'
  CYAN='\033[0;36m'; BOLD='\033[1m'; DIM='\033[2m'; RESET='\033[0m'; BLUE='\033[0;34m'
fi

# ---------------------------------------------------------------------------
# LOGGING
# ---------------------------------------------------------------------------
_ts()    { date '+%Y-%m-%d %H:%M:%S'; }
log()    { echo -e "${CYAN}[INFO]${RESET}  $*"; echo "[$(_ts)] [INFO]  $*" >> "$CLI_LOG" 2>/dev/null || true; }
ok()     { echo -e "${GREEN}[OK]${RESET}    $*"; echo "[$(_ts)] [OK]    $*" >> "$CLI_LOG" 2>/dev/null || true; }
warn()   { echo -e "${YELLOW}[WARN]${RESET}  $*" >&2; echo "[$(_ts)] [WARN]  $*" >> "$CLI_LOG" 2>/dev/null || true; }
die()    { echo -e "${RED}[ERROR]${RESET} $*" >&2; echo "[$(_ts)] [ERROR] $*" >> "$CLI_LOG" 2>/dev/null || true; exit 1; }
info()   { echo -e "${DIM}$*${RESET}"; }

# Escape a value for safe single-quoted interpolation into a sqlite3 statement.
_sql_escape() { printf '%s' "$1" | sed "s/'/''/g"; }

# Progress markers for the panel's streaming UI. Prints ONE machine-readable line
# to stdout per stage, but ONLY when --progress was passed (PROGRESS_ENABLED=1) —
# so terminal use and the smoke tests see byte-identical output otherwise. First
# field is a 0-100 percentage; the panel renders bar=pct + the message + a live
# elapsed timer (long steps simply have a longer gap to the next marker). Always
# returns 0 so it is safe under `set -e`; verbose detail still goes to $CLI_LOG.
PROGRESS_ENABLED=0
_progress() {
  [[ "${PROGRESS_ENABLED:-0}" == 1 ]] || return 0
  local pct="${1:-0}" key="${2:-step}"; shift 2 || true
  local IFS=' '
  local msg="$*"
  printf '@@PROGRESS %s %s %s\n' "$pct" "$key" "$msg"
  return 0
}

# ---------------------------------------------------------------------------
# HELPERS
# ---------------------------------------------------------------------------
_require_root() {
  if [[ "$(id -u)" -ne 0 ]]; then
    # Auto re-exec with sudo if available
    if command -v sudo &>/dev/null && sudo -n true 2>/dev/null; then
      exec sudo "$0" "$@"
    fi
    die "This command must be run as root. Use: sudo aidipanel $*"
  fi
}

_require_arg() {
  # Usage: _require_arg "domain" "$domain" "site:add --domain example.com"
  local name="$1" value="$2" example="$3"
  [[ -n "$value" ]] || die "Missing required option: --${name}\n  Example: aidipanel ${example}"
}

_confirm() {
  # Usage: _confirm "Are you sure?" || return 1
  local prompt="${1:-Are you sure?}"
  echo -en "${YELLOW}${prompt} [y/N]${RESET} "
  read -r answer
  [[ "${answer,,}" == "y" || "${answer,,}" == "yes" ]]
}

_domain_exists() {
  [[ -f "${NGINX_CONF_DIR}/${1}.conf" ]]
}

_domain_valid() {
  [[ "$1" =~ ^([a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\.)+[a-zA-Z]{2,}$ ]]
}

_proxy_url_valid() {
  local url="$1"
  [[ "$url" =~ ^https?://[a-zA-Z0-9._:-]+(/[^[:space:];]*)?$ ]] \
    && [[ "$url" != *$'\n'* ]] \
    && [[ "$url" != *$'\r'* ]] \
    && [[ "$url" != *";"* ]]
}

_sql_escape_literal() {
  printf "%s" "$1" | sed -e 's/\\/\\\\/g' -e "s/'/''/g"
}

_sed_inplace() {
  local file="$1"; shift
  local expr args=()
  for expr in "$@"; do
    args+=(-e "$expr")
  done
  sed -i "${args[@]}" "$file"
}

_php_version_valid() {
  local ver="$1"
  for v in "${PHP_VERSIONS_SUPPORTED[@]}"; do
    [[ "$v" == "$ver" ]] && return 0
  done
  return 1
}

# True if PHP <ver> is genuinely installed. Probes the FPM *binary*
# (/usr/sbin/php-fpm<ver>, shipped by the phpX.Y-fpm package) — NOT the
# /etc/php/<ver> dir: `apt purge` removes the binary but can leave the config
# dir behind, and aidipanel itself writes 99-aidipanel.ini + pool.d/*.conf into
# it, so the dir (and those markers) read as "installed" even after a purge.
# The dpkg-owned binary is the honest signal; the panel's php_is_installed()
# mirrors this exact probe so panel-state and CLI-state agree.
_php_installed() {
  [[ -x "/usr/sbin/php-fpm${1}" ]]
}

_php_sock() {
  echo "/run/php/php${1}-fpm.sock"
}

# Per-site PHP-FPM socket path:  _site_php_sock <php_ver> <site_user>
_site_php_sock() { echo "/run/php/php${1}-fpm-${2}.sock"; }

# Suggest a Linux-safe site-user from a domain's first label.
_suggest_site_user() {
  local base="${1%%.*}"
  base="${base,,}"; base="${base//[^a-z0-9-]/}"; base="${base#-}"
  [[ "$base" =~ ^[a-z] ]] || base="site${base}"
  echo "${base:0:32}"
}

# Return a username not currently taken (append -2,-3,...).
_unique_site_user() {
  local want="$1" cand="$1" n=2
  while id "$cand" &>/dev/null; do cand="${want:0:29}-${n}"; n=$((n + 1)); done
  echo "$cand"
}

# Validate a site-user name (format + reserved). die on failure.
_validate_site_user() {
  local u="$1" r
  [[ "$u" =~ ^[a-z][a-z0-9_-]{0,31}$ ]] \
    || die "Invalid site user '${u}': lowercase, start with a letter, [a-z0-9_-], max 32."
  for r in "${RESERVED_SITE_USERS[@]}"; do
    [[ "$u" == "$r" ]] && die "Site user '${u}' is reserved."
  done
  return 0
}

# Create a no-login site-user if absent. Idempotent. Sets global DID_CREATE_USER.
# flock + retry dodges the /etc/passwd|/etc/group lock race that broke the earlier attempt.
_ensure_site_user() {
  local user="$1"
  DID_CREATE_USER=0
  id "$user" &>/dev/null && return 0
  local lock="/run/lock/aidipanel-useradd.lock" tries=0
  while (( tries < 5 )); do
    if flock -w 10 "$lock" useradd --create-home --home-dir "${HOME_BASE}/${user}" \
         --shell /usr/sbin/nologin "$user" >> "$CLI_LOG" 2>&1; then
      passwd -l "$user" >> "$CLI_LOG" 2>&1 || true
      DID_CREATE_USER=1
      return 0
    fi
    id "$user" &>/dev/null && return 0    # a racing call created it
    tries=$((tries + 1)); sleep 1
  done
  warn "Failed to create site user '${user}' (lock contention?). Check: ${CLI_LOG}"
  return 1
}

# Create the per-site tree (group+setgid) and the root-owned .aidipanel-managed marker.
_site_make_layout() {
  local user="$1" domain="$2" webroot="$3" home="${HOME_BASE}/${1}"
  mkdir -p "${home}/tmp" "${home}/logs" "${home}/backups" "$webroot"
  chown -R "${user}:${user}" "$home"
  chmod 750 "$home" "${home}/logs" "${home}/backups"
  chmod 700 "${home}/tmp"
  chmod 2750 "${home}/htdocs" "$webroot"          # setgid: new files keep group <user>
  cat > "${home}/.aidipanel-managed" <<JSON
{ "managed_by": "aidipanel", "domain": "${domain}", "site_user": "${user}", "created_at": "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" }
JSON
  chown root:root "${home}/.aidipanel-managed"
  chmod 644 "${home}/.aidipanel-managed"
}

# Let nginx (www-data) read/traverse this site's tree. MVP = group model;
# the whole policy lives here so ACL can replace it without touching callers.
_site_grant_web_access() {
  usermod -aG "$1" www-data >> "$CLI_LOG" 2>&1 || { warn "Could not add www-data to group ${1}"; return 1; }
}

# Tear down a site user cleanly (symmetric to _ensure_site_user + _site_grant_web_access).
# _site_grant_web_access adds www-data as a SECONDARY member of the user's group, so a
# plain `userdel` refuses to remove that primary group ("not removed because it has other
# members") — leaving an orphan group that makes re-creating the same site user fail with
# "group X exists". So drop www-data from the group first (userdel then removes the now-
# empty group), and groupdel mops up any residue. Best-effort: always return 0.
_remove_site_user() {
  local user="$1"
  [[ -n "$user" ]] || return 0
  if id "$user" &>/dev/null; then
    gpasswd -d www-data "$user" >> "$CLI_LOG" 2>&1 || true   # undo the usermod -aG web grant
    userdel --remove "$user"   >> "$CLI_LOG" 2>&1 || true    # user + home
  fi
  getent group "$user" >/dev/null 2>&1 && groupdel "$user" >> "$CLI_LOG" 2>&1 || true
  return 0
}

# Write + test a per-site pool, then reload that version's service. return 1 on failure.
_write_fpm_pool() {
  local user="$1" ver="$2"
  local pool_dir="/etc/php/${ver}/fpm/pool.d"
  [[ -d "$pool_dir" ]] || { warn "Pool dir missing: ${pool_dir}"; return 1; }
  local sock home tmp; sock=$(_site_php_sock "$ver" "$user"); home="${HOME_BASE}/${user}"; tmp=$(mktemp)
  cat > "$tmp" <<POOL
[${user}]
user = ${user}
group = ${user}

listen = ${sock}
listen.owner = www-data
listen.group = www-data
listen.mode = 0660

pm = ondemand
pm.max_children = 15
pm.process_idle_timeout = 10s
pm.max_requests = 100

clear_env = yes
security.limit_extensions = .php

php_admin_value[upload_tmp_dir] = ${home}/tmp
php_admin_value[session.save_path] = ${home}/tmp
php_admin_value[error_log] = ${home}/logs/php-error.log
php_admin_flag[log_errors] = on
POOL
  cp "$tmp" "${pool_dir}/${user}.conf"; rm -f "$tmp"
  if ! "php-fpm${ver}" -t >> "$CLI_LOG" 2>&1; then
    rm -f "${pool_dir}/${user}.conf"
    warn "PHP-FPM config test failed for pool ${user} (php${ver}). Check: ${CLI_LOG}"
    return 1
  fi
  systemctl reload "php${ver}-fpm" >> "$CLI_LOG" 2>&1 || systemctl restart "php${ver}-fpm" >> "$CLI_LOG" 2>&1
  local i
  for i in {1..30}; do
    [[ -S "$sock" ]] && return 0
    sleep 0.2
  done
  warn "PHP-FPM socket did not become ready for pool ${user} (php${ver}). Check: ${CLI_LOG}"
  return 1
}

# Remove a per-site pool and reload that version's service.
_remove_fpm_pool() {
  local pool="/etc/php/${2}/fpm/pool.d/${1}.conf"
  [[ -f "$pool" ]] || return 0
  rm -f "$pool"
  systemctl reload "php${2}-fpm" >> "$CLI_LOG" 2>&1 || true
}

_load_credentials() {
  [[ -f "$CREDENTIALS_FILE" ]] || die "Credentials file not found: ${CREDENTIALS_FILE}\nIs AidiPanel installed?"
  # Parse safely line by line (do not use source so special chars in the password do not break bash)
  while IFS= read -r line || [[ -n "$line" ]]; do
    # Skip comments and blank lines
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    [[ -z "${line// }" ]] && continue
    # Only export valid VAR=VALUE pairs
    if [[ "$line" =~ ^([A-Z_]+)=(.*)$ ]]; then
      local var="${BASH_REMATCH[1]}"
      local val="${BASH_REMATCH[2]}"
      # Strip surrounding quotes if present
      val="${val%\"}"
      val="${val#\"}"
      val="${val%\'}"
      val="${val#\'}"
      export "$var"="$val"
    fi
  done < "$CREDENTIALS_FILE"
}

_db_binary() {
  # Use mariadb binary if available (MariaDB 10.4+), fall back to mysql
  if command -v mariadb &>/dev/null; then
    echo "mariadb"
  else
    echo "mysql"
  fi
}

_mysql_exec() {
  # Run a MySQL/MariaDB query using root credentials
  _load_credentials
  local bin; bin=$(_db_binary)
  $bin --defaults-extra-file=<(printf '[client]\nuser=%s\npassword=%s\n' \
    root "${MYSQL_ROOT_PASSWORD}") \
    -e "$1" 2>/dev/null
}

_mysql_exec_db() {
  # Run query against a specific database
  local db="$1"; shift
  _load_credentials
  local bin; bin=$(_db_binary)
  $bin --defaults-extra-file=<(printf '[client]\nuser=%s\npassword=%s\n' \
    root "${MYSQL_ROOT_PASSWORD}") \
    "$db" -e "$1" 2>/dev/null
}

_nginx_test_reload() {
  nginx -t >> "$CLI_LOG" 2>&1 || die "The web server rejected the new configuration; no changes were applied."
  systemctl reload nginx >> "$CLI_LOG" 2>&1
  ok "Nginx reloaded"
}

_hr() {
  echo -e "${DIM}$(printf '─%.0s' {1..60})${RESET}"
}

_table_row() {
  printf "  %-22s %s\n" "$1" "$2"
}

