# ---------------------------------------------------------------------------
# CACHE PAGE — per-site status (Phase 1: read-only)
# ---------------------------------------------------------------------------

_cache_page_status() {
  _require_root "cache:page status"
  _parse_opts "$@"
  local domain; domain=$(_opt "domain")
  _require_arg "domain" "$domain" "cache:page --action status --domain example.com"
  _domain_valid "$domain" || die "Invalid domain name: ${domain}"

  local conf="${NGINX_CONF_DIR}/${domain}.conf"
  if [[ ! -f "$conf" ]]; then
    echo "error=domain_not_found"
    exit 1
  fi

  local site_user; site_user=$(grep -oP '^\s*root\s+/home/\K[^/;]+' "$conf" 2>/dev/null | head -1 || echo "")
  local webroot; webroot=$(_vhost_webroot "$conf")
  local site_type; site_type=$(grep -oP '# Type: \K\w+' "$conf" 2>/dev/null | head -1 || echo "php")

  echo "domain=${domain}"
  echo "site_user=${site_user}"
  echo "webroot=${webroot}"
  echo "site_type=${site_type}"
  echo "engine=fastcgi"
  echo "cache_path=${NGINX_CACHE_DIR}"

  # Engine readiness: fastcgi_cache_path directive exists + cache dir present
  local engine_ok=0
  if grep -rql 'fastcgi_cache_path' /etc/nginx/ 2>/dev/null && [[ -d "$NGINX_CACHE_DIR" ]]; then
    engine_ok=1
  fi
  echo "engine_ok=${engine_ok}"

  # Unsupported site types
  if [[ "$site_type" == "static" || "$site_type" == "proxy" ]]; then
    echo "site_cache_status=unsupported"
    echo "wp_helper_status=not_applicable"
    echo "cache_header=unknown"
    echo "hit_rate=unknown"
    echo "can_enable=0"
    echo "can_disable=0"
    echo "can_purge=0"
    echo "can_check=0"
    echo "error="
    return 0
  fi

  # Site cache status: check if FastCGI directives are active in vhost
  local site_cache_status="disabled"
  if grep -Eq "^[[:space:]]*fastcgi_cache[[:space:]]+${NGINX_CACHE_ZONE}" "$conf" 2>/dev/null; then
    site_cache_status="active"
  fi
  echo "site_cache_status=${site_cache_status}"

  # WP helper (Nginx Helper plugin) — file-based detection only
  local wp_helper_status="not_wordpress"
  if [[ "$site_type" == "wordpress" && -n "$webroot" ]]; then
    if [[ -d "${webroot}/wp-content/plugins/nginx-helper" || -d "${webroot}/wp-content/plugins/nginx-cache" ]]; then
      wp_helper_status="installed"
    else
      wp_helper_status="not_installed"
    fi
  fi
  echo "wp_helper_status=${wp_helper_status}"

  echo "cache_header=unknown"
  echo "hit_rate=unknown"

  local can_enable=0 can_disable=0 can_purge=0 can_check=1
  [[ "$engine_ok" -eq 1 && "$site_cache_status" == "disabled" ]] && can_enable=1
  [[ "$site_cache_status" == "active" ]] && can_disable=1
  [[ "$site_cache_status" == "active" ]] && can_purge=1
  echo "can_enable=${can_enable}"
  echo "can_disable=${can_disable}"
  echo "can_purge=${can_purge}"
  echo "can_check=${can_check}"
  echo "error="
}

# cache:page --action check --domain <d> --url <u>
# Read-only: one anonymous GET; report FastCGI cache status + TTFB.
_cache_page_check() {
  _require_root "cache:page check"
  _parse_opts "$@"
  local domain url
  domain=$(_opt "domain")
  url=$(_opt "url")
  _require_arg "domain" "$domain" "cache:page --action check --domain example.com --url https://example.com/"
  _require_arg "url" "$url" "cache:page --action check --domain example.com --url https://example.com/"
  _domain_valid "$domain" || die "Invalid domain name: ${domain}"

  # The URL must belong to this site (domain or www.domain) — never probe other hosts.
  local host
  host=$(printf '%s' "$url" | sed -E 's#^[a-zA-Z]+://([^/]+).*#\1#')
  if [[ "$host" != "$domain" && "$host" != "www.${domain}" ]]; then
    echo "domain=${domain}"; echo "status=unknown"; echo "ttfb_ms=0"
    echo "http_code=0"; echo "error=url_not_in_domain"; exit 1
  fi

  local hdrs timing http_code ttfb_s ttfb_ms status
  hdrs=$(mktemp)
  timing=$(curl -sk --max-time 10 -o /dev/null -D "$hdrs" \
    -w '%{http_code} %{time_starttransfer}' "$url" 2>/dev/null || echo "0 0")
  http_code=$(printf '%s' "$timing" | awk '{print $1}')
  ttfb_s=$(printf '%s' "$timing" | awk '{print $2}')
  ttfb_ms=$(awk -v t="$ttfb_s" 'BEGIN{printf "%d", (t*1000)+0.5}')
  # `|| true`: under `set -Eeuo pipefail` a header-less response makes grep fail,
  # and a bare `status=$(...)` assignment would otherwise abort the script.
  status=$(grep -i '^X-FastCGI-Cache:' "$hdrs" 2>/dev/null | head -1 \
    | sed -E 's/^[^:]+:[[:space:]]*//' | tr -d '\r' | tr '[:lower:]' '[:upper:]' || true)
  rm -f "$hdrs"
  [[ -z "$status" ]] && status="unknown"

  echo "domain=${domain}"
  echo "url=${url}"
  echo "status=${status}"
  echo "ttfb_ms=${ttfb_ms}"
  echo "http_code=${http_code}"
  echo "error="
}

# cache:page --action purge-url --domain <d> --urls "<u1,u2,...>"
# Delete only the cache files for the given URLs, by matching each file's KEY line
# (KEY: <scheme><method><host><uri>). Fail closed if any URL is off-site.
_cache_page_purge_url() {
  _require_root "cache:page purge-url"
  _parse_opts "$@"
  local domain urls
  domain=$(_opt "domain")
  urls=$(_opt "urls")
  _require_arg "domain" "$domain" "cache:page --action purge-url --domain example.com --urls https://example.com/a"
  _require_arg "urls" "$urls" "cache:page --action purge-url --domain example.com --urls https://example.com/a"
  _domain_valid "$domain" || die "Invalid domain name: ${domain}"

  local cache_path="${NGINX_CACHE_DIR}"
  [[ -d "$cache_path" ]] || { echo "purged=0"; echo "notfound=0"; echo "error=cache_dir_missing"; exit 1; }

  local -a url_list=()
  IFS=',' read -ra url_list <<< "$urls"

  local u host
  # Pass 1: validate every host belongs to this site (fail closed).
  for u in "${url_list[@]}"; do
    u=$(printf '%s' "$u" | xargs 2>/dev/null || true)
    [[ -z "$u" ]] && continue
    host=$(printf '%s' "$u" | sed -E 's#^[a-zA-Z]+://([^/]+).*#\1#')
    if [[ "$host" != "$domain" && "$host" != "www.${domain}" ]]; then
      echo "purged=0"; echo "notfound=0"; echo "error=url_not_in_domain"; exit 1
    fi
  done

  # Pass 2: purge each URL by KEY-line match.
  local purged=0 notfound=0 path key_re matches f
  for u in "${url_list[@]}"; do
    u=$(printf '%s' "$u" | xargs 2>/dev/null || true)
    [[ -z "$u" ]] && continue
    host=$(printf '%s' "$u" | sed -E 's#^[a-zA-Z]+://([^/]+).*#\1#')
    path=$(printf '%s' "$u" | sed -E 's#^[a-zA-Z]+://[^/]+##')
    [[ -z "$path" ]] && path="/"
    # Escape every non-alphanumeric in host+path so it matches literally in the grep
    # ERE. Using [^[:alnum:]] avoids the backslash-before-closing-bracket ordering that
    # broke an explicit metacharacter class on some sed builds ("unterminated s command").
    key_re=$(printf '%s%s' "$host" "$path" | sed -E 's/[^[:alnum:]]/\\&/g')
    matches=$(grep -rlE "^KEY: .*${key_re}\$" "$cache_path" 2>/dev/null || true)
    if [[ -z "$matches" ]]; then
      notfound=$((notfound+1))
      continue
    fi
    while IFS= read -r f; do
      [[ -n "$f" ]] || continue
      rm -f "$f" && purged=$((purged+1))
    done <<< "$matches"
  done

  echo "domain=${domain}"
  echo "purged=${purged}"
  echo "notfound=${notfound}"
  echo "error="
}

_cache_page() {
  _parse_opts "$@"
  local action; action=$(_opt "action" "status")
  case "$action" in
    status)     _cache_page_status "$@" ;;
    check)      _cache_page_check "$@" ;;
    purge-url)  _cache_page_purge_url "$@" ;;
    *) die "cache:page: unknown action '${action}'. Supported: status, check, purge-url" ;;
  esac
}

# ---------------------------------------------------------------------------
# CACHE REDIS — per-site object cache status (Phase 1: read-only)
# ---------------------------------------------------------------------------

_cache_redis_site_status() {
  _require_root "cache:redis status"
  _parse_opts "$@"
  local domain; domain=$(_opt "domain")
  _require_arg "domain" "$domain" "cache:redis --action status --domain example.com"
  _domain_valid "$domain" || die "Invalid domain name: ${domain}"

  local conf="${NGINX_CONF_DIR}/${domain}.conf"
  if [[ ! -f "$conf" ]]; then
    echo "error=domain_not_found"
    exit 1
  fi

  local site_user; site_user=$(grep -oP '^\s*root\s+/home/\K[^/;]+' "$conf" 2>/dev/null | head -1 || echo "")
  local webroot; webroot=$(_vhost_webroot "$conf")
  local site_type; site_type=$(grep -oP '# Type: \K\w+' "$conf" 2>/dev/null | head -1 || echo "php")

  echo "domain=${domain}"
  echo "site_user=${site_user}"
  echo "webroot=${webroot}"
  echo "site_type=${site_type}"
  echo "engine=redis"

  # Redis service check (2-second timeout)
  local service_ok=0 redis_host="127.0.0.1" redis_port="6379"
  local ping; ping=$(timeout 2 redis-cli -h "$redis_host" -p "$redis_port" PING 2>/dev/null || echo "FAIL")
  [[ "$ping" == "PONG" ]] && service_ok=1
  echo "service_ok=${service_ok}"
  echo "redis_host=${redis_host}"
  echo "redis_port=${redis_port}"

  # Non-WordPress: report engine status but no plugin/prefix info
  if [[ "$site_type" != "wordpress" ]]; then
    echo "site_cache_status=unsupported"
    echo "plugin_status=not_wordpress"
    echo "dropin_status=unknown"
    echo "prefix="
    echo "prefix_managed=0"
    echo "site_keys=unknown"
    echo "site_memory=unknown"
    local wp_cli_missing=0; command -v wp &>/dev/null || wp_cli_missing=1
    echo "wp_cli_missing=${wp_cli_missing}"
    echo "can_enable=0"
    echo "can_disable=0"
    echo "can_flush=0"
    echo "error="
    return 0
  fi

  # WordPress detection (wp-config.php presence)
  local wp_config="${webroot}/wp-config.php"
  local wp_detected=0
  [[ -f "$wp_config" ]] && wp_detected=1

  # WP-CLI availability
  local wp_cli_missing=0
  command -v wp &>/dev/null || wp_cli_missing=1
  echo "wp_cli_missing=${wp_cli_missing}"

  # Plugin and drop-in detection (filesystem only, no WP-CLI needed)
  local plugin_dir="${webroot}/wp-content/plugins/redis-cache"
  local dropin="${webroot}/wp-content/object-cache.php"
  local plugin_status="not_installed"
  local dropin_status="missing"

  [[ -f "$dropin" ]] && dropin_status="present"

  if [[ -d "$plugin_dir" ]]; then
    if [[ "$dropin_status" == "present" ]]; then
      plugin_status="active"
    else
      plugin_status="installed"
    fi
  fi
  echo "plugin_status=${plugin_status}"
  echo "dropin_status=${dropin_status}"

  # Prefix from wp-config.php (read-only grep, root can always read)
  local prefix=""
  if [[ "$wp_detected" -eq 1 ]]; then
    prefix=$(grep -oP "define\s*\(\s*['\"]WP_REDIS_PREFIX['\"]\s*,\s*['\"]\K[^'\"]+(?=['\"])" \
      "$wp_config" 2>/dev/null | head -1 || echo "")
  fi
  echo "prefix=${prefix}"

  # Prefix management check: does it match what AidiPanel would set?
  local expected_prefix="aidipanel:${site_user}:"
  local prefix_managed=0
  [[ -n "$prefix" && "$prefix" == "$expected_prefix" ]] && prefix_managed=1
  echo "prefix_managed=${prefix_managed}"

  # site_cache_status: all 3 conditions required for "active"
  local site_cache_status="not_connected"
  if [[ "$service_ok" -eq 0 ]]; then
    site_cache_status="service_down"
  elif [[ "$service_ok" -eq 1 && "$plugin_status" == "active" && "$dropin_status" == "present" ]]; then
    site_cache_status="active"
  fi
  echo "site_cache_status=${site_cache_status}"

  # Phase 1: keys and memory not calculated
  echo "site_keys=unknown"
  echo "site_memory=unknown"

  local can_enable=0 can_disable=0 can_flush=0
  [[ "$service_ok" -eq 1 && "$wp_detected" -eq 1 && "$site_cache_status" != "active" ]] && can_enable=1
  [[ "$site_cache_status" == "active" ]] && can_disable=1
  [[ "$site_cache_status" == "active" ]] && can_flush=1
  echo "can_enable=${can_enable}"
  echo "can_disable=${can_disable}"
  echo "can_flush=${can_flush}"
  echo "error="
}

# Resolve a domain's per-site object-cache context. Sets OC_* globals + OC_RUNNER.
# Prints "error=domain_not_found" and exits on an unknown/invalid domain.
_cache_redis_resolve() {
  local domain="$1"
  _domain_valid "$domain" || { echo "error=domain_not_found"; exit 1; }
  OC_CONF="${NGINX_CONF_DIR}/${domain}.conf"
  [[ -f "$OC_CONF" ]] || { echo "error=domain_not_found"; exit 1; }
  OC_SITE_USER=$(grep -oP '^\s*root\s+/home/\K[^/;]+' "$OC_CONF" 2>/dev/null | head -1 || echo "")
  OC_WEBROOT=$(_vhost_webroot "$OC_CONF")
  OC_SITE_TYPE=$(grep -oP '# Type: \K\w+' "$OC_CONF" 2>/dev/null | head -1 || echo "php")
  OC_WPCONFIG="${OC_WEBROOT}/wp-config.php"
  OC_EXPECTED_PREFIX="aidipanel:${OC_SITE_USER}:"
  # WP-CLI runs as the SITE USER (per-site-user model) — never www-data/root/--allow-root.
  OC_RUNNER=(sudo -u "$OC_SITE_USER" -- env "WP_CLI_CACHE_DIR=/tmp/aidipanel-wp-cli-cache" wp --path="$OC_WEBROOT")
}

# Read WP_REDIS_PREFIX from a wp-config.php (empty if unset). Read-only.
_cache_redis_cfg_prefix() {
  grep -oP "define\s*\(\s*['\"]WP_REDIS_PREFIX['\"]\s*,\s*['\"]\K[^'\"]+(?=['\"])" \
    "$1" 2>/dev/null | head -1 || echo ""
}

# cache:redis --action enable --domain <domain>
# Install/activate the per-site WordPress Redis Object Cache, managed by AidiPanel.
# Idempotent; refuses to overwrite an unmanaged cache; full ledger-based rollback.
_cache_redis_enable_site() {
  _require_root "cache:redis enable"
  _parse_opts "$@"
  local domain; domain=$(_opt "domain")
  _require_arg "domain" "$domain" "cache:redis --action enable --domain example.com"
  _cache_redis_resolve "$domain"

  _progress 10 oc_check "Checking site and Redis"
  [[ "$OC_SITE_TYPE" == "wordpress" && -f "$OC_WPCONFIG" ]] || { echo "error=not_wordpress"; exit 1; }
  [[ "$(timeout 2 redis-cli -h 127.0.0.1 -p 6379 PING 2>/dev/null || echo FAIL)" == "PONG" ]] \
    || { echo "error=redis_service_down"; exit 1; }
  command -v wp &>/dev/null || { echo "error=wp_cli_missing"; exit 1; }

  local dropin="${OC_WEBROOT}/wp-content/object-cache.php"
  local cur_prefix; cur_prefix=$(_cache_redis_cfg_prefix "$OC_WPCONFIG")

  # Already active (drop-in present)? Managed → idempotent success; unmanaged → refuse.
  if [[ -f "$dropin" ]]; then
    if [[ "$cur_prefix" == "$OC_EXPECTED_PREFIX" ]]; then
      _progress 100 "done" "Already active"
      ok "Object cache already active (managed): ${domain}"
      _cache_redis_site_status --domain "$domain"
      return 0
    fi
    echo "error=object_cache_unmanaged"; exit 1
  fi

  # wp-config safety: a regular file, NOT a symlink, resolving inside the managed webroot.
  _progress 20 oc_wpconfig "Checking wp-config"
  local real; real=$(realpath -e "$OC_WPCONFIG" 2>/dev/null || echo "")
  [[ -n "$real" && -f "$real" && ! -L "$OC_WPCONFIG" && "$real" == "${OC_WEBROOT}/wp-config.php" ]] \
    || { echo "error=wp_config_not_safe"; exit 1; }
  sudo -u "$OC_SITE_USER" -- test -w "$OC_WPCONFIG" || { echo "error=wp_config_not_writable"; exit 1; }

  # Rollback ledger (parent locals; visible to the nested rollback via dynamic scope).
  local wp_config_backup_path="" plugin_installed_this_run=0 plugin_activated_this_run=0
  local config_modified_this_run=0 dropin_enabled_this_run=0
  _oc_enable_rollback() {
    if [[ "$dropin_enabled_this_run" == 1 ]]; then "${OC_RUNNER[@]}" redis disable >> "$CLI_LOG" 2>&1 || true; fi
    if [[ "$plugin_activated_this_run" == 1 ]]; then "${OC_RUNNER[@]}" plugin deactivate redis-cache >> "$CLI_LOG" 2>&1 || true; fi
    if [[ "$config_modified_this_run" == 1 && -f "$wp_config_backup_path" ]]; then
      # CLI_LOG is root-owned; the log redirect runs as root by design (cp runs as the site user for ownership).
      # shellcheck disable=SC2024
      sudo -u "$OC_SITE_USER" -- cp -f "$wp_config_backup_path" "$OC_WPCONFIG" >> "$CLI_LOG" 2>&1 || true
    fi
    if [[ "$plugin_installed_this_run" == 1 ]]; then "${OC_RUNNER[@]}" plugin uninstall redis-cache --deactivate >> "$CLI_LOG" 2>&1 || true; fi
  }

  # Timestamped backup (written by the site user, in their own webroot).
  wp_config_backup_path="${OC_WPCONFIG}.aidipanel-bak-$(date +%Y%m%d-%H%M%S)"
  # CLI_LOG is root-owned; the log redirect runs as root by design (cp runs as the site user for ownership).
  # shellcheck disable=SC2024
  sudo -u "$OC_SITE_USER" -- cp -f "$OC_WPCONFIG" "$wp_config_backup_path" >> "$CLI_LOG" 2>&1 \
    || { echo "error=wp_config_not_writable"; exit 1; }

  # Install the plugin only if it is not already installed.
  _progress 35 oc_install "Installing Redis Object Cache plugin"
  if ! "${OC_RUNNER[@]}" plugin is-installed redis-cache >> "$CLI_LOG" 2>&1; then
    if ! "${OC_RUNNER[@]}" plugin install redis-cache >> "$CLI_LOG" 2>&1; then
      _oc_enable_rollback; echo "error=plugin_install_failed"; exit 1
    fi
    plugin_installed_this_run=1
  fi

  # Constants via `wp config set` (never sed).
  _progress 60 oc_config "Writing wp-config constants"
  config_modified_this_run=1
  if ! "${OC_RUNNER[@]}" config set WP_REDIS_HOST 127.0.0.1 --type=constant >> "$CLI_LOG" 2>&1 \
     || ! "${OC_RUNNER[@]}" config set WP_REDIS_PORT 6379 --raw --type=constant >> "$CLI_LOG" 2>&1 \
     || ! "${OC_RUNNER[@]}" config set WP_REDIS_PREFIX "$OC_EXPECTED_PREFIX" --type=constant >> "$CLI_LOG" 2>&1; then
    _oc_enable_rollback; echo "error=wp_config_not_writable"; exit 1
  fi
  "${OC_RUNNER[@]}" config set WP_REDIS_TIMEOUT 1 --raw --type=constant >> "$CLI_LOG" 2>&1 || true
  "${OC_RUNNER[@]}" config set WP_REDIS_READ_TIMEOUT 1 --raw --type=constant >> "$CLI_LOG" 2>&1 || true
  "${OC_RUNNER[@]}" config set WP_CACHE true --raw --type=constant >> "$CLI_LOG" 2>&1 || true
  # Per-site flush safety (verified by T0): without this, `wp cache flush` does a
  # global FLUSHDB (wipes every site's keys). This scopes the plugin's flush to
  # this site's prefix only. Keep in sync with the flush guard below.
  "${OC_RUNNER[@]}" config set WP_REDIS_SELECTIVE_FLUSH true --raw --type=constant >> "$CLI_LOG" 2>&1 || true

  # Activate only if not already WP-active (so rollback won't deactivate a pre-active plugin).
  _progress 80 oc_activate "Activating plugin"
  if ! "${OC_RUNNER[@]}" plugin is-active redis-cache >> "$CLI_LOG" 2>&1; then
    if ! "${OC_RUNNER[@]}" plugin activate redis-cache >> "$CLI_LOG" 2>&1; then
      _oc_enable_rollback; echo "error=plugin_activate_failed"; exit 1
    fi
    plugin_activated_this_run=1
  fi

  # Enable the object-cache drop-in.
  _progress 90 oc_dropin "Enabling object cache"
  if ! "${OC_RUNNER[@]}" redis enable >> "$CLI_LOG" 2>&1; then
    _oc_enable_rollback; echo "error=dropin_enable_failed"; exit 1
  fi
  dropin_enabled_this_run=1

  # Final validation: drop-in present AND our prefix in place.
  local v_prefix; v_prefix=$(_cache_redis_cfg_prefix "$OC_WPCONFIG")
  if [[ ! -f "$dropin" || "$v_prefix" != "$OC_EXPECTED_PREFIX" ]]; then
    _oc_enable_rollback; echo "error=dropin_enable_failed"; exit 1
  fi

  _progress 100 "done" "Object cache enabled"
  ok "Object cache enabled: ${domain}"
  _cache_redis_site_status --domain "$domain"
}

# cache:redis --action disable --domain <domain>
# Disable only an AidiPanel-managed object cache (prefix match). Refuse unmanaged.
# Does NOT stop Redis, remove constants, delete keys, or touch other sites.
_cache_redis_disable_site() {
  _require_root "cache:redis disable"
  _parse_opts "$@"
  local domain; domain=$(_opt "domain")
  _require_arg "domain" "$domain" "cache:redis --action disable --domain example.com"
  _cache_redis_resolve "$domain"

  [[ "$OC_SITE_TYPE" == "wordpress" && -f "$OC_WPCONFIG" ]] || { echo "error=not_wordpress"; exit 1; }

  local cur_prefix; cur_prefix=$(_cache_redis_cfg_prefix "$OC_WPCONFIG")
  [[ "$cur_prefix" == "$OC_EXPECTED_PREFIX" ]] || { echo "error=object_cache_unmanaged"; exit 1; }

  _progress 30 oc_dropin "Disabling object cache"
  "${OC_RUNNER[@]}" redis disable >> "$CLI_LOG" 2>&1 || true
  _progress 70 oc_deactivate "Deactivating plugin"
  "${OC_RUNNER[@]}" plugin deactivate redis-cache >> "$CLI_LOG" 2>&1 || true
  _progress 100 "done" "Object cache disabled"
  ok "Object cache disabled: ${domain}"
  _cache_redis_site_status --domain "$domain"
}

# cache:redis --action flush --domain <domain>
# Flush ONLY this AidiPanel-managed site's object cache. Default `wp cache flush`
# does a GLOBAL FLUSHDB (proven by T0), so we hard-require WP_REDIS_SELECTIVE_FLUSH=true
# (prefix-scoped) before flushing — never FLUSHALL/FLUSHDB/KEYS ourselves.
_cache_redis_flush_site() {
  _require_root "cache:redis flush"
  _parse_opts "$@"
  local domain; domain=$(_opt "domain")
  _require_arg "domain" "$domain" "cache:redis --action flush --domain example.com"
  _cache_redis_resolve "$domain"

  [[ "$OC_SITE_TYPE" == "wordpress" && -f "$OC_WPCONFIG" ]] || { echo "error=not_wordpress"; exit 1; }
  [[ "$(timeout 2 redis-cli -h 127.0.0.1 -p 6379 PING 2>/dev/null || echo FAIL)" == "PONG" ]] \
    || { echo "error=redis_service_down"; exit 1; }

  local dropin="${OC_WEBROOT}/wp-content/object-cache.php"
  local cur_prefix; cur_prefix=$(_cache_redis_cfg_prefix "$OC_WPCONFIG")
  [[ -f "$dropin" ]]                            || { echo "error=object_cache_not_connected"; exit 1; }
  [[ "$cur_prefix" == "$OC_EXPECTED_PREFIX" ]]  || { echo "error=object_cache_unmanaged"; exit 1; }

  # Scope guard: ensure selective (prefix-scoped) flush, else REFUSE.
  if ! grep -qE "define\s*\(\s*['\"]WP_REDIS_SELECTIVE_FLUSH['\"]\s*,\s*true" "$OC_WPCONFIG" 2>/dev/null; then
    "${OC_RUNNER[@]}" config set WP_REDIS_SELECTIVE_FLUSH true --raw --type=constant >> "$CLI_LOG" 2>&1 || true
  fi
  grep -qE "define\s*\(\s*['\"]WP_REDIS_SELECTIVE_FLUSH['\"]\s*,\s*true" "$OC_WPCONFIG" 2>/dev/null \
    || { echo "error=flush_scope_unsafe"; exit 1; }

  _progress 40 oc_flush "Flushing object cache"
  "${OC_RUNNER[@]}" cache flush >> "$CLI_LOG" 2>&1 || { echo "error=flush_failed"; exit 1; }
  _progress 100 "done" "Object cache flushed"
  ok "Object cache flushed: ${domain}"
  _cache_redis_site_status --domain "$domain"
}

# cache:redis --action metrics --domain <domain>
# Read-only, bounded: SCAN (never KEYS) the site prefix, cap 1000 keys + timeout,
# approximate memory from a 50-key sample. Returns unknown when not measurable.
_cache_redis_metrics() {
  _require_root "cache:redis metrics"
  _parse_opts "$@"
  local domain; domain=$(_opt "domain")
  _require_arg "domain" "$domain" "cache:redis --action metrics --domain example.com"
  _cache_redis_resolve "$domain"

  echo "domain=${domain}"
  local keys="unknown" mem="unknown" limited=0
  local dropin="${OC_WEBROOT}/wp-content/object-cache.php"
  if [[ "$OC_SITE_TYPE" == "wordpress" && -f "$dropin" \
        && "$(timeout 2 redis-cli -h 127.0.0.1 -p 6379 PING 2>/dev/null || echo FAIL)" == "PONG" ]]; then
    local pat="${OC_EXPECTED_PREFIX}*"
    # Keys: redis-cli --scan uses SCAN (never KEYS); cap 1000; time-bounded.
    # The subshell disables pipefail so head closing the pipe (SIGPIPE) isn't an error.
    local n; n=$( set +o pipefail; timeout 3 redis-cli -h 127.0.0.1 -p 6379 --scan --pattern "$pat" 2>/dev/null | head -1000 | wc -l | tr -d ' ' )
    [[ "$n" =~ ^[0-9]+$ ]] || n=0
    keys="$n"
    [[ "$n" -ge 1000 ]] && limited=1
    if [[ "$n" -gt 0 ]]; then
      # Memory: average a <=50-key sample, extrapolate. Approximate by design.
      local total=0 sn=0 k u
      while IFS= read -r k; do
        [[ -z "$k" ]] && continue
        u=$(redis-cli -h 127.0.0.1 -p 6379 MEMORY USAGE "$k" 2>/dev/null || echo "")
        [[ "$u" =~ ^[0-9]+$ ]] && { total=$((total+u)); sn=$((sn+1)); }
      done < <( set +o pipefail; timeout 2 redis-cli -h 127.0.0.1 -p 6379 --scan --pattern "$pat" 2>/dev/null | head -50 )
      if [[ "$sn" -gt 0 ]]; then
        local approx=$(( (total / sn) * n ))
        if   [[ "$approx" -ge 1048576 ]]; then mem="~$((approx/1048576))MB"
        elif [[ "$approx" -ge 1024 ]];    then mem="~$((approx/1024))KB"
        else mem="~${approx}B"; fi
      fi
    fi
  fi
  echo "site_keys=${keys}"
  echo "site_memory=${mem}"
  echo "metrics_limited=${limited}"
  echo "error="
}

_cache_redis_per_site() {
  _parse_opts "$@"
  local action; action=$(_opt "action" "status")
  case "$action" in
    status)  _cache_redis_site_status "$@" ;;
    enable)  _cache_redis_enable_site "$@" ;;
    disable) _cache_redis_disable_site "$@" ;;
    flush)   _cache_redis_flush_site "$@" ;;
    metrics) _cache_redis_metrics "$@" ;;
    *) die "cache:redis: unknown action '${action}'. Supported: status, enable, disable, flush, metrics" ;;
  esac
}

# ---------------------------------------------------------------------------
# CACHE ENGINE HELPERS
# ---------------------------------------------------------------------------

_cache_snippet_path() { echo "${NGINX_SNIPPET_DIR}/cache-${1}.conf"; }

# Read one AIDIPANEL_CACHE_* field from a per-site snippet.
# Usage: _cache_snippet_read <domain> <FIELD>  (FIELD = TTL, EXCLUDE_URLS, etc.)
_cache_snippet_read() {
  local file; file=$(_cache_snippet_path "$1")
  [[ -f "$file" ]] || { echo ""; return; }
  grep -oP "(?<=# AIDIPANEL_CACHE_${2}=).*" "$file" 2>/dev/null | head -1 || true
}

# Build nginx URI regex from comma-separated URL list.
# Returns: /wp-admin/|/wp-login\.php|...   (no outer parens)
_cache_build_uri_regex() {
  local urls="$1"
  local parts=()
  IFS=',' read -ra parts <<< "$urls"
  local regex="" p
  for p in "${parts[@]}"; do
    p="${p## }"; p="${p%% }"
    p="${p//./\\.}"
    p="${p//\?/\\?}"
    [[ -z "$p" ]] && continue
    [[ -n "$regex" ]] && regex+="|"
    regex+="$p"
  done
  echo "$regex"
}

# The non-removable URL bypass baseline: paths whose responses are dynamic,
# authenticated, or an attack surface and must never be cached, whatever a site's
# configured exclude list says. Single source of truth, enforced in
# _cache_snippet_write (mirrors _cache_baseline_cookies).
_cache_baseline_exclude_urls() {
  echo "/wp-json/,/xmlrpc.php"
}

# The default per-site exclude list for new / reset sites (tunable extras on top
# of the baseline). Single source — replaces the literal that was duplicated
# across create / cache:config / cache:enable / cache:migrate.
_cache_default_exclude_urls() {
  echo "/wp-admin/,/wp-login.php,/checkout/,/cart/,/my-account/,/?wc-ajax="
}

# Merge the URL baseline with a user comma list: baseline first, then extras,
# de-duplicated, blanks dropped. Guarantees the baseline can never be removed
# regardless of what the caller (or the panel form) passes.
_cache_merge_exclude_urls() {
  local user="$1"
  local parts=() out=() seen=" " u
  IFS=',' read -ra parts <<< "$(_cache_baseline_exclude_urls),${user}"
  for u in "${parts[@]}"; do
    u="${u#"${u%%[![:space:]]*}"}"; u="${u%"${u##*[![:space:]]}"}"  # trim whitespace
    [[ -z "$u" ]] && continue
    case "$seen" in *" ${u} "*) continue ;; esac
    out+=("$u")
    seen+="${u} "
  done
  local IFS=','
  echo "${out[*]}"
}

# The non-removable cache-bypass baseline: session/login cookies that MUST always
# bypass the page cache or a logged-in/checkout response could be cached and served
# to other visitors. Single source of truth (mirrored in the panel by
# cache_baseline_cookies() in helpers.php — keep both lists in sync).
_cache_baseline_cookies() {
  echo "wordpress_logged_in,woocommerce_session,comment_author,laravel_session,PHPSESSID"
}

# Merge the security baseline with a user-supplied comma list: baseline first, then
# any extra names, de-duplicated, blanks dropped. Guarantees the baseline can never
# be removed regardless of what the caller passes.
_cache_merge_cookies() {
  local user="$1"
  local parts=() out=() seen=" " c
  IFS=',' read -ra parts <<< "$(_cache_baseline_cookies),${user}"
  for c in "${parts[@]}"; do
    c="${c#"${c%%[![:space:]]*}"}"; c="${c%"${c##*[![:space:]]}"}"  # trim all surrounding whitespace
    [[ -z "$c" ]] && continue
    case "$seen" in *" ${c} "*) continue ;; esac
    out+=("$c")
    seen+="${c} "
  done
  local IFS=','
  echo "${out[*]}"
}

# Build nginx cookie regex from comma-separated cookie-name list.
# Returns: wordpress_logged_in|woocommerce_session|...   (no outer parens)
_cache_build_cookie_regex() {
  local cookies="$1"
  local parts=()
  IFS=',' read -ra parts <<< "$cookies"
  local regex="" c
  for c in "${parts[@]}"; do
    c="${c## }"; c="${c%% }"
    [[ -z "$c" ]] && continue
    [[ -n "$regex" ]] && regex+="|"
    regex+="$c"
  done
  echo "$regex"
}

# >>> CACHE_ZONE_HELPERS_START
# Pure, dependency-light helpers for cache:zone. Kept between sentinels and PCRE-free
# (sed -E / grep -E) so _private/tests/unit/cache_zone_test.sh can source just this block
# with stubbed NGINX_CONF_DIR / NGINX_CACHE_ZONE.

# Dedicated-zone name for a site user. Single source of truth.
_cache_zone_name() { echo "${NGINX_CACHE_ZONE}_${1}"; }

# Validate an nginx size token (e.g. 32m, 2g, 512k). Case-insensitive k/m/g suffix.
_cache_zone_valid_size() { [[ "$1" =~ ^[0-9]+[kKmMgG]$ ]]; }

# Convert an nginx size token to bytes. Echoes 0 + returns 1 on bad input.
_size_to_bytes() {
  [[ "$1" =~ ^([0-9]+)([kKmMgG])$ ]] || { echo 0; return 1; }
  local n="${BASH_REMATCH[1]}" u="${BASH_REMATCH[2]}"
  case "$u" in
    k|K) echo $(( n * 1024 )) ;;
    m|M) echo $(( n * 1024 * 1024 )) ;;
    g|G) echo $(( n * 1024 * 1024 * 1024 )) ;;
  esac
}

# Echo the FastCGI zone referenced by a site's vhost (active OR commented), defaulting
# to the shared zone when none is found. The space after `fastcgi_cache` excludes
# `fastcgi_cache_valid` etc.
_cache_vhost_zone() {
  local domain="$1"
  local conf="${NGINX_CONF_DIR}/${domain}.conf" zone
  [[ -f "$conf" ]] || { echo "$NGINX_CACHE_ZONE"; return 0; }
  zone=$(sed -nE 's/^[[:space:]]*#?[[:space:]]*fastcgi_cache[[:space:]]+([A-Za-z0-9_-]+)[[:space:]]*;.*/\1/p' "$conf" | head -1)
  echo "${zone:-$NGINX_CACHE_ZONE}"
}

# Return 0 iff the vhost has an ACTIVE (uncommented) bare `fastcgi_cache <zone>;` line.
_cache_vhost_cache_active() {
  local conf="${NGINX_CONF_DIR}/${1}.conf"
  grep -qE '^[[:space:]]*fastcgi_cache[[:space:]]+[A-Za-z0-9_-]+[[:space:]]*;' "$conf" 2>/dev/null
}
# <<< CACHE_ZONE_HELPERS_END

# Write (or overwrite) a per-site cache snippet from config values.
# Usage: _cache_snippet_write <domain> <ttl> <exclude_urls> <bypass_cookies> <bypass_query> [stale_revalidate] [debug_header]
_cache_snippet_write() {
  local domain="$1" ttl="$2" exclude_urls="$3" bypass_cookies="$4" bypass_query="$5"
  local stale_revalidate="${6:-off}" debug_header="${7:-on}"
  local file; file=$(_cache_snippet_path "$domain")

  # Enforce the non-removable bypass-cookie baseline here, the single point every
  # snippet write passes through, so the persisted header AND the nginx regex are
  # always safe even if a caller (or the panel form) omits the session cookies.
  bypass_cookies=$(_cache_merge_cookies "$bypass_cookies")

  # URLs: enforce the security baseline (/wp-json/, /xmlrpc.php) in the compiled
  # regex, but persist only the caller's list in the header below. Cookies store
  # the merged value; URLs store unmerged so the panel form shows just the tunable
  # extras and a baseline path can't be shown-then-deleted in the UI.
  local enforced_urls; enforced_urls=$(_cache_merge_exclude_urls "$exclude_urls")
  local uri_regex; uri_regex=$(_cache_build_uri_regex "$enforced_urls")
  local cookie_regex; cookie_regex=$(_cache_build_cookie_regex "$bypass_cookies")

  local query_block=""
  [[ "$bypass_query" == "on" ]] && \
    query_block='if ($query_string != "")             { set $skip_cache 1; }'

  cat > "$file" <<SNIP
# AidiPanel — FastCGI cache config for ${domain}
# AIDIPANEL_CACHE_TTL=${ttl}
# AIDIPANEL_CACHE_EXCLUDE_URLS=${exclude_urls}
# AIDIPANEL_CACHE_BYPASS_COOKIES=${bypass_cookies}
# AIDIPANEL_CACHE_BYPASS_QUERY=${bypass_query}
# AIDIPANEL_CACHE_STALE_REVALIDATE=${stale_revalidate}
# AIDIPANEL_CACHE_DEBUG_HEADER=${debug_header}

set \$skip_cache 0;

if (\$request_method = POST)          { set \$skip_cache 1; }
${query_block}
if (\$request_uri ~* "(${uri_regex})") {
    set \$skip_cache 1;
}

if (\$http_cookie ~* "(${cookie_regex})") {
    set \$skip_cache 1;
}
SNIP

  chmod 644 "$file"
}

# Toggle fastcgi_cache_use_stale in the site vhost (on=uncomment, off=comment out).
# Preference is always saved in the snippet; vhost is only updated when the line exists.
_cache_vhost_stale_revalidate() {
  local domain="$1" val="$2"
  local conf="${NGINX_CONF_DIR}/${domain}.conf"
  if [[ "$val" == "on" ]]; then
    if grep -q "#.*fastcgi_cache_use_stale" "$conf"; then
      sed -i 's|^\(\s*\)#\s*\(fastcgi_cache_use_stale\)|\1\2|' "$conf"
    elif ! grep -q "fastcgi_cache_use_stale" "$conf"; then
      # Placeholder missing (old site) — insert active only if cache is currently on
      if grep -qE "^\s*fastcgi_cache aidipanel_fcgi" "$conf"; then
        sed -i '/fastcgi_cache_valid.*404/a\        fastcgi_cache_use_stale error timeout updating http_500 http_503;' "$conf"
      fi
    fi
  else
    if grep -qE "^\s*fastcgi_cache_use_stale" "$conf"; then
      sed -i 's|^\(\s*\)\(fastcgi_cache_use_stale\)|\1#\2|' "$conf"
    fi
  fi
}

# Toggle add_header X-FastCGI-Cache in the site vhost (on=uncomment, off=comment out).
_cache_vhost_debug_header() {
  local domain="$1" val="$2"
  local conf="${NGINX_CONF_DIR}/${domain}.conf"
  if [[ "$val" == "on" ]]; then
    if grep -q "#.*add_header X-FastCGI-Cache" "$conf"; then
      sed -i 's|^\(\s*\)#\(\s*add_header X-FastCGI-Cache\)|\1\2|' "$conf"
    fi
  else
    if grep -qE "^\s*add_header X-FastCGI-Cache" "$conf"; then
      sed -i 's|^\(\s*\)\(add_header X-FastCGI-Cache\)|\1#\2|' "$conf"
    fi
  fi
}

_cache_config() {
  _parse_opts "$@"
  local domain; domain=$(_opt "domain")
  _require_arg "domain" "$domain" "cache:config --domain example.com [--ttl 1h] [--exclude-urls \"/path/\"] [--bypass-cookies \"name\"] [--bypass-query on|off] [--stale-revalidate on|off] [--debug-header on|off]"
  _domain_valid "$domain"   || die "Invalid domain name: ${domain}"
  _domain_exists "$domain"  || die "Site not found: ${domain}"

  local snippet; snippet=$(_cache_snippet_path "$domain")

  # ---- SET mode: any --set flag present ----
  local set_ttl;        set_ttl=$(_opt "ttl" "")
  local set_exclude;    set_exclude=$(_opt "exclude-urls" "")
  local set_cookies;    set_cookies=$(_opt "bypass-cookies" "")
  local set_bypass_q;   set_bypass_q=$(_opt "bypass-query" "")
  local set_stale;      set_stale=$(_opt "stale-revalidate" "")
  local set_debug_hdr;  set_debug_hdr=$(_opt "debug-header" "")

  local has_set=0
  if [[ -n "$set_ttl" || -n "$set_exclude" || -n "$set_cookies" || -n "$set_bypass_q" \
        || -n "$set_stale" || -n "$set_debug_hdr" ]]; then has_set=1; fi

  if [[ "$has_set" == 1 ]]; then
    _require_root "cache:config --set"
    [[ -f "$snippet" ]] || die "No per-site cache config for ${domain}. Run: aidipanel cache:enable --domain ${domain}"

    # Validate inputs before touching any file
    if [[ -n "$set_ttl" ]]; then
      [[ "$set_ttl" =~ ^[0-9]+[smhd]$ ]] || die "Invalid TTL '${set_ttl}'. Use format: 30m, 1h, 2d"
    fi
    if [[ -n "$set_exclude" ]]; then
      local _excl_parts=()
      IFS=',' read -ra _excl_parts <<< "$set_exclude"
      local u
      for u in "${_excl_parts[@]}"; do
        u="${u## }"; u="${u%% }"
        [[ "$u" == /* ]] || die "Each exclude URL must start with '/': got '${u}'"
        [[ "$u" =~ [';''\`''$'$'\n'] ]] && die "Exclude URL contains unsafe characters: '${u}'"
      done
      [[ "${#_excl_parts[@]}" -le 50 ]] || die "Too many exclude URLs (max 50)."
      [[ "${#set_exclude}" -le 2000 ]] || die "Exclude URLs string too long (max 2000 chars)."
    fi
    if [[ -n "$set_cookies" ]]; then
      local _ck_parts=()
      IFS=',' read -ra _ck_parts <<< "$set_cookies"
      local ck
      for ck in "${_ck_parts[@]}"; do
        ck="${ck## }"; ck="${ck%% }"
        [[ "$ck" =~ ^[a-zA-Z0-9_-]+$ ]] || die "Invalid cookie name '${ck}': use alphanumeric, underscore, dash only."
      done
      [[ "${#_ck_parts[@]}" -le 30 ]] || die "Too many bypass cookies (max 30)."
    fi
    if [[ -n "$set_bypass_q" ]]; then
      [[ "$set_bypass_q" == "on" || "$set_bypass_q" == "off" ]] || die "bypass-query must be 'on' or 'off'."
    fi
    if [[ -n "$set_stale" ]]; then
      [[ "$set_stale" == "on" || "$set_stale" == "off" ]] || die "stale-revalidate must be 'on' or 'off'."
    fi
    if [[ -n "$set_debug_hdr" ]]; then
      [[ "$set_debug_hdr" == "on" || "$set_debug_hdr" == "off" ]] || die "debug-header must be 'on' or 'off'."
    fi

    # Read current values, merge with new
    local cur_ttl;     cur_ttl=$(_cache_snippet_read "$domain" "TTL")
    local cur_excl;    cur_excl=$(_cache_snippet_read "$domain" "EXCLUDE_URLS")
    local cur_cookies; cur_cookies=$(_cache_snippet_read "$domain" "BYPASS_COOKIES")
    local cur_bq;      cur_bq=$(_cache_snippet_read "$domain" "BYPASS_QUERY")
    local cur_stale;   cur_stale=$(_cache_snippet_read "$domain" "STALE_REVALIDATE")
    local cur_debug;   cur_debug=$(_cache_snippet_read "$domain" "DEBUG_HEADER")

    local final_ttl="${set_ttl:-${cur_ttl:-1h}}"
    local final_excl="${set_exclude:-${cur_excl:-$(_cache_default_exclude_urls)}}"
    local final_cookies="${set_cookies:-$cur_cookies}"  # baseline enforced in _cache_snippet_write
    local final_bq="${set_bypass_q:-${cur_bq:-off}}"
    local final_stale="${set_stale:-${cur_stale:-off}}"
    local final_debug="${set_debug_hdr:-${cur_debug:-on}}"

    # Backup snippet + vhost in case nginx -t fails
    local backup; backup=$(mktemp)
    local vhost_backup; vhost_backup=$(mktemp)
    local conf="${NGINX_CONF_DIR}/${domain}.conf"
    cp "$snippet" "$backup"
    cp "$conf"    "$vhost_backup"

    _cache_snippet_write "$domain" "$final_ttl" "$final_excl" "$final_cookies" "$final_bq" "$final_stale" "$final_debug"

    # Apply vhost changes (TTL, stale-revalidate, debug-header)
    sed -i -E "s|(#?\s*fastcgi_cache_valid\s+200 301 302 )[0-9]+[smhd]|\1${final_ttl}|g" "$conf"
    _cache_vhost_stale_revalidate "$domain" "$final_stale"
    _cache_vhost_debug_header     "$domain" "$final_debug"

    if ! nginx -t >> "$CLI_LOG" 2>&1; then
      cp "$backup"       "$snippet"
      cp "$vhost_backup" "$conf"
      rm -f "$backup" "$vhost_backup"
      die "The web server rejected the cache configuration change; it was reverted."
    fi
    rm -f "$backup" "$vhost_backup"
    nginx -s reload >> "$CLI_LOG" 2>&1
    ok "Cache config updated for: ${domain}"
    return 0
  fi

  # ---- GET mode ----
  if [[ ! -f "$snippet" ]]; then
    warn "No per-site cache config for ${domain}. Run: aidipanel cache:enable --domain ${domain}"
    return 0
  fi

  local cur_ttl;     cur_ttl=$(_cache_snippet_read "$domain" "TTL")
  local cur_excl;    cur_excl=$(_cache_snippet_read "$domain" "EXCLUDE_URLS")
  local cur_cookies; cur_cookies=$(_cache_snippet_read "$domain" "BYPASS_COOKIES")
  local cur_bq;      cur_bq=$(_cache_snippet_read "$domain" "BYPASS_QUERY")
  local cur_stale;   cur_stale=$(_cache_snippet_read "$domain" "STALE_REVALIDATE")
  local cur_debug;   cur_debug=$(_cache_snippet_read "$domain" "DEBUG_HEADER")

  echo ""
  echo -e "  ${BOLD}Cache config: ${domain}${RESET}"
  _hr
  _table_row "TTL"                "${cur_ttl:--}"
  _table_row "Exclude URLs"       "${cur_excl:--}"
  _table_row "Bypass cookies"     "${cur_cookies:--}"
  _table_row "Bypass query"       "${cur_bq:--}"
  _table_row "Stale revalidate"   "${cur_stale:-off}"
  _table_row "Debug header"       "${cur_debug:-on}"
  _hr
  echo ""
}

_cache_status() {
  _parse_opts "$@"
  local cache_size="-"
  local cache_files=0

  if [[ -d "$NGINX_CACHE_DIR" ]]; then
    cache_size=$(du -sh "$NGINX_CACHE_DIR" 2>/dev/null | cut -f1 || echo "-")
    cache_files=$(find "$NGINX_CACHE_DIR" -type f 2>/dev/null | wc -l || echo 0)
  fi

  local zone_active="unknown"
  nginx -T 2>/dev/null | grep -q "keys_zone=${NGINX_CACHE_ZONE}" && zone_active="active"

  echo ""
  echo -e "  ${BOLD}FastCGI Cache Status${RESET}"
  _hr
  _table_row "Cache zone:"    "${NGINX_CACHE_ZONE}"
  _table_row "Zone status:"   "$zone_active"
  _table_row "Cache dir:"     "$NGINX_CACHE_DIR"
  _table_row "Cache size:"    "$cache_size"
  _table_row "Cached files:"  "$cache_files"
  _hr

  echo ""
  echo -e "  ${BOLD}Per-site cache status:${RESET}"
  printf "  %-30s %-12s\n" "Domain" "Cache"
  _hr
  for conf in "${NGINX_CONF_DIR}"/*.conf; do
    [[ -f "$conf" ]] || continue
    [[ "$(basename "$conf")" == "aidipanel-ui.conf" ]] && continue
    local domain; domain=$(basename "$conf" .conf)
    local status
    grep -Eq "^[[:space:]]*fastcgi_cache[[:space:]]+${NGINX_CACHE_ZONE}" "$conf" 2>/dev/null \
      && status="${GREEN}enabled${RESET}" \
      || status="${DIM}disabled${RESET}"
    printf "  %-30s " "$domain"
    echo -e "$status"
  done
  _hr
  echo ""
}

_cache_purge_domain() {
  local domain="$1"
  local cache_path="${NGINX_CACHE_DIR}"
  [[ -d "$cache_path" ]] || { warn "Cache directory not found: ${cache_path}"; return 0; }

  # FastCGI cache files store their key (e.g. "KEY: httpsGET<host>/uri").
  # Match files whose KEY line contains this host and delete only those, so one
  # site can be purged without flushing the shared cache. Dots are escaped and
  # the host is anchored to the URI's leading "/" (or end-of-line) so that
  # "site.com" does not also match "siteXcom" or "site.com.au".
  local escaped="${domain//./\\.}"
  local matches; matches=$(grep -rlE "^KEY: .*${escaped}(/|\$)" "$cache_path" 2>/dev/null || true)
  if [[ -z "$matches" ]]; then
    ok "No cached entries for: ${domain}"
    return 0
  fi
  local count=0
  while IFS= read -r f; do
    [[ -n "$f" ]] || continue
    rm -f "$f" && count=$((count + 1))
  done <<< "$matches"
  ok "Purged ${count} cached entries for: ${domain}"
}

_cache_purge() {
  _require_root "cache:purge"
  _parse_opts "$@"
  local domain; domain=$(_opt "domain" "")
  local url; url=$(_opt "url" "")
  local force; force=$(_opt "force" "false")

  if [[ -n "$url" ]]; then
    # Purge by specific URL — compute cache key hash
    local cache_key="${url}"
    local hash; hash=$(echo -n "$cache_key" | md5sum | awk '{print $1}')
    local level1="${hash: -1}"
    local level2="${hash: -3:2}"
    local cache_file="${NGINX_CACHE_DIR}/${level1}/${level2}/${hash}"
    if [[ -f "$cache_file" ]]; then
      rm -f "$cache_file"
      ok "Purged cache for URL: ${url}"
    else
      warn "No cache file found for URL: ${url}"
    fi
  elif [[ -n "$domain" ]]; then
    _domain_valid "$domain" || die "Invalid domain name: ${domain}"
    _cache_purge_domain "$domain"
  else
    # Purge ALL
    [[ "$force" == "true" ]] || _confirm "Purge ALL FastCGI cache?" || { log "Cancelled."; return 0; }
    find "$NGINX_CACHE_DIR" -type f -delete 2>/dev/null || true
    ok "All FastCGI cache purged (${NGINX_CACHE_DIR})"
  fi
}

_cache_install_wp_plugins() {
  local domain="$1" install_nginx_helper="$2" install_redis_plugin="$3"
  [[ "$install_nginx_helper" == "true" || "$install_redis_plugin" == "true" ]] || return 0

  local conf="${NGINX_CONF_DIR}/${domain}.conf"
  local webroot; webroot=$(_vhost_webroot "$conf")
  if [[ -z "$webroot" || ! -f "${webroot}/wp-config.php" ]]; then
    warn "WordPress not detected in ${webroot}; skipping WordPress cache plugin installation."
    [[ "$install_nginx_helper" == "true" ]] && echo "nginx_helper=skipped_no_wordpress" || true
    [[ "$install_redis_plugin"  == "true" ]] && echo "redis_plugin=skipped_no_wordpress"  || true
    return 0
  fi
  if ! command -v wp >/dev/null 2>&1; then
    warn "WP-CLI is not installed; skipping WordPress cache plugin installation."
    [[ "$install_nginx_helper" == "true" ]] && echo "nginx_helper=skipped_no_wpcli" || true
    [[ "$install_redis_plugin"  == "true" ]] && echo "redis_plugin=skipped_no_wpcli"  || true
    return 0
  fi

  local site_user; site_user=$(stat -c '%U' "$webroot" 2>/dev/null || echo "")
  mkdir -p /tmp/aidipanel-wp-cli-cache
  chown "${site_user:-www-data}":"${site_user:-www-data}" /tmp/aidipanel-wp-cli-cache 2>/dev/null || true

  local wp_base=(env WP_CLI_CACHE_DIR=/tmp/aidipanel-wp-cli-cache wp --path="$webroot")
  local runner=("${wp_base[@]}")
  if [[ -n "$site_user" ]] && command -v sudo >/dev/null 2>&1; then
    runner=(sudo -u "$site_user" "${wp_base[@]}")
  else
    runner=("${wp_base[@]}" --allow-root)
  fi

  if [[ "$install_nginx_helper" == "true" ]]; then
    local nh_status="install_failed"
    log "Installing WordPress plugin: Nginx Helper (${domain})..."
    if "${runner[@]}" plugin install nginx-helper --activate >> "$CLI_LOG" 2>&1; then
      ok "Nginx Helper plugin installed for: ${domain}"
      local nh_options
      nh_options=$(printf '{"enable_purge":"1","cache_method":"enable_fastcgi","purge_method":"unlink_files","cache_path":"%s"}' \
        "$NGINX_CACHE_DIR")
      if "${runner[@]}" option update rt_wp_nginx_helper_options "$nh_options" --format=json >> "$CLI_LOG" 2>&1; then
        ok "Nginx Helper configured (cache path: ${NGINX_CACHE_DIR})"
        nh_status="configured"
      else
        warn "Nginx Helper installed but WP option set failed — configure manually in WP Admin > Settings > Nginx Helper"
        nh_status="installed_not_configured"
      fi
    else
      warn "Failed to install Nginx Helper plugin for: ${domain}"
      nh_status="install_failed"
    fi
    echo "nginx_helper=${nh_status}"
  fi

  if [[ "$install_redis_plugin" == "true" ]]; then
    local rp_status="install_failed"
    log "Installing WordPress plugin: Redis Object Cache (${domain})..."
    if "${runner[@]}" plugin install redis-cache --activate >> "$CLI_LOG" 2>&1; then
      ok "Redis Object Cache plugin installed for: ${domain}"
      if "${runner[@]}" redis enable >> "$CLI_LOG" 2>&1; then
        ok "Redis Object Cache enabled for: ${domain}"
        rp_status="enabled"
      else
        warn "Redis Object Cache plugin installed, but object-cache enable did not complete for: ${domain}"
        rp_status="installed_not_enabled"
      fi
    else
      warn "Failed to install Redis Object Cache plugin for: ${domain}"
      rp_status="install_failed"
    fi
    echo "redis_plugin=${rp_status}"
  fi
}
_cache_toggle() {
  # $1 = enable|disable
  _require_root "cache:${1}"
  _parse_opts "${@:2}"
  local action="$1"
  local domain; domain=$(_opt "domain")
  _require_arg "domain" "$domain" "cache:${action} --domain example.com"
  _domain_valid "$domain" || die "Invalid domain name: ${domain}"
  _domain_exists "$domain" || die "Site not found: ${domain}"

  local conf="${NGINX_CONF_DIR}/${domain}.conf"
  local install_nginx_helper; install_nginx_helper=$(_opt "install-nginx-helper" "false")
  local install_redis_plugin; install_redis_plugin=$(_opt "install-redis-plugin" "false")

  if [[ "$action" != "enable" && ( "$install_nginx_helper" == "true" || "$install_redis_plugin" == "true" ) ]]; then
    die "Plugin install options are only supported with cache:enable"
  fi

  if [[ "$action" == "enable" ]]; then
    if _cache_vhost_cache_active "$domain"; then
      _progress 100 "done" "Already enabled"
      warn "FastCGI cache is already enabled for: ${domain}"
      return 0
    fi

    _progress 15 cache_snippet "Preparing cache config"
    # 1. Create per-site snippet if absent
    local snippet; snippet=$(_cache_snippet_path "$domain")
    if [[ ! -f "$snippet" ]]; then
      _cache_snippet_write "$domain" "1h" \
        "$(_cache_default_exclude_urls)" \
        "$(_cache_baseline_cookies)" \
        "off" "off" "on"
      log "Per-site cache snippet created: ${snippet}"
    fi

    # 2. Migrate vhost include from shared snippet to per-site (idempotent)
    if grep -qF "include ${NGINX_SNIPPET_DIR}/fastcgi-cache.conf;" "$conf"; then
      sed -i "s|include ${NGINX_SNIPPET_DIR}/fastcgi-cache.conf;|include ${NGINX_SNIPPET_DIR}/cache-${domain}.conf;|g" "$conf"
      log "Vhost include migrated to per-site snippet: ${domain}"
    fi

    _progress 45 cache_apply "Enabling cache in nginx"
    # 3. Uncomment cache directives
    _sed_inplace "$conf" \
      's|#\s*fastcgi_cache\s\+|fastcgi_cache |g' \
      's|#\s*fastcgi_cache_valid|fastcgi_cache_valid|g' \
      's|#\s*fastcgi_cache_bypass|fastcgi_cache_bypass|g' \
      's|#\s*fastcgi_no_cache|fastcgi_no_cache|g'

    # 4. Apply TTL from snippet to vhost (in case it differs from the 1h default)
    local saved_ttl; saved_ttl=$(_cache_snippet_read "$domain" "TTL")
    if [[ -n "$saved_ttl" && "$saved_ttl" != "1h" ]]; then
      sed -i -E "s|(fastcgi_cache_valid\s+200 301 302 )[0-9]+[smhd]|\1${saved_ttl}|g" "$conf"
    fi

    # 5. Apply stale-revalidate and debug-header preferences from snippet
    local saved_stale; saved_stale=$(_cache_snippet_read "$domain" "STALE_REVALIDATE")
    local saved_debug; saved_debug=$(_cache_snippet_read "$domain" "DEBUG_HEADER")
    _cache_vhost_stale_revalidate "$domain" "${saved_stale:-off}"
    _cache_vhost_debug_header     "$domain" "${saved_debug:-on}"

    ok "FastCGI cache enabled for: ${domain}"
    if [[ "$install_nginx_helper" == "true" || "$install_redis_plugin" == "true" ]]; then
      _progress 70 wp_plugins "Installing WordPress helper plugin"
    fi
    _cache_install_wp_plugins "$domain" "$install_nginx_helper" "$install_redis_plugin"
  else
    _progress 30 cache_disable "Disabling cache"
    # If the site is on a dedicated zone, revert + tear it down first (back to shared),
    # so the comment-out below operates on the shared zone and no orphaned zone/dir remains.
    local _zone; _zone=$(_cache_vhost_zone "$domain")
    if [[ "$_zone" != "$NGINX_CACHE_ZONE" ]]; then
      _cache_zone_disable --domain "$domain" >/dev/null 2>&1 || true
    fi
    # Comment out cache directives (now guaranteed on the shared zone)
    sed -i \
      -e "s|^\(\s*\)fastcgi_cache\s\+${NGINX_CACHE_ZONE}|\1#fastcgi_cache ${NGINX_CACHE_ZONE}|g" \
      -e 's|^\(\s*\)fastcgi_cache_valid|\1#fastcgi_cache_valid|g' \
      -e 's|^\(\s*\)fastcgi_cache_bypass|\1#fastcgi_cache_bypass|g' \
      -e 's|^\(\s*\)fastcgi_no_cache|\1#fastcgi_no_cache|g' \
      -e 's|^\(\s*\)fastcgi_cache_use_stale|\1#fastcgi_cache_use_stale|g' \
      -e 's|^\(\s*\)add_header X-FastCGI-Cache|\1#add_header X-FastCGI-Cache|g' \
      "$conf"
    _cache_purge_domain "$domain"
    ok "FastCGI cache disabled for: ${domain}"
  fi

  _progress 90 nginx "Validating and reloading nginx"
  _nginx_test_reload
  if [[ "$action" == "enable" ]]; then
    _progress 100 "done" "Page cache enabled"
  else
    _progress 100 "done" "Page cache disabled"
  fi
}

# cache:harden [--no-flush]
# Idempotently bring an existing install's global nginx.conf up to the hardened
# default: remove Set-Cookie from fastcgi_ignore_headers so cookie-setting
# responses are never cached. Backup + nginx -t + rollback, then flush the cache
# to evict any already-poisoned entries (skip with --no-flush).
_cache_harden() {
  _require_root "cache:harden"
  _parse_opts "$@"
  local no_flush; no_flush=$(_opt "no-flush" "false")

  local conf="/etc/nginx/nginx.conf"
  [[ -f "$conf" ]] || die "nginx.conf not found: ${conf}"

  if ! grep -qE '^[[:space:]]*fastcgi_ignore_headers' "$conf"; then
    die "cache:harden: 'fastcgi_ignore_headers' not found in ${conf} — inspect the config manually."
  fi

  # 1. Drop Set-Cookie from fastcgi_ignore_headers so cookie-setting responses are
  #    never cached (idempotent).
  local backup=""
  if grep -E '^[[:space:]]*fastcgi_ignore_headers' "$conf" | grep -qw 'Set-Cookie'; then
    backup="${conf}.harden-bak.$(date +%s)"
    cp "$conf" "$backup"
    log "Backed up nginx.conf -> ${backup}"
    sed -i -E '/^[[:space:]]*fastcgi_ignore_headers/ s/[[:space:]]+Set-Cookie\b//' "$conf"
    ok "Removed Set-Cookie from fastcgi_ignore_headers."
  else
    ok "fastcgi_ignore_headers already excludes Set-Cookie."
  fi

  # 2. Retrofit every per-site cache snippet to the current bypass policy (e.g. the
  #    /wp-json/ + /xmlrpc.php baseline). Re-write each from its stored config;
  #    _cache_snippet_write re-applies the baseline. Idempotent and structurally
  #    identical to the original write, so it adds no nginx -t risk.
  local rewritten=0 sn dom
  for sn in "${NGINX_SNIPPET_DIR}"/cache-*.conf; do
    [[ -f "$sn" ]] || continue
    dom=$(basename "$sn" .conf); dom="${dom#cache-}"
    _cache_snippet_write "$dom" \
      "$(_cache_snippet_read "$dom" TTL)" \
      "$(_cache_snippet_read "$dom" EXCLUDE_URLS)" \
      "$(_cache_snippet_read "$dom" BYPASS_COOKIES)" \
      "$(_cache_snippet_read "$dom" BYPASS_QUERY)" \
      "$(_cache_snippet_read "$dom" STALE_REVALIDATE)" \
      "$(_cache_snippet_read "$dom" DEBUG_HEADER)"
    rewritten=$((rewritten + 1))
  done
  [[ "$rewritten" -gt 0 ]] && ok "Retrofitted ${rewritten} per-site cache snippet(s) to the current policy."

  # 3. Validate everything, then reload (rollback nginx.conf on failure).
  if ! nginx -t >> "$CLI_LOG" 2>&1; then
    [[ -n "$backup" ]] && cp "$backup" "$conf"
    warn "nginx -t failed after harden — restored nginx.conf backup."
    die "cache:harden aborted. Check: nginx -t"
  fi
  nginx -s reload >> "$CLI_LOG" 2>&1
  ok "cache:harden applied; nginx reloaded."

  # 4. Flush so any entry cached under the old policy is evicted (skip with --no-flush).
  if [[ "$no_flush" == "true" ]]; then
    warn "Skipped cache flush (--no-flush)."
  elif [[ -d "$NGINX_CACHE_DIR" ]]; then
    find "$NGINX_CACHE_DIR" -mindepth 1 -delete 2>/dev/null || true
    ok "Flushed FastCGI cache: ${NGINX_CACHE_DIR}"
  fi

  [[ -n "$backup" ]] && ok "Backup kept at ${backup}."
  ok "cache:harden complete."
}

# ===========================================================================
# cache:zone — per-site dedicated FastCGI cache zone (opt-in; default is shared)
# ===========================================================================
_cache_zone() {
  _parse_opts "$@"
  local action; action=$(_opt "action" "status")
  case "$action" in
    status)  _cache_zone_status "$@" ;;
    enable)  _cache_zone_enable "$@" ;;
    disable) _cache_zone_disable "$@" ;;
    *) die "cache:zone: unknown action '${action}'. Supported: status, enable, disable" ;;
  esac
}

# cache:zone --action status --domain <d>  (read-only; key=value output)
_cache_zone_status() {
  _parse_opts "$@"
  local domain; domain=$(_opt "domain")
  _require_arg "domain" "$domain" "cache:zone --action status --domain example.com"
  _domain_valid "$domain" || die "Invalid domain name: ${domain}"
  echo "domain=${domain}"
  if ! _domain_exists "$domain"; then echo "error=domain_not_found"; return 0; fi

  local zone; zone=$(_cache_vhost_zone "$domain")
  if [[ "$zone" == "$NGINX_CACHE_ZONE" ]]; then
    echo "zone=shared"; echo "zone_name=${NGINX_CACHE_ZONE}"
    echo "keys=-"; echo "max_size=-"; echo "cache_dir=-"; echo "error="; return 0
  fi
  local user="${zone#${NGINX_CACHE_ZONE}_}"
  local zfile="${NGINX_ZONE_CONF_DIR}/${user}.conf"
  local cdir="${NGINX_ZONE_CACHE_BASE}/${user}/fastcgi"
  local keys="-" max="-"
  if [[ -f "$zfile" ]]; then
    keys=$(sed -nE 's/.*keys_zone=[A-Za-z0-9_-]+:([0-9]+[kKmMgG]).*/\1/p' "$zfile" | head -1)
    max=$(sed -nE 's/.*max_size=([0-9]+[kKmMgG]).*/\1/p' "$zfile" | head -1)
  fi
  echo "zone=dedicated"; echo "zone_name=${zone}"
  echo "keys=${keys:--}"; echo "max_size=${max:--}"; echo "cache_dir=${cdir}"; echo "error="
}

# cache:zone --action enable --domain <d> [--keys 32m] [--max-size 2g] [--force]
_cache_zone_enable() {
  _require_root "cache:zone enable"
  _parse_opts "$@"
  local domain; domain=$(_opt "domain")
  _require_arg "domain" "$domain" "cache:zone --action enable --domain example.com [--keys 32m] [--max-size 2g] [--force]"
  _domain_valid "$domain" || die "Invalid domain name: ${domain}"
  echo "domain=${domain}"
  _domain_exists "$domain" || { echo "error=domain_not_found"; die "Site not found: ${domain}"; }

  local keys; keys=$(_opt "keys" "32m")
  local maxsize; maxsize=$(_opt "max-size" "2g")
  local force; force=$(_opt "force" "false")
  _cache_zone_valid_size "$keys"    || { echo "error=invalid_size"; die "Invalid --keys '${keys}' (use 32m, 512k, 2g)."; }
  _cache_zone_valid_size "$maxsize" || { echo "error=invalid_size"; die "Invalid --max-size '${maxsize}' (use 32m, 512k, 2g)."; }

  # Precondition: the page cache must be ACTIVE on this site.
  _cache_vhost_cache_active "$domain" || { echo "error=cache_not_enabled"; die "Enable the page cache first: aidipanel cache:enable --domain ${domain}"; }

  local conf="${NGINX_CONF_DIR}/${domain}.conf"
  local site_user; site_user=$(grep -oP '^\s*root\s+/home/\K[^/;]+' "$conf" 2>/dev/null | head -1 || echo "")
  [[ -n "$site_user" ]] || { echo "error=site_user_unresolved"; die "Could not resolve the site user for ${domain}."; }

  local zone; zone=$(_cache_zone_name "$site_user")
  local zfile="${NGINX_ZONE_CONF_DIR}/${site_user}.conf"
  local cdir="${NGINX_ZONE_CACHE_BASE}/${site_user}/fastcgi"
  local cur_zone; cur_zone=$(_cache_vhost_zone "$domain")
  local is_resize=0; [[ "$cur_zone" == "$zone" ]] && is_resize=1

  _progress 15 zone_preflight "Checking disk and memory"
  # 2. Pre-flight (unless --force): disk free >= max_size, RAM available >= keys_zone.
  if [[ "$force" != "true" ]]; then
    local need_disk; need_disk=$(_size_to_bytes "$maxsize")
    local free_disk; free_disk=$(df -PB1 "$NGINX_CACHE_DIR" 2>/dev/null | awk 'NR==2{print $4}')
    [[ -n "$free_disk" ]] || free_disk=$(df -PB1 /var/cache 2>/dev/null | awk 'NR==2{print $4}')
    if [[ -n "$free_disk" && "$free_disk" -lt "$need_disk" ]]; then
      echo "error=insufficient_disk"; die "Not enough free disk for max_size=${maxsize}. Use a smaller --max-size or free space."
    fi
    local need_ram; need_ram=$(_size_to_bytes "$keys")
    local free_ram; free_ram=$(awk '/MemAvailable/{print $2*1024}' /proc/meminfo 2>/dev/null)
    if [[ -n "$free_ram" && "$free_ram" -lt "$need_ram" ]]; then
      echo "error=insufficient_ram"; die "Not enough available RAM for keys_zone=${keys}. Use a smaller --keys."
    fi
  fi

  _progress 40 zone_write "Writing the dedicated zone"
  # 3. Create the zone-config dir FIRST, then the cache dir, then the shim (idempotent).
  mkdir -p "$NGINX_ZONE_CONF_DIR"
  install -d -o www-data -g www-data -m 0750 "$cdir"
  local shim_created=0
  if [[ ! -f "$NGINX_ZONE_SHIM" ]]; then
    printf 'include %s/*.conf;\n' "$NGINX_ZONE_CONF_DIR" > "$NGINX_ZONE_SHIM"
    shim_created=1
  fi

  # 4. On resize, back up the old zone file; then write the zone file.
  local zbackup=""
  if [[ -f "$zfile" ]]; then zbackup=$(mktemp); cp "$zfile" "$zbackup"; fi
  cat > "$zfile" <<ZONE
# AidiPanel — dedicated FastCGI cache zone for ${domain} (site_user=${site_user})
fastcgi_cache_path ${cdir}
    levels=1:2
    keys_zone=${zone}:${keys}
    max_size=${maxsize}
    inactive=60m
    use_temp_path=off;
ZONE
  chmod 644 "$zfile"

  # 5. nginx -t; state-aware rollback (vhost still untouched here).
  if ! nginx -t >> "$CLI_LOG" 2>&1; then
    if [[ -n "$zbackup" ]]; then cp "$zbackup" "$zfile"; rm -f "$zbackup"
    else rm -f "$zfile"; [[ "$shim_created" == 1 ]] && rm -f "$NGINX_ZONE_SHIM"; fi
    echo "error=nginx_test_failed"; die "cache:zone enable: nginx rejected the zone; reverted."
  fi
  rm -f "$zbackup"
  _progress 65 zone_load "Loading the zone into nginx"
  # 6. reload so the zone exists in the running config.
  nginx -s reload >> "$CLI_LOG" 2>&1

  _progress 85 zone_point "Pointing the site at its zone"
  # 7. repoint the vhost (resolve current zone via the regex; do not assume shared).
  local vbackup; vbackup=$(mktemp); cp "$conf" "$vbackup"
  sed -i -E "s|^([[:space:]]*)fastcgi_cache[[:space:]]+[A-Za-z0-9_-]+([[:space:]]*;)|\1fastcgi_cache ${zone}\2|" "$conf"
  # 8. nginx -t; rollback vhost on failure.
  if ! nginx -t >> "$CLI_LOG" 2>&1; then
    cp "$vbackup" "$conf"; rm -f "$vbackup"; nginx -s reload >> "$CLI_LOG" 2>&1
    echo "error=nginx_test_failed"; die "cache:zone enable: vhost repoint failed; reverted."
  fi
  rm -f "$vbackup"
  # 9. reload.
  nginx -s reload >> "$CLI_LOG" 2>&1

  # 10. flush this host's now-orphaned shared entries (skip on resize). Best-effort.
  [[ "$is_resize" == 0 ]] && { _cache_purge_domain "$domain" >/dev/null 2>&1 || true; }

  echo "zone=dedicated"; echo "zone_name=${zone}"; echo "error="
  _progress 100 "done" "Dedicated zone enabled"
  ok "Dedicated cache zone enabled for ${domain} (${zone}, keys=${keys}, max_size=${maxsize})."
}

# cache:zone --action disable --domain <d>  (revert to shared zone + tear down dedicated)
_cache_zone_disable() {
  _require_root "cache:zone disable"
  _parse_opts "$@"
  local domain; domain=$(_opt "domain")
  _require_arg "domain" "$domain" "cache:zone --action disable --domain example.com"
  _domain_valid "$domain" || die "Invalid domain name: ${domain}"
  echo "domain=${domain}"
  _domain_exists "$domain" || { echo "error=domain_not_found"; die "Site not found: ${domain}"; }

  local conf="${NGINX_CONF_DIR}/${domain}.conf"
  local cur_zone; cur_zone=$(_cache_vhost_zone "$domain")
  if [[ "$cur_zone" == "$NGINX_CACHE_ZONE" ]]; then
    echo "zone=shared"; echo "zone_name=${NGINX_CACHE_ZONE}"; echo "error="
    _progress 100 "done" "Already on the shared zone"
    ok "${domain} already uses the shared cache zone."; return 0
  fi
  local user="${cur_zone#${NGINX_CACHE_ZONE}_}"
  local zfile="${NGINX_ZONE_CONF_DIR}/${user}.conf"

  _progress 25 zone_revert "Reverting to the shared zone"
  # 2-3. repoint vhost back to the shared zone; nginx -t; rollback.
  local vbackup; vbackup=$(mktemp); cp "$conf" "$vbackup"
  sed -i -E "s|^([[:space:]]*)fastcgi_cache[[:space:]]+[A-Za-z0-9_-]+([[:space:]]*;)|\1fastcgi_cache ${NGINX_CACHE_ZONE}\2|" "$conf"
  if ! nginx -t >> "$CLI_LOG" 2>&1; then
    cp "$vbackup" "$conf"; rm -f "$vbackup"; nginx -s reload >> "$CLI_LOG" 2>&1
    echo "error=nginx_test_failed"; die "cache:zone disable: revert failed; restored."
  fi
  rm -f "$vbackup"
  # 4. reload — nothing references the dedicated zone now.
  nginx -s reload >> "$CLI_LOG" 2>&1

  _progress 60 zone_cleanup "Removing the dedicated zone"
  # 5. back up + remove the zone file; nginx -t; restore on failure.
  if [[ -f "$zfile" ]]; then
    local zbackup; zbackup=$(mktemp); cp "$zfile" "$zbackup"
    rm -f "$zfile"
    if ! nginx -t >> "$CLI_LOG" 2>&1; then
      cp "$zbackup" "$zfile"; rm -f "$zbackup"; nginx -s reload >> "$CLI_LOG" 2>&1
      echo "error=nginx_test_failed"; die "cache:zone disable: zone-file removal failed; restored."
    fi
    rm -f "$zbackup"
    nginx -s reload >> "$CLI_LOG" 2>&1
  fi
  # 6. remove the per-site cache dir.
  [[ -n "$user" ]] && rm -rf "${NGINX_ZONE_CACHE_BASE:?}/${user}"

  echo "zone=shared"; echo "zone_name=${NGINX_CACHE_ZONE}"; echo "error="
  _progress 100 "done" "Back to the shared zone"
  ok "Dedicated cache zone removed for ${domain}; back to shared."
}

_cache_migrate() {
  _require_root "cache:migrate"
  _parse_opts "$@"
  local dry_run; dry_run=$(_opt "dry-run" "false")

  local migrated=0 skipped=0
  local changed_confs=()

  for conf in "${NGINX_CONF_DIR}"/*.conf; do
    [[ -f "$conf" ]] || continue
    local domain; domain=$(basename "$conf" .conf)
    [[ "$domain" == "aidipanel-ui" ]] && continue

    if grep -qF "include ${NGINX_SNIPPET_DIR}/fastcgi-cache.conf;" "$conf"; then
      local snippet; snippet=$(_cache_snippet_path "$domain")

      if [[ "$dry_run" == "true" ]]; then
        log "[dry-run] Would migrate: ${domain}"
        migrated=$((migrated + 1))
        continue
      fi

      if [[ ! -f "$snippet" ]]; then
        _cache_snippet_write "$domain" "1h" \
          "$(_cache_default_exclude_urls)" \
          "$(_cache_baseline_cookies)" \
          "off" "off" "on"
      fi

      local backup="${conf}.migrate-bak"
      cp "$conf" "$backup"
      changed_confs+=("$conf" "$backup")

      sed -i "s|include ${NGINX_SNIPPET_DIR}/fastcgi-cache.conf;|include ${NGINX_SNIPPET_DIR}/cache-${domain}.conf;|g" "$conf"
      log "Migrated: ${domain}"
      migrated=$((migrated + 1))
    else
      log "Skip: ${domain} (already per-site or no shared include)"
      skipped=$((skipped + 1))
    fi
  done

  if [[ "$dry_run" == "true" ]]; then
    ok "Dry-run done. Would migrate: ${migrated} sites. Run without --dry-run to apply."
    return 0
  fi

  if [[ "$migrated" -eq 0 ]]; then
    ok "Nothing to migrate — all sites already use per-site snippets."
    return 0
  fi

  if ! nginx -t >> "$CLI_LOG" 2>&1; then
    warn "Nginx test failed — rolling back all migrated vhosts..."
    local i
    for (( i = 0; i < ${#changed_confs[@]}; i += 2 )); do
      cp "${changed_confs[$((i+1))]}" "${changed_confs[$i]}"
      rm -f "${changed_confs[$((i+1))]}"
    done
    die "Migration rolled back. Check: nginx -t"
  fi

  local i
  for (( i = 1; i < ${#changed_confs[@]}; i += 2 )); do
    rm -f "${changed_confs[$i]}"
  done

  nginx -s reload >> "$CLI_LOG" 2>&1
  ok "Migration complete. Sites migrated: ${migrated}. Skipped: ${skipped}."
}

# ---------------------------------------------------------------------------
# REDIS COMMANDS (standalone — independent of WordPress plugin)
# ---------------------------------------------------------------------------

_cache_redis_status() {
  local svc_active; svc_active=$(systemctl is-active redis-server 2>/dev/null || echo "unknown")
  local svc_enabled; svc_enabled=$(systemctl is-enabled redis-server 2>/dev/null || echo "unknown")
  local ping; ping=$(redis-cli ping 2>/dev/null || echo "FAIL")
  echo ""
  echo -e "  ${BOLD}Redis Status${RESET}"
  _hr
  _table_row "Service:"  "$svc_active"
  _table_row "Enabled:"  "$svc_enabled"
  _table_row "Ping:"     "$ping"
  _hr
  echo ""
}

_cache_redis_enable() {
  _require_root "cache:redis-enable"
  command -v redis-server >/dev/null 2>&1 || die "redis-server not installed."
  systemctl enable --now redis-server >> "$CLI_LOG" 2>&1 \
    && ok "Redis enabled and started." \
    || die "Could not start Redis. The redis-server service failed to start."
}

_cache_redis_disable() {
  _require_root "cache:redis-disable"
  systemctl stop redis-server >> "$CLI_LOG" 2>&1 || true
  systemctl disable redis-server >> "$CLI_LOG" 2>&1 \
    && ok "Redis stopped and disabled." \
    || warn "Redis disable returned non-zero — check manually."
}

_cache_redis_flush() {
  _require_root "cache:redis-flush"
  command -v redis-cli >/dev/null 2>&1 || die "redis-cli not installed."
  redis-cli FLUSHALL >> "$CLI_LOG" 2>&1 \
    && ok "Redis flushed (FLUSHALL)." \
    || die "Could not flush the Redis cache — Redis may not be running."
}

_cache_opcache_restart() {
  _require_root "cache:opcache-restart"
  _parse_opts "$@"
  local target_ver; target_ver=$(_opt "php" "")

  local versions=()
  if [[ -n "$target_ver" ]]; then
    versions=("$target_ver")
  else
    while IFS= read -r svc; do
      local ver; ver=$(echo "$svc" | grep -oP '\d+\.\d+(?=-fpm)')
      [[ -n "$ver" ]] && versions+=("$ver")
    done < <(systemctl list-units --type=service --state=active --no-legend 2>/dev/null \
      | grep -oP 'php\d+\.\d+-fpm\.service' | sort -u)
  fi

  if [[ "${#versions[@]}" -eq 0 ]]; then
    warn "No active PHP-FPM found."
    return 0
  fi

  local ver
  for ver in "${versions[@]}"; do
    systemctl reload "php${ver}-fpm" >> "$CLI_LOG" 2>&1 \
      && ok "OPcache restarted (PHP ${ver})" \
      || warn "Failed to reload php${ver}-fpm — try: systemctl restart php${ver}-fpm"
  done
}

# ===========================================================================
# DATABASE COMMANDS
# ===========================================================================

# Resolve a site's Linux user from its vhost and echo the DB name prefix
# (dashes -> underscores, plus a trailing "_"). Scopes every per-site db:*
# operation to one site; the vhost is root-owned, so this cannot be forged.
_db_site_prefix() {
  local domain="$1" user=""
  local conf="${NGINX_CONF_DIR}/${domain}.conf"
  _domain_valid "$domain" || die "Invalid domain name: ${domain}"
  [[ -f "$conf" ]] || die "Site not found: ${domain}"
  # Prefer the PHP-FPM socket (php<ver>-fpm-<user>.sock); fall back to the webroot owner.
  user=$(grep -oP 'php[0-9.]+-fpm-\K[a-z0-9_-]+(?=\.sock)' "$conf" 2>/dev/null | head -1 || echo "")
  [[ -n "$user" ]] || user=$(grep -oP "^[[:space:]]*root[[:space:]]+${HOME_BASE}/\K[^/]+" "$conf" 2>/dev/null | head -1 || echo "")
  [[ -n "$user" ]] || die "Could not resolve the site user for ${domain}."
  printf '%s_' "${user//-/_}"
}

# Refuse any name that is not inside the site's prefix (the isolation guard).
_db_require_prefix() {
  local name="$1" prefix="$2"
  [[ "$name" == "${prefix}"* ]] \
    || die "Name '${name}' is not allowed for this site (must start with '${prefix}')."
}

# Grant a user's privileges on a database at the requested level (rw=ALL, ro=SELECT).
_db_grant() {
  local db="$1" user="$2" perm="${3:-rw}"
  if [[ "$perm" == "ro" ]]; then
    _mysql_exec "GRANT SELECT ON \`${db}\`.* TO '${user}'@'localhost';" || return 1
  else
    _mysql_exec "GRANT ALL PRIVILEGES ON \`${db}\`.* TO '${user}'@'localhost';" || return 1
  fi
}

_db_secret_init() {
  mkdir -p "$DB_SECRET_DIR" "$(dirname "$DB_SECRET_KEY")" || return 1
  chown root:root "$DB_SECRET_DIR" "$(dirname "$DB_SECRET_KEY")" 2>/dev/null || true
  chmod 700 "$DB_SECRET_DIR" || return 1

  if [[ ! -f "$DB_SECRET_KEY" ]]; then
    local old_umask
    old_umask=$(umask)
    umask 177
    openssl rand -hex 32 > "$DB_SECRET_KEY" || { umask "$old_umask"; return 1; }
    umask "$old_umask"
  fi
  chown root:root "$DB_SECRET_KEY" 2>/dev/null || true
  chmod 600 "$DB_SECRET_KEY" || return 1

  if [[ ! -f "$DB_SECRET_STORE" ]]; then
    : > "$DB_SECRET_STORE" || return 1
  fi
  chown root:root "$DB_SECRET_STORE" 2>/dev/null || true
  chmod 600 "$DB_SECRET_STORE" || return 1
}

_db_secret_encrypt() {
  _db_secret_init || return 1
  printf '%s' "$1" | openssl enc -aes-256-cbc -pbkdf2 -salt -a -A -pass "file:${DB_SECRET_KEY}"
}

_db_secret_decrypt() {
  _db_secret_init || return 1
  printf '%s' "$1" | openssl enc -d -aes-256-cbc -pbkdf2 -a -A -pass "file:${DB_SECRET_KEY}" 2>/dev/null
}

_db_secret_put() {
  local site="$1" db_name="$2" db_user="$3" db_pass="$4"
  [[ -n "$site" && -n "$db_name" && -n "$db_user" && -n "$db_pass" ]] || return 1
  local cipher tmp
  cipher=$(_db_secret_encrypt "$db_pass") || return 1
  tmp=$(mktemp) || return 1
  awk -F '\t' -v s="$site" -v d="$db_name" -v u="$db_user" \
    'BEGIN { OFS = FS } !($1 == s && $2 == d && $3 == u) { print }' \
    "$DB_SECRET_STORE" > "$tmp" || { rm -f "$tmp"; return 1; }
  printf '%s\t%s\t%s\t%s\n' "$site" "$db_name" "$db_user" "$cipher" >> "$tmp"
  chown root:root "$tmp" 2>/dev/null || true
  chmod 600 "$tmp" || { rm -f "$tmp"; return 1; }
  mv "$tmp" "$DB_SECRET_STORE"
}

_db_secret_get() {
  local site="$1" db_name="$2" db_user="$3" cipher=""
  _db_secret_init || return 1
  cipher=$(awk -F '\t' -v s="$site" -v d="$db_name" -v u="$db_user" \
    '$1 == s && $2 == d && $3 == u { print $4; exit }' "$DB_SECRET_STORE")
  [[ -n "$cipher" ]] || return 1
  _db_secret_decrypt "$cipher"
}

_db_secret_delete_db() {
  local site="$1" db_name="$2" tmp
  _db_secret_init || return 0
  tmp=$(mktemp) || return 0
  awk -F '\t' -v s="$site" -v d="$db_name" \
    'BEGIN { OFS = FS } !($1 == s && $2 == d) { print }' \
    "$DB_SECRET_STORE" > "$tmp" || { rm -f "$tmp"; return 0; }
  chown root:root "$tmp" 2>/dev/null || true
  chmod 600 "$tmp" 2>/dev/null || true
  mv "$tmp" "$DB_SECRET_STORE" 2>/dev/null || true
}

_db_secret_delete_user() {
  local site="$1" db_user="$2" tmp
  _db_secret_init || return 0
  tmp=$(mktemp) || return 0
  awk -F '\t' -v s="$site" -v u="$db_user" \
    'BEGIN { OFS = FS } !($1 == s && $3 == u) { print }' \
    "$DB_SECRET_STORE" > "$tmp" || { rm -f "$tmp"; return 0; }
  chown root:root "$tmp" 2>/dev/null || true
  chmod 600 "$tmp" 2>/dev/null || true
  mv "$tmp" "$DB_SECRET_STORE" 2>/dev/null || true
}

# Remove every stored secret belonging to a site (keyed by the site identifier in
# column 1 — the domain passed as `db:add --site <domain>`). Used by site teardown.
_db_secret_delete_site() {
  local site="$1" tmp
  _db_secret_init || return 0
  tmp=$(mktemp) || return 0
  awk -F '\t' -v s="$site" \
    'BEGIN { OFS = FS } $1 != s { print }' \
    "$DB_SECRET_STORE" > "$tmp" || { rm -f "$tmp"; return 0; }
  chown root:root "$tmp" 2>/dev/null || true
  chmod 600 "$tmp" 2>/dev/null || true
  mv "$tmp" "$DB_SECRET_STORE" 2>/dev/null || true
}

_db_user_grant_dbs() {
  local db_user="$1"
  _mysql_exec "SELECT Db FROM mysql.db WHERE User = '$(_sql_escape_literal "$db_user")' AND Host = 'localhost';" 2>/dev/null \
    | awk 'NR > 1 && NF { print $1 }'
}

_db_wp_config_value() {
  local file="$1" key="$2"
  grep -E "define\([[:space:]]*['\"]${key}['\"]" "$file" 2>/dev/null \
    | head -1 \
    | sed -E "s/.*define\([[:space:]]*['\"]${key}['\"][[:space:]]*,[[:space:]]*['\"]([^'\"]*)['\"].*/\1/"
}

_db_secret_backfill_wp() {
  local site="$1" db_name="$2" db_user="$3"
  local conf="${NGINX_CONF_DIR}/${site}.conf"
  [[ -f "$conf" ]] || return 1
  local webroot; webroot=$(_vhost_webroot "$conf")
  local wp_config="${webroot}/wp-config.php"
  [[ -f "$wp_config" ]] || return 1
  local wp_db wp_user wp_pass
  wp_db=$(_db_wp_config_value "$wp_config" "DB_NAME")
  wp_user=$(_db_wp_config_value "$wp_config" "DB_USER")
  wp_pass=$(_db_wp_config_value "$wp_config" "DB_PASSWORD")
  [[ "$wp_db" == "$db_name" && "$wp_user" == "$db_user" && -n "$wp_pass" ]] || return 1
  _db_secret_put "$site" "$db_name" "$db_user" "$wp_pass" || return 1
  printf '%s' "$wp_pass"
}

# Escape SQL LIKE metacharacters so a value matches LITERALLY under `ESCAPE '|'`.
# A site DB prefix ends in `_`, which LIKE treats as a single-char wildcard; without
# this, prefix `aa_` (LIKE 'aa_%') would also match another site's `aab_*` databases.
# Escape the escape char first, then the wildcards.
_db_like_escape() {
  local s="$1"
  s="${s//|/||}"
  s="${s//%/|%}"
  s="${s//_/|_}"
  printf '%s' "$s"
}

# Provision / deprovision a MySQL database + user. Shared by db:add and WordPress
# provisioning so both go through one code path.
_db_provision() {
  local db_name="$1" db_user="$2" db_pass="$3" db_perm="${4:-rw}"
  local db_pass_sql; db_pass_sql=$(_sql_escape_literal "$db_pass")
  # `|| return 1` on each step so a failure surfaces even when this runs in a `||`
  # context (errexit suppressed), e.g. the site:add WordPress rollback path.
  _mysql_exec "CREATE DATABASE IF NOT EXISTS \`${db_name}\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;" || return 1
  _mysql_exec "CREATE USER IF NOT EXISTS '${db_user}'@'localhost' IDENTIFIED BY '${db_pass_sql}';" || return 1
  # CREATE USER IF NOT EXISTS is a no-op for an existing user, so without this a
  # leftover user from a prior site keeps its OLD password and the new connection
  # fails with "Access denied". ALTER USER force-sets the intended password.
  _mysql_exec "ALTER USER '${db_user}'@'localhost' IDENTIFIED BY '${db_pass_sql}';" || return 1
  _db_grant "$db_name" "$db_user" "$db_perm" || return 1
  _mysql_exec "FLUSH PRIVILEGES;" || return 1
}

_db_deprovision() {
  local db_name="$1" db_user="$2"
  _mysql_exec "DROP DATABASE IF EXISTS \`${db_name}\`;"
  _mysql_exec "DROP USER IF EXISTS '${db_user}'@'localhost';"
  _mysql_exec "FLUSH PRIVILEGES;"
}

# Drop every MySQL database + @localhost user that belongs to a site (matched by the
# site's `<site_user>_` prefix), plus the site's stored phpMyAdmin secrets. The prefix
# is LIKE-escaped (see _db_like_escape) so it can never reach another site's data.
# Non-fatal: warns and returns 0 so a database error can't block the rest of teardown.
_db_deprovision_site() {
  local site_user="$1" domain="$2"
  [[ -n "$site_user" ]] || { warn "No site user resolved; skipping database cleanup for ${domain:-site}."; return 0; }

  local prefix esc
  prefix="${site_user//-/_}_"
  esc=$(_db_like_escape "$prefix")

  local -a dbs users
  mapfile -t dbs < <(_mysql_exec "SELECT schema_name FROM information_schema.schemata WHERE schema_name LIKE '${esc}%' ESCAPE '|' AND schema_name NOT IN ('information_schema','mysql','performance_schema','sys');" 2>/dev/null | awk 'NR>1 && NF { print $1 }')
  mapfile -t users < <(_mysql_exec "SELECT User FROM mysql.user WHERE User LIKE '${esc}%' ESCAPE '|' AND Host='localhost';" 2>/dev/null | awk 'NR>1 && NF { print $1 }')

  local d u dropped_db=0 dropped_user=0
  for d in "${dbs[@]}"; do
    [[ -n "$d" ]] || continue
    if _mysql_exec "DROP DATABASE IF EXISTS \`${d}\`;"; then
      dropped_db=$((dropped_db + 1))
    else
      warn "Could not drop database ${d}."
    fi
  done
  for u in "${users[@]}"; do
    [[ -n "$u" ]] || continue
    if _mysql_exec "DROP USER IF EXISTS '${u}'@'localhost';"; then
      dropped_user=$((dropped_user + 1))
    else
      warn "Could not drop database user ${u}."
    fi
  done
  _mysql_exec "FLUSH PRIVILEGES;" >/dev/null 2>&1 || true

  if [[ -n "$domain" ]]; then
    _db_secret_delete_site "$domain"
  fi

  if [[ "$dropped_db" -gt 0 || "$dropped_user" -gt 0 ]]; then
    ok "Databases removed for ${domain:-$site_user}: ${dropped_db} database(s), ${dropped_user} user(s)."
  fi
  return 0
}

_db_add() {
  _require_root "db:add"
  _parse_opts "$@"
  local db_name; db_name=$(_opt "name")
  local db_user; db_user=$(_opt "user" "$db_name")
  local db_pass; db_pass=$(_opt "pass" "$(openssl rand -base64 16 | tr -dc 'A-Za-z0-9' | head -c 16)")
  local site;    site=$(_opt "site" "")
  local perm;    perm=$(_opt "permission" "rw")
  local no_user; no_user=$(_opt "no-user" "false")

  _require_arg "name" "$db_name" "db:add --name mydb --user myuser"

  # Validate: only alphanumeric and underscores
  [[ "$db_name" =~ ^[a-zA-Z0-9_]+$ ]] \
    || die "Database name must contain only letters, numbers, underscores"
  [[ "$db_user" =~ ^[a-zA-Z0-9_]+$ ]] \
    || die "Database user must contain only letters, numbers, underscores"
  [[ "$db_pass" =~ ^[A-Za-z0-9_!@#%+=.,:-]{8,128}$ ]] \
    || die "Database password must be 8-128 characters and contain only safe symbols"
  [[ "$perm" =~ ^(rw|ro)$ ]] || die "Permission must be 'rw' or 'ro'"

  # When scoped to a site, every name must live under that site's prefix.
  if [[ -n "$site" ]]; then
    local prefix; prefix=$(_db_site_prefix "$site")
    _db_require_prefix "$db_name" "$prefix"
    [[ "$no_user" == "true" ]] || _db_require_prefix "$db_user" "$prefix"
  fi

  if [[ "$no_user" == "true" ]]; then
    log "Creating database: ${db_name}..."
    _mysql_exec "CREATE DATABASE IF NOT EXISTS \`${db_name}\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;" \
      || die "Could not create database ${db_name}."
    ok "Database created: ${db_name}"
    echo ""
    _table_row "Database:" "$db_name"
    _table_row "Host:"     "localhost"
    echo ""
    return 0
  fi

  log "Creating database: ${db_name} (user: ${db_user}, ${perm})..."

  _db_provision "$db_name" "$db_user" "$db_pass" "$perm"
  if [[ -n "$site" ]]; then
    _db_secret_put "$site" "$db_name" "$db_user" "$db_pass" \
      || warn "Could not store encrypted phpMyAdmin credential; reset the user password before using Manage."
  fi

  ok "Database created: ${db_name}"
  echo ""
  _table_row "Database:"   "$db_name"
  _table_row "User:"       "$db_user"
  _table_row "Password:"   "$db_pass"
  _table_row "Permission:" "$perm"
  _table_row "Host:"       "localhost"
  echo ""
  warn "Save the password above — it will not be shown again."
}

_db_delete() {
  _require_root "db:delete"
  _parse_opts "$@"
  local db_name; db_name=$(_opt "name")
  _require_arg "name" "$db_name" "db:delete --name mydb [--user myuser]"
  [[ "$db_name" =~ ^[a-zA-Z0-9_]+$ ]] \
    || die "Database name must contain only letters, numbers, underscores"
  local db_user; db_user=$(_opt "user" "$db_name")
  [[ "$db_user" =~ ^[a-zA-Z0-9_]+$ ]] \
    || die "Database user must contain only letters, numbers, underscores"
  local site; site=$(_opt "site" "")
  if [[ -n "$site" ]]; then
    local prefix; prefix=$(_db_site_prefix "$site")
    _db_require_prefix "$db_name" "$prefix"
  fi
  local force; force=$(_opt "force" "false")

  [[ "$force" == "true" ]] || _confirm "Delete database '${db_name}' and its user '${db_user}'?" || { log "Cancelled."; return 0; }

  _db_deprovision "$db_name" "$db_user"
  [[ -n "$site" ]] && _db_secret_delete_db "$site" "$db_name"
  ok "Database deleted: ${db_name} (user: ${db_user})"
}

_db_list() {
  _parse_opts "$@"
  local plain; plain=$(_opt "plain" "false")
  local site;  site=$(_opt "site" "")
  local json;  json=$(_opt "json" "false")

  # Base exclusion of the server's own schemas; add the site prefix when --site is given.
  local where="schema_name NOT IN ('information_schema','mysql','performance_schema','sys')"
  if [[ -n "$site" ]]; then
    local prefix; prefix=$(_db_site_prefix "$site")
    where="${where} AND schema_name LIKE '$(_sql_escape_literal "$prefix")%'"
  fi

  if [[ "$plain" == "true" ]]; then
    _mysql_exec "SELECT schema_name FROM information_schema.schemata
      WHERE ${where}
      ORDER BY schema_name;" 2>/dev/null | awk 'NR > 1 && NF { print $1 }'
    return 0
  fi

  if [[ "$json" == "true" ]]; then
    # JSON array: [{name,size_mb,tables,status}]; status Active when tables>0 else Empty.
    _mysql_exec "SELECT s.schema_name,
        COALESCE(ROUND(SUM(t.data_length + t.index_length) / 1024 / 1024, 2), 0) AS size_mb,
        COALESCE(COUNT(t.table_name), 0) AS tables
      FROM information_schema.schemata s
      LEFT JOIN information_schema.tables t ON t.table_schema = s.schema_name
      WHERE ${where}
      GROUP BY s.schema_name ORDER BY s.schema_name;" 2>/dev/null \
    | awk 'NR > 1 && NF {
        st = ($3 > 0 ? "Active" : "Empty");
        printf "%s{\"name\":\"%s\",\"size_mb\":%s,\"tables\":%s,\"status\":\"%s\"}", (n++ ? "," : ""), $1, $2, $3, st }
        BEGIN { printf "[" } END { printf "]\n" }'
    return 0
  fi

  echo ""
  echo -e "  ${BOLD}Databases${RESET}"
  _hr
  _mysql_exec "SELECT table_schema AS 'Database',
    ROUND(SUM(data_length + index_length) / 1024 / 1024, 2) AS 'Size (MB)',
    COUNT(table_name) AS 'Tables'
    FROM information_schema.tables
    WHERE table_schema NOT IN ('information_schema','mysql','performance_schema','sys')
    GROUP BY table_schema;" 2>/dev/null | column -t | sed 's/^/  /'
  _hr
  echo ""
}

# List a site's database users (user, database, rw/ro permission) from mysql.db.
_db_users() {
  _require_root "db:users"
  _parse_opts "$@"
  local site; site=$(_opt "site")
  _require_arg "site" "$site" "db:users --site example.com"
  local json; json=$(_opt "json" "false")
  local prefix; prefix=$(_db_site_prefix "$site")
  local q; q="SELECT d.User, d.Db,
      CASE WHEN d.Insert_priv = 'Y' OR d.Update_priv = 'Y' OR d.Delete_priv = 'Y'
           THEN 'rw' ELSE 'ro' END AS permission
    FROM mysql.db d
    WHERE d.User LIKE '$(_sql_escape_literal "$prefix")%'
    ORDER BY d.User, d.Db;"

  if [[ "$json" == "true" ]]; then
    _mysql_exec "$q" 2>/dev/null | awk 'NR > 1 && NF {
        printf "%s{\"user\":\"%s\",\"database\":\"%s\",\"permission\":\"%s\"}", (n++ ? "," : ""), $1, $2, $3 }
        BEGIN { printf "[" } END { printf "]\n" }'
    return 0
  fi

  echo ""
  echo -e "  ${BOLD}Database users${RESET}"
  _hr
  _mysql_exec "$q" 2>/dev/null | column -t | sed 's/^/  /'
  _hr
  echo ""
}

_db_backup() {
  _require_root "db:backup"
  _parse_opts "$@"
  local db_name; db_name=$(_opt "name")
  local output_dir; output_dir=$(_opt "output" "/var/backups/aidipanel")
  _require_arg "name" "$db_name" "db:backup --name mydb"
  [[ "$db_name" =~ ^[a-zA-Z0-9_]+$ ]] \
    || die "Database name must contain only letters, numbers, underscores"

  _load_credentials
  mkdir -p "$output_dir"

  local backup_file; backup_file="${output_dir}/${db_name}_$(date +%Y%m%d_%H%M%S).sql.gz"
  log "Backing up database: ${db_name} → ${backup_file}"

  mysqldump \
    --defaults-extra-file=<(printf '[client]\nuser=root\npassword=%s\n' "${MYSQL_ROOT_PASSWORD}") \
    --single-transaction \
    --quick \
    --lock-tables=false \
    "$db_name" \
    | gzip > "$backup_file"

  local size; size=$(du -sh "$backup_file" | cut -f1)
  ok "Backup created: ${backup_file} (${size})"
}

# Create a new MySQL user on an existing database (site-scoped).
_db_user_add() {
  _require_root "db:user-add"
  _parse_opts "$@"
  local site;    site=$(_opt "site");    _require_arg "site" "$site" "db:user-add --site example.com --name <user> --db <database>"
  local db_user; db_user=$(_opt "name"); _require_arg "name" "$db_user" "db:user-add --name <user>"
  local db_name; db_name=$(_opt "db");   _require_arg "db" "$db_name" "db:user-add --db <database>"
  local db_pass; db_pass=$(_opt "pass" "$(openssl rand -base64 16 | tr -dc 'A-Za-z0-9' | head -c 16)")
  local perm;    perm=$(_opt "permission" "rw")

  [[ "$db_user" =~ ^[a-zA-Z0-9_]+$ ]] || die "Database user must contain only letters, numbers, underscores"
  [[ "$db_name" =~ ^[a-zA-Z0-9_]+$ ]] || die "Database name must contain only letters, numbers, underscores"
  [[ "$db_pass" =~ ^[A-Za-z0-9_!@#%+=.,:-]{8,128}$ ]] || die "Database password must be 8-128 characters and contain only safe symbols"
  [[ "$perm" =~ ^(rw|ro)$ ]] || die "Permission must be 'rw' or 'ro'"

  local prefix; prefix=$(_db_site_prefix "$site")
  _db_require_prefix "$db_user" "$prefix"
  _db_require_prefix "$db_name" "$prefix"

  local exists; exists=$(_mysql_exec "SELECT 1 FROM information_schema.schemata WHERE schema_name = '$(_sql_escape_literal "$db_name")' LIMIT 1;" 2>/dev/null | awk 'NR>1{print $1}')
  [[ "$exists" == "1" ]] || die "Database '${db_name}' does not exist."

  local db_pass_sql; db_pass_sql=$(_sql_escape_literal "$db_pass")
  log "Creating database user: ${db_user} on ${db_name} (${perm})..."
  _mysql_exec "CREATE USER IF NOT EXISTS '${db_user}'@'localhost' IDENTIFIED BY '${db_pass_sql}';" || die "Could not create user ${db_user}."
  _mysql_exec "ALTER USER '${db_user}'@'localhost' IDENTIFIED BY '${db_pass_sql}';" || die "Could not set the user password."
  _db_grant "$db_name" "$db_user" "$perm" || die "Could not grant privileges on ${db_name}."
  _mysql_exec "FLUSH PRIVILEGES;"
  _db_secret_put "$site" "$db_name" "$db_user" "$db_pass" \
    || warn "Could not store encrypted phpMyAdmin credential; reset the user password before using Manage."

  ok "Database user created: ${db_user}"
  echo ""
  _table_row "User:"       "$db_user"
  _table_row "Database:"   "$db_name"
  _table_row "Password:"   "$db_pass"
  _table_row "Permission:" "$perm"
  _table_row "Host:"       "localhost"
  echo ""
  warn "Save the password above — it will not be shown again."
}

# Change a database user's permission and/or password (site-scoped). Optional
# --wp-config rewrites DB_PASSWORD so a WordPress site keeps working.
_db_user_edit() {
  _require_root "db:user-edit"
  _parse_opts "$@"
  local site;     site=$(_opt "site");     _require_arg "site" "$site" "db:user-edit --site example.com --name <user>"
  local db_user;  db_user=$(_opt "name");  _require_arg "name" "$db_user" "db:user-edit --name <user>"
  local perm;     perm=$(_opt "permission" "")
  local new_pass; new_pass=$(_opt "pass" "")
  local generate; generate=$(_opt "generate" "false")
  local wp_config; wp_config=$(_opt "wp-config" "")

  [[ "$db_user" =~ ^[a-zA-Z0-9_]+$ ]] || die "Database user must contain only letters, numbers, underscores"
  local prefix; prefix=$(_db_site_prefix "$site")
  _db_require_prefix "$db_user" "$prefix"

  local exists; exists=$(_mysql_exec "SELECT 1 FROM mysql.user WHERE User = '$(_sql_escape_literal "$db_user")' AND Host = 'localhost' LIMIT 1;" 2>/dev/null | awk 'NR>1{print $1}')
  [[ "$exists" == "1" ]] || die "Database user '${db_user}' does not exist."

  local did=0

  if [[ -n "$perm" ]]; then
    [[ "$perm" =~ ^(rw|ro)$ ]] || die "Permission must be 'rw' or 'ro'"
    local dbs; dbs=$(_mysql_exec "SELECT Db FROM mysql.db WHERE User = '$(_sql_escape_literal "$db_user")';" 2>/dev/null | awk 'NR>1 && NF{print $1}')
    [[ -n "$dbs" ]] || die "User '${db_user}' has no database grant to change."
    local d
    while IFS= read -r d; do
      [[ -n "$d" ]] || continue
      # Revoke only ALL PRIVILEGES (not GRANT OPTION): the panel never grants WITH
      # GRANT OPTION, and naming it makes MySQL 8 fail the whole REVOKE (ERROR 1141,
      # "no such grant") — which silently left the old privileges in place.
      _mysql_exec "REVOKE ALL PRIVILEGES ON \`${d}\`.* FROM '${db_user}'@'localhost';" \
        || die "Could not revoke existing privileges on ${d}."
      _db_grant "$d" "$db_user" "$perm" || die "Could not change privileges on ${d}."
    done <<< "$dbs"
    did=1
    log "Permission for ${db_user} set to ${perm}."
  fi

  if [[ "$generate" == "true" || -n "$new_pass" ]]; then
    [[ "$generate" == "true" ]] && new_pass="$(openssl rand -base64 16 | tr -dc 'A-Za-z0-9' | head -c 16)"
    [[ "$new_pass" =~ ^[A-Za-z0-9_!@#%+=.,:-]{8,128}$ ]] || die "Database password must be 8-128 characters and contain only safe symbols"
    local p_sql; p_sql=$(_sql_escape_literal "$new_pass")
    _mysql_exec "ALTER USER '${db_user}'@'localhost' IDENTIFIED BY '${p_sql}';" || die "Could not set the new password."
    did=1
    local grant_db
    while IFS= read -r grant_db; do
      [[ -n "$grant_db" ]] || continue
      _db_secret_put "$site" "$grant_db" "$db_user" "$new_pass" \
        || warn "Could not store encrypted phpMyAdmin credential for ${db_user} on ${grant_db}."
    done <<< "$(_db_user_grant_dbs "$db_user")"

    if [[ -n "$wp_config" ]]; then
      if [[ -w "$wp_config" ]]; then
        cp -- "$wp_config" "${wp_config}.aidipanel-bak"
        local esc; esc=$(printf '%s' "$new_pass" | sed -e 's/[\&|]/\\&/g')
        if sed -i -E "s|(define\(\s*'DB_PASSWORD'\s*,\s*')[^']*('\s*\)\s*;)|\1${esc}\2|" "$wp_config"; then
          log "Updated DB_PASSWORD in ${wp_config} (backup: ${wp_config}.aidipanel-bak)."
        else
          warn "Could not rewrite ${wp_config}; update DB_PASSWORD manually."
        fi
      else
        warn "wp-config.php not writable (${wp_config}); update DB_PASSWORD manually."
      fi
    fi
  fi

  _mysql_exec "FLUSH PRIVILEGES;"
  [[ "$did" == "1" ]] || die "Nothing to change: pass --permission and/or --pass/--generate."

  ok "Database user updated: ${db_user}"
  if [[ "$generate" == "true" || -n "$new_pass" ]]; then
    echo ""
    _table_row "User:"     "$db_user"
    _table_row "Password:" "$new_pass"
    echo ""
    warn "Save the password above — it will not be shown again."
  fi
}

# Delete a database user (site-scoped).
_db_user_delete() {
  _require_root "db:user-delete"
  _parse_opts "$@"
  local site;    site=$(_opt "site");    _require_arg "site" "$site" "db:user-delete --site example.com --name <user>"
  local db_user; db_user=$(_opt "name"); _require_arg "name" "$db_user" "db:user-delete --name <user>"
  [[ "$db_user" =~ ^[a-zA-Z0-9_]+$ ]] || die "Database user must contain only letters, numbers, underscores"
  local prefix; prefix=$(_db_site_prefix "$site")
  _db_require_prefix "$db_user" "$prefix"
  local force; force=$(_opt "force" "false")

  [[ "$force" == "true" ]] || _confirm "Delete database user '${db_user}'?" || { log "Cancelled."; return 0; }

  _mysql_exec "DROP USER IF EXISTS '${db_user}'@'localhost';" || die "Could not delete user ${db_user}."
  _mysql_exec "FLUSH PRIVILEGES;"
  _db_secret_delete_user "$site" "$db_user"
  ok "Database user deleted: ${db_user}"
}

_db_pma_credentials() {
  _require_root "db:pma-credentials"
  _parse_opts "$@"
  local site;    site=$(_opt "site");    _require_arg "site" "$site" "db:pma-credentials --site example.com --user <user> --db <database>"
  local db_user; db_user=$(_opt "user"); _require_arg "user" "$db_user" "db:pma-credentials --user <user>"
  local db_name; db_name=$(_opt "db");   _require_arg "db" "$db_name" "db:pma-credentials --db <database>"

  [[ "$db_user" =~ ^[a-zA-Z0-9_]+$ ]] || die "Database user must contain only letters, numbers, underscores"
  [[ "$db_name" =~ ^[a-zA-Z0-9_]+$ ]] || die "Database name must contain only letters, numbers, underscores"
  local prefix; prefix=$(_db_site_prefix "$site")
  _db_require_prefix "$db_user" "$prefix"
  _db_require_prefix "$db_name" "$prefix"

  local has_grant
  has_grant=$(_mysql_exec "SELECT 1 FROM mysql.db WHERE User = '$(_sql_escape_literal "$db_user")' AND Host = 'localhost' AND Db = '$(_sql_escape_literal "$db_name")' LIMIT 1;" 2>/dev/null | awk 'NR>1{print $1}')
  [[ "$has_grant" == "1" ]] || die "Database user '${db_user}' has no grant on '${db_name}'."

  local db_pass=""
  db_pass=$(_db_secret_get "$site" "$db_name" "$db_user" 2>/dev/null || true)
  if [[ -z "$db_pass" ]]; then
    db_pass=$(_db_secret_backfill_wp "$site" "$db_name" "$db_user" 2>/dev/null || true)
  fi
  [[ -n "$db_pass" ]] || die "No stored password for '${db_user}'. Reset the database user password, then open phpMyAdmin again."

  echo "pma_user=${db_user}"
  echo "pma_db=${db_name}"
  echo "pma_password=${db_pass}"
  echo "pma_host=127.0.0.1"
  echo "pma_port=3306"
}

_db_pma_write_config() {
  mkdir -p /etc/aidipanel /var/lib/phpmyadmin/tmp
  chown www-data:www-data /var/lib/phpmyadmin/tmp
  chmod 700 /var/lib/phpmyadmin/tmp

  local secret
  secret=$(openssl rand -hex 16)
  cat > "${PMA_DIR}/config.inc.php" <<PHP
<?php
\$cfg['blowfish_secret'] = '${secret}';

\$i = 0;
\$i++;
\$cfg['Servers'][\$i]['auth_type'] = 'signon';
\$cfg['Servers'][\$i]['SignonSession'] = 'AIDIPANEL_PMA_SIGNON';
\$cfg['Servers'][\$i]['SignonURL'] = '/sites';
\$cfg['Servers'][\$i]['host'] = '127.0.0.1';
\$cfg['Servers'][\$i]['compress'] = false;
\$cfg['Servers'][\$i]['AllowNoPassword'] = false;
\$cfg['Servers'][\$i]['AllowRoot'] = false;
\$cfg['Servers'][\$i]['hide_db'] = '^(information_schema|performance_schema)$';

\$cfg['TempDir'] = '/var/lib/phpmyadmin/tmp';
PHP
  chown root:www-data "${PMA_DIR}/config.inc.php"
  chmod 640 "${PMA_DIR}/config.inc.php"

  cat > "$PMA_CONF" <<PMA
PMA_VERSION=${PMA_VERSION}
PMA_DIR=${PMA_DIR}
PMA_URL=${PMA_URL_PATH}
PMA
  chmod 644 "$PMA_CONF"
}

_db_pma_write_nginx() {
  local fpm_sock; fpm_sock=$(_php_sock "$PHP_DEFAULT_VERSION")
  [[ -S "$fpm_sock" ]] || die "PHP-FPM socket not found: ${fpm_sock}"

  cat > "$PMA_NGINX_SNIPPET" <<NGINX
    location = /phpmyadmin {
        return 302 /phpmyadmin/index.php;
    }

    location ~ ^/phpmyadmin/(config\\.inc\\.php|setup/|libraries/|templates/|tmp/) {
        deny all;
    }

    location ~ ^/phpmyadmin/(.+\\.php)$ {
        alias ${PMA_DIR}/\$1;
        fastcgi_pass unix:${fpm_sock};
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME ${PMA_DIR}/\$1;
        include fastcgi_params;
        fastcgi_read_timeout 300;
    }

    location /phpmyadmin/ {
        alias ${PMA_DIR}/;
        index index.php;
    }
NGINX
  chmod 644 "$PMA_NGINX_SNIPPET"
}

_db_pma_wire_panel_vhost() {
  local vhost="/etc/nginx/sites-available/aidipanel-ui.conf"
  [[ -f "$vhost" ]] || die "Panel vhost not found: ${vhost}"

  if ! grep -Fq "$PMA_NGINX_SNIPPET" "$vhost"; then
    local tmp include_line
    tmp=$(mktemp)
    include_line="    include ${PMA_NGINX_SNIPPET};"
    if ! awk -v inc="$include_line" '
      !done && $0 ~ /^[[:space:]]*location[[:space:]]+\/[[:space:]]*\{/ {
        print inc;
        print "";
        done=1;
      }
      { print }
      END { if (!done) exit 42 }
    ' "$vhost" > "$tmp"; then
      rm -f "$tmp"
      die "Could not insert phpMyAdmin location into panel vhost."
    fi
    cp -- "$vhost" "${vhost}.aidipanel-bak"
    cp -- "$tmp" "$vhost"
    rm -f "$tmp"
  fi
}

_db_pma_install() {
  _require_root "db:pma-install"
  _parse_opts "$@"

  local archive="/tmp/phpMyAdmin-${PMA_VERSION}-all-languages.tar.gz"
  local extracted="/tmp/phpMyAdmin-${PMA_VERSION}-all-languages"
  local url="https://files.phpmyadmin.net/phpMyAdmin/${PMA_VERSION}/phpMyAdmin-${PMA_VERSION}-all-languages.tar.gz"

  _progress 10 preflight "Checking phpMyAdmin"
  if [[ ! -f "${PMA_DIR}/index.php" ]]; then
    _progress 25 download "Downloading phpMyAdmin ${PMA_VERSION}"
    log "Downloading phpMyAdmin ${PMA_VERSION}..."
    curl -fsSL "$url" -o "$archive" || die "Could not download phpMyAdmin ${PMA_VERSION}."
    _progress 45 extract "Extracting phpMyAdmin"
    rm -rf "$extracted" "${PMA_DIR}.new"
    tar -xzf "$archive" -C /tmp || die "Could not extract phpMyAdmin archive."
    mv "$extracted" "${PMA_DIR}.new"
    rm -rf "$PMA_DIR"
    mv "${PMA_DIR}.new" "$PMA_DIR"
    _progress 60 permissions "Securing phpMyAdmin files"
    chown -R root:root "$PMA_DIR"
    find "$PMA_DIR" -type d -exec chmod 755 {} \;
    find "$PMA_DIR" -type f -exec chmod 644 {} \;
    rm -rf "${PMA_DIR}/setup"
  fi

  _progress 70 config "Writing phpMyAdmin signon config"
  _db_pma_write_config
  _progress 80 nginx "Writing nginx configuration"
  _db_pma_write_nginx
  _db_pma_wire_panel_vhost

  _progress 90 reload "Testing and reloading nginx"
  nginx -t >> "$CLI_LOG" 2>&1 || die "Nginx rejected the phpMyAdmin configuration. Check: ${CLI_LOG}"
  systemctl reload nginx >> "$CLI_LOG" 2>&1 || die "Could not reload nginx."

  ok "phpMyAdmin installed: ${PMA_URL_PATH}"
  echo "pma_url=${PMA_URL_PATH}"
  echo "pma_version=${PMA_VERSION}"
  _progress 100 "done" "Done"
}

# ===========================================================================
# PHP COMMANDS
# ===========================================================================

_ensure_php_version() {
  local ver="$1"
  _php_version_valid "$ver" || die "Invalid PHP version: ${ver}. Supported: ${PHP_AVAILABLE_VERSIONS}"

  # Idempotency probes the FPM binary, not the 99-aidipanel.ini marker we write:
  # that marker lives under /etc/php/<ver> and survives `apt purge`, so keying off
  # it would (a) read a purged version as installed and (b) refuse to reinstall it.
  if _php_installed "$ver"; then
    ok "PHP ${ver} is already installed."
    return 0
  fi

  log "Installing PHP ${ver} on-demand (this may take 1-2 minutes)..."

  export DEBIAN_FRONTEND=noninteractive
  apt-get update -qq || true

  # Build the package list, skipping suffixes the repo does not ship for this
  # version (e.g. PHP 8.5 bundles OPcache into core, so php8.5-opcache is absent).
  # apt-get fails the whole transaction on one unlocatable package, so filter first.
  local pkgs=() skipped=() exts ext
  local IFS=' '
  read -ra exts <<< "$PHP_EXTENSIONS"
  for ext in "${exts[@]}"; do
    if apt-cache show "php${ver}-${ext}" >/dev/null 2>&1; then
      pkgs+=("php${ver}-${ext}")
    else
      skipped+=("php${ver}-${ext}")
    fi
  done
  [[ ${#skipped[@]} -gt 0 ]] && log "Skipping packages not in repo for PHP ${ver}: ${skipped[*]} (bundled into core or unavailable)."
  [[ ${#pkgs[@]} -gt 0 ]] || die "PHP ${ver} is not available from this server's package repository."

  apt-get install -y -qq "${pkgs[@]}" || die "Could not install PHP ${ver}. The package repository may be temporarily unavailable — please try again."

  local ini_dir="/etc/php/${ver}/fpm/conf.d"
  mkdir -p "$ini_dir"
  cat > "${ini_dir}/99-aidipanel.ini" <<PHPINI
; AidiPanel PHP-FPM tuning (PHP ${ver})
memory_limit         = 256M
max_execution_time   = 300
max_input_time       = 300
post_max_size        = 256M
upload_max_filesize  = 256M
date.timezone        = Asia/Jakarta
expose_php           = Off

; OPcache (important for performance)
opcache.enable                  = 1
opcache.enable_cli              = 0
opcache.memory_consumption      = 128
opcache.interned_strings_buffer = 16
opcache.max_accelerated_files   = 10000
opcache.revalidate_freq         = 2
opcache.fast_shutdown           = 1
opcache.validate_timestamps     = 1
opcache.save_comments           = 1
PHPINI

  local pool_conf="/etc/php/${ver}/fpm/pool.d/www.conf"
  if [[ -f "$pool_conf" ]]; then
    local mem_mb max_ch=10 start_sv=2 min_sp=2 max_sp=4
    mem_mb=$(awk '/MemTotal/{printf "%d", $2/1024}' /proc/meminfo 2>/dev/null || echo 0)
    [[ -z "$mem_mb" ]] && mem_mb=0
    if (( mem_mb >= 2048 )); then max_ch=20; start_sv=4; min_sp=2; max_sp=6; fi
    if (( mem_mb >= 4096 )); then max_ch=40; start_sv=6; min_sp=4; max_sp=10; fi
    sed -i \
      -e "s|^listen = .*|listen = /run/php/php${ver}-fpm.sock|" \
      -e 's|^;listen.owner = .*|listen.owner = www-data|' \
      -e 's|^;listen.group = .*|listen.group = www-data|' \
      -e 's|^;listen.mode = .*|listen.mode = 0660|' \
      -e 's|^pm = .*|pm = dynamic|' \
      -e "s|^pm.max_children = .*|pm.max_children = ${max_ch}|" \
      -e "s|^pm.start_servers = .*|pm.start_servers = ${start_sv}|" \
      -e "s|^pm.min_spare_servers = .*|pm.min_spare_servers = ${min_sp}|" \
      -e "s|^pm.max_spare_servers = .*|pm.max_spare_servers = ${max_sp}|" \
      -e 's|^;pm.max_requests = .*|pm.max_requests = 500|' \
      "$pool_conf"
  fi

  systemctl enable --now "php${ver}-fpm" || die "Failed to start php${ver}-fpm"
  ok "PHP ${ver} installed successfully."
  return 0
}

_php_list() {
  _parse_opts "$@"
  echo ""
  echo -e "  ${BOLD}PHP versions${RESET}"
  _hr
  for ver in "${PHP_VERSIONS_SUPPORTED[@]}"; do
    local status="${DIM}available${RESET}"
    local fpm_status="${DIM}stopped${RESET}"
    if _php_installed "$ver"; then
      status="${GREEN}installed${RESET}"
      [[ "$ver" == "$PHP_DEFAULT_VERSION" ]] && status="${GREEN}installed (default)${RESET}"
      systemctl is-active --quiet "php${ver}-fpm" 2>/dev/null \
        && fpm_status="${GREEN}running${RESET}" \
        || fpm_status="${RED}stopped${RESET}"
    fi
    printf "  PHP %-6s " "$ver"
    echo -e "  status: $status  fpm: $fpm_status"
  done
  _hr
  echo ""
}

_php_version() {
  _require_root "php:version"
  _parse_opts "$@"
  local domain; domain=$(_opt "domain")
  local new_ver; new_ver=$(_opt "set" "")
  _require_arg "domain" "$domain" "php:version --domain example.com [--set 8.3]"
  _domain_valid "$domain" || die "Invalid domain name: ${domain}"
  _domain_exists "$domain" || die "Site not found: ${domain}"

  local conf="${NGINX_CONF_DIR}/${domain}.conf"
  local current_ver; current_ver=$(grep -oP 'php\K[0-9.]+(?=-fpm)' "$conf" 2>/dev/null | head -1 || echo "unknown")

  if [[ -z "$new_ver" ]]; then
    echo "  PHP version for ${domain}: ${BOLD}${current_ver}${RESET}"
    return 0
  fi

  _php_version_valid "$new_ver" || die "Invalid PHP version: ${new_ver}. Supported: ${PHP_VERSIONS_SUPPORTED[*]}"
  _progress 15 check "Preparing PHP ${new_ver}"
  # Auto-install the target version on demand if it is missing (Patch C).
  if ! _php_installed "$new_ver"; then
    _progress 25 php_install "Installing PHP ${new_ver}"
    log "PHP ${new_ver} not installed — installing it first (this may take 1-2 minutes)..."
    _ensure_php_version "$new_ver"
  fi

  log "Changing PHP for ${domain}: ${current_ver} → ${new_ver}"

  # Resolve the site-user from the current vhost socket, recreate its pool on the
  # new version, then repoint the vhost socket. (Pool must follow the version.)
  local site_user; site_user=$(grep -oP 'php[0-9.]+-fpm-\K[a-z0-9_-]+(?=\.sock)' "$conf" 2>/dev/null | head -1 || echo "")
  local old_sock new_sock
  _progress 65 php_pool "Reconfiguring PHP-FPM pool"
  if [[ -n "$site_user" ]]; then
    _write_fpm_pool "$site_user" "$new_ver" || die "Could not create php${new_ver} pool for ${site_user}."
    _remove_fpm_pool "$site_user" "$current_ver"
    old_sock=$(_site_php_sock "$current_ver" "$site_user")
    new_sock=$(_site_php_sock "$new_ver" "$site_user")
  else
    old_sock=$(_php_sock "$current_ver"); new_sock=$(_php_sock "$new_ver")   # legacy fallback
  fi

  local tmp; tmp=$(mktemp)
  sed "s|${old_sock}|${new_sock}|g" "$conf" > "$tmp" && cp "$tmp" "$conf"
  rm -f "$tmp"

  _progress 90 reload "Reloading nginx"
  _nginx_test_reload
  _progress 100 "done" "Done"
  ok "PHP version changed for ${domain}: ${current_ver} → ${new_ver}"
}

_php_install() {
  _require_root "php:install"
  _parse_opts "$@"
  local ver; ver=$(_opt "version")
  _require_arg "version" "$ver" "php:install --version 8.5"
  _progress 10 php_install "Installing PHP ${ver}"
  _ensure_php_version "$ver"
  _progress 100 "done" "PHP ${ver} ready"
}

_php_restart() {
  _require_root "php:restart"
  _parse_opts "$@"
  local ver; ver=$(_opt "version" "all")

  if [[ "$ver" == "all" ]]; then
    for v in "${PHP_VERSIONS_SUPPORTED[@]}"; do
      if systemctl list-units --quiet "php${v}-fpm.service" &>/dev/null; then
        systemctl restart "php${v}-fpm" >> "$CLI_LOG" 2>&1 \
          && ok "Restarted: php${v}-fpm" \
          || warn "Could not restart php${v}-fpm"
      fi
    done
  else
    _php_version_valid "$ver" || die "Invalid PHP version: ${ver}"
    systemctl restart "php${ver}-fpm" >> "$CLI_LOG" 2>&1
    ok "Restarted: php${ver}-fpm"
  fi
}

_php_info() {
  _parse_opts "$@"
  local ver; ver=$(_opt "version" "${PHP_DEFAULT_VERSION}")
  _php_version_valid "$ver" || die "Invalid PHP version: ${ver}"
  command -v "php${ver}" &>/dev/null || die "PHP ${ver} not installed"

  echo ""
  "php${ver}" -i 2>/dev/null | grep -E "^(PHP Version|memory_limit|upload_max_filesize|post_max_size|max_execution_time|opcache)" \
    | head -20 | sed 's/^/  /'
  echo ""
}

# ===========================================================================
# SSL COMMANDS
# ===========================================================================

# Does any of the given cert names cover $domain? Exact match or wildcard
# (*.example.com matches a single-label subdomain). Case-insensitive.
_cert_covers_domain() {
  local domain="${1,,}"; shift
  local name base sub
  for name in "$@"; do
    name="${name,,}"
    [[ "$name" == "$domain" ]] && return 0
    if [[ "$name" == \*.* ]]; then
      base="${name#\*.}"
      if [[ "$domain" == *".$base" ]]; then
        sub="${domain%.$base}"
        [[ -n "$sub" && "$sub" != *.* ]] && return 0
      fi
    fi
  done
  return 1
}

# Point a site's vhost at the given cert paths. Generalized: replaces whatever
# ssl_certificate path is currently set (self-signed / LE / custom), so switching
# between cert types always works. Backs up the conf and restores on nginx -t fail.
_ssl_point_vhost() {
  local domain="$1" fullchain="$2" privkey="$3"
  local conf="${NGINX_CONF_DIR}/${domain}.conf"
  [[ -f "$conf" ]] || die "Vhost not found: ${conf}"
  local bak tmp; bak=$(mktemp); tmp=$(mktemp)
  cp "$conf" "$bak"
  sed -E \
    -e "s#^([[:space:]]*ssl_certificate)[[:space:]]+[^;]+;#\1 ${fullchain};#" \
    -e "s#^([[:space:]]*ssl_certificate_key)[[:space:]]+[^;]+;#\1 ${privkey};#" \
    "$conf" > "$tmp" && cp "$tmp" "$conf"
  rm -f "$tmp"
  if ! nginx -t >> "$CLI_LOG" 2>&1; then
    cp "$bak" "$conf"; rm -f "$bak"
    die "The web server rejected the certificate change for ${domain}; it was reverted."
  fi
  rm -f "$bak"
  systemctl reload nginx >> "$CLI_LOG" 2>&1
}

# Import a user-supplied certificate (paid / wildcard / existing LE).
_ssl_import() {
  _require_root "ssl:import"
  _parse_opts "$@"
  local domain cert_path key_path chain_path
  domain=$(_opt "domain")
  cert_path=$(_opt "cert")
  key_path=$(_opt "key")
  chain_path=$(_opt "chain" "")
  _require_arg "domain" "$domain"    "ssl:import --domain example.com --cert cert.pem --key key.pem"
  _require_arg "cert"   "$cert_path" "ssl:import --domain example.com --cert cert.pem --key key.pem"
  _require_arg "key"    "$key_path"  "ssl:import --domain example.com --cert cert.pem --key key.pem"
  _domain_valid "$domain"  || die "Invalid domain name: ${domain}"
  _domain_exists "$domain" || die "Site not found: ${domain}"
  [[ -f "$cert_path" ]] || die "Certificate file not found: ${cert_path}"
  [[ -f "$key_path"  ]] || die "Private key file not found: ${key_path}"
  [[ -z "$chain_path" || -f "$chain_path" ]] || die "Chain file not found: ${chain_path}"

  # Validate: cert + key parse, key matches cert, cert not expired.
  openssl x509 -noout -in "$cert_path" 2>/dev/null || die "Certificate is not valid PEM."
  openssl pkey -noout -in "$key_path"  2>/dev/null || die "Private key is not valid PEM."
  local cert_pub key_pub
  cert_pub=$(openssl x509 -in "$cert_path" -noout -pubkey 2>/dev/null | openssl md5 2>/dev/null)
  key_pub=$(openssl pkey -in "$key_path" -pubout 2>/dev/null | openssl md5 2>/dev/null)
  [[ -n "$cert_pub" && "$cert_pub" == "$key_pub" ]] || die "Private key does not match the certificate."
  openssl x509 -checkend 0 -noout -in "$cert_path" 2>/dev/null || die "Certificate has already expired."

  # Ensure the cert actually covers this domain (CN or SAN). Importing a cert for
  # the wrong host is the most common mistake — it leaves the browser showing
  # "not secure" even though the import itself "succeeded".
  local -a cert_names=()
  local cn san
  cn=$(openssl x509 -in "$cert_path" -noout -subject 2>/dev/null \
       | grep -oiE 'CN *= *[A-Za-z0-9.*_-]+' | sed -E 's/^CN *= *//I' | head -1)
  [[ -n "$cn" ]] && cert_names+=("$cn")
  while IFS= read -r san; do
    [[ -n "$san" ]] && cert_names+=("$san")
  done < <(openssl x509 -in "$cert_path" -noout -ext subjectAltName 2>/dev/null \
           | grep -oiE 'DNS:[A-Za-z0-9.*_-]+' | sed -E 's/^DNS://I')
  _cert_covers_domain "$domain" "${cert_names[@]}" \
    || die "Certificate does not cover ${domain} (it is issued for: ${cert_names[*]:-unknown}). Import the certificate that matches this site."

  log "Importing certificate for: ${domain}..."
  local dir="/etc/ssl/aidipanel-custom/${domain}"
  mkdir -p "$dir"
  cat "$cert_path" > "${dir}/fullchain.pem"
  if [[ -n "$chain_path" ]]; then
    printf '\n' >> "${dir}/fullchain.pem"
    cat "$chain_path" >> "${dir}/fullchain.pem"
  fi
  cp "$key_path" "${dir}/privkey.pem"
  chown -R root:root "$dir"
  # The directory + public certificate must be readable by the panel (www-data)
  # so it can report the real SSL status; only the private key stays root-only.
  chmod 755 "$dir"
  chmod 644 "${dir}/fullchain.pem"
  chmod 600 "${dir}/privkey.pem"

  _ssl_point_vhost "$domain" "${dir}/fullchain.pem" "${dir}/privkey.pem"
  ok "Certificate imported for: ${domain}"
}

_ssl_install() {
  _require_root "ssl:install"
  _parse_opts "$@"
  local email; email=$(_opt "email" "")
  local staging; staging=$(_opt "staging" "")

  # Domains: prefer --domains "a,www.a" (the user picks which names go on the
  # cert); fall back to the legacy single --domain. This is why we never force
  # "www." onto a domain that has no DNS record — the #1 cause of LE failures.
  local domains_csv; domains_csv=$(_opt "domains" "")
  [[ -z "$domains_csv" ]] && domains_csv=$(_opt "domain" "")
  _require_arg "domains" "$domains_csv" "ssl:install --domains example.com,www.example.com"

  local -a domains=() _raw=()
  IFS=',' read -ra _raw <<< "$domains_csv"
  local d e exists
  for d in "${_raw[@]}"; do
    d="${d//[[:space:]]/}"
    [[ -z "$d" ]] && continue
    _domain_valid "$d" || die "Invalid domain name: ${d}"
    exists=0; for e in "${domains[@]}"; do [[ "$e" == "$d" ]] && exists=1; done
    [[ $exists -eq 0 ]] && domains+=("$d")
  done
  [[ ${#domains[@]} -gt 0 ]] || die "No valid domains provided."

  # certbot uses the first -d as the certificate name / live dir, so the site's
  # own domain leads.
  local primary="${domains[0]}"
  _domain_exists "$primary" || die "Site not found: ${primary}"

  command -v certbot &>/dev/null || die "Certbot (the Let's Encrypt client) is not installed on this server, so SSL cannot be issued."

  # Pre-flight DNS: every name must resolve, or certbot's HTTP-01 challenge fails
  # with a cryptic error. Fail early with a clear, per-domain message instead.
  _progress 10 dns "Checking DNS"
  local -a unresolved=()
  for d in "${domains[@]}"; do
    getent hosts "$d" >/dev/null 2>&1 || unresolved+=("$d")
  done
  if [[ ${#unresolved[@]} -gt 0 ]]; then
    die "These domains do not resolve in DNS yet: ${unresolved[*]} — point them to this server (or remove them) and try again."
  fi

  if [[ -n "$staging" ]]; then
    log "Installing Let's Encrypt SSL (STAGING) for: ${domains[*]}"
  else
    log "Installing Let's Encrypt SSL for: ${domains[*]}"
  fi

  local certbot_args=(certbot --nginx --non-interactive --agree-tos --cert-name "$primary")
  for d in "${domains[@]}"; do certbot_args+=(-d "$d"); done
  [[ -n "$email" ]] && certbot_args+=(--email "$email") || certbot_args+=(--register-unsafely-without-email)
  [[ -n "$staging" ]] && certbot_args+=(--test-cert)

  _progress 30 request "Requesting certificate (Let's Encrypt)"
  "${certbot_args[@]}" >> "$CLI_LOG" 2>&1 \
    || die "Let's Encrypt could not verify domain ownership. Make sure every domain points to this server's IP and that port 80 is open, then try again."

  # certbot makes /etc/letsencrypt/{live,archive} 0700 (root-only), which blocks
  # the panel (www-data) from reading the public cert to report SSL status.
  # Make the two parent dirs traversable; private keys keep their own 0600.
  chmod 755 /etc/letsencrypt/live /etc/letsencrypt/archive 2>/dev/null || true

  # Point the vhost at the LE certs (generalized — replaces whatever path is
  # currently set, so self-signed/custom → LE all work; tests + restores on fail).
  _progress 90 reload "Updating nginx"
  _ssl_point_vhost "$primary" \
    "/etc/letsencrypt/live/${primary}/fullchain.pem" \
    "/etc/letsencrypt/live/${primary}/privkey.pem"
  _progress 100 "done" "Done"
  # LE certs auto-renew via the global cron; mark it so the panel can show it.
  _vhost_marker_set "${NGINX_CONF_DIR}/${primary}.conf" "AUTORENEW" "on"
  ok "SSL certificate installed for: ${domains[*]}"
  info "Auto-renewal is managed by: /etc/cron.d/aidipanel"
}

_ssl_renew() {
  _require_root "ssl:renew"
  _parse_opts "$@"
  local domain; domain=$(_opt "domain" "")

  log "Renewing SSL certificates..."
  _progress 20 renew "Renewing certificate"
  if [[ -n "$domain" ]]; then
    _domain_valid "$domain" || die "Invalid domain name: ${domain}"
    certbot renew --cert-name "$domain" --nginx --non-interactive >> "$CLI_LOG" 2>&1
    ok "Renewed: ${domain}"
  else
    certbot renew --nginx --non-interactive >> "$CLI_LOG" 2>&1
    ok "All certificates renewed"
  fi
  _progress 90 reload "Reloading nginx"
  systemctl reload nginx >> "$CLI_LOG" 2>&1
  _progress 100 "done" "Done"
}

_ssl_status() {
  _parse_opts "$@"
  echo ""
  echo -e "  ${BOLD}SSL Certificate Status${RESET}"
  _hr
  printf "  %-30s %-14s %s\n" "Domain" "Type" "Expiry"
  _hr

  for conf in "${NGINX_CONF_DIR}"/*.conf; do
    [[ -f "$conf" ]] || continue
    [[ "$(basename "$conf")" == "aidipanel-ui.conf" ]] && continue
    local domain; domain=$(basename "$conf" .conf)
    local cert_type expiry

    if [[ -f "/etc/letsencrypt/live/${domain}/fullchain.pem" ]]; then
      cert_type="Let's Encrypt"
      expiry=$(openssl x509 -enddate -noout \
        -in "/etc/letsencrypt/live/${domain}/fullchain.pem" 2>/dev/null \
        | cut -d= -f2 || echo "unknown")
    elif [[ -f "/etc/ssl/aidipanel-custom/${domain}/fullchain.pem" ]]; then
      cert_type="imported"
      expiry=$(openssl x509 -enddate -noout \
        -in "/etc/ssl/aidipanel-custom/${domain}/fullchain.pem" 2>/dev/null \
        | cut -d= -f2 || echo "unknown")
    elif [[ -f "/etc/ssl/aidipanel-self/${domain}.crt" ]]; then
      cert_type="self-signed"
      expiry=$(openssl x509 -enddate -noout \
        -in "/etc/ssl/aidipanel-self/${domain}.crt" 2>/dev/null \
        | cut -d= -f2 || echo "unknown")
    else
      cert_type="none"
      expiry="-"
    fi

    printf "  %-30s %-14s %s\n" "$domain" "$cert_type" "$expiry"
  done
  _hr
  echo ""
}

# ---------------------------------------------------------------------------
# SSL — HTTPS options (force-https / HSTS / per-site auto-renew) + JSON check
# ---------------------------------------------------------------------------

# Read/replace a managed marker comment (e.g. # AIDIPANEL_AUTORENEW=on) in a
# vhost. Markers are top-level comments, so they never affect nginx parsing.
_vhost_marker_get() {
  grep -oP "^# AIDIPANEL_$2=\K\S+" "$1" 2>/dev/null | head -1 || true
}
_vhost_marker_set() {
  local conf="$1" key="$2" val="$3" tmp; tmp=$(mktemp)
  if grep -q "^# AIDIPANEL_${key}=" "$conf" 2>/dev/null; then
    sed -E "s/^# AIDIPANEL_${key}=.*/# AIDIPANEL_${key}=${val}/" "$conf" > "$tmp"
  else
    sed -E "1a # AIDIPANEL_${key}=${val}" "$conf" > "$tmp"
  fi
  cp "$tmp" "$conf"; rm -f "$tmp"
}

# Atomically swap a vhost with an edited copy: back up, install, nginx -t, then
# restore + die on failure (so a bad edit never takes the site offline), else
# reload. Mirrors the safety of _ssl_point_vhost. Removes $newfile when done.
_vhost_commit() {
  local conf="$1" newfile="$2" bak; bak=$(mktemp)
  cp "$conf" "$bak"; cp "$newfile" "$conf"
  if ! nginx -t >> "$CLI_LOG" 2>&1; then
    cp "$bak" "$conf"; rm -f "$bak" "$newfile"
    die "The web server rejected the change for $(basename "$conf"); it was reverted."
  fi
  rm -f "$bak" "$newfile"
  systemctl reload nginx >> "$CLI_LOG" 2>&1
}

# Replace the FIRST top-level `server { … }` block (always the port-80 block in
# AidiPanel vhosts) with the contents of $blockfile. Brace-aware so nested
# location/if blocks toggle cleanly between redirect and serve forms.
_vhost_replace_first_server() {
  local conf="$1" blockfile="$2" tmp; tmp=$(mktemp)
  awk -v bf="$blockfile" '
    BEGIN { depth=0; inblock=0; done=0 }
    !done && !inblock && /^server[[:space:]]*\{/ {
      inblock=1
      depth += gsub(/\{/,"{") - gsub(/\}/,"}")
      while ((getline l < bf) > 0) print l
      close(bf)
      if (depth<=0) { inblock=0; done=1 }
      next
    }
    inblock {
      depth += gsub(/\{/,"{") - gsub(/\}/,"}")
      if (depth<=0) { inblock=0; done=1 }
      next
    }
    { print }
  ' "$conf" > "$tmp" && cp "$tmp" "$conf"
  rm -f "$tmp"
}

# Port-80 block, redirect form (Force HTTPS = on): bounce everything to https,
# keeping the ACME challenge path reachable for certbot.
_vhost_port80_redirect() {
  local domain="$1"
  cat <<REDIR
server {
    listen 80;
    listen [::]:80;
    server_name ${domain} www.${domain};

    # ACME challenge for Let's Encrypt
    location /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 301 https://\$host\$request_uri; }
}
REDIR
}

# Port-80 block, serve form (Force HTTPS = off): also answer plain HTTP. Built
# from the live vhost's own facts (type/root/index/socket) so it tracks the
# real site. Keep the essentials in sync with _site_write_vhost's 443 block.
_vhost_port80_serve() {
  local domain="$1" conf="$2"
  local type webroot index sock
  type=$(grep -oP '# Type: \K\w+' "$conf" 2>/dev/null || echo php)
  webroot=$(awk '/^[[:space:]]*root[[:space:]]/{print $2; exit}' "$conf" | tr -d ';')
  index=$(awk '/^[[:space:]]*index[[:space:]]/{sub(/^[[:space:]]*index[[:space:]]+/,""); sub(/;[[:space:]]*$/,""); print; exit}' "$conf")
  [[ -n "$index" ]] || index="index.php index.html"
  sock=$(grep -oP 'fastcgi_pass[[:space:]]+unix:\K[^;]+' "$conf" 2>/dev/null | head -1)

  local body
  if [[ "$type" == "proxy" ]]; then
    local proxy_pass; proxy_pass=$(grep -oP 'proxy_pass[[:space:]]+\K\S+' "$conf" 2>/dev/null | head -1 | tr -d ';')
    body=$(cat <<PROXY
    location / {
        proxy_pass         ${proxy_pass};
        proxy_http_version 1.1;
        proxy_set_header   Upgrade \$http_upgrade;
        proxy_set_header   Connection 'upgrade';
        proxy_set_header   Host \$host;
        proxy_set_header   X-Real-IP \$remote_addr;
        proxy_set_header   X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto \$scheme;
        proxy_cache_bypass \$http_upgrade;
    }
PROXY
)
  else
    local try="try_files \$uri \$uri/ =404;"
    [[ "$type" == "wordpress" ]] && try="try_files \$uri \$uri/ /index.php?\$args;"
    local php_loc=""
    if [[ "$type" != "static" && -n "$sock" ]]; then
      php_loc=$(cat <<PHPL

    location ~ \.php\$ {
        try_files \$uri =404;
        fastcgi_split_path_info ^(.+\.php)(/.+)\$;
        fastcgi_pass unix:${sock};
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME \$document_root\$fastcgi_script_name;
        include fastcgi_params;
    }
PHPL
)
    fi
    local wp_deny=""
    if [[ "$type" == "wordpress" ]]; then
      wp_deny=$(cat <<'WPD'

    location ~ ^/(wp-config\.php|xmlrpc\.php|wp-cron\.php)$ { deny all; }
    location ~* /(?:uploads|files)/.*\.php$ { deny all; }
WPD
)
    fi
    body=$(cat <<MAIN
    location / {
        ${try}
    }${wp_deny}${php_loc}
MAIN
)
  fi

  cat <<SERVE
server {
    listen 80;
    listen [::]:80;
    server_name ${domain} www.${domain};

    root ${webroot};
    index ${index};

    # ACME challenge for Let's Encrypt
    location /.well-known/acme-challenge/ { root /var/www/letsencrypt; }

    # Deny hidden files
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

${body}
}
SERVE
}

_ssl_force_https() {
  _require_root "ssl:force-https"
  _parse_opts "$@"
  local domain action conf
  domain=$(_opt "domain"); action=$(_opt "action")
  _require_arg "domain" "$domain" "ssl:force-https --domain example.com --action on"
  _require_arg "action" "$action" "ssl:force-https --domain example.com --action on|off"
  _domain_valid "$domain"  || die "Invalid domain name: ${domain}"
  _domain_exists "$domain" || die "Site not found: ${domain}"
  [[ "$action" == "on" || "$action" == "off" ]] || die "Action must be 'on' or 'off'."
  conf="${NGINX_CONF_DIR}/${domain}.conf"
  [[ -f "$conf" ]] || die "Vhost not found: ${conf}"

  local blockfile newconf; blockfile=$(mktemp); newconf=$(mktemp)
  if [[ "$action" == "on" ]]; then
    _vhost_port80_redirect "$domain" > "$blockfile"
  else
    _vhost_port80_serve "$domain" "$conf" > "$blockfile"
  fi
  cp "$conf" "$newconf"
  _vhost_replace_first_server "$newconf" "$blockfile"
  rm -f "$blockfile"
  _vhost_commit "$conf" "$newconf"
  ok "Force HTTPS turned ${action} for ${domain}"
}

_ssl_hsts() {
  _require_root "ssl:hsts"
  _parse_opts "$@"
  local domain action conf
  domain=$(_opt "domain"); action=$(_opt "action")
  _require_arg "domain" "$domain" "ssl:hsts --domain example.com --action on"
  _require_arg "action" "$action" "ssl:hsts --domain example.com --action on|off"
  _domain_valid "$domain"  || die "Invalid domain name: ${domain}"
  _domain_exists "$domain" || die "Site not found: ${domain}"
  [[ "$action" == "on" || "$action" == "off" ]] || die "Action must be 'on' or 'off'."
  conf="${NGINX_CONF_DIR}/${domain}.conf"
  [[ -f "$conf" ]] || die "Vhost not found: ${conf}"

  local newconf; newconf=$(mktemp); cp "$conf" "$newconf"
  local hsts='add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;'
  # Use '|' as the sed delimiter: the comment marker '#' appears in the replacement.
  if [[ "$action" == "off" ]]; then
    # Comment any active HSTS line (idempotent: already-commented lines won't match).
    sed -E -i 's|^([[:space:]]*)(add_header[[:space:]]+Strict-Transport-Security.*)|\1# \2|' "$newconf"
  else
    # Uncomment a commented HSTS line; if none exists at all, inject one in the 443 block.
    sed -E -i 's|^([[:space:]]*)#[[:space:]]*(add_header[[:space:]]+Strict-Transport-Security.*)|\1\2|' "$newconf"
    if ! grep -Eq '^[[:space:]]*add_header[[:space:]]+Strict-Transport-Security' "$newconf"; then
      sed -E -i "s|^([[:space:]]*)(ssl_session_timeout[[:space:]].*)|\1\2\n\1${hsts}|" "$newconf"
    fi
  fi
  _vhost_commit "$conf" "$newconf"
  ok "HSTS turned ${action} for ${domain}"
}

_ssl_autorenew() {
  _parse_opts "$@"
  local domain action
  domain=$(_opt "domain"); action=$(_opt "action")
  _require_arg "domain" "$domain" "ssl:autorenew --domain example.com --action on"
  _require_arg "action" "$action" "ssl:autorenew --domain example.com --action on|off|status"
  _domain_valid "$domain" || die "Invalid domain name: ${domain}"
  local renewal="/etc/letsencrypt/renewal/${domain}.conf"
  local disabled="${renewal}.disabled"

  if [[ "$action" == "status" ]]; then
    if [[ -f "$renewal" ]]; then echo "on"
    elif [[ -f "$disabled" ]]; then echo "off"
    else echo "none"; fi
    return 0
  fi

  _require_root "ssl:autorenew"
  _domain_exists "$domain" || die "Site not found: ${domain}"
  [[ "$action" == "on" || "$action" == "off" ]] || die "Action must be 'on', 'off' or 'status'."
  [[ -f "$renewal" || -f "$disabled" ]] || die "No Let's Encrypt certificate to manage for ${domain}."

  # Disabling moves the renewal config aside so the global `certbot renew` skips
  # just this site; enabling moves it back. Mirror the state into a vhost marker
  # so the panel (www-data) can show it without reading the root-only renewal dir.
  if [[ "$action" == "off" ]]; then
    [[ -f "$renewal" ]] && mv "$renewal" "$disabled"
  else
    [[ -f "$disabled" ]] && mv "$disabled" "$renewal"
  fi
  local conf="${NGINX_CONF_DIR}/${domain}.conf"
  [[ -f "$conf" ]] && _vhost_marker_set "$conf" "AUTORENEW" "$action"
  ok "Auto-renew turned ${action} for ${domain}"
}

# Machine-readable status for the panel's "Run SSL check". One JSON line.
_ssl_check() {
  _parse_opts "$@"
  local domain; domain=$(_opt "domain")
  _require_arg "domain" "$domain" "ssl:check --domain example.com"
  _domain_valid "$domain" || die "Invalid domain name: ${domain}"
  local conf="${NGINX_CONF_DIR}/${domain}.conf"

  # Prefer the certificate actually wired into the vhost (ssl_certificate), so the
  # reported state follows "Use this cert" switches instead of file priority.
  local state="none" certfile="" wired=""
  if [[ -f "$conf" ]]; then
    wired=$(grep -E '^[[:space:]]*ssl_certificate[[:space:]]' "$conf" 2>/dev/null | head -1 \
            | sed -E 's/^[[:space:]]*ssl_certificate[[:space:]]+([^;]+);.*/\1/' | tr -d '[:space:]')
  fi
  if [[ "$wired" == "/etc/letsencrypt/live/${domain}/fullchain.pem" ]]; then
    state="letsencrypt"; certfile="$wired"
  elif [[ "$wired" == "/etc/ssl/aidipanel-custom/${domain}/fullchain.pem" ]]; then
    state="custom"; certfile="$wired"
  elif [[ "$wired" == "/etc/ssl/aidipanel-self/${domain}.crt" ]]; then
    state="self-signed"; certfile="$wired"
  elif [[ -f "/etc/letsencrypt/live/${domain}/fullchain.pem" ]]; then
    state="letsencrypt"; certfile="/etc/letsencrypt/live/${domain}/fullchain.pem"
  elif [[ -f "/etc/ssl/aidipanel-custom/${domain}/fullchain.pem" ]]; then
    state="custom"; certfile="/etc/ssl/aidipanel-custom/${domain}/fullchain.pem"
  elif [[ -f "/etc/ssl/aidipanel-self/${domain}.crt" ]]; then
    state="self-signed"; certfile="/etc/ssl/aidipanel-self/${domain}.crt"
  fi

  local expiry="" days=0 issuer="" trusted="false"
  if [[ -n "$certfile" ]]; then
    local end; end=$(openssl x509 -enddate -noout -in "$certfile" 2>/dev/null | cut -d= -f2)
    if [[ -n "$end" ]]; then
      expiry=$(date -d "$end" '+%Y-%m-%d' 2>/dev/null || echo "")
      days=$(( ( $(date -d "$end" +%s 2>/dev/null || echo 0) - $(date +%s) ) / 86400 ))
    fi
    issuer=$(openssl x509 -issuer -noout -in "$certfile" 2>/dev/null | sed -E 's/^issuer=//')
    issuer="${issuer//\"/}"; issuer="${issuer//\\/}"
    [[ "$state" != "self-signed" && "$days" -gt 0 ]] && trusted="true"
  fi

  local force_https="off" hsts="off" autorenew="none"
  if [[ -f "$conf" ]]; then
    grep -q 'return 301 https' "$conf" 2>/dev/null && force_https="on"
    grep -Eq '^[[:space:]]*add_header[[:space:]]+Strict-Transport-Security' "$conf" 2>/dev/null && hsts="on"
  fi
  if [[ -f "/etc/letsencrypt/renewal/${domain}.conf" ]]; then autorenew="on"
  elif [[ -f "/etc/letsencrypt/renewal/${domain}.conf.disabled" ]]; then autorenew="off"; fi

  printf '{"domain":"%s","state":"%s","expiry":"%s","days_left":%s,"issuer":"%s","trusted":%s,"force_https":"%s","hsts":"%s","auto_renew":"%s"}\n' \
    "$domain" "$state" "$expiry" "$days" "$issuer" "$trusted" "$force_https" "$hsts" "$autorenew"
}

# Switch the vhost to an already-present certificate (Let's Encrypt / imported /
# self-signed). Drives the certificates table's "Use this cert" action.
_ssl_use() {
  _require_root "ssl:use"
  _parse_opts "$@"
  local domain type; domain=$(_opt "domain"); type=$(_opt "type")
  _require_arg "domain" "$domain" "ssl:use --domain example.com --type letsencrypt"
  _require_arg "type"   "$type"   "ssl:use --domain example.com --type letsencrypt|custom|self-signed"
  _domain_valid "$domain"  || die "Invalid domain name: ${domain}"
  _domain_exists "$domain" || die "Site not found: ${domain}"
  local fullchain privkey
  case "$type" in
    letsencrypt) fullchain="/etc/letsencrypt/live/${domain}/fullchain.pem"; privkey="/etc/letsencrypt/live/${domain}/privkey.pem" ;;
    custom)      fullchain="/etc/ssl/aidipanel-custom/${domain}/fullchain.pem"; privkey="/etc/ssl/aidipanel-custom/${domain}/privkey.pem" ;;
    self-signed) fullchain="/etc/ssl/aidipanel-self/${domain}.crt"; privkey="/etc/ssl/aidipanel-self/${domain}.key" ;;
    *) die "Unknown certificate type: ${type}" ;;
  esac
  [[ -f "$fullchain" && -f "$privkey" ]] || die "No ${type} certificate is available for ${domain}."
  _ssl_point_vhost "$domain" "$fullchain" "$privkey"
  ok "Now using the ${type} certificate for ${domain}"
}

# ===========================================================================
# SERVICE COMMANDS
# ===========================================================================

_service_status() {
  _parse_opts "$@"
  echo ""
  echo -e "  ${BOLD}AidiPanel Services${RESET}"
  _hr

  local services=("nginx" "mysql" "redis-server")
  for ver in "${PHP_VERSIONS_SUPPORTED[@]}"; do
    services+=("php${ver}-fpm")
  done

  for svc in "${services[@]}"; do
    local status
    if systemctl is-active --quiet "$svc" 2>/dev/null; then
      status="${GREEN}● running${RESET}"
    elif systemctl list-units --quiet "${svc}.service" &>/dev/null; then
      status="${RED}● stopped${RESET}"
    else
      status="${DIM}  not installed${RESET}"
    fi
    printf "  %-20s " "$svc"
    echo -e "$status"
  done
  _hr
  echo ""
}

_service_action() {
  _require_root "service:${1}"
  local action="$1"
  _parse_opts "${@:2}"
  local service_name; service_name="${OPTS[arg]:-}"
  service_name="${service_name// /}"

  [[ -n "$service_name" ]] || die "Specify a service: nginx, mysql, redis, php (or php8.3, etc.)"
  [[ "$action" =~ ^(start|stop|restart|reload)$ ]] || die "Invalid service action: ${action}"

  # Aliases
  [[ "$service_name" == "redis" ]] && service_name="redis-server"
  [[ "$service_name" == "php" ]]   && service_name="php${PHP_DEFAULT_VERSION}-fpm"
  [[ "$service_name" =~ ^php[0-9]+\.[0-9]+$ ]] && service_name="${service_name}-fpm"

  case "$service_name" in
    nginx|mysql|mariadb|redis-server|php8.2-fpm|php8.3-fpm|php8.4-fpm|php8.5-fpm) ;;
    *) die "Invalid service: ${service_name}" ;;
  esac

  log "${action^}: ${service_name}"
  systemctl "$action" "$service_name" >> "$CLI_LOG" 2>&1 \
    || die "Could not ${action} ${service_name}; the service did not respond as expected."
  ok "${action^}ed: ${service_name}"
}

# ===========================================================================
# USER COMMANDS
# ===========================================================================

_user_add() {
  _require_root "user:add"
  _parse_opts "$@"
  local username; username=$(_opt "user")
  _require_arg "user" "$username" "user:add --user example"

  _validate_site_user "$username"
  id "$username" &>/dev/null && die "User already exists: ${username}"

  # Create a dedicated no-login user (file ownership / PHP isolation only).
  # Login is disabled by default; this mirrors the per-site user model.
  _ensure_site_user "$username" || die "Could not create user '${username}'."

  ok "User created: ${username}"
  _table_row "Username:"  "$username"
  _table_row "Home dir:"  "${HOME_BASE}/${username}"
  _table_row "Shell:"     "/usr/sbin/nologin (login disabled)"
}

_user_delete() {
  _require_root "user:delete"
  _parse_opts "$@"
  local username; username=$(_opt "user")
  _require_arg "user" "$username" "user:delete --user example"

  id "$username" &>/dev/null || die "User not found: ${username}"
  _confirm "Delete user '${username}' and its home directory?" || { log "Cancelled."; return 0; }

  _remove_site_user "$username"
  ok "User deleted: ${username}"
}

_user_list() {
  _parse_opts "$@"
  echo ""
  echo -e "  ${BOLD}Site Users${RESET}"
  _hr
  # List regular users whose home is under HOME_BASE (the per-site user model).
  while IFS=: read -r user _ uid _ _ home _; do
    [[ "$home" == "${HOME_BASE}/"* ]] || continue
    (( uid >= 1000 )) || continue
    printf "  %-20s %s\n" "$user" "$home"
  done < /etc/passwd
  _hr
  echo ""
}

_user_passwd() {
  _require_root "user:passwd"
  _parse_opts "$@"
  local username; username=$(_opt "user")
  _require_arg "user" "$username" "user:passwd --user example"

  id "$username" &>/dev/null || die "User not found: ${username}"

  # Site users are no-login by default. Setting an interactive password would
  # re-enable login, which the per-site isolation model intentionally disables.
  die "Site users are no-login by default; interactive passwords are not set. SFTP/SSH access is a planned, opt-in feature."
}

# ===========================================================================
# SYSTEM COMMANDS
# ===========================================================================

_system_info() {
  _parse_opts "$@"
  local hostname; hostname=$(hostname)
  local server_ip; server_ip=$(ip route get 8.8.8.8 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1);exit}}' || echo "-")
  local os_info; os_info=$(grep PRETTY_NAME /etc/os-release 2>/dev/null | cut -d= -f2 | tr -d '"' || echo "-")
  local kernel; kernel=$(uname -r)
  local arch; arch=$(uname -m)
  local cpu; cpu=$(nproc)
  local mem_total; mem_total=$(grep MemTotal /proc/meminfo | awk '{printf "%.0f MB", $2/1024}')
  local mem_free; mem_free=$(grep MemAvailable /proc/meminfo | awk '{printf "%.0f MB", $2/1024}')
  local disk; disk=$(df -h / | awk 'NR==2{print $4" free of "$2}')
  local load; load=$(cut -d' ' -f1-3 /proc/loadavg)
  local uptime_str; uptime_str=$(uptime -p 2>/dev/null || uptime)

  echo ""
  echo -e "  ${BOLD}${CYAN}AidiPanel v${CLI_VERSION}${RESET} — System Information"
  _hr
  _table_row "Hostname:"     "$hostname"
  _table_row "IP address:"   "$server_ip"
  _table_row "OS:"           "$os_info"
  _table_row "Kernel:"       "$kernel"
  _table_row "Architecture:" "$arch"
  _table_row "CPU cores:"    "$cpu"
  _table_row "Memory total:" "$mem_total"
  _table_row "Memory free:"  "$mem_free"
  _table_row "Disk (/):"     "$disk"
  _table_row "Load avg:"     "$load"
  _table_row "Uptime:"       "$uptime_str"
  _hr
  echo ""
}

_log_tail() {
  _parse_opts "$@"
  local domain; domain=$(_opt "domain")
  local log_type; log_type=$(_opt "type" "access")
  local lines; lines=$(_opt "lines" "50")
  _require_arg "domain" "$domain" "log:tail --domain example.com --type access"
  _domain_valid "$domain" || die "Invalid domain name: ${domain}"
  [[ "$lines" =~ ^[0-9]+$ ]] || die "Lines must be a number"

  local log_file
  case "$log_type" in
    access)     log_file="/var/log/nginx/${domain}-access.log" ;;
    error)      log_file="/var/log/nginx/${domain}-error.log" ;;
    php)        log_file="/var/log/php/php-fpm.log" ;;
    aidipanel)  log_file="$CLI_LOG" ;;
    *)          die "Invalid log type: ${log_type}. Supported: access, error, php, aidipanel" ;;
  esac

  [[ -f "$log_file" ]] || die "Log file not found: ${log_file}"

  log "Tailing ${lines} lines from: ${log_file} (Ctrl+C to stop)"
  tail -n "$lines" -f "$log_file"
}

_self_update() {
  _require_root "self:update"
  log "Checking for AidiPanel CLI updates..."
  local install_url="https://raw.githubusercontent.com/rezzaidr/AidiPanel/master/aidipanel"
  # Optional override: /etc/aidipanel/update.conf may set UPDATE_URL=...
  if [[ -r /etc/aidipanel/update.conf ]]; then
    # shellcheck disable=SC1091
    source /etc/aidipanel/update.conf
    [[ -n "${UPDATE_URL:-}" ]] && install_url="$UPDATE_URL"
  fi
  local tmp_file; tmp_file=$(mktemp /tmp/aidipanel-cli.XXXXXX)

  curl -fsSL "$install_url" -o "$tmp_file" 2>/dev/null \
    || die "Failed to download update. Check internet connection."

  bash -n "$tmp_file" || die "Downloaded script has syntax errors — aborting update."

  local current_bin; current_bin=$(command -v aidipanel)
  cp "$tmp_file" "$current_bin"
  chmod +x "$current_bin"
  rm -f "$tmp_file"

  ok "AidiPanel CLI updated: ${current_bin}"
  aidipanel --version 2>/dev/null || true
}

# ---------------------------------------------------------------------------
# RUN HELPER (used inside functions to exec+log commands)
# ---------------------------------------------------------------------------
run() {
  echo "[$(_ts)] RUN: $*" >> "$CLI_LOG" 2>/dev/null || true
  "$@" >> "$CLI_LOG" 2>&1
}

# ===========================================================================
# MAIN DISPATCHER
# ===========================================================================
main() {
  # Init log
  mkdir -p "$(dirname "$CLI_LOG")"
  touch "$CLI_LOG" 2>/dev/null || true

  local command="${1:-}"
  shift 2>/dev/null || true

  # Streaming progress: the panel passes --progress so long ops emit @@PROGRESS
  # stage markers on stdout. Detect it ONCE here (a flag, not an env var, so it
  # survives the sudo wrapper) so nested helpers can't lose it to a re-parse.
  local _a
  for _a in "$@"; do [[ "$_a" == "--progress" ]] && PROGRESS_ENABLED=1; done

  case "$command" in
    # Site
    site:add)       _site_add "$@" ;;
    site:delete)    _site_delete "$@" ;;
    site:list)      _site_list "$@" ;;
    site:info)      _site_info "$@" ;;
    vhost:save)     _vhost_save "$@" ;;

    # Cache — per-site status (Phase 1)
    cache:page)   _cache_page "$@" ;;
    cache:redis)  _cache_redis_per_site "$@" ;;
    cache:zone)   _cache_zone "$@" ;;
    # Cache — existing commands (unchanged)
    cache:status)   _cache_status "$@" ;;
    cache:purge)    _cache_purge "$@" ;;
    cache:enable)   _cache_toggle enable "$@" ;;
    cache:disable)  _cache_toggle disable "$@" ;;
    cache:config)   _cache_config "$@" ;;
    cache:migrate)       _cache_migrate "$@" ;;
    cache:harden)        _cache_harden "$@" ;;
    cache:redis-status)  _cache_redis_status "$@" ;;
    cache:redis-enable)  _cache_redis_enable "$@" ;;
    cache:redis-disable) _cache_redis_disable "$@" ;;
    cache:redis-flush)      _cache_redis_flush "$@" ;;
    cache:opcache-restart)  _cache_opcache_restart "$@" ;;

    # Database
    db:add)         _db_add "$@" ;;
    db:delete)      _db_delete "$@" ;;
    db:list)        _db_list "$@" ;;
    db:users)       _db_users "$@" ;;
    db:user-add)    _db_user_add "$@" ;;
    db:user-edit)   _db_user_edit "$@" ;;
    db:user-delete) _db_user_delete "$@" ;;
    db:pma-credentials) _db_pma_credentials "$@" ;;
    db:pma-install) _db_pma_install "$@" ;;
    db:backup)      _db_backup "$@" ;;

    # PHP
    php:install)    _php_install "$@" ;;
    php:list)       _php_list "$@" ;;
    php:version)    _php_version "$@" ;;
    php:restart)    _php_restart "$@" ;;
    php:info)       _php_info "$@" ;;

    # SSL
    ssl:install)    _ssl_install "$@" ;;
    ssl:renew)      _ssl_renew "$@" ;;
    ssl:status)     _ssl_status "$@" ;;
    ssl:import)     _ssl_import "$@" ;;
    ssl:force-https) _ssl_force_https "$@" ;;
    ssl:hsts)       _ssl_hsts "$@" ;;
    ssl:autorenew)  _ssl_autorenew "$@" ;;
    ssl:check)      _ssl_check "$@" ;;
    ssl:use)        _ssl_use "$@" ;;

    # Service
    service:status)  _service_status "$@" ;;
    service:restart) _service_action restart "$@" ;;
    service:reload)  _service_action reload "$@" ;;
    service:start)   _service_action start "$@" ;;
    service:stop)    _service_action stop "$@" ;;

    # User
    user:add)       _user_add "$@" ;;
    user:delete)    _user_delete "$@" ;;
    user:list)      _user_list "$@" ;;
    user:passwd)    _user_passwd "$@" ;;

    # System
    system:info)    _system_info "$@" ;;
    log:tail)       _log_tail "$@" ;;
    self:update)    _self_update "$@" ;;

    --version|-v)
      echo "AidiPanel CLI v${CLI_VERSION}"
      ;;

    help|--help|-h|"")
      _usage
      ;;

    *)
      echo -e "${RED}Unknown command: '${command}'${RESET}"
      echo "Run 'aidipanel help' to see all available commands."
      exit 1
      ;;
  esac
}

main "$@"
